  "scripts": {
    "adb-wifi": "node adb-wifi.js",
    "bootsplash": "npx react-native generate-bootsplash assets/images/app_logo.png --platforms=android,ios --background=\"#87CEEB\"",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "postinstall": "patch-package",
    "clean": "cd android && ./gradlew clean && cd ..",
    "bundle:android": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output ./ota-bundle/index.android.bundle --assets-dest ./ota-bundle/",
    "bundle:zip": "powershell -Command \"Compress-Archive -Path ./ota-bundle/* -DestinationPath ./bundle.zip -Force\"",
    "ota:prepare": "npm run bundle:android && npm run bundle:zip",
    "clean:ota": "powershell -Command \"Remove-Item -Recurse -Force -ErrorAction SilentlyContinue ota-bundle, android.bundle, bundle.zip\"",
    "ota:fresh": "npm run clean:ota & npm run ota:prepare",
    "build:android": "powershell -Command \"cd android; .\\gradlew assembleRelease; cd ..\"",
    "build:android:debug": "powershell -Command \"cd android; .\\gradlew assembleDebug; cd ..\""
  },
