c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c05\u0c2a\u0c4d\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.","Upload failed":"\u0c05\u0c2a\u0c4d\u0c32\u0c4b\u0c21\u0c4d \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f","Selfie with Store":"\u0c38\u0c4d\u0c1f\u0c4b\u0c30\u0c4d\u200c\u0c24\u0c4b \u0c38\u0c46\u0c32\u0c4d\u0c2b\u0c40",key_pleaseupl_62:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c2a\u0c3f\u0c15\u0c2a\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c32\u0c4b \u0c38\u0c46\u0c32\u0c4d\u0c2b\u0c40 \u0c05\u0c2a\u0c4d\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Location unavailable":"\u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41","Address not available, showing GPS only":"\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c32\u0c47\u0c26\u0c41, \u0c15\u0c47\u0c35\u0c32\u0c02 GPS \u0c1a\u0c42\u0c2a\u0c3f\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f",Retake:"\u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f","Scratch Code Verification":"\u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c24\u0c28\u0c3f\u0c16\u0c40",Name_Address_Location:"\u0c2a\u0c47\u0c30\u0c41 / \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e / \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02","Point Code_Shop Id":"\u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d \u0c15\u0c4b\u0c21\u0c4d / \u0c37\u0c3e\u0c2a\u0c4d ID","Contact Person Name":"\u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c2a\u0c41 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f \u0c2a\u0c47\u0c30\u0c41","Very Important Note":"\u0c1a\u0c3e\u0c32\u0c3e \u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c2e\u0c48\u0c28 \u0c17\u0c2e\u0c28\u0c3f\u0c15",Cms_Note_1:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 \u0c07\u0c1a\u0c4d\u0c1a\u0c3f\u0c28 \u0c2c\u0c1f\u0c28\u0c4d (\u0c39\u0c3e, \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f) \u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41, \u0c05\u0c35\u0c38\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c28\u0c41\u0c17\u0c41\u0c23\u0c02\u0c17\u0c3e \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c38\u0c02\u0c26\u0c47\u0c36\u0c02 \u0c2a\u0c02\u0c2a\u0c47 \u0c21\u0c3f\u0c2b\u0c3e\u0c32\u0c4d\u0c1f\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c32\u0c3f\u0c02\u0c15\u0c4d \u0c2a\u0c26\u0c4d\u0c27\u0c24\u0c3f\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f. \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c2a\u0c02\u0c2a\u0c3f\u0c28 \u0c32\u0c3f\u0c02\u0c15\u0c4d\u200c\u0c32\u0c4b \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c2a\u0c4a\u0c02\u0c26\u0c41\u0c24\u0c3e\u0c30\u0c41. \u0c07\u0c30\u0c41\u0c35\u0c41\u0c30\u0c41 \u0c15\u0c4b\u0c21\u0c4d\u200c\u0c28\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c3f, \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c38\u0c4d\u0c25\u0c3e\u0c28\u0c02\u0c32\u0c4b \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c3e\u0c30\u0c41.","Action is":"\u0c1a\u0c30\u0c4d\u0c2f \u0c0f\u0c2e\u0c3f\u0c1f\u0c3f","for successful pickup":"\u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c2e\u0c48\u0c28 \u0c2a\u0c3f\u0c15\u0c2a\u0c4d \u0c15\u0c4b\u0c38\u0c02","TEXT SMS":"\u0c1f\u0c46\u0c15\u0c4d\u0c38\u0c4d\u0c1f\u0c4d SMS",WhatsApp:"WhatsApp","E-mail ID":"\u0c07-\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d ID",Cms_Note_2:"\u0c17\u0c2e\u0c28\u0c3f\u0c15: \u0c30\u0c39\u0c38\u0c4d\u0c2f \u0c15\u0c4b\u0c21\u0c4d \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c4d\u0c32\u0c2f\u0c3f\u0c21\u0c4d \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c0e\u0c21\u0c2e \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c15\u0c41\u0c21\u0c3f\u0c15\u0c3f \u0c38\u0c4d\u0c35\u0c48\u0c2a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c07\u0c30\u0c41\u0c35\u0c41\u0c30\u0c41 \u0c15\u0c42\u0c21\u0c3e 7 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c15\u0c4b\u0c21\u0c4d \u0c2a\u0c4a\u0c02\u0c26\u0c24\u0c3e\u0c30\u0c41, \u0c07\u0c26\u0c3f \u0c2a\u0c30\u0c38\u0c4d\u0c2a\u0c30\u0c02 \u0c37\u0c47\u0c30\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f.","Generate Code":"\u0c15\u0c4b\u0c21\u0c4d \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Cms_Success_Msg:"\u0c05\u0c2d\u0c3f\u0c28\u0c02\u0c26\u0c28\u0c32\u0c41, \u0c30\u0c39\u0c38\u0c4d\u0c2f \u0c15\u0c4b\u0c21\u0c4d \u0c2e\u0c40 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c41\u0c28\u0c4d\u0c28 \u0c2e\u0c4b\u0c21\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c37\u0c47\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c2a\u0c4a\u0c02\u0c26\u0c15\u0c2a\u0c4b\u0c24\u0c47","click upon Resend Button":"\"\u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c02\u0c2a\u0c41 \u0c2c\u0c1f\u0c28\u0c4d\" \u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Resend Code":"\u0c15\u0c4b\u0c21\u0c4d \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c02\u0c2a\u0c02\u0c21\u0c3f","Your scratch code is below":"\u0c2e\u0c40 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 \u0c09\u0c02\u0c26\u0c3f, \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u0c32\u0c24\u0c4b \u0c37\u0c47\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Ask the Customer Contact Person":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c15\u0c3e\u0c02\u0c1f\u0c3e\u0c15\u0c4d\u0c1f\u0c4d \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f \u0c28\u0c41\u0c02\u0c21\u0c3f 6 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32 \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c05\u0c21\u0c3f\u0c17\u0c3f, \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter customer code":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","scratch Code Copied":"\u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c15\u0c3e\u0c2a\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Scratch Code is required":"\u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c05\u0c35\u0c38\u0c30\u0c02","Scratch Code":"\u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c3e\u0c1a\u0c4d \u0c15\u0c4b\u0c21\u0c4d","Please confirm details":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c30\u0c3f\u0c17\u0c3e \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3e \u0c05\u0c28\u0c3f \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2c\u0c3e\u0c15\u0c4d\u0c38\u0c4d\u200c\u0c28\u0c3f \u0c1a\u0c46\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Enter Mobile and TransID":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 ID \u0c30\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c1f\u0c3f\u0c28\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","OTP Sent":"\ud83d\udce9 OTP \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Failed to send OTP":"\u26a0 OTP \u0c2a\u0c02\u0c2a\u0c21\u0c02\u0c32\u0c4b \u0c35\u0c3f\u0c2b\u0c32\u0c02. \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f:","Error sending OTP":"\u274c OTP \u0c2a\u0c02\u0c2a\u0c21\u0c02\u0c32\u0c4b \u0c32\u0c4b\u0c2a\u0c02.","Enter 6-digit OTP":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f 6-\u0c05\u0c02\u0c15\u0c46\u0c32 OTP \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","OTP Verified":"\u2705 OTP \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.","OTP verification failed":"\u26a0 OTP \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f. \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f:","Error verifying OTP":"\u274c OTP \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23\u0c32\u0c4b \u0c32\u0c4b\u0c2a\u0c02.","Exit Confirmation":"\u0c2e\u0c40\u0c30\u0c41 \u0c28\u0c3f\u0c1c\u0c02\u0c17\u0c3e \u0c2c\u0c2f\u0c1f\u0c15\u0c41 \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c3e? \u0c2e\u0c40\u0c30\u0c41 \u0c07\u0c02\u0c15\u0c3e \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c26\u0c36\u0c32\u0c28\u0c41 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c26\u0c28\u0c3f, \u0c07\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c2c\u0c2f\u0c1f\u0c15\u0c41 \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c21\u0c02 \u0c35\u0c32\u0c4d\u0c32 \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c17\u0c24\u0c3f \u0c15\u0c4b\u0c32\u0c4d\u0c2a\u0c4b\u0c24\u0c3e\u0c30\u0c41.","Go To Home":"\u0c39\u0c4b\u0c2e\u0c4d\u200c\u0c15\u0c41 \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c02\u0c21\u0c3f",Denom:"\u0c35\u0c3f\u0c32\u0c41\u0c35","No. of Notes":"\u0c28\u0c4b\u0c1f\u0c4d\u0c32\u0c41 \u0c38\u0c02\u0c16\u0c4d\u0c2f",Receipt:"\u0c30\u0c38\u0c40\u0c26\u0c41","RCMS CUSTOMER INFO":"RCMS \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02","Verification Required":"\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c05\u0c35\u0c38\u0c30\u0c02","Please match the number of":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c02\u0c16\u0c4d\u0c2f\u0c28\u0c41 \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c4d\u0c1a\u0c02\u0c21\u0c3f",Notes:"\u0c28\u0c4b\u0c1f\u0c4d\u0c32\u0c41","total amount":"\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02","Complete transaction msg":"\u0c05\u0c28\u0c4d\u0c28\u0c40 \u0c38\u0c30\u0c3f\u0c17\u0c4d\u0c17\u0c3e \u0c09\u0c02\u0c1f\u0c47, OTP\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c38\u0c3f \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","OTP sent msg":"OTP \u0c38\u0c4d\u0c1f\u0c4b\u0c30\u0c4d \u0c15\u0c3e\u0c02\u0c1f\u0c3e\u0c15\u0c4d\u0c1f\u0c4d \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c15\u0c3f \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","with details msg":"\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c2e\u0c4a\u0c24\u0c4d\u0c24 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c24\u0c4b.","ReQ No.":"\u0c05\u0c28\u0c41\u0c30\u0c4b\u0c27 \u0c38\u0c02\u0c16\u0c4d\u0c2f","Pickup Time":"\u0c2a\u0c3f\u0c15\u0c2a\u0c4d \u0c38\u0c2e\u0c2f\u0c02",Cms_Check_Msg:"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c28\u0c47\u0c28\u0c41 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c38\u0c3e\u0c28\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c4d\u0c1f\u0c4b\u0c30\u0c4d \u0c15\u0c3e\u0c02\u0c1f\u0c3e\u0c15\u0c4d\u0c1f\u0c4d \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c24\u0c4b \u0c15\u0c42\u0c21\u0c3e \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c28\u0c41, \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f\u0c17\u0c3e \u0c38\u0c30\u0c48\u0c28\u0c26\u0c3f, \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c47\u0c28\u0c41 \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c1a\u0c30\u0c4d\u0c2f\u0c28\u0c41 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c3e\u0c28\u0c41.","Verify & Fill Next Data":"\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c2d\u0c30\u0c4d\u0c24\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Send OTP to Customer Point":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d\u200c\u0c15\u0c41 OTP \u0c2a\u0c02\u0c2a\u0c02\u0c21\u0c3f","If OTP is not received":"OTP \u0c05\u0c02\u0c26\u0c15\u0c2a\u0c4b\u0c24\u0c47,","Verify & Next":"\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c24\u0c26\u0c41\u0c2a\u0c30\u0c3f","Please enter a valid pin code":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c12\u0c15 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c28 \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Failed to add pin code":"\u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c1c\u0c4b\u0c21\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c35\u0c3f\u0c2b\u0c32\u0c02","No pinType selected":"\u274c \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c0e\u0c32\u0c3e\u0c02\u0c1f\u0c3f \u0c2a\u0c3f\u0c28\u0c4d \u0c30\u0c15\u0c02 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41.","Work In Other Code Area":"\u0c07\u0c24\u0c30 \u0c15\u0c4b\u0c21\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c02\u0c24\u0c02\u0c32\u0c4b \u0c2a\u0c28\u0c3f \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","My Own Pin Code":"\u0c28\u0c3e \u0c38\u0c4d\u0c35\u0c02\u0c24 \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d","Your own Pin Code msg":"\u0c2e\u0c40 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32 \u0c2a\u0c4d\u0c30\u0c15\u0c3e\u0c30\u0c02, \u0c2e\u0c40 \u0c38\u0c4d\u0c35\u0c02\u0c24 \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c2a\u0c48 \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.",Cms_Add_Pin_Msg:"\u0c2e\u0c40\u0c30\u0c41 \u0c07\u0c24\u0c30 \u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c4b\u0c21\u0c4d \u0c2a\u0c4d\u0c