f\u0c2e\u0c3f\u0c1f\u0c3f?",key_ifyoua_129:"1. \u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c4d\u0c30\u0c26\u0c47\u0c36\u0c02\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c2e\u0c40 \u0c17\u0c42\u0c17\u0c41\u0c32\u0c4d \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c06\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c30\u0c40\u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",key_ifyoua_130:"2. \u0c2e\u0c40\u0c30\u0c41 \u0c35\u0c46\u0c32\u0c41\u0c2a\u0c32 \u0c09\u0c28\u0c4d\u0c28\u0c1f\u0c4d\u0c32\u0c2f\u0c3f\u0c24\u0c47, \u0c1c\u0c3f\u0c2f\u0c4b\u0c2b\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c32\u0c4b\u0c2a\u0c32\u0c3f\u0c15\u0c3f \u0c30\u0c02\u0c21\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c1a\u0c3e\u0c32\u0c3e \u0c26\u0c17\u0c4d\u0c17\u0c30\u0c17\u0c3e \u0c09\u0c28\u0c4d\u0c28\u0c3e \u0c32\u0c4b\u0c2a\u0c32 \u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c32\u0c4b\u0c2a\u0c32\u0c3f\u0c15\u0c3f \u0c35\u0c1a\u0c4d\u0c1a\u0c3f \u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",key_turnon_131:"3. \u0c17\u0c42\u0c17\u0c41\u0c32\u0c4d \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c05\u0c15\u0c4d\u0c2f\u0c41\u0c30\u0c46\u0c38\u0c40\u0c28\u0c3f \u0c06\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c07\u0c26\u0c3f \u0c2e\u0c40 \u0c2b\u0c4b\u0c28\u0c4d \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c2e\u0c48\u0c28 \u0c32\u0c4a\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f",key_ifthere_132:"4. \u0c07\u0c24\u0c30 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32\u0c41 \u0c09\u0c02\u0c1f\u0c47 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d\u200c\u0c15\u0c41 \u0c15\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",I_Understood:"\u0c28\u0c3e\u0c15\u0c41 \u0c05\u0c30\u0c4d\u0c25\u0c2e\u0c48\u0c02\u0c26\u0c3f",Extremely_Important:"\u0c1a\u0c3e\u0c32\u0c3e \u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c2e\u0c48\u0c28\u0c26\u0c3f",Sorry_you_cannot_accept_new_payment_from_Customer_Point_without_police_verification_PVC:"\u0c15\u0c4d\u0c37\u0c2e\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c2a\u0c4b\u0c32\u0c40\u0c38\u0c4d \u0c35\u0c46\u0c30\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d (PVC) \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2a\u0c3e\u0c2f\u0c3f\u0c02\u0c1f\u0c4d \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2a\u0c47\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c32\u0c47\u0c30\u0c41",But_this_is_optional_for_the_customer_you_can_continue_further:"\u0c15\u0c3e\u0c28\u0c40 \u0c07\u0c26\u0c3f \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c10\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c02, \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c41\u0c02\u0c26\u0c41\u0c15\u0c41 \u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c35\u0c1a\u0c4d\u0c1a\u0c41",Police_verification_is_mandatory_Please_do_the_verification_and_then_try_again:"\u0c2a\u0c4b\u0c32\u0c40\u0c38\u0c4d \u0c35\u0c46\u0c30\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c35\u0c46\u0c30\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Contact_to_admin_for_more_details:"\u0c2e\u0c30\u0c3f\u0c28\u0c4d\u0c28\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c21\u0c4d\u0c2e\u0c3f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Recent_5_Transaction:"\u0c07\u0c1f\u0c40\u0c35\u0c32\u0c3f