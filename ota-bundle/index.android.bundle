94b\u0917 \u0915\u0930\u0915\u0947 \u0906\u092a \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092c\u0922\u093c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0932\u0949\u0917\u093f\u0928 \u0924\u092d\u0940 \u0938\u0902\u092d\u0935 \u0939\u094b\u0917\u093e \u091c\u092c \u0906\u092a\u0915\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0938\u093f\u092e \u0909\u0938\u0940 \u092e\u094b\u092c\u093e\u0907\u0932 \u092e\u0947\u0902 \u0939\u094b \u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u092a \u092e\u094b\u092c\u093e\u0907\u0932 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964","Submit OTP":"\u0913\u091f\u0940\u092a\u0940 \u091c\u092e\u093e \u0915\u0930\u0947\u0902","Save Change":"\u092c\u0926\u0932\u093e\u0935 \u0938\u0939\u0947\u091c\u0947\u0902","":""},SMS:"\u090f\u0938\u090f\u092e\u090f\u0938",SP1:"\u0938\u0947\u0932\u094d\u092b \u092a\u0947\u0906\u0909\u091f \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u0948\u0938\u093e IMPS (\u0924\u0924\u094d\u0915\u093e\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0947\u0935\u093e) \u0914\u0930 NEFT (\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092b\u0902\u0921 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930) \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u092d\u0947\u091c\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964",SP2:"\u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u0940 \u0938\u0947 10.00 \u0930\u0941\u092a\u092f\u0947 \u0936\u0941\u0932\u094d\u0915 \u0932\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e",SP3:"\u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u093e\u0930\u0923 \u0938\u0947, \u0917\u0932\u0924