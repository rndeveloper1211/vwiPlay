eClosed:"\u0917\u094d\u0930\u0940\u0928 \u0932\u093e\u0907\u0928 \u092c\u0902\u0926 \u0939\u0948",green_line_aeps:"\u0917\u094d\u0930\u0940\u0928 \u0932\u093e\u0907\u0928 \u090f\u0908\u092a\u0940\u090f\u0938",gst_length_error:"\u091c\u0940\u090f\u0938\u091f\u0940 \u0928\u0902\u092c\u0930 \u0915\u092e \u0938\u0947 \u0915\u092e 15 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f",gst_optional:"\u091c\u0940\u090f\u0938\u091f\u0940 (\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915)",health:"\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f",help:"\u0938\u0939\u093e\u092f\u0924\u093e \u0914\u0930 \u0938\u092e\u0930\u094d\u0925\u0928",hi:"\u0928\u092e\u0938\u094d\u0924\u0947",hindi:"\u0939\u093f\u0902\u0926\u0940",home:"\u092e\u0941\u0916\u094d\u092f\u092a\u0943\u0937\u094d\u0920",home_page:"\u092e\u0941\u0916 \u092a\u0943\u0937\u094d\u0920",home_screen_title:"\u0939\u094b\u092e","ifsc code..":"\u0906\u0908\u090f\u092b\u090f\u0938\u0938\u0940 \u0915\u094b\u0921..",ifscCode:"IFSC \u0915\u094b\u0921",important:"\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923","indian currency denominations":"\u092d\u093e\u0930\u0924\u0940\u092f \u092e\u0941\u0926\u094d\u0930\u093e \u092e\u0942\u0932\u094d\u092f\u0935\u0930\u094d\u0917",invalid_otp:"\u0905\u092e\u093e\u0928\u094d\u092f \u0913\u091f\u0940\u092a\u0940",invalid_otp_request_failed:"\u0905\u092e\u093e\u0928\u094d\u092f \u0913\u091f\u0940\u092a\u0940 \u092f\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0935\u093f\u092b\u0932\u0964",iosMsg:"IOS \u0910\u092a \u0932\u093f\u0902\u0915 \u092d\u0947\u091c\u0928\u0947 \u092f\u093e \u0915\u0949\u092a\u0940 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0928\u093f\u092e\u094d\u0928 \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902","is Pending":"\u0932\u0902\u092c\u093f\u0924 \u0939\u0948",is_already_exists:"\u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948",issue_fetching_data_error:"\u0921\u0947\u091f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u092e\u0938\u094d\u092f\u093e \u0939\u0941\u0908\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",join_now:"\u0905\u092d\u0940 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0902",kyc:"\u0915\u0947\u0935\u093e\u0908\u0938\u0940",kycInfo:"\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940",label:"\u0932\u0947\u092c\u0932",language_changed_success:"\u092d\u093e\u0937\u093e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092c\u0926\u0932 \u0917\u0908 \u0939\u0948\u0964","location Permission":"\u0938\u094d\u0925\u093e\u0928 \u0905\u0928\u0941\u092e\u0924\u093f",locationMsg:"\u092a\u094d\u0930\u093f\u092f \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u092d\u093e\u0917\u0940\u0926\u093e\u0930 \u0906\u092a\u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0939\u092e\u093e\u0930\u0940 \u092e\u0941\u0916\u094d\u092f \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0939\u0948, \u0906\u092a \u0905\u092a\u0928\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0932\u0949\u0917\u093f\u0928 \u0914\u0930 \u0932\u0947\u0928\u0926\u0947\u0928 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f \u0915\u0947 \u0932\u093f\u090f 3 \u0936\u0939\u0930\u094b\u0902 \u0924\u0915 \u0932\u0949\u0917\u093f\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u091c\u094b\u0921\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",location_note_title:"\u0915\u0943\u092a\u092f\u093e \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0902 \u0915\u093f \u092f\u0939",location_outside_message:"\u0906\u092a \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0915\u0938\u094d\u091f\u092e\u0930 \u0938\u0947\u0902\u091f\u0930 \u0915\u0947 \u091c\u093f\u092f\u094b\u092b\u0947\u0902\u0938\u093f\u0902\u0917 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u0939\u092e \u0906\u092a\u0915\u094b \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0947 \u0938\u0915\u0924\u0947\u0964",location_solution_1:"1. \u092f\u0926\u093f \u0906\u092a \u0938\u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0939\u0948\u0902, \u0924\u094b \u0905\u092a\u0928\u093e Google Location \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902 \u092f\u093e \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964",location_solution_2:"2. \u092f\u0926\u093f \u0906\u092a \u092c\u093e\u0939\u0930 \u0939\u0948\u0902, \u0924\u094b \u091c\u093f\u092f\u094b\u092b\u0947\u0902\u0938 \u0915\u0947 \u0905\u0902\u0926\u0930 \u091c\u093e\u090f\u0901\u0964 \u092f\u0926\u093f \u0906\u092a \u092c\u0939\u0941\u0924 \u092a\u093e\u0938 \u0939\u0948\u0902 \u0932\u0947\u0915\u093f\u0928 \u0905\u0902\u0926\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902, \u0924\u094b \u0905\u0902\u0926\u0930 \u091c\u093e\u0915\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",location_solution_3:"3. Google Location Accuracy \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902: \u0907\u0938\u0938\u0947 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0938\u092c\u0938\u0947 \u0938\u091f\u0940\u0915 \u0932\u094b\u0915\u0947\u0936\u0928 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0917\u093e\u0964",location_solution_4:"4. \u092f\u0926\u093f \u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e \u0939\u0948, \u0924\u094b \u0915\u0938\u094d\u091f\u092e\u0930 \u0938\u0947\u0935\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964",location_solution_title:"\u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u094d\u092f\u093e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948?",login:"\u0932\u0949\u0917\u093f\u0928",loginInfo:"\u0932\u0949\u0917\u093f\u0928 \u091c\u093e\u0928\u0915\u093e\u0930\u0940",loginPlateMsg:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u094b \u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092c\u0926\u0932\u0928\u0947 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u0948, \u092b\u093f\u0930 \u0915\u0943\u092a\u092f\u093e \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964",login_credentials_blank:"\u0915\u0943\u092a\u092f\u093e \u092e\u093e\u0928\u094d\u092f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0906\u0908\u0921\u0940 \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902, \u0906\u092a \u0907\u0938\u0947 \u0916\u093e\u0932\u0940 \u0928\u0939\u0940\u0902 \u091b\u094b\u0921\u093c \u0938\u0915\u0924\u0947",logout:"\u0932\u0949\u0917 \u0906\u0909\u091f","m-ATM History":"\u090f\u092e-\u090f\u091f\u0940\u090f\u092e \u0907\u0924\u093f\u0939\u093e\u0938",mATM:"\u090f\u092e.\u090f\u091f\u0940\u090f\u092e",main_wallet:"\u092e\u0941\u0916\u094d\u092f \u0935\u0949\u0932\u0947\u091f",masked_pan:"\u092e\u093e\u0938\u094d\u0915\u094d\u0921 \u092a\u0948\u0928",max:"\u0905\u0927\u093f\u0915\u0924\u092e","max (\u20b9)":"\u0905\u0927\u093f\u0915\u0924\u092e (\u20b9)",message:"\u0938\u0902\u0926\u0947\u0936",min:"\u0928\u094d\u092f\u0942\u0928\u0924\u092e",mis:"\u0938\u092d\u0940 \u092e\u0941\u0916\u094d\u092f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0907\u0938 \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964 \u0906\u092a \u0905\u092a\u0928\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0928\u0941\u0938\u093e\u0930 \u0910\u092a \u0915\u0940 \u092d\u093e\u0937\u093e \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0910\u092a \u092e\u0947\u0902 \u0905\u0927\u093f\u0915\u093e\u0902\u0936 \u092d\u093e\u0930\u0924\u0940\u092f \u092d\u093e\u0937\u093e\u090f\u0901 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0902\u0964 \u0906\u092a \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092e\u094b\u0921, \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0914\u0930 \u0905\u0928\u094d\u092f \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u094b \u092e\u0948\u0928\u0947\u091c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",missing_fields:"\u0935\u093f\u0935\u0930\u0923 \u0917\u093e\u092f\u092c \u0939\u0948\u0902",mobileNumber:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930",mobile_already_exists:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0964",mobile_exists_error:"\u0906\u092a\u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0938 \u092e\