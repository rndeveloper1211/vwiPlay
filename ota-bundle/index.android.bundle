a96\u0abe\u0aa4\u0ac1\u0a82 \u0a95\u0abe\u0aa2\u0acd\u0aaf\u0abe \u0aaa\u0a9b\u0ac0, \u0aa4\u0aae\u0ac7 \u0aad\u0ab5\u0abf\u0ab7\u0acd\u0aaf\u0aae\u0abe\u0a82 \u0aa4\u0ac7\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0ac7\u0ab6 \u0aae\u0ac7\u0ab3\u0ab5\u0ac0 \u0ab6\u0a95\u0ab6\u0acb \u0aa8\u0ab9\u0ac0\u0a82 \u0a85\u0aa8\u0ac7 \u0aac\u0aa7\u0ac0 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0 \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1 \u0aaa\u0aa3 \u0aa6\u0ac2\u0ab0 \u0aa5\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aaa\u0a9b\u0ac0 \u0aaa\u0ac1\u0aa8\u0a83\u0aaa\u0acd\u0ab0\u0abe\u0aaa\u0acd\u0aa4 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0ab6\u0ac7 \u0aa8\u0ab9\u0ac0\u0a82. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab8\u0a82\u0aae\u0aa4 \u0ab9\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a9c \u0a95\u0abe\u0aa2\u0acb.",Delete:"\u0a95\u0abe\u0aa2\u0ac0 \u0aa8\u0abe\u0a96\u0acb",Cancel:"\u0ab0\u0aa6 \u0a95\u0ab0\u0acb","Press me if you agree to the deletion":"\u0a95\u0abe\u0aa2\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0a82\u0aae\u0aa4 \u0ab9\u0acb \u0aa4\u0acb \u0aae\u0aa8\u0ac7 \u0aa6\u0aac\u0abe\u0ab5\u0acb","Are you sure you want to delete your account?":"\u0ab6\u0ac1\u0a82 \u0aa4\u0aae\u0ac7 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0a95\u0abe\u0aa2\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a9b\u0acb?"},"Are You Sure ?":"\u0ab6\u0ac1\u0a82 \u0aa4\u0aae\u0ac7 \u0a96\u0abe\u0aa4\u0ab0\u0ac0 \u0a95\u0ab0\u0acb \u0a9b\u0acb?","Yes, Delete Account":"\u0ab9\u0abe, \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0a95\u0abe\u0aa2\u0ac0 \u0aa8\u0abe\u0a96\u0acb","Delete Your Account Successfully":"\u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0a95\u0abe\u0aa2\u0ac0 \u0aa8\u0abe\u0a96\u0ab5\u0a