c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Update Password":"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Re-enter New Password":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c28\u0c41 \u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Passwords should be at least 6 characters long":"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c28\u0c40\u0c38\u0c02 6 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32 \u0c2a\u0c4a\u0c21\u0c35\u0c41 \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f","Don't use personal information":"\u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c15\u0c02\u0c21\u0c3f","Randomize patterns and sequences":"\u0c2a\u0c4d\u0c2f\u0c3e\u0c1f\u0c30\u0c4d\u0c28\u0c4d\u200c\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c4d\u0c30\u0c2e\u0c3e\u0c32\u0c28\u0c41 \u0c2f\u0c3e\u0c26\u0c43\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c02 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Never reuse passwords":"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c15\u0c02\u0c21\u0c3f","Prioritize password length":"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c2a\u0c4a\u0c21\u0c35\u0c41\u0c28\u0c3f \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24 \u0c07\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f","Never share your passwords":"\u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c0e\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c40 \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c15\u0c02\u0c21\u0c3f","Avoid public Wi-Fi":"\u0c2a\u0c2c\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c35\u0c48-\u0c2b\u0c48\u0c28\u0c3f \u0c28\u0c3f\u0c35\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Use a variety of numbers, letters, and characters":"\u0c28\u0c02\u0c2c\u0c30\u0c4d\u0c32\u0c41, \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c47\u0c15 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32 \u0c2e\u0c3f\u0c36\u0c4d\u0c30\u0c2e\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Download a reliable password manager":"\u0c2d\u0c30\u0c4b\u0c38\u0c3e \u0c09\u0c28\u0c4d\u0c28 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c47\u0c28\u0c47\u0c1c\u0c30\u0c4d\u200c\u0c28\u0c41 \u0c21\u0c4c\u0c28\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enable two-factor authentication":"\u0c30\u0c46\u0c02\u0c21\u0c41-\u0c2b\u0c4d\u0c2f\u0c3e\u0c15\u0c4d\u0c1f\u0c30\u0c4d \u0c38\u0c3e\u0c15\u0c4d\u0c37\u0c4d\u0c2f\u0c2a\u0c30\u0c1a\u0c21\u0c02 \u0c0e\u0c28\u0c47\u0c2c\u0c41\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Check the strength of your passwords":"\u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32 \u0c36\u0c15\u0c4d\u0c24\u0c3f\u0c28\u0c3f \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Change passwords periodically":"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c02\u0c24\u0c30\u0c02 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c02\u0c21\u0c3f","Close Tips":"\u0c38\u0c42\u0c1a\u0c28\u0c32\u0c41 \u0c2e\u0c42\u0c38\u0c3f\u0c35\u0c47\u0c2f\u0c02\u0c21\u0c3f","Periodically Change":"\u0c35\u0c3f\u0c2d\u0c3f\u0c28\u0c4d\u0c28 \u0c16\u0c3e\u0c24\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c41\u0c38\u0c4d\u0c24\u0c42 \u0c09\u0c02\u0c1f\u0c47, \u0c2e\u0c40 \u0c16\u0c3e\u0c24\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c28\u0c41 \u0c24\u0c40\u0c38\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c28\u0c3f \u0c2e\u0c40\u0c30\u0c41 \u0c39\u0c3e\u0c2e\u0c40 \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","Password Strength":"\u0c32\u0c3e\u0c38\u0c4d\u0c1f\u0c4d\u0c2a\u0c3e\u0c38\u0c4d \u0c35\u0c02\u0c1f\u0c3f \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c46\u0c02\u0c17\u0c4d\u0c24\u0c4d \u0c1a\u0c46\u0c15\u0c30\u0c4d\u200c\u0c32\u0c41, \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32\u0c41 \u0c38\u0c43\u0c37\u0c4d\u0c1f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c41 \u0c0e\u0c02\u0c24 \u0c2a\u0c4d\u0c30\u0c2d\u0c3e\u0c35\u0c35\u0c02\u0c24\u0c2e\u0c4b \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c39\u0c3e\u0c2f\u0c2a\u0c21\u0c24\u0c3e\u0c2f\u0c3f.",Reliability:"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c47\u0c28\u0c47\u0c1c\u0c30\u0c4d\u200c\u0c32\u0c41, \u0c35\u0c3e\u0c30\u0c3f \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c02\u0c32\u0c4b \u0c38\u0c2e\u0c38\u0c4d\u0c2f \u0c0e\u0c26\u0c41\u0c30\u0c4d\u0c15\u0c4a\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c35\u0c3e\u0c30\u0c3f\u0c15\u0c3f \u0c05\u0c26\u0c4d\u0c2d\u0c41\u0c24\u0c2e\u0c48\u0c28 \u0c1f\u0c42\u0c32\u0c4d.",Variety:"\u0c1c\u0c1f\u0c3f\u0c32\u0c2e\u0c48\u0c28 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c24\u0c4b, \u0c05\u0c28\u0c47\u0c15 \u0c28\u0c02\u0c2c\u0c30\u0c4d\u0c32\u0c41, \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c15\u0c32\u0c3f\u0c17\u0c3f\u0c28 \u0c16\u0c3e\u0c24\u0c3e\u0c32\u0c41 \u0c39\u0c4d\u0c2f\u0c3e\u0c15\u0c30\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c1a\u0c47\u0c30\u0c41\u0c15\u0c41\u0c28\u0c47 \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c24\u0c17\u0c4d\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c3e\u0c2f\u0c3f.","Avoid Wi-Fi":"VPN \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c2a\u0c2c\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c35\u0c48-\u0c2b\u0c48 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c39\u0c4d\u0c2f\u0c3e\u0c15\u0c30\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c2e\u0c40 \u0c06\u0c28\u0c4d\u200c\u0c32\u0c48\u0c28\u0c4d \u0c2a\u0c4d\u0c30\u0c35\u0c30\u0c4d\u0c24\u0c28\u0c28\u0c41 \u0c1f\u0c4d\u0c30\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 (\u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c46\u0c28\u0c4d\u0c37\u0c3f\u0c2f\u0c32\u0c4d\u0c38\u0c4d \u0c38\u0c39\u0c3e) \u0c09\u0c32\u0c4d\u0c32\u0c02\u0c18\u0c3f\u0c02\u0c1a\u0c47 \u0c05\u0c35\u0c15\u0c3e\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.","Never share password ":"\u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2e\u0c40 \u0c38\u0c4d\u0c28\u0c47\u0c39\u0c3f\u0c24\u0c41\u0c32\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c15\u0c41\u0c1f\u0c41\u0c02\u0c2c \u0c38\u0c2d\u0c4d\u0c2f\u0c41\u0c32\u0c24\u0c4b \u0c2a\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c21\u0c02 \u0c35\u0c32\u0c4d\u0c32 \u0c2e\u0c40 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c3f\u0c17\u0c24 \u0c16\u0c3e\u0c24\u0c3e\u0c32 \u0c38\u0c48\u0c2c\u0c30\u0c4d \u0c2d\u0c26\u0c4d\u0c30\u0c24\u0c15\u0c41 \u0c2a\u0c4d\u0c30\u0c2e\u0c3e\u0c26\u0c02 \u0c0f\u0c30\u0c4d\u0c2a\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",priority:"\u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c2a\u0c4a\u0c21\u0c35\u0c48\u0c28\u0c02\u0c24 \u0c35\u0c30\u0c15\u0c41, \u0c39\u0c4d\u0c2f\u0c3e\u0c15\u0c30\u0c4d\u200c\u0c32\u0c15\u0c41 \u0c26\u0c40\u0c28\u0c4d\u0c28\u0c3f \u0c0a\u0c39\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c15\u0c37\u0c4d\u0c1f\u0c02 \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.","Don't use personal Info":"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c4b \u0c2a\u0c47\u0c30\u0c41, \u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c3f, \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e \u0c32\u0c47\u0c26\u0c3e \u0c2b\u0c4b\u0c28\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c38\u0c48\u0c2c\u0c30\u0c4d \u0c26\u0c3e\u0c21\u0c41\u0c32\u0c2a\u0c48 \u0c2a\u0c4d\u0c30\u0c2d\u0c3e\u0c35\u0c02 \u0c1a\u0c42\u0c2a\u0c47 \u0c38\u0c3e\u0c2e\u0c30\u0c4d\u0c25\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c24\u0c17\u0c4d\u0c17\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",Randomize:"\u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32\u0c41, \u0c28\u0c02\u0c2c\u0c30\u0c4d\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c15\u0c4d\u0c37\u0c30\u0c3e\u0c32 \u0c15\u0c4d\u0c30\u0c2e\u0c3e\u0c32\u0c28\u0c41 \u0c2f\u0c3e\u0c26\u0c43\u0c1a\u0c4d\u0c1b\u0c3f\u0c15\u0c02 \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c4d\u0c2a\u0c4d\u0c30\u0c47 \u0c05\u0c1f\u0c4d\u0c32\u0c3e\u0c02\u0c1f\u0c3f \u0c26\u0c3e\u0c21\u0c41\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c30\u0c15\u0c4d\u0c37\u0c23 \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","Never reuse pass":"\u0c2a\u0c3e\u0c24 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c35\u0c32\u0c4d\u0c32 \u0c2e\u0c40 \u0c16\u0c3e\u0c24\u0c3e\u0c32\u0c41 \u0c38\u0c48\u0c2c\u0c30\u0c4d \u0c15\u0c4d\u0c30\u0c3f\u0c2e\u0c3f\u0c28\u0c32\u0c4d\u0c38\u0c4d \u0c1a\u0c47\u0c24 \u0c39\u0c4d\u0c2f\u0c3e\u0c15\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c15\u0c41 \u0c05\u0c23\u0c41\u0c35\u0c41\u0c17\u0c3e \u0c2e\u0c3e\u0c30\u0c41\u0c24\u0c3e\u0c2f\u0c3f."},"Password Security Tips":"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c38\u0c42\u0c1a\u0c28\u0c32\u0c41","Change Login Password":"\u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c02\u0c21\u0c3f","Set Transaction PIN":"\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c1c\u0c3e\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c2a\u0c3f\u0c28\u0c4d \u0c38\u0c46\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Change PIN":"\u0c2a\u0c3f\u0c28\u0c4d \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c02\u0c21\u0c3f","Current PIN":"\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24 \u0c2a\u0c3f\u0c28\u0c4d","Enter New PIN":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2a\u0c3f\u0c28\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Re-enter New PIN":"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2a\u0c3f\u0c28\u0c4d \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","PIN should be at least 6 characters long":"\u0c2a\u0c3f\u0c28\u0c4d \u0c15\u0c28\u0c40\u0c38\u0c02 6 \u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2a\u0c4a\u0c21\u0c35\u0c41 \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f","Forgot PIN ?":"\u0c2a\u0c3f\u0c28\u0c4d \u0c2e\u0c30\u0c4d\u0c1a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3e\u0c30\u0c3e ?","Forget Transaction PIN":"\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c1c\u0c3e\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c2a\u0c3f\u0c28\u0c4d \u0c2e\u0c30\u0c4d\u0c1a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3e\u0c30\u0c41",RechargePin:{"Invalid PIN":"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c28\u0c3f\u0c26\u0c3f \u0c2a\u0c3f\u0c28\u0c4d","Please enter your PIN":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c2a\u0c3f\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter PIN":"\u0c2a\u0c3f\u0c28\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Confirm PIN":"\u0c2a\u0c3f\u0c28\u0c4d \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Please enter your Confirm PIN":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c2a\u0c3f\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","PIN does not match":"\u0c2a\u0c3f\u0c28\u0c4d \u0c38\u0c30\u0c3f\u0c2a\u0c4b\u0c32\u0c32\u0c47\u0c26\u0c41","PIN updated successfully":"\u0c2a\u0c3f\u0c28\u0c4d \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Failed to update PIN":"\u0c2a\u0c3f\u0c28\u0c4d \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f",Submit:"\u0c38\u0c2c\u0c4d\u0c2e\u0c3f\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Your PIN is secure \ud83d\udd10":"\u0c2e\u0c40 \u0c2a\u0c3f\u0c28\u0c4d \u0c2d\u0c26\u0c4d\u0c30\u0c02\u0c17\u0c3e \u0c09\u0c02\u0c26\u0c3f \ud83d\udd10","Enter Transaction PIN":"\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c1c\u0c3e\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c2a\u0c3f\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f"},dlt:{"Delete Acc & Clear Data":"\u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c21\u0c47\u0c1f\u0c3e\u0c28\u0c41 \u0c15\u0c4d\u0c32\u0c3f\u0c2f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Please Read Carefully !":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c1a\u0c26\u0c35\u0c02\u0c21\u0c3f!",description:"\u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c36\u0c3e\u0c36\u0c4d\u0c35\u0c24\u0c02\u0c17\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c08 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2d\u0c35\u0c3f\u0c37\u0c4d\u0c2f\u0c24\u0c4d\u0c24\u0c41\u0c32\u0c4b \u0c08 \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c2e\u0c40\u0c30\u0c41 \uc811\uadfc\u0c02 \u0c2a\u0c4a\u0c02\u0c26\u0c32\u0c47\u0c30\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2e\u0c40\u0c30\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c38\u0c47\u0c35\u0c32 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c42\u0c21\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f, \u0c26\u0c40\u0c28\u0c3f\u0c28\u0c3f \u0c2a\u0c41\u0c28\u0c30\u0c41\u0c26\u0c4d\u0c27\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c38\u0c3e\u0c27\u0c4d\u0c2f\u0c02\u0c15\u0c3e\u0c26\u0c41. \u0c15\u0c47\u0c35\u0c32\u0c02 \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c47 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",Delete:"\u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Cancel:"\u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Press me if you agree to the deletion":"\u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c05\u0c02\u0c17\u0c40\u0c15\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c47 \u0c28\u0c28\u0c4d\u0c28\u0c41 \u0c28\u0c4a\u0c15\u0c4d\u0c15\u0c02\u0c21\u0c3f","Are you sure you want to delete your account?":"\u0c2e\u0c40\u0c30\u0c41 \u0c28\u0c3f\u0c1c\u0c02\u0c17\u0c3e \u0c2e\u0c40 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c3e?","":""},"Are You Sure ?":"\u0c2e\u0c40\u0c30\u0c41 \u0c28\u0c3f\u0c1c\u0c02\u0c17\u0c3e \u0c2e\u0c40 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c3e?","Yes, Delete Account":"\u0c05\u0c35\u0c41\u0c28\u0c41, \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Delete Your Account Successfully":"\u0c2e\u0c40 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f","Delete Account":"\u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","OTP Sumbit to Delete Acc":"\u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f OTP \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Attention Please !":"\u0c17\u0c2e\u0c28\u0c3f\u0c15!",key_dearuser_31:"\u0c2a\u0c4d\u0c30\u0c3f\u0c2f\u0c2e\u0c48\u0c28 \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41, \u0c2e\u0c40 \u0c12\u0c15\u0c38\u0c3e\u0c30\u0c3f \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d (OTP) \u0c2e\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c48\u0c28 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d ID \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c3f \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c35\u0c3f\u0c28\u0c3f\u0c2f\u0c4b\u0c17\u0c26\u0c3e\u0c30\u0c41 \u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c07\u0c30\u0c41 OTP\u0c32\u0c41 \u0c05\u0c28\u0c3f\u0c35\u0c3e\u0c30\u0c4d\u0c2f\u0c2e\u0c28\u0c3f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c41\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.",key_enterotp_33:"\u0c2e\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c48\u0c28 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d ID\u0c15\u0c41 \u0c2a\u0c02\u0c2a\u0c3f\u0c28 OTP\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",key_enterotp_34:"\u0c2e\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c48\u0c28 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d\u200c\u0c15\u0c41 \u0c2a\u0c02\u0c2a\u0c3f\u0c28 OTP\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Sumbit to Delete Account":"\u0c16\u0c3e\u0c24\u0c3e\u0c28\u0c41 \u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c2e\u0c30\u0c4d\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Prepaid Gas":"\u0c2a\u0c4d\u0c30\u0c40\u0c2a\u0c46\u0c2f\u0c3f\u0c21\u0c4d \u0c17\u0c4d\u0c2f\u0c3e\u0c38\u0c4d",key_pancards_60:"\u0c2a\u0c3e\u0c28\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f \u0c06\u0c2b\u0c4d\u200c\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c40 \u0c05\u0c21\u0c4d\u0c2e\u0c3f\u0c28\u0c4d\u200c\u0c28\u0c3f \u0c38\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",RechargeScreen:{PREPAID:"\u0c2a\u0c4d\u0c30\u0c40\u0c2a\u0c46\u0c2f\u0c3f\u0c21\u0c4d",Prepaid:"\u0c2a\u0c4d\u0c30\u0c40\u0c2a\u0c46\u0c2f\u0c3f\u0c21\u0c4d",prepaid:"\u0c2a\u0c4d\u0c30\u0c40\u0c2a\u0c46\u0c2f\u0c3f\u0c21\u0c4d",POSTPAID:"\u0c2a\u0c4b\u0c38\u0c4d\u0c1f\u0c4d\u200c\u0c2a\u0c46\u0c2f\u0c3f\u0c21\u0c4d",Plan:"\u0c2a\u0c4d\u0c32\u0c3e\u0c28\u0c4d","Select Operator & Circle":"\u0c06\u0c2a\u0c30\u0c47\u0c1f\u0c30\u0c4d & \u0c38\u0c30\u0c4d\u0c15\u0c3f\u0c32\u0c4d\u200c\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f","Plea