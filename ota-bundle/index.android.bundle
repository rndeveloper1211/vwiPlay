tner, profile change info":"\u0caa\u0ccd\u0cb0\u0cbf\u0caf \u0cb0\u0cbf\u0c9f\u0cc8\u0cb2\u0ccd \u0caa\u0cbe\u0cb2\u0cc1\u0ca6\u0cbe\u0cb0\u0cb0\u0cc7, \u0c86\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0cbf\u0cb8\u0ccd\u0c9f\u0ccd\u0cb0\u0cc7\u0c9f\u0cb0\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0c97\u0cc2 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf \u0ca8\u0c82\u0ca4\u0cb0 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2; \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd/\u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Mobile number must be exactly 10 digits.":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf 10 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1.",Edit:"\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1","select state":"\u0cb0\u0cbe\u0c9c\u0ccd\u0caf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","select District":"\u0c9c\u0cbf\u0cb2\u0ccd\u0cb2\u0cc6 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","select Agency":"\u0c8f\u0c9c\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","select City":"\u0ca8\u0c97\u0cb0 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","select State":"\u0cb0\u0cbe\u0c9c\u0ccd\u0caf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf",mis:"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c88 \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0ca8\u0cc1\u0c95\u0cc2\u0cb2\u0c95\u0ccd\u0c95\u0cc6 \u0ca4\u0c95\u0ccd\u0c95\u0c82\u0ca4\u0cc6 \u0c86\u0caa\u0ccd \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0caa\u0cb0\u0ca6\u0cc6 \u0caa\u0ccd\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8, \u0ca8\u0ccb\u0c9f\u0cbf\u0cab\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cb9\u0cbe\u0c97\u0cc2 \u0c87\u0ca4\u0cb0\u0cc6 \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",alert:"\u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6","Application {App} Language":"\u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd {App} \u0cad\u0cbe\u0cb7\u0cc6",update_description:"\u0c85\u0cb8\u0ccc\u0c95\u0cb0\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0cb5\u0cbf\u0cb7\u0cbe\u0ca6\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0cb5\u0cc6. \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cb8\u0cc1\u0ca7\u0cbe\u0cb0\u0ca3\u0cc6\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6. \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0cac\u0c9f\u0ca8\u0ccd \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0c85\u0caa\u0ccd\u0ca1\u0cc7\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0c8e\u0ca6\u0cc1\u0cb0\u0cbe\u0ca6\u0cb0\u0cc6 \u0c85\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u200c\u0c87\u0ca8\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cbe\u0cb2\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0cb0\u0cc1\u0c87\u0ca8\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cbe\u0cb2\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",update_troubleshoot:"\u0c85\u0caa\u0ccd\u0ca1\u0cc7\u0c9f\u0ccd \u0c86\u0c97\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0caa\u0ccd \u0c85\u0ca8\u0ccd\u200c\u0c87\u0ca8\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cbe\u0cb2\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0cb0\u0cc1\u0c87\u0ca8\u0ccd\u200c\u0cb8\u0ccd\u0c9f\u0cbe\u0cb2\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",personal_info:"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf",bank_info:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf",verify_info:"\u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6",username:"\u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1",mobile_number:"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",referral_code:"\u0cb0\u0cc6\u0cab\u0cb0\u0cb2\u0ccd \u0c95\u0ccb\u0ca1\u0ccd (\u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95)",verify_otp:"OTP \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",resend_otp:"OTP \u0cae\u0cb0\u0cc1\u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf",enter_password:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",confirm_password:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",re_enter_password:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0cb0\u0cc1\u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",email_id:"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c90\u0ca1\u0cbf",personal_aadhar:"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd",personal_pan:"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 PAN",dob_format:"\u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 (dd/mm/yyyy)",pin_code:"\u0caa\u0cbf\u0ca8\u0ccd \u