th:"\u091c\u0928\u094d\u092e \u0915\u0940 \u0924\u093e\u0930\u0940\u0916",date_time:"\u0924\u093e\u0930\u0940\u0916 \u0914\u0930 \u0938\u092e\u092f",delete_account:"\u0916\u093e\u0924\u093e \u0939\u091f\u093e\u090f\u0902",delivery_boy:"\u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u092c\u0949\u092f",deposit_slip_cms_desc:"\u0915\u0941\u091b \u092c\u0948\u0902\u0915\u094b\u0902 \u0915\u094b \u092a\u0948\u0938\u093e \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0905\u0932\u0917 \u091c\u092e\u093e \u092a\u0930\u094d\u091a\u0940 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0907\u0928 \u092c\u0948\u0902\u0915\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u092d\u0940 \u0938\u094d\u0932\u093f\u092a \u092f\u0939\u093e\u0901 \u0938\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a \u0909\u0928\u0915\u093e \u092a\u094d\u0930\u093f\u0902\u091f \u0906\u0909\u091f (\u092a\u094d\u0930\u093f\u0902\u091f \u0938\u094d\u0932\u093f\u092a) \u0932\u0947\u0915\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",description:"\u092a\u094d\u0930\u093f\u092f \u0930\u093f\u091f\u0947\u0932 \u092a\u093e\u0930\u094d\u091f\u0928\u0930, \u0906\u092a \u092a\u094d\u0930\u0936\u093e\u0938\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0935\u093f\u0935\u0930\u0923 \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u092c\u093e\u0926 \u0906\u092a \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u094b \u0928\u0939\u0940\u0902 \u092