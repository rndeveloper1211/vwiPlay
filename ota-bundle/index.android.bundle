tication":"\u0921\u093f\u0935\u093e\u0907\u0938 \u0932\u0949\u0915 \u090f\u0925\u0930\u093f\u0935\u0947\u0902\u091f\u0940","With this function you can choose your security lock authentication as per your choice and maintain your security with easy process.":"\u0907\u0938 \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u0915\u0947 \u091c\u093c\u0930\u093f\u090f \u0906\u092a \u0905\u092a\u0928\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u0924\u092f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u094b \u0909\u091a\u094d\u091a \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b\u0921 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u092f\u093e\u0926 \u0930\u0916\u0928\u093e \u0906\u092a\u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u0924\u094d\u092f\u0902\u0924 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964","Select Mode":"\u092e\u094b\u0921 \u091a\u0941\u0928\u0947\u0902","Selective Active Mode ":"\u0938\u0947\u0932\u0915\u094d\u091f\u093f\u0935 \u090f\u0915\u094d\u091f\u093f\u0935 \u092e\u094b\u0921","Save Change":"\u092c\u0926\u0932\u093e\u0935 \u0938\u0939\u0947\u091c\u0947\u0902",SUCCESS:"\u0938\u092b\u0932\u0924\u093e","Device Lock Setting Updated Successfully.":"\u0921\u093f\u0935\u093e\u0907\u0938 \u0932\u0949\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u092a\u0921\u0947\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964",OK:"\u0920\u0940\u0915 \u0939\u0948","Screen Lock Setting":"\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0932\u0949\u0915 \u0938\u0947\u091f\u093f\u0902\u0917",description:"\u0907\u0938 \u092b\u093c\u0902\u0915\u094d\u0936\u0928 \u0915\u0940 \u092e\u0926\u0926 \u0938\u0947 \u0906\u092a \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0932\u0949\u0915 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u091a\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u0938\u093e\u0928 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0947 \u0905\u092a\u0928\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092c\u0928\u093e\u090f \u0930\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},Search:"\u0916\u094b\u091c\u0947\u0902","Search By Consumer Number":"\u0909\u092a\u092d\u094b\u0915\u094d\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u094b\u091c\u0947\u0902","Search By Sender Acc Number":"\u092a\u094d\u0930\u0947\u0937\u0915 / \u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u094b\u091c\u0947\u0902","Search by Name /Firm name/ Mobile...":"\u0928\u093e\u092e / \u092b\u0930\u094d\u092e \u0928\u093e\u092e / \u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u0947 \u0916\u094b\u091c\u0947\u0902...","Search by Name or Account No":"\u0928\u093e\u092e \u092f\u093e \u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0916\u094b\u091c\u0947\u0902","Search by name/firm name/ mobile":"\u0928\u093e\u092e / \u092b\u0930\u094d\u092e \u0928\u093e\u092e / \u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u0947 \u0916\u094b\u091c\u0947\u0902","Search for Bus Tickets":"\u092c\u0938 \u091f\u093f\u0915\u091f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0916\u094b\u091c\u0947\u0902","Search...":"\u0916\u094b\u091c\u0947\u0902...",Search_By_Consumer_Number:"\u0915\u0902\u091c\u094d\u092f\u0942\u092e\u0930 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0916\u094b\u091c\u0947\u0902",Security:{"Set SIM":"\u090f\u0915 \u092c\u093e\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u094b \u091c\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092f\u0939 \u0924\u092d\u0940 \u0915\u093e\u092e \u0915\u0930\u0947\u0917\u093e \u091c\u092c \u0906\u092a\u0915\u093e \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0938\u093f\u092e \u0909\u0938\u0940 \u092e\u094b\u092c\u093e\u0907\u0932 \u092e\u0947\u0902 \u0939\u094b\u0917\u093e, \u091c\u093f\u0938\u0938\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0938\u0947 \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u092c\u091a\u093e \u091c\u093e \u0938\u0915\u0947\u0917\u093e\u0964 \u0906\u092a\u0915\u0940 \u0938\u0939\u092e\u0924\u093f \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u094b\u0908 \u092d\u0940 \u0932\u0949\u0917 \u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u090f\u0917\u093e\u0964","Mandatory SIM Setting":"\u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0938\u093f\u092e \u0938\u0947\u091f\u093f\u0902\u0917","Screen Lock Setting":"\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0932\u0949\u0915","Set One Time Password":"\u0938\u0947\u091f \u0935\u0928 \u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921","Screen Lock":"\u092f\u0939 \u092b\u0940\u091a\u0930 \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0932\u0949\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0932\u0949\u0915 \u0915\u094b \u092a\u093f\u0928, \u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f \u0914\u0930 \u091a\u0947\u0939\u0930\u0947 \u0938\u0947 \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","OTP setting":"\u0935\u0928 \u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 {OTP} \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u094b\u0916\u093f\u092e\u094b\u0902 \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u0930\u0924 \u0939\u0948 \u091c\u094b \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0939\u0948\u0964 \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0938 \u0915\u0941\u091b \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u0940 \u0913\u091f\u0940\u092a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092a\u0930\u0924\u0947\u0902 \u0939\u0948\u0902 \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0906\u092a \u0905\u092a\u0928\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0928\u0941\u0938\u093e\u0930 \u091a\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","Change Login Password":"\u0932\u0949\u0917\u093f\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932\u0947\u0902","Change L & P":"\u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0915\u0947 \u0906\u092a \u0905\u092a\u0928\u093e \u0932\u0949\u0917\u093f\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u093e\u0930\u0923\u094b\u0902 \u0938\u0947 \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u092c\u0926\u0932\u0928\u093e \u092c\u0939\u0941\u0924 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0964 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u092d\u0940 \u092e\u0941\u0916\u094d\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u0917\u0932\u0947 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964","Change or Forget PIN":"\u092a\u093f\u0928 \u092c\u0926\u0932\u0947\u0902 \u092f\u093e \u092d\u0942\u0932 \u091c\u093e\u090f\u0902","Forget PIN":"\u092f\u0926\u093f \u0906\u092a \u0905\u092a\u0928\u093e \u0932\u0947\u0928\u0926\u0947\u0928 \u092a\u093f\u0928 \u092d\u0942\u0932 \u0917\u090f \u0939\u0948\u0902 \u092f\u093e \u092c\u0926\u0932\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0932\u0947\u0928\u0926\u0947\u0928 \u092a\u093f\u0928 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0932\u0947\u0928\u0926\u0947\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948, \u0932\u0947\u0928\u0926\u0947\u0928 \u092a\u093f\u0928 \u0915\u0947 \u092c\u093f\u0928\u093e \u0906\u092a \u0905\u092a\u0928\u093e \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0932\u0947\u0928\u0926\u0947\u0928 \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947\u0964","Mob Registration Settings":"\u092e\u094b\u092c \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938",Registration:"\u0906\u092a \u090f\u0915 \u092f\u093e \u0905\u0927\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u094b \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u093e \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u0915\u093f\u0938\u0940 \u0905\u0928\u094d\u092f \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u0938\u0941\u0932\u092d \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964 \u0906\u092a \u0915\u0947\u0935\u0932 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u0938\u0947\u0935\u093e\u0913\u0902 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0914\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0939\u094b\u0902\u0917\u0947\u0964","Manage Login Platform":"\u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902","Manage Login":"\u0907\u0938 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a \u0926\u094b\u0928\u094b\u0902 \u092a\u094d\u0932\u0947\u091f\u092b\u093e\u0930\u094d\u092e\u094b\u0902 (\u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0914\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928) \u092a\u0930 \u0905\u092a\u0928\u0947 \u0932\u0949\u0917\u093f\u0928 \u0915\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u092f\u0926\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u094b \u0924\u094b \u0926\u094b\u0928\u094b\u0902 \u092a\u094d\u0932\u0947\u091f\u092b\u093e\u0930\u094d\u092e\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902 \u0905\u0928\u094d\u092f\u0925\u093e \u0905\u092a\u0928\u0940 \u092a\u0938\u0902\u0926 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0947\u0902\u0964 \u0907\u0938\u0947 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939\u093e\u0902 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"},"Security Cheque":"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091a\u0947\u0915","Security History":"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0907\u0924\u093f\u0939\u093e\u0938","Security updates for better protection":"\u092c\u0947\u0939\u0924\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0921\u0947\u0