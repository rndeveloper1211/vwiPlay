28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter Transaction PIN":"\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c38\u0c3e\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c2a\u0c3f\u0c28\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Please Enter Valid Aadhar Number":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Please Enter Valid Pan Card Number":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c2a\u0c3e\u0c28\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Enter Same Amount":"\u0c38\u0c2e\u0c3e\u0c28\u0c2e\u0c48\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f !!!","Please Enter Valid Amount":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f !!!",aadhaarpanrequired:"\u20b924999/- \u0c2a\u0c48\u0c17\u0c3e \u0c09\u0c28\u0c4d\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c3e\u0c28\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c05\u0c35\u0c38\u0c30\u0c02",Failed:"\u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f",Success:"\u0c35\u0c3f\u0c1c\u0c2f\u0c02",acHolder:"\u0c16\u0c3e\u0c24\u0c3e \u0c39\u0c4b\u0c32\u0c4d\u0c21\u0c30\u0c4d","Pay Again":"\u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Hi:"\u0c39\u0c3e\u0c2f\u0c4d","Monthly Limit":"\u0c2e\u0c3e\u0c38\u0c3f\u0c15 \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c3f","Remain Limit":"\u0c2e\u0c3f\u0c17\u0c3f\u0c32\u0c3f\u0c28 \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24\u0c3f","Enter Mobile No":"\u0c2e\u0c4a\u0c2c