":"\u0926\u093f\u0928 \u0932\u0947\u091c\u0930",Day_Book:"\u0921\u0947 \u092c\u0941\u0915",key_dealercap_26:"\u0921\u0940\u0932\u0930 \u0915\u0948\u092a\u093f\u0902\u0917 \u0915\u092e \u0939\u0948, \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0947 \u0932\u093f\u090f \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964","Dealer Login":"\u0921\u0940\u0932\u0930 \u0932\u0949\u0917\u093f\u0928","Dealer Name":"\u0935\u093f\u0915\u094d\u0930\u0947\u0924\u093e \u0915\u093e \u0928\u093e\u092e",key_dearbusin_27:"\u092a\u094d\u0930\u093f\u092f \u092c\u093f\u091c\u0928\u0947\u0938 \u092a\u093e\u0930\u094d\u091f\u0928\u0930, \u0906\u092a\u0915\u093e \u0906\u0927\u093e\u0930 \u0908-\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0926\u0947\u092f \u0939\u0948\u0964 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f, \u0939\u092e\u0947\u0902 \u0924\u0924\u094d\u0915\u093e\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964 \u092f\u0926\u093f \u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u0938\u093e\u0925 \u092c\u0928\u0947 \u0930\u0939\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0905\u092d\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964",key_dearcusto_28:"\u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u0906\u092a\u0915\u093e \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092a\u0942\u0930\u094d\u0923 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u093e \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902\u0964",key_dearcusto_29:"\u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u0906\u092a\u0915\u093e \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092a\u0942\u0930\u094d\u0923 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u093e \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902\u0964","Dear Retail Partner, profile change info":"\u092a\u094d\u0930\u093f\u092f \u0930\u093f\u091f\u0947\u0932\u0930 \u092a\u093e\u0930\u094d\u091f\u0928\u0930, \u0906\u092a \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0939\u0940 \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0935\u093f\u0935\u0930\u0923 \u092c\u0926\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0915\u0947 \u092c\u093e\u0926 \u0906\u092a \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0935\u093f\u0935\u0930\u0923 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932 \u0938\u0915\u0924\u0947, \u0906\u092a \u0915\u0947\u0935\u0932 \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092c\u0926\u0932/\u0905\u092a\u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",key_dearuser_30:"\u092a\u094d\u0930\u093f\u092f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e, \u0906\u092a\u0915\u093e \u092a\u0948\u0928\u0915\u093e\u0930\u094d\u0921 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u092a\u0948\u0928\u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",key_dearuser_31:"\u092a\u094d\u0930\u093f\u092f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e, \u0906\u092a\u0915\u093e \u0935\u0928-\u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 (OTP) \u0906\u092a\u0915\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940 \u0914\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0902 \u0915\u093f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0916\u093e\u0924\u093e \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0926\u094b\u0928\u094b\u0902 OTP \u092d\u0930\u0928\u093e \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0939\u0948\u0964",Debit:"\u0928\u093f\u0915\u0932\u093e \u0917\u092f\u093e","Debit Above 2000":"\u0921\u0947\u092c\u093f\u091f \u20b9 2000 \u0938\u0947 \u090a\u092a\u0930","Debit Balance":"\u0928\u093f\u0915\u0932\u0940 \u0917\u0908 \u0930\u093e\u0936\u093f","Debit Card":"2000 \u0924\u0915 \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921","Debit Card Above":"2000 \u0938\u0947 \u090a\u092a\u0930 \u0915\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921","Debit Card Above 2000":"\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u20b9 2000 \u0938\u0947 \u0905\u0927\u093f\u0915","Debit Card Up to 2000":"\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u20b9 2000 \u0924\u0915","Debit Card01":"\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921","Debit Up to 2000":"\u0921\u0947\u092c\u093f\u091f \u20b9 2000 \u0924\u0915","Debit\u20b9":"\u0921\u0947\u092c\u093f\u091f\u20b9",Deepawali:"\u0926\u0940\u092a\u093e\u0935\u0932\u0940",Delete:"\u0939\u091f\u093e\u090f\u0902","Delete Account":"\u0916\u093e\u0924\u093e \u0939\u091f\u093e\u090f\u0902","Delete Your Account Successfully":"\u0906\u092a\u0915\u093e \u0916\u093e\u0924\u093e \u0938\u09