d\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Website Login (Web)":"\u0c35\u0c46\u0c2c\u0c4d \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d","Website description":"\u0c35\u0c46\u0c2c\u0c4d \u0c2f\u0c42\u0c1c\u0c30\u0c4d \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c32\u0c48\u0c35\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c15\u0c3f\u0c02\u0c26 \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f, \u0c2e\u0c40\u0c30\u0c41 \u0c05\u0c35\u0c38\u0c30\u0c3e\u0c28\u0c41\u0c38\u0c3e\u0c30\u0c02 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c41\u0c28\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2a\u0c4d\u0c30\u0c2d\u0c3e\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.","Go to Unblock":"\u0c05\u0c28\u0c4d\u200c\u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c02\u0c21\u0c3f",ON:"\u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c41\u0c2c\u0c3e\u0c1f\u0c41",OFF:"\u0c06\u0c2b\u0c4d"},MobileDeviceReg:{MobileDeviceReg:"\u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c47\u0c37\u0c28\u0c4d",Note:"\u0c17\u0c2e\u0c28\u0c3f\u0c15:- \u0c17\u0c24 5 \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c4d\u0c32\u0c4b \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c05\u0c2f\u0c3f\u0c28 \u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d\u200c\u0c32 \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c07\u0c15\u0c4d\u0c15\u0c21 \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d \u0c2a\u0c47\u0c30\u0c41, \u0c2e\u0c4b\u0c21\u0c32\u0c4d, IP \u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d, \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d ID, \u0c32\u0c3e\u0c1f\u0c3f\u0c1f\u0c4d\u0c2f\u0c42\u0c21\u0c4d, \u0c32\u0c3e\u0c02\u0c17\u0c3f\u0c1f\u0c4d\u0c2f\u0c42\u0c21\u0c4d, \u0c1a\u0c3f\u0c35\u0c30\u0c3f \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c05\u0c21\u0c4d\u0c30\u0c38\u0c4d \u0c1a\u0c42\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c05\u0c35\u0c38\u0c30\u0c2e\u0c48\u0c28 \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c24\u0c30\u0c41\u0c35\u0c3e\u0c24, \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c30\u0c4d\u0c21\u0c4d \u0c15\u0c3e\u0c28\u0c3f \u0c07\u0c24\u0c30 \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d\u200c\u0c32 \u0c28\u0c41\u0c02\u0c21\u0c3f \u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c30\u0c41.","MobileDeviceReg description":"\u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c21\u0c3f\u0c35\u0c48\u0c38\u0c4d \u0c30\u0c3f\u0c1c\u0c3f\u0c38\u0c4d\u0c1f\u0c4d\u0c30\u0c47\u0c37\u0c28\u0c4d \u0c2f\u0c4a\u0c15\u0c4d\u0c15 \u0c32\u0c48\u0c35\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c15\u0c3f\u0c02\u0c26 \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c47 \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c2a\u0c4d\u0c30\u0c2d\u0c3e\u0c35\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c1c\u0c3e\u0c17\u0c4d\u0c30\u0c24\u0c4d\u0c24\u0c17\u0c3e \u0c05\u0c30\u0c4d\u0c25\u0c02 \u0c1a\u0c47\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f."},"Live Status is":"\u0c32\u0c48\u0c35\u0c4d \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f:","Go to Block":"\u0c2c\u0c4d\u0c32\u0c3e\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c35\u0c46\u0c33\u0c4d\u0c32\u0c02\u0c21\u0c3f","Submit OPT":"OTP \u0c38\u0c2e\u0c30\u0c4d\u0c