30 \u0935 \u092a\u093e\u0920\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u0932\u093f\u0902\u0915\u0935\u0930 \u0938\u094d\u0915\u094d\u0930\u0945\u091a \u0915\u094b\u0921 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0908\u0932. \u0926\u094b\u0928\u094d\u0939\u0940 \u092c\u093e\u091c\u0942\u0902\u0928\u0940 \u0915\u094b\u0921\u091a\u0940 \u0926\u0947\u0935\u093e\u0923\u0918\u0947\u0935\u093e\u0923 \u0915\u0930\u0942\u0928 \u0924\u094b \u092f\u094b\u0917\u094d\u092f \u0920\u093f\u0915\u093e\u0923\u0940 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e\u0935\u093e.","Action is":"\u0915\u093e\u0930\u0935\u093e\u0908 \u0906\u0939\u0947","for successful pickup":"\u092f\u0936\u0938\u094d\u0935\u0940 \u092a\u093f\u0915\u0905\u092a\u0938\u093e\u0920\u0940","TEXT SMS":"\u091f\u0947\u0915\u094d\u0938\u094d\u091f SMS",WhatsApp:"WhatsApp","E-mail ID":"\u0908-\u092e\u0947\u0932 \u0906\u092f\u0921\u0940",Cms_Note_2:"\u091f\u0940\u092a: \u0917\u0941\u092a\u094d\u0924 \u0915\u094b\u0921 \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u094d\u0932\u093e\u0907\u0921 \u092c\u091f\u0923 \u0921\u093e\u0935\u0940\u0915\u0921\u0942\u0928 \u0909\u091c\u0935\u0940\u0915\u0921\u0947 \u0938\u0930\u0915\u0935\u093e. \u0926\u094b\u0928\u094d\u0939\u0940 \u092a\u0915\u094d\u0937\u093e\u0902\u0928\u093e 7 \u0905\u0902\u0915\u0940 \u0915\u094b\u0921 \u092e\u093f\u0933\u0947\u0932, \u091c\u094b \u090f\u0915\u092e\u0947\u0915\u093e\u0902\u0936\u0940 \u0936\u0947\u0905\u0930 \u0915\u0930\u0942\u0928 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.","Generate Code":"\u0915\u094b\u0921 \u0924\u092f\u093e\u0930 \u0915\u0930\u093e",Cms_Success_Msg:"\u0905\u092d\u093f\u0928\u0902\u0926\u0928, \u0917\u0941\u092a\u094d\u0924 \u0915\u094b\u0921 \u0906\u092a\u0932\u094d\u092f\u093e \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u094d\u092f\u093e \u092e\u094b\u0921\u0926\u094d\u0935\u093e\u0930\u0947 \u0936\u0947\u0905\u0930 \u0915\u0947\u0932\u093e \u0917\u0947\u0932\u093e. \u091c\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u091d\u093e\u0932\u093e \u0928\u0938\u0947\u0932 \u0924\u0930","click upon Resend Button":"\"\u092a\u0941\u0928\u094d\u0939\u093e \u092a\u093e\u0920\u0935\u093e \u092c\u091f\u0923\" \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e","Resend Code":"\u0915\u094b\u0921 \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u093e\u0920\u0935\u093e","Your scratch code is below":"\u0906\u092a\u0932\u093e \u0938\u094d\u0915\u094d\u0930\u0945\u091a \u0915\u094b\u0921 \u0916\u093e\u0932\u0940 \u0926\u093f\u0932\u093e \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0925\u092e \u0938\u094d\u0915\u094d\u0930\u0945\u091a \u0915\u0930\u093e \u0906\u0923\u093f \u0917\u094d\u0930\u093e\u0939\u0915 \u092a\u0949\u0907\u0902\u091f\u0938\u094b\u092c\u0924 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e.","Ask the Customer Contact Person":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0915\u0921\u0942\u0928 6 \u0905\u0915\u094d\u0937\u0930\u0940 \u0938\u094d\u0915\u094d\u0930\u0945\u091a \u0915\u094b\u0921 \u092e\u093e\u0917\u093e \u0906\u0923\u093f \u0924\u094b \u092f\u0947\u0925\u0947 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e","Enter customer code":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e","scratch Code Copied":"\u0938\u094d\u0915\u094d\u0930\u0945\u091a \u0915\u094b\u0921 \u0915\u0949\u092a\u0940 \u0915\u0947\u0932\u093e","Scratch Code is required":"\u0938\u094d\u0915\u094d\u0930\u0945\u091a \u0915\u094b\u0921 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947","Scratch Code":"\u0938\u094d\u0915\u094d\u0930\u0945\u091a \u0915\u094b\u0921","Please confirm details":"\u0915\u0943\u092a\u092f\u093e \u092c\u0949\u0915\u094d\u0938 \u0928\u093f\u0935\u0921\u0942\u0928 \u0924\u092a\u0936\u0940\u0932 \u092f\u094b\u0917\u094d\u092f \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e.","Enter Mobile and TransID":"\u0915\u0943\u092a\u092f\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0923\u093f \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0906\u092f\u0921\u0940 \u0926\u094b\u0928\u094d\u0939\u0940 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e.","OTP Sent":"\ud83d\udce9 OTP \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u092a\u093e\u0920\u0935\u0932\u093e","Failed to send OTP":"\u26a0 OTP \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940. \u0938\u094d\u0925\u093f\u0924\u0940:","Error sending OTP":"\u274c OTP \u092a\u093e\u0920\u0935\u0924\u093e\u0928\u093e \u0924\u094d\u0930\u0941\u091f\u0940.","Enter 6-digit OTP":"\u0915\u0943\u092a\u092f\u093e 6 \u0905\u0902\u0915\u0940 OTP \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e","OTP Verified":"\u2705 OTP \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u091d\u093e\u0932\u093e.","OTP verification failed":"\u26a0 OTP \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0905\u092f\u0936\u0938\u094d\u0935\u0940. \u0938\u094d\u0925\u093f\u0924\u0940:","Error verifying OTP":"\u274c OTP \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u093e\u0928\u093e \u0924\u094d\u0930\u0941\u091f\u0940.","Exit Confirmation":"\u0906\u092a\u0923 \u0916\u0930\u094b\u0916\u0930 \u092c\u093e\u0939\u0947\u0930 \u092a\u0921\u0942 \u0907\u091a\u094d\u091b\u093f\u0924\u093e? \u0906\u092a\u0923 \u0905\u0926\u094d\u092f\u093e\u092a \u0938\u0930\u094d\u0935 \u0906\u0935\u0936\u094d\u092f\u0915 \u092a\u093e\u092f\u0931\u094d\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0928\u093e\u0939\u0940\u0924, \u0906\u0923\u093f \u0906\u0924\u093e \u092c\u093e\u0939\u0947\u0930 \u092a\u0921\u0932\u094d\u092f\u093e\u0938 \u0906\u092a\u0932\u0940 \u092a\u094d\u0930\u0917\u0924\u0940 \u0917\u092e\u093e\u0935\u0932\u0940 \u091c\u093e\u0908\u0932.","Go To Home":"\u0939\u094b\u092e\u0935\u0930 \u091c\u093e",Denom:"\u092e\u0942\u0932\u094d\u092f\u0935\u0930\u094d\u0917","No. of Notes":"\u0928\u094b\u091f\u093e\u0902\u091a\u0940 \u0938\u0902\u0916\u094d\u092f\u093e",Receipt:"\u092a\u093e\u0935\u0924\u0940","RCMS CUSTOMER INFO":"RCMS \u0917\u094d\u0930\u093e\u0939\u0915 \u092e\u093e\u0939\u093f\u0924\u0940","Verification Required":"\u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0906\u0935\u0936\u094d\u092f\u0915","Please match the number of":"\u0915\u0943\u092a\u092f\u093e \u091c\u0941\u0933\u0935\u093e",Notes:"\u0928\u094b\u091f\u093e","total amount":"\u090f\u0915\u0942\u0923 \u0930\u0915\u094d\u0915\u092e","Complete transaction msg":"\u0938\u0930\u094d\u0935 \u0915\u093e\u0939\u0940 \u092f\u094b\u0917\u094d\u092f \u0905\u0938\u0932\u094d\u092f\u093e\u0938, OTP \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0942\u0928 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u093e.","OTP sent msg":"OTP \u0938\u094d\u091f\u094b\u0905\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0915\u0921\u0947 \u092a\u093e\u0920\u0935\u0932\u093e \u0906\u0939\u0947","with details msg":"\u090f\u0915\u0942\u0923 \u0930\u0915\u092e\u0947\u091a\u094d\u092f\u093e \u0924\u092a\u0936\u0940\u0932\u093e\u0902\u0938\u0939.","ReQ No.":"\u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915","Pickup Time":"\u092a\u093f\u0915\u0905\u092a \u0935\u0947\u0933",Cms_Check_Msg:"\u0939\u094b\u092f, \u092e\u0940 \u0938\u0930\u094d\u0935 \u0924\u092a\u0936\u0940\u0932 \u0924\u092a\u093e\u0938\u0932\u0947 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0938\u094d\u091f\u094b\u0905\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0915\u0921\u0942\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947. \u0906\u0924\u093e \u092e\u0940 \u092a\u0941\u0922\u0940\u0932 \u0915\u093e\u0930\u0935\u093e\u0908 \u0915\u0930\u0947\u0928.","Verify & Fill Next Data":"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u0941\u0922\u0940\u0932 \u092e\u093e\u0939\u093f\u0924\u0940 \u092d\u0930\u093e","Send OTP to Customer Point":"\u0917\u094d\u0930\u093e\u0939\u0915 \u092a\u0949\u0907\u0902\u091f\u0935\u0930 OTP \u092a\u093e\u0920\u0935\u093e","If OTP is not received":"\u091c\u0930 OTP \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u091d\u093e\u0932\u093e \u0928\u0938\u0947\u0932,","Verify & Next":"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u0941\u0922\u0947 \u091c\u093e","Please enter a valid pin code":"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u092a\u093f\u0928 \u0915\u094b\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e","Failed to add pin code":"\u092a\u093f\u0928 \u0915\u094b\u0921 \u091c\u094b\u0921\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940","No pinType selected":"\u274c \u0939\u091f\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092a\u093f\u0928 \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u093e \u0928\u093e\u0939\u0940.","Work In Other Code Area":"\u0907\u0924\u0930 \u0915\u094b\u0921 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924 \u0915\u093e\u092e \u0915\u0930\u093e","My Own Pin Code":"\u092e\u093e\u091d\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u093e \u092a\u093f\u0928 \u0915\u094b\u0921","Your own Pin Code msg":"\u0906\u092a\u0932\u094d\u092f\u093e \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0906\u092a\u0932\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u093e \u092a\u093f\u0928 \u0915\u094b\u0921 \u0935\u0930 \u0926\u093f\u0932\u093e \u0906\u0939\u0947.",Cms_Add_Pin_Msg:"\u091c\u0930 \u0906\u092a\u0923 \u0907\u0924\u0930 \u092a\u093f\u0928 \u0915\u094b\u0921 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924\u0939\u0940 \u0915\u093e\u092e \u0915\u0930\u0942 \u0936\u0915\u0924 \u0905\u0938\u093e\u0932, \u0924\u0930 \u0915\u0943\u092a\u092f\u093e \"\u0928\u0935\u0940\u0928 \u091c\u094b\u0921\u093e\" \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942\u0928 \u091c\u093e\u0938\u094d\u0924\u0940\u0924 \u091c\u093e\u0938\u094d\u0924 4 \u092a\u093f\u0928 \u0915\u094b\u0921 \u091c\u094b\u0921\u093e.","Add New":"\u0928\u0935\u0940\u0928 \u091c\u094b\u0921\u093e","Additional Pin Code":"\u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u092a\u093f\u0928 \u0915\u094b\u0921","Add New My Own Pin Code":"\u092e\u093e\u091d\u093e \u0928\u0935\u0940\u0928 \u0938\u094d\u0935\u0924\u0903\u091a\u093e \u092a\u093f\u0928 \u0915\u094b\u0921 \u091c\u094b\u0921\u093e","Add New Pin Code":"\u0928\u0935\u0940\u0928 \u092a\u093f\u0928 \u0915\u094b\u0921 \u091c\u094b\u0921\u093e",personal_information:"\u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940",key_forcomple_42:"\u0906\u092a\u0932\u0947 \u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e 'OK' \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0915\u094d\u0932\u093f\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0906\u092a\u0932\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\