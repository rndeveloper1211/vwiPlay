\u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0cb0\u0ccd \u0cae\u0cc7\u0cb2\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0cc6\u0cb0\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0cb0\u0cbf\u0cb8\u0cbf.","Comm \u20b9":"\u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd \u20b9","Connect your Biometric Device via OTG.":"OTG \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0caf\u0ccb\u0cae\u0cc6\u0c9f\u0ccd\u0cb0\u0cbf\u0c95\u0ccd \u0cb8\u0cbe\u0ca7\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.","Consumer Aadhaar":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd","Contact No.:":"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Contact information is updated till":"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c88 \u0cb8\u0cae\u0caf\u0ca6\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","DR \u20b9":"\u0c96\u0cb0\u0ccd\u0c9a\u0cc1 (DR) \u20b9","Date & Time:":"\u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0caf:","Date:":"\u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95:","Designation:":"\u0cb9\u0cc1\u0ca6\u0ccd\u0ca6\u0cc6:","Device ID:":"\u0cb8\u0cbe\u0ca7\u0ca8\u0ca6 \u0c90\u0ca1\u0cbf (Device ID):","Distributor Id:":"\u0cb5\u0cbf\u0ca4\u0cb0\u0c95\u0cb0 \u0c90\u0ca1\u0cbf (Distributor Id):","Downloading... %":"\u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6... %","Due Date:":"\u0ca8\u0cbf\u0c97\u0ca6\u0cbf\u0ca4 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95:","Email ID:":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0c90\u0ca1\u0cbf:","Enter 6-digit OTP sent to your registered mobile":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0cac\u0c82\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5 6-\u0c85\u0c82\u0c95\u0cbf\u0caf \u0c92\u0c9f\u0cbf\u0caa\u0cbf (OTP) \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",Face:"\u0cae\u0cc1\u0c96 (Face)","Follow these steps:":"\u0c88 \u0cb9\u0c82\u0ca4\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cbf:","From Date:":"\u0c88 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0ca6\u0cbf\u0c82\u0ca6:","Go To Purchase":"\u0c96\u0cb0\u0cc0\u0ca6\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb9\u0ccb\u0c97\u0cbf","Hi, Please Complete Your Video KYC Now!":"\u0ca8\u0cae\u0cb8\u0ccd\u0c95\u0cbe\u0cb0, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88\u0c97\u0cb2\u0cc7 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cc0\u0ca1\u0cbf\u0caf\u0cca \u0c95\u0cc6\u0cb5\u0cc8\u0cb8\u0cbf (Video KYC) \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf!","IFSC Code:":"IFSC \u0c95\u0ccb\u0ca1\u0ccd:","Latitude:":"\u0c85\u0c95\u0ccd\u0cb7\u0cbe\u0c82\u0cb6 (Latitude):","Longitude:":"\u0cb0\u0cc7\u0c96\u0cbe\u0c82\u0cb6 (Longitude):","Message :":"\u0cb8\u0c82\u0ca6\u0cc7\u0cb6 :","Mobile Number:":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Monthly Payout Summary":"\u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0caa\u0cc7-\u0c94\u0c9f\u0ccd \u0cb8\u0cbe\u0cb0\u0cbe\u0c82\u0cb6","My Own Pin Code -":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd -","Name:":"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1:","No banks found":"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","No transactions found":"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","Note:":"\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6:","Operator:":"\u0c86\u0caa\u0cb0\u0cc7\u0c9f\u0cb0\u0ccd:","PAY NOW \u20b9":"\u0c88\u0c97\u0cb2\u0cc7 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cbf \u20b9",PROCEED:"\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf","PROTECTED BY SECURITY SYSTEM":"\u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0cb8\u0cb2\u0ccd\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6","Payee:":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1:",Paying:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6","Please complete your verification to enable all AEPS features.":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe AEPS \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 (Verification) \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf.","Please match the number of Notes":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0ccb\u0c9f\u0cc1\u0c97\u0cb3 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cbe\u0cb3\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf","Please wait...":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c95\u0cbe\u0caf\u0cbf\u0cb0\u0cbf...","Post Balance: \u20b9":"\u0ca8\u0c82\u0ca4\u0cb0\u0ca6 \u0cac\u0cbe\u0c95\u0cbf: \u20b9","Pre Balance: \u20b9":"\u0cae\u0cca\u0ca6\u0cb2\u0cbf\u0ca8 \u0cac\u0cbe\u0c95\u0cbf: \u20b9","Profile Picture Not Found - click for upload new":"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 - \u0cb9\u0cca\u0cb8\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0caa\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Receipt of":"\u0cb0\u0cb6\u0cc0\u0ca6\u0cbf","Recharge Amount:":"\u0cb0\u0cbf\u0c9a\u0cbe\u0cb0\u0ccd\u0c9c\u0ccd \u0cae\u0cca\u0ca4\u0ccd\u0ca4:","Ref No:":"\u0c89\u0cb2\u0ccd\u0cb2\u0cc7\u0c96 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 (Ref No):","Remain Amount: \u20b9":"\u0c89\u0cb3\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4: \u20b9","Remaining Receipts:":"\u0c89\u0cb3\u0cbf\u0ca6 \u0cb0\u0cb6\u0cc0\u0ca6\u0cbf\u0c97\u0cb3\u0cc1:","Remaining: \u20b9":"\u0c89\u0cb3\u0cbf\u0ca6\u0cbf\u0cb0\u0cc1\u0cb5\u0cbf\u0c95\u0cc6: \u20b9","Retailer Info:":"\u0c9a\u0cbf\u0cb2\u0ccd\u0cb2\u0cb0\u0cc6 \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0cbe\u0cb0\u0cbf\u0caf (Retailer) \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf:","SECURITY ALERT":"\u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6","Select your device model from the dropdown below.":"\u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0ca1\u0ccd\u0cb0\u0cbe\u0caa\u0ccd\u200c\u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0ca8\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0cbe\u0ca7\u0ca8\u0ca6 \u0cae\u0cbe\u0ca6\u0cb0\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf.",Sender:"\u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0\u0cc1","Sender Name:":"\u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1:","Spent: \u20b9":"\u0c96\u0cb0\u0ccd\u0c9a\u0cc1 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4: \u20b9","State Bank Of India":"\u0cb8\u0ccd\u0c9f\u0cc7\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c86\u0cab\u0ccd \u0c87\u0c82\u0ca1\u0cbf\u0caf\u0cbe","Status:":"\u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf (Status):","To Date:":"\u0c88 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0ca6\u0cb5\u0cb0\u0cc6\u0c97\u0cc6:","Tokens No:":"\u0c9f\u0ccb\u0c95\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","Total Receipt":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb0\u0cb6\u0cc0\u0ca6\u0cbf","Transaction Date:":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cbf\u0ca8 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95:","Transaction Status:":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cbf\u0ca8 \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf:","Try a different search term":"\u0cac\u0cc7\u0cb0\u0cc6 \u0caa\u0ca6\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf","Try adjusting the date range or filters.":"\u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 \u0c85\u0ca5\u0cb5\u0cbe \u0cab\u0cbf\u0cb2\u0ccd\u0c9f\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","UTR No:":"UTR \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6:","VPA:":"VPA:","Your Version: V":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4\u0cbf: V","Your wallet balance is short by \u20b9":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0cb2\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u20b9 \u0c95\u0cca\u0cb0\u0ca4\u0cc6\u0caf\u0cbf\u0ca6\u0cc6"}},1082,[]);
__d(function(e,a,t,o,i,n,r){i.exports={SP1:"\u0938\u0947\u0932\u094d\u092b \u092a\u0947\u0906\u0909\u091f\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0948\u0938\u0947 IMPS (\u0924\u0924\u094d\u0915\u093e\u0933 \u092a\u0947\u092e\u0947\u0902\u091f \u0938\u0947\u0935\u093e) \u0906\u0923\u093f NEFT (\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0928\u093f\u0927\u0940 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923) \u092e\u093e\u0930\u094d\u092b\u0924 \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u093e\u0920\u0935\u0924\u093e \u092f\u0947\u0924\u093e\u0924.",SP2:"\u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0928\u094b\u0902\u0926\u0923\u0940\u0938\u093e\u0920\u0940 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0915\u0921\u0942\u0928 \u20b910.00 \u0936\u0941\u0932\u094d\u0915 \u0906\u0915\u093e\u0930\u0932\u0947 \u091c\u093e\u0908\u0932.",SP3:"\u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0915\u093e\u0930\u0923\u093e\u0938\u094d\u0924\u0935 \u091a\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091d\u093e\u0932\u0947\u0932\u093e \u092e\u0928\u0940 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u092a\u0930\u0924 \u0915\u0947\u0932\u093e \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u0938\u0931\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u0935\u0930\u094d\u0917 \u0915\u0947\u0932\u093e \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0916\u093e\u0924\u0947 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0924\u092a\u093e\u0938\u093e.",SP4:"\u0938\u0947\u0932\u094d\u092b-\u092a\u0947 \u0938\u0947\u0935\u093e \u092b\u0915\u094d\u0924 \u0915\u093f\u0930\u0915\u094b\u0933 \u0935\u093f\u0915\u094d\u0930\u0947\u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0902\u0938\u093e\u0920\u0940 \u0906\u0939\u0947. \u092f\u093e\u091a\u093e \u0935\u093e\u092a\u0930 DMT \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0902\u0938\u093e\u0920\u0940 \u0915\u0930\u0924\u093e \u092f\u0947\u0923\u093e\u0930 \u0928\u093e\u0939\u0940. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u094b\u0923\u093e\u0932\u093e\u0939\u0940 \u0930\u0915\u094d\u0915\u092e \u092a\u093e\u0920\u0935\u0932\u094d\u092f\u093e\u0938 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u093e\u0930\u0923\u093e\u0938\u094d\u0924\u0935 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u091a\u093e \u092f\u094b\u0917\u094d\u092f \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0930\u093e\u0939\u0940\u0932.",SP5:"\u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0924\u094b \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u094d\u092f\u093e \u0924\u093e\u0930\u0916\u0947\u092a\u093e\u0938\u0942\u0928 \u0926\u094b\u0928 \u092c\u0901\u0915\u093f\u0902\u0917 \u0926\u093f\u0935\u0938\u093e\u0902\u0924 \u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u093e \u091c\u093e\u0908\u0932.",SP6:"\u0939\u0940 \u0938\u0947\u0935\u093e \u092e\u0945\u0928\u094d\u092f\u0941\u0905\u0932 \u092a\u094d\u0930\u0923\u093e\u0932\u0940\u0926\u094d\u0935\u093e\u0930\u0947 \u0926\u093f\u0932\u0940 \u091c\u093e\u0924\u0947 \u0906\u0923\u093f \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092f\u0936\u0938\u094d\u0935\u0940 \u0939\u094b\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 30 \u092e\u093f\u0928\u093f\u091f\u093e\u0902\u092a\u0930\u094d\u092f\u0902\u0924 \u0935\u0947\u0933 \u0932\u093e\u0917\u0942 \u0936\u0915\u0924\u094b.",D1:"IMPS (\u0924\u0924\u094d\u0915\u093e\u0933 \u092a\u0947\u092e\u0947\u0902\u091f \u0938\u0947\u0935\u093e) \u0906\u0923\u093f NEFT (\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0928\u093f\u0927\u0940 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923) \u092e\u093e\u0930\u094d\u092b\u0924 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0924\u093e \u092f\u0947\u0924\u093e\u0924.",D2:"\u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0928\u094b\u0902\u0926\u0923\u0940\u0938\u093e\u0920\u0940 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u0915\u0921\u0942\u0928 \u20b910.00 \u0936\u0941\u0932\u094d\u0915 \u0906\u0915\u093e\u0930\u0932\u0947 \u091c\u093e\u0908\u0932.",D3:"\u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0915\u093e\u0930\u0923\u093e\u0938\u094d\u0924\u0935 \u091a\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091d\u093e\u0932\u0947\u0932\u093e Domestic Money Transfer (DMT) \u092a\u0930\u0924 \u0915\u0947\u0932\u093e \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u0938\u0931\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u0935\u0930\u094d\u0917 \u0915\u0947\u0932\u093e \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940. \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0916\u093e\u0924\u0947 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0924\u092a\u093e\u0938\u093e.",D4:"Domestic Money Transfer (DMT) \u0926\u094d\u0935\u093e\u0930\u0947 \u0917\u094d\u0930\u093e\u0939\u0915 \u090f\u0915\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0924 \u091c\u093e\u0938\u094d\u0924\u0940\u0924 \u091c\u093e\u0938\u094d\u0924 \u20b95000 \u0906\u0923\u093f \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0935\u0930\u0942\u0928 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0932\u093e \u0915\u092e\u093e\u0932 \u20b925000 \u092a\u093e\u0920\u0935\u0942 \u0936\u0915\u0924\u093e\u0924.",D5:"\u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0924\u094b \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u094d\u092f\u093e \u0924\u093e\u0930\u0916\u0947\u092a\u093e\u0938\u0942\u0928 \u0926\u094b\u0928 \u092c\u0901\u0915\u093f\u0902\u0917 \u0926\u093f\u0935\u0938\u093e\u0902\u0924 \u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u093e \u091c\u093e\u0908\u0932.",D6:"\u0928\u0935\u0940\u0928 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915 \u0924\u0924\u094d\u0924\u094d\u0935\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u0940 \u0928\u094b\u0902\u0926\u0923\u0940\u0938\u093e\u0920\u0940 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0906\u0939\u0947. \u092a\u093e\u092f\u0931\u094d\u092f\u093e: \u092a\u094d\u0930\u0925\u092e 10 \u0905\u0902\u0915\u0940 \u092a\u094d\u0930\u0947\u0937\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u091f\u093e\u0915\u093e \u2192 OTP \u091f\u093e\u0915\u093e \u2192 \u0906\u0927\u093e\u0930 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u091f\u093e\u0915\u093e \u2192 \u092c\u094b\u091f\u093e\u091a\u093e \u0920\u0938\u093e \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e.",D7:"\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u091d\u093e\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 OTP \u0936\u093f\u0935\u093e\u092f \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0938\u093e\u0926\u0930 \u0915\u0930\u0924\u093e \u092f\u0947\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.",PPI1:"IMPS, NEFT \u0906\u0923\u093f UPI \u092e\u093e\u0930\u094d\u092b\u0924 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0924\u093e \u092f\u0947\u0924\u093e\u0924.",PPI2:"\u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0915\u093e\u0930\u0923\u093e\u0938\u094d\u0924\u0935 \u091a\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091c\u092e\u093e \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u0948\u0938\u0947 \u092a\u0930\u0924 \u0915\u093f\u0902\u0935\u093e \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0947\u0932\u0947 \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924.",PPI3:"\u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0926\u094b\u0928 \u092c\u0901\u0915\u093f\u0902\u0917 \u0926\u093f\u0935\u0938\u093e\u0902\u0924 \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0908\u0932.",PPI4:"\u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u0947\u0937\u0915\u093e\u091a\u093e \u0906\u0927\u093e\u0930 \u0915\u093f\u0902\u0935\u093e \u092a\u0945\u0928 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.",login:"\u0932\u0949\u0917\u093f\u0928",signUp:"\u0938\u093e\u0907\u0928 \u0905\u092a",forgotPassword:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0935\u093f\u0938\u0930\u0932\u093e\u0924?",loginInfo:"\u0932\u0949\u0917\u093f\u0928 \u092e\u093e\u0939\u093f\u0924\u0940",update_available:"\u0905\u092a\u0921\u0947\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947",update_description:"\u0905\u0938\u0941\u0935\u093f\u0927\u0947\u092c\u0926\u094d\u0926\u0932 \u0926\u093f\u0932\u0917\u0940\u0930 \u0906\u0939\u094b\u0924. \u0938\u0941\u0927\u093e\u0930\u0923\u093e \u0905\u0938\u0932\u0947\u0932\u0940 \u0905\u092a\u0921\u0947\u091f\u0947\u0921 \u0906\u0935\u0943\u0924\u094d\u0924\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947. \u0916\u093e\u0932\u0940\u0932 \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942\u0928 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e. \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0932\u094d\u092f\u093e\u0938 \u0905\u200d\u0945\u092a \u0905\u0928\u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0942\u0928 \u092a\u0941\u0928\u094d\u0939\u093e \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u093e.",update_now:"\u0906\u0924\u094d\u0924\u093e\u091a \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e",update_troubleshoot:"\u0905\u200d\u0945\u092a \u0905\u092a\u0921\u0947\u091f \u0928 \u091d\u093e\u0932\u094d\u092f\u093e\u0938 \u0915\u0943\u092a\u092f\u093e \u0905\u0928\u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0942\u0928 \u092a\u0941\u0928\u094d\u0939\u093e \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u093e.",login_credentials_blank:"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u093e \u0906\u092f\u0921\u0940 \u0906\u0923\u093f \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u091f\u093e\u0915\u093e. \u0939\u0947 \u0930\u093f\u0915\u094d\u0924 \u0920\u0947\u0935\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940.",notification_permission_granted:"\u0938\u0942\u091a\u0928\u093e \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u093f\u0932\u0940",notification_permission_not_granted:"\u0938\u0942\u091a\u0928\u093e \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u093f\u0932\u0940 \u0928\u093e\u0939\u0940",video_kyc_pending:"\u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915