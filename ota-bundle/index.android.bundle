\u0ccd\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Upload failed":"\u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Selfie with Store":"\u0cb8\u0ccd\u0c9f\u0ccb\u0cb0\u0ccd \u0c9c\u0cca\u0ca4\u0cc6\u0c97\u0cc6 \u0cb8\u0cc6\u0cb2\u0ccd\u0cab\u0cbf",key_pleaseupl_62:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc6\u0cb2\u0ccd\u0cab\u0cbf \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Location unavailable":"\u0cb8\u0ccd\u0ca5\u0cb3 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2","Address not available, showing GPS only":"\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2, \u0c95\u0cc7\u0cb5\u0cb2 GPS \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6",Retake:"\u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf","Scratch Code Verification":"\u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6",Name_Address_Location:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 / \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 / \u0cb8\u0ccd\u0ca5\u0cb3","Point Code_Shop Id":"\u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd \u0c95\u0ccb\u0ca1\u0ccd / \u0cb6\u0cbe\u0caa\u0ccd ID","Contact Person Name":"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0caf \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Very Important Note":"\u0cae\u0cc1\u0c96\u0ccd\u0caf \u0c97\u0cae\u0ca8\u0cbe\u0cb0\u0ccd\u0cb9 \u0c9f\u0cbf\u0caa\u0ccd\u0caa\u0ca3\u0cbf",Cms_Note_1:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf: \u0c95\u0cc6\u0cb3\u0c97\u0cbf\u0ca8 \u0cac\u0c9f\u0ca8\u0ccd \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 (\u0cb9\u0ccc\u0ca6\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0caf\u0cbf\u0cb0\u0cbf) \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0c85\u0ca8\u0cc1\u0cb8\u0cbe\u0cb0\u0cb5\u0cbe\u0c97\u0cbf \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0ca1\u0cc0\u0cab\u0cbe\u0cb2\u0ccd\u0c9f\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0cb8\u0c82\u0ca6\u0cc7\u0cb6 \u0cae\u0cbe\u0cb0\u0ccd\u0c97 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf. \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0ca6\u0cbe\u0c97, \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0cb0\u0ca6\u0cc6 \u0cae\u0cc7\u0cb2\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cb2\u0cbf\u0c82\u0c95\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c8e\u0cb0\u0ca1\u0cc2 \u0caa\u0c95\u0ccd\u0cb7\u0c97\u0cb3\u0cc1 \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0ca8\u0cbf\u0cae\u0caf \u0cae\u0cbe\u0ca1\u0cbf \u0c85\u0cb5\u0cb6\u0ccd\u0caf\u0c95 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6.","Action is":"\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","for successful pickup":"\u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf \u0caa\u0cbf\u0c95\u0caa\u0ccd\u200c\u0c97\u0cbe\u0c97\u0cbf","TEXT SMS":"\u0caa\u0ca0\u0ccd\u0caf SMS",WhatsApp:"WhatsApp","E-mail ID":"\u0c87\u0cae\u0cc7\u0cb2\u0ccd ID",Cms_Note_2:"\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6: \u0c97\u0cc1\u0caa\u0ccd\u0ca4 \u0c95\u0ccb\u0ca1\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cc1 \u0c8e\u0ca1\u0ca6\u0cbf\u0c82\u0ca6 \u0cac\u0cb2\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0ccd\u0cb2\u0cc8\u0ca1\u0ccd \u0cac\u0c9f\u0ca8\u0ccd \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0c8e\u0cb0\u0ca1\u0cc2 \u0caa\u0c95\u0ccd\u0cb7\u0c97\u0cb3\u0cc1 7 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0ca1\u0cc6\u0caf\u0cc1\u0ca4\u0ccd\u0ca4\u0cbe\u0cb0\u0cc6, \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cb8\u0ccd\u0caa\u0cb0 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.","Generate Code":"\u0c95\u0ccb\u0ca1\u0ccd \u0cb0\u0c9a\u0cbf\u0cb8\u0cbf",Cms_Success_Msg:"\u0c85\u0cad\u0cbf\u0ca8\u0c82\u0ca6\u0ca8\u0cc6\u0c97\u0cb3\u0cc1, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0cae\u0cbe\u0ca6\u0cb0\u0cbf\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0c97\u0cc1\u0caa\u0ccd\u0ca4 \u0c95\u0ccb\u0ca1\u0ccd \u0cb9\u0c82\u0c9a\u0cb2\u0ccd\u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6\u0cc6. \u0caa\u0ca1\u0cc6\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6","click upon Resend Button":"\"Resend Button\" \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Resend Code":"\u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0cc1\u0ca8\u0c83 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf","Your scratch code is below":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0c87\u0ca6\u0cc6, \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf","Ask the Customer Contact Person":"6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0 \u0cb8\u0ccd\u0c95\u0cc6\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c95\u0cc7\u0cb3\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter customer code":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","scratch Code Copied":"\u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0c95\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Scratch Code is required":"\u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6","Scratch Code":"\u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd","Please confirm details":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0cb5\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0cac\u0cbe\u0c95\u0ccd\u0cb8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf","Enter Mobile and TransID":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 ID \u0c8e\u0cb0\u0ca1\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","OTP Sent":"\ud83d\udce9 OTP \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Failed to send OTP":"\u26a0 OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf:","Error sending OTP":"\u274c OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0ccb\u0cb7\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Enter 6-digit OTP":"6 \u0c85\u0c82\u0c95\u0cbf\u0c97\u0cb3 OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","OTP Verified":"\u2705 OTP \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","OTP verification failed":"\u26a0 OTP \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf:","Error verifying OTP":"\u274c OTP \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cb2\u0ccd\u0cb2\u0cbf \u0ca6\u0ccb\u0cb7\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Exit Confirmation":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0c97\u0cae\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc6? \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2, \u0c87\u0ca6\u0cc0\u0c97 \u0ca8\u0cbf\u0cb0\u0ccd\u0c97\u0cae\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6 \u0caa\u0ccd\u0cb0\u0c97\u0ca4\u0cbf \u0c95\u0cb3\u0cc6\u0ca6\u0cc1\u0cb9\u0ccb\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6","Go To Home":"\u0cae\u0ca8\u0cc6\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf",Denom:"\u0c98\u0c9f\u0c95","No. of Notes":"\u0ca8\u0ccb\u0c9f\u0ccd\u200c\u0c97\u0cb3 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",Receipt:"\u0cb0\u0cb8\u0cc0\u0ca6\u0cbf","RCMS CUSTOMER INFO":"RCMS \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf","Verification Required":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6","Please match the number of":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf",Notes:"\u0ca8\u0ccb\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1","total amount":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0ca4\u0ccd\u0ca4","Complete transaction msg":"\u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb8\u0cb0\u0cbf\u0caf\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf","OTP sent msg":"OTP \u0cb8\u0ccd\u0c9f\u0ccb\u0cb0\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","with details msg":"\u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6","ReQ No.":"\u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Pickup Time":"\u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb8\u0cae\u0caf",Cms_Check_Msg:"\u0cb9\u0ccc\u0ca6\u0cc1, \u0ca8\u0cbe\u0ca8\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0ccd\u0c9f\u0ccb\u0cb0\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0ca8\u0cc6. \u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0c95\u0ccd\u0cb0\u0cae\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cc7\u0ca8\u0cc6","Verify & Fill Next Data":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf & \u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0cad\u0cb0\u0ccd\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cbf","Send OTP to Customer Point":"OTP \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf","If OTP is not received":"OTP \u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6,","Verify & Next":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf & \u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8","Please enter a valid pin code":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Failed to add pin code":"\u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","No pinType selected":"\u274c \u0c85\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 pinType \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2","Work In Other Code Area":"\u0c87\u0ca4\u0cb0 \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cbf","My Own Pin Code":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd","Your own Pin Code msg":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0cae\u0cc7\u0cb2\u0cbf\u0ca8\u0c82\u0ca4\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",Cms_Add_Pin_Msg:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c87\u0ca4\u0cb0 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf\u0caf\u0cc2 \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6\u0cb0\u0cc6, \"ADD New\" \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf 4 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cb5\u0cb0\u0cc6\u0c97\u0cc2 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1","Add New":"\u0cb9\u0cca\u0cb8 \u0cb8\u0cc7\u0cb0\u0ccd\u0caa\u0ca1\u0cc6","Additional Pin Code":"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd","Add New My Own Pin Code":"\u0ca8\u0ca8\u0ccd\u0ca8 \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0cb9\u0cca\u0cb8 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add New Pin Code":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf",verification_details:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",bank_reference_no:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb0\u0cc6\u0cab\u0cb0\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",account_mismatch:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0cb2\u0ccd\u0cb2",try_after_sometime:"\u0cb8\u0c82\u0cb8\u0ca4\u0ccd\u0ca4 \u0ca8\u0c82\u0ca4\u0cb0 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf !!!",consume_limit:"\u0c96\u0cb0\u0ccd\u0c9a\u0cc1 \u0cae\u0cbf\u0ca4\u0cbf",remain_limit:"\u0cac\u0cbe\u0c95\u0cbf \u0cae\u0cbf\u0ca4\u0cbf",per_txn_limit:"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cae\u0cbf\u0ca4\u0cbf",search_name_acc_no:"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf",bank_down_note:"\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6: \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cb2\u0cbe\u0cad\u0c97\u0cbe\u0cb0 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb8\u0cb0\u0ccd\u0cb5\u0cb0\u0ccd \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0ccd\u0caf\u0cc1\u0cb8\u0cbf \u0c87\u0ca6\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf",add_acc:"\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf",delete_account:"\u0c96\u0cbe\u0ca4\u0cc6 \u0c85\u0cb3\u0cbf\u0cb8\u0cbf",confirm:"\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",message:"\u0cb8\u0c82\u0ca6\u0cc7\u0cb6","- Emergency Leave":"- \u0ca4\u0cc1\u0cb0\u0ccd\u0ca4\u0cc1 \u0cb0\u0c9c\u0cbe","- Penalty**":"- \u0ca6\u0c82\u0ca1**","ABOUT THE COMPANY":"\u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf \u0cac\u0c97\u0ccd\u0c97\u0cc6","Aadhaar card (Mandatory)":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd (\u0c85\u0ca8\u0cbf\u0cb5\u0cbe\u0cb0\u0ccd\u0caf)","Active USB Connection Detected":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf USB \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0ca6\u0cc6","Add New Pickup Request":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb5\u0cbf\u0ca8\u0c82\u0ca4\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf","Add Other Qualification":"\u0c87\u0ca4\u0cb0\u0cc6 \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf",key_asproofo_17:"\u0cb8\u0cb0\u0ca8\u0cbe\u0cae\u0cc6 \u092a\u094d\u0930\u092e\u093e\u0923\u0cb5\u0cbe\u0c97\u0cbf, \u0c85\u0cb5\u0cb0\u0cc1 \u0cb6\u0cbe\u0cb6\u0ccd\u0cb5\u0ca4 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0cac\u0cc7\u0cb0\u0cc6 \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6","Back Image":"\u0cb9\u0cbf\u0ca8\u0ccd\u0ca8\u0cc6\u0cb2\u0cc6 \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0","Background Verification Form":"\u0cb9\u0cbf\u0ca8\u0ccd\u0ca8\u0cb2\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd","Bank Charges":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb6\u0cc1\u0cb2\u0ccd\u0c95\u0c97\u0cb3\u0cc1","Board/University*":"\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd/\u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cbe\u0cb2\u0caf*","CIBIL/CREDIT SCORE":"CIBI