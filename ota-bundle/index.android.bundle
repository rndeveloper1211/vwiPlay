e:":"\u0938\u0902\u0926\u0947\u0936:",key_errorwhil_37:"\u092b\u093f\u0902\u0917\u0930 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0924\u093e\u0928\u093e \u0924\u094d\u0930\u0941\u091f\u0940 \u0906\u0932\u0940. \u0915\u0943\u092a\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u092f\u094b\u0917\u094d\u092f\u0930\u0940\u0924\u094d\u092f\u093e \u0915\u0928\u0947\u0915\u094d\u091f \u0906\u0939\u0947 \u0915\u093e \u0924\u0947 \u0924\u092a\u093e\u0938\u093e.",key_errorcou_39:"\u0924\u094d\u0930\u0941\u091f\u0940: \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u093e \u0921\u094d\u0930\u093e\u092f\u0935\u094d\u0939\u0930 \u0938\u093e\u092a\u0921\u0932\u093e \u0928\u093e\u0939\u0940.","Your E-KYC is Not Completed":"\u0906\u092a\u0932\u0947 \u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u0947\u0932\u0947 \u0928\u093e\u0939\u0940",key_dearcus_146:"1. \u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u0906\u092a\u0932\u0947 \u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u0947\u0932\u0947 \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0925\u092e \u0906\u092a\u0932\u0947 \u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u093e.",key_forcom_4:"2. \u0908-\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e 'Ok' \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0915\u094d\u0932\u093f\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0906\u092a\u0932\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0908\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0935\u0930 OTP \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0908\u0932.",key_pleasef_144:"3. \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0925\u092e \u0906\u092a\u0932\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f \u0938\u094d\u0915\u0945\u0928\u0930 \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0936\u0940 (Morpho, Mantra, Startek) \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u093e.",key_errorwhil_38:"\u092b\u093f\u0902\u0917\u0930 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0924\u093e\u0928\u093e \u0924\u094d\u0930\u0941\u091f\u0940 \u0906\u0932\u0940. \u0915\u0943\u092a\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0915\u0928\u0947\u0915\u094d\u091f \u0906\u0939\u0947 \u0915\u093e \u0924\u0947 \u0924\u092a\u093e\u0938\u093e.",key_anerroro_9:"\u0906\u092a\u0932\u093e \u0935\u093f\u0928\u0902\u0924\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0924\u093e\u0928\u093e \u0924\u094d\u0930\u0941\u091f\u0940 \u0906\u0932\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.","Transaction Failed ":"\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0905\u092f\u0936\u0938\u094d\u0935\u0940",green:"\u0939\u093f\u0930\u0935\u093e",yellow:"\u092a\u093f\u0935\u0933\u093e",greenLineClosed:"\u0939\u093f\u0930\u0935\u0940 \u0932\u093e\u0908\u0928 \u092c\u0902\u0926 \u0906\u0939\u0947",yellowLineClosed:"\u092a\u093f\u0935\u0933\u0940 \u0932\u093e\u0908\u0928 \u092c\u0902\u0926 \u0906\u0939\u0947","AEPS / AADHAAR PAY":"AEPS / \u0906\u0927\u093e\u0930 \u092a\u0947",green_line_aeps:"\u0939\u093f\u0930\u0935\u0940 \u0932\u093e\u0908\u0928 AEPS",yellow_line_aeps:"\u092a\u093f\u0935\u0933\u0940 \u0932\u093e\u0908\u0928 AEPS",key_hiiams_48:"\u0928\u092e\u0938\u094d\u0915\u093e\u0930, \u092e\u0940 ${APP_URLS.AppName} \u0905\u0945\u092a\u0926\u094d\u0935\u093e\u0930\u0947 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u0947 \u0924\u092a\u0936\u0940\u0932 \u0936\u0947\u09