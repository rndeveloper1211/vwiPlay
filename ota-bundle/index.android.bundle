__d(function(e,a,t,o,i,n,r){i.exports={SP1:"\u0ab8\u0ac7\u0ab2\u0acd\u0aab \u0aaa\u0ac7\u0a86\u0a89\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0ac8\u0ab8\u0abe IMPS (\u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe) \u0a85\u0aa8\u0ac7 NEFT (\u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aaf \u0a87\u0ab2\u0ac7\u0a95\u0acd\u0a9f\u0acd\u0ab0\u0acb\u0aa8\u0abf\u0a95 \u0aab\u0a82\u0aa1 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0) \u0aae\u0abe\u0ab0\u0aab\u0aa4\u0ac7 \u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",SP2:"\u0a87-\u0a95\u0ac7\u0ab5\u0abe\u0aaf\u0ab8\u0ac0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u20b910.00 \u0ab6\u0ac1\u0ab2\u0acd\u0a95 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",SP3:"\u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a95\u0abe\u0ab0\u0aa3\u0ab8\u0ab0 \u0a96\u0acb\u0a9f\u0abe \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0aa5\u0aaf\u0ac7\u0ab2 \u0aae\u0aa8\u0ac0 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0aa8 \u0aa4\u0acb \u0aaa\u0ab0\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa8 \u0aa4\u0acb \u0a85\u0aa8\u0acd\u0aaf \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abe\u0a82\u0aa4\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0aaa\u0ac8\u0ab8\u0abe \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0aa4\u0abe \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a96\u0abe\u0aa4\u0abe \u0aa8\u0a82\u0aac\u0ab0 \u0aa4\u0aaa\u0abe\u0ab8\u0acb.",SP4:"\u0ab8\u0ac7\u0ab2\u0acd\u0aab-\u0aaa\u0ac7 \u0ab8\u0ac7\u0ab5\u0abe \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0ab0\u0abf\u0a9f\u0ac7\u0ab2\u0ab0\u0acb\u0aa8\u0abe \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0abe \u0ab5\u0acd\u0aaf\u0abe\u0ab5\u0ab8\u0abe\u0aaf\u0abf\u0a95 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0a9b\u0ac7. \u0aa8\u0acb\u0a82\u0aa7 \u0ab2\u0acb \u0a95\u0ac7 \u0aa4\u0ac7\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 DMT \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0aa8\u0ab9\u0ac0\u0a82. \u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0aaa\u0a95\u0acd\u0ab7\u0aa8\u0ac7 \u0ab0\u0a95\u0aae \u0aae\u0acb\u0a95\u0ab2\u0acb \u0a9b\u0acb, \u0aa4\u0acb \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0abe\u0ab0\u0aa3\u0acb\u0ab8\u0ab0 \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0aa8\u0ac1\u0a82 \u0aaf\u0acb\u0a97\u0acd\u0aaf KYC \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0aab\u0ab0\u0a9c\u0abf\u0aaf\u0abe\u0aa4 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7.",SP5:"\u0a9c\u0acb \u0a95\u0acb\u0a88 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0aaa\u0ac7\u0aa8\u0acd\u0aa1\u0abf\u0a82\u0a97 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa4\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96 + \u0aac\u0ac7 \u0aac\u0ac7\u0a82\u0a95\u0abf\u0a82\u0a97 \u0aa6\u0abf\u0ab5\u0ab8\u0aae\u0abe\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0aaf\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",SP6:"\u0a86 \u0ab8\u0ac7\u0ab5\u0abe \u0aae\u0ac7\u0aa8\u0acd\u0aaf\u0ac1\u0a85\u0ab2 \u0ab8\u0abf\u0ab8\u0acd\u0a9f\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0ab8\u0aab\u0ab3 \u0aa5\u0ab5\u0abe\u0aae\u0abe\u0a82 30 \u0aae\u0abf\u0aa8\u0abf\u0a9f \u0ab8\u0ac1\u0aa7\u0ac0\u0aa8\u0acb \u0ab8\u0aae\u0aaf \u0ab2\u0abe\u0a97\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.",D1:"IMPS (\u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe) \u0a85\u0aa8\u0ac7 NEFT (\u0ab0\u0abe\u0ab7\u0acd\u0a9f\u0acd\u0ab0\u0ac0\u0aaf \u0a87\u0ab2\u0ac7\u0a95\u0acd\u0a9f\u0acd\u0ab0\u0acb\u0aa8\u0abf\u0a95 \u0aab\u0a82\u0aa1 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0) \u0aae\u0abe\u0ab0\u0aab\u0aa4\u0ac7 \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95\u0aa8\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0aaa\u0ac8\u0ab8\u0abe \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",D2:"\u0a87-\u0a95\u0ac7\u0ab5\u0abe\u0aaf\u0ab8\u0ac0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u20b910.00 \u0ab6\u0ac1\u0ab2\u0acd\u0a95 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",D3:"\u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a95\u0abe\u0ab0\u0aa3\u0ab8\u0ab0 \u0a96\u0acb\u0a9f\u0abe \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0aa5\u0aaf\u0ac7\u0ab2 \u0aa1\u0acb\u0aae\u0ac7\u0ab8\u0acd\u0a9f\u0abf\u0a95 \u0aae\u0aa8\u0ac0 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 (DMT) \u0aa8 \u0aa4\u0acb \u0aaa\u0ab0\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa8 \u0aa4\u0acb \u0a85\u0aa8\u0acd\u0aaf \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abe\u0a82\u0aa4\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0aaa\u0ac8\u0ab8\u0abe \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0aa4\u0abe \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a96\u0abe\u0aa4\u0abe \u0aa8\u0a82\u0aac\u0ab0 \u0aa4\u0aaa\u0abe\u0ab8\u0acb.",D4:"\u0aa1\u0acb\u0aae\u0ac7\u0ab8\u0acd\u0a9f\u0abf\u0a95 \u0aae\u0aa8\u0ac0 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 (DMT) \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0a8f\u0a95 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aae\u0abe\u0a82 \u20b95000 \u0ab8\u0ac1\u0aa7\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0aa8\u0abe \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aae\u0ab9\u0aa4\u0acd\u0aa4\u0aae \u20b925000 \u0aaa\u0acd\u0ab0\u0aa4\u0abf \u0aae\u0ab9\u0abf\u0aa8\u0abe \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.",D5:"\u0a9c\u0acb \u0a95\u0acb\u0a88 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0aaa\u0ac7\u0aa8\u0acd\u0aa1\u0abf\u0a82\u0a97 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa4\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96 + \u0aac\u0ac7 \u0aac\u0ac7\u0a82\u0a95\u0abf\u0a82\u0a97 \u0aa6\u0abf\u0ab5\u0ab8\u0aae\u0abe\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0aaf\u0ab0 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7.",D6:"\u0aa8\u0ab5\u0abe \u0aae\u0abe\u0ab0\u0acd\u0a97\u0aa6\u0ab0\u0acd\u0ab6\u0abf\u0a95\u0abe \u0a85\u0aa8\u0ac1\u0ab8\u0abe\u0ab0 \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0 \u0aa8\u0acb\u0a82\u0aa7\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0aab\u0ab0\u0a9c\u0abf\u0aaf\u0abe\u0aa4 \u0a9b\u0ac7. \u0ab2\u0abe\u0aad\u0abe\u0ab0\u0acd\u0aa5\u0ac0\u0a8f \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0aaa\u0a97\u0ab2\u0abe\u0a82 \u0a85\u0aa8\u0ac1\u0ab8\u0ab0\u0ab5\u0abe: \u0aaa\u0ab9\u0ac7\u0ab2\u0abe 10 \u0a85\u0a82\u0a95\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0ac7\u0ab7\u0a95 \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb > OTP \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb (\u0ab8\u0ac7\u0ab5\u0abe \u0aaa\u0acd\u0ab0\u0aa6\u0abe\u0aa4\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aae\u0acb\u0a95\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7) > \u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb > \u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95 \u0aab\u0abf\u0a82\u0a97\u0ab0 \u0ab8\u0acd\u0a95\u0ac7\u0aa8 \u0a95\u0ab0\u0acb.",D7:"\u0a8f\u0a95\u0ab5\u0abe\u0ab0 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0aaa\u0ac7\u0aa8\u0acd\u0aa1\u0abf\u0a82\u0a97 \u0aa5\u0a88 \u0a9c\u0abe\u0aaf \u0aaa\u0a9b\u0ac0 OTP \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0ab5\u0abf\u0aa8\u0abe \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0aa8\u0ab9\u0ac0\u0a82 (OTP \u0aaa\u0acd\u0ab0\u0ac7\u0ab7\u0a95\u0aa8\u0abe \u0aae\u0acb\u0aac\u0abe\u0a87\u0ab2 \u0aa8\u0a82\u0aac\u0ab0 \u0aaa\u0ab0 \u0aae\u0acb\u0a95\u0ab2\u0abe\u0ab6\u0ac7).",PPI1:"IMPS, NEFT \u0a85\u0aa8\u0ac7 UPI \u0aae\u0abe\u0ab0\u0aab\u0aa4\u0ac7 \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95\u0aa8\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0aaa\u0ac8\u0ab8\u0abe \u0aae\u0acb\u0a95\u0ab2\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",PPI2:"\u0a95\u0acb\u0a88\u0aaa\u0aa3 \u0a95\u0abe\u0ab0\u0aa3\u0ab8\u0ab0 \u0a96\u0acb\u0a9f\u0abe \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2 \u0aaa\u0ac8\u0ab8\u0abe \u0aa8 \u0aa4\u0acb \u0aaa\u0ab0\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7 \u0a85\u0aa8\u0ac7 \u0aa8 \u0aa4\u0acb \u0a85\u0aa8\u0acd\u0aaf \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0abe\u0a82\u0aa4\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ab6\u0ac7. \u0aaa\u0ac8\u0ab8\u0abe \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0aa4\u0abe \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a96\u0abe\u0aa4\u0abe \u0aa8\u0a82\u0aac\u0ab0 \u0aa4\u0aaa\u0abe\u0ab8\u0acb.",PPI3:"\u0a9c\u0acb \u0a95\u0acb\u0a88 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0aaa\u0ac7\u0aa8\u0acd\u0aa1\u0abf\u0a82\u0a97 \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0aa4\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96 + \u0aac\u0ac7 \u0aac\u0ac7\u0a82\u0a95\u0abf\u0a82\u0a97 \u0aa6\u0abf\u0ab5\u0ab8\u0aae\u0abe\u0a82 \u0a95\u0acd\u0ab2\u0abf\u0aaf\u0ab0 \u0aa5\u0a88 \u0a9c\u0ab6\u0ac7.",PPI4:"\u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0aa8\u0ac7 \u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0aaa\u0acd\u0ab0\u0ac7\u0ab7\u0a95\u0aa8\u0acb \u0a86\u0aa7\u0abe\u0ab0 \u0a85\u0aa5\u0ab5\u0abe PAN \u0a95\u0abe\u0ab0\u0acd\u0aa1 \u0aa8\u0a82\u0aac\u0ab0 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0acb \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7. \u0aa8\u0ab9\u0abf\u0aa4\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0aa8\u0a82\u0aac\u0ab0 \u0a86\u0aaa\u0aae\u0ac7\u0ab3\u0ac7 \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0 \u0ab8\u0abe\u0aa5\u0ac7 \u0a9c\u0acb\u0aa1\u0abe\u0a88 \u0a9c\u0ab6\u0ac7.",login:"\u0ab2\u0ac9\u0a97\u0abf\u0aa8",signUp:"\u0ab8\u0abe\u0a87\u0aa8 \u0a85\u0aaa",forgotPassword:"\u0aaa\u0abe\u0ab8\u0ab5\u0ab0\u0acd\u0aa1 \u0aad\u0ac2\u0ab2\u0ac0 \u0a97\u0aaf\u0abe?",loginInfo:"\u0ab2\u0ac9\u0a97\u0abf\u0aa8 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0",update_available:"\u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7",update_description:"\u0a85\u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0aac\u0aa6\u0ab2 \u0a95\u0acd\u0ab7\u0aae\u0abe \u0a95\u0ab0\u0ab6\u0acb, \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0abe\u0a93 \u0ab8\u0abe\u0aa5\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f\u0ac7\u0aa1 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7. \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0aac\u0a9f\u0aa8 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0aae\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0a95\u0acb\u0a88 \u0a