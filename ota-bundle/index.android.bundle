0\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6 \u0c95\u0cb0\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca8\u0ccb\u0c9f\u0ccd\u0cb8\u0ccd\u200c\u0c97\u0cb3 \u0c97\u0ca3\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1, \u0c87\u0ca6\u0cc1 \u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cb0\u0cbf\u0cb9\u0cca\u0c82\u0ca6\u0cac\u0cc7\u0c95\u0cc1.",key_throughth_105:"\u0c88 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0cbe\u0c9a\u0cb0\u0ca3\u0cc6\u0caf\u0cbf\u0c82\u0ca6, \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0ca6 \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0c95\u0cbe\u0ca3\u0cc1\u0ca4\u0ccd\u0ca4\u0cc0\u0cb0\u0cbf. \u0c88 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc7\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c92\u0c9f\u0ccd\u0c9f\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","To Date*":"\u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95\u0ca6\u0cb5\u0cb0\u0cc6\u0c97\u0cc6*","Transfer Report by Wallet":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0cb5\u0ca3\u0cc6 \u0cb5\u0cb0\u0ca6\u0cbf","Upload Document":"\u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Verification Fees":"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95","View Back Aadhar Image":"\u0cb9\u0cbf\u0ca8\u0ccd\u0ca8\u0cc6\u0cb2\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0 \u0ca8\u0ccb\u0ca1\u0cbf","View Front Aadhar Image":"\u0cae\u0cc1\u0c82\u0cad\u0cbe\u0c97 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0 \u0ca8\u0ccb\u0ca1\u0cbf",key_voterside_109:"\u0cae\u0ca4\u0ca6\u0cbe\u0cb0\u0cb0 \u0c90\u0ca1\u0cbf / \u0caa\u0cbe\u0cb8\u0ccd\u0caa\u0ccb\u0cb0\u0ccd\u0c9f\u0ccd / \u0cb0\u0cc7\u0cb6\u0ca8\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd / \u0ca1\u0ccd\u0cb0\u0cc8\u0cb5\u0cbf\u0c82\u0c97\u0ccd \u0cb2\u0cc8\u0cb8\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd / \u0cb5\u0cbf\u0ca6\u0ccd\u0caf\u0cc1\u0ca4\u0ccd \u0cac\u0cbf\u0cb2\u0ccd / \u0c85\u0ca8\u0cbf\u0cb2 \u0cac\u0cbf\u0cb2\u0ccd (\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c92\u0cac\u0ccd\u0cac)","Wallet Mode":"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cae\u0ccb\u0ca1\u0ccd","Yes, how can i work?":"\u0cb9\u0ccc\u0ca6\u0cc1, \u0ca8\u0cbe\u0ca8\u0cc1 \u0cb9\u0cc7\u0c97\u0cc6 \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?","Your Image":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0",key_yourscrat_118:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0c87\u0ca6\u0cc6, \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cbe\u0c9a\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cac\u0cbf\u0c82\u0ca6\u0cc1\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf","Yourself, bank security cheque":"\u0ca8\u0cc0\u0cb5\u0cc1, \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cbe \u0c9a\u0cc6\u0c95\u0ccd","Aadhaar Images":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0c97\u0cb3\u0cc1","Cash Management Services":"\u0ca8\u0c97\u0ca6\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cbe \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cc1","Cash Pickup":"\u0ca8\u0c97\u0ca6\u0cc1 \u0caa\u0cbf\u0c95\u0caa\u0ccd","From Date*":"\u0ca4\u0cbe\u0cb0\u0cc0\u0c96\u0cbf\u0ca8\u0cbf\u0c82\u0ca6*","Other Qualification details":"\u0c87\u0ca4\u0cb0\u0cc6 \u0c85\u0cb0\u0ccd\u0cb9\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1",about_company_text_1:"\u0cb0\u0cc7\u0ca1\u0cbf\u0caf\u0c82\u0c9f\u0ccd \u0c95\u0ccd\u0caf\u0cbe\u0cb6\u0ccd \u0cae\u0ccd\u0caf\u0cbe\u0ca8\u0cc7\u0c9c\u0ccd\u200c\u0cae\u0cc6\u0c82\u0c9f\u0ccd \u0cb8\u0cb0\u0ccd\u0cb5\u0cbf\u0cb8\u0cb8\u0ccd \u0cb2\u0cbf\u0cae\u0cbf\u0c9f\u0cc6\u0ca1\u0ccd \u0cad\u0cbe\u0cb0\u0ca4\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cc1\u0c97\u0cb3\u0cc1, \u0cb9\u0ca3\u0c95\u0cbe\u0cb8\u0cc1 \u0cb8\u0c82\u0cb8\u0ccd\u0ca5\u0cc6\u0c97\u0cb3\u0cc1, \u0cb8\u0c82\u0c98\u0c9f\u0cbf\u0ca4 \u0c9a\u0cbf\u0cb2\u0ccd\u0cb2\u0cb0\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c87-\u0c95\u0cbe\u0cae\u0cb0\u0ccd\u0cb8\u0ccd \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0c97\u0cb3 \u0ca8\u0c97\u0ca6\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cbe \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0c95 \u0c94\u0c9f\u0ccd\u200c\u0cb8\u0ccb\u0cb0\u0ccd\u0cb8\u0cbf\u0c82\u0c97\u0ccd \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cc2\u0cb0\u0cc8\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf\u0cc1 \u0ca8\u0cae\u0ccd\u0cae \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c90\u0ca6\u0cc1 \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ca1\u0cc6\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",about_company_text_2:"\u0caa\u0ccd\u0cb0\u0cae\u0cbe\u0ca3\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6, \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf\u0cc1 \u0ca8\u0c97\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c85\u0cae\u0cc2\u0cb2\u0ccd\u0caf \u0cb5\u0cb8\u0ccd\u0ca4\u0cc1\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cbe\u0c97\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb9\u0cb2\u0cb5\u0cc1 \u0cb8\u0cbe\u0cb0\u0cbf\u0c97\u0cc6 \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0c89\u0ca6\u0cbe: \u0c8e\u0cb0\u0ca1\u0cc1 \u0c9a\u0c95\u0ccd\u0cb0 \u0cb5\u0cbe\u0cb9\u0ca8\u0c97\u0cb3\u0cc1, \u0cac\u0cbe\u0ca1\u0cbf\u0c97\u0cc6 \u0cb5\u0cbe\u0cb9\u0ca8\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cb0\u0ccd\u0cae\u0cbf\u0ca4 \u0c86\u0cb0\u0ccd\u0cae\u0cb0\u0ccd \u0cb5\u0ccd\u0caf\u0cbe\u0ca8\u0ccd\u200c\u0c97\u0cb3\u0cc1. \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0ca6\u0cbf\u0ca8 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0\u0cbf\u0c82\u0ca6 \u0cb8\u0cc1\u0cae\u0cbe\u0cb0\u0cc1 \u20b95000 - 6000 \u0cae\u0cbf\u0cb2\u0cbf\u0caf\u0ca8\u0ccd \u0ca8\u0c97\u0ca6\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",about_company_text_3:"\u0c88 \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0ca6 \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0c82\u0ca4\u0cbf\u0cae \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0c97\u0ca6\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0ca3\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1, \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf \u0c9a\u0cbe\u0cb2\u0ca8\u0cc6 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0ca6\u0cc7 \u0ca6\u0cbf\u0ca8 \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0c95\u0cc6\u0cb2\u0cb8\u0ca6 \u0ca6\u0cbf\u0ca8\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0cb5\u0ca3\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cb8\u0cc7\u0cb0\u0cbf\u0ca6\u0cc6. \u0c95\u0c82\u0caa\u0ca8\u0cbf \u0ca6\u0cc7\u0cb6\u0ca6\u0cbe\u0ca6\u0ccd\u0caf\u0c82\u0ca4 60,000\u0c95\u0ccd\u0c95\u0cc2 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0c9f\u0c9a\u0ccd \u0caa\u0cbe\u0caf\u0cbf\u0c82\u0c9f\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cb3 \u0cb5\u0cbf\u0cb6\u0cbe\u0cb2 \u0ca8\u0cc6\u0c9f\u0ccd\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0c87\u0ca6\u0ccd\u0ca6\u0cc1, \u0cb5\u0cbf\u0cb6\u0cc7\u0cb7\u0cb5\u0cbe\u0c97\u0cbf \u0c96\u0cbe\u0cb8\u0c97\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbf\u0ca6\u0cc7\u0cb6\u0cbf \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6, \u0cb8\u0cc0\u0cae\u0cbf\u0ca4 \u0cb6\u0cbe\u0c96\u0cbe \u0ca8\u0cc6\u0c9f\u0ccd\u0cb5\u0cb0\u0ccd\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb5\u0cbf\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f \u0cae\u0ccc\u0cb2\u0ccd\u0caf \u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cbe\u0cb5\u0ca8\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf\u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c8e\u0c82\u0ca6\u0cc1 \u0ca8\u0c82\u0cac\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",add_new_pickup_desc:"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cac\u0cbf\u0c82\u0ca6\u0cc1\u0cb5\u0cbf\u0ca8\u0cbf\u0c82\u0ca6 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0c82\u0ca1 \u0ca8\u0c97\u0ca6\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3 \u0caa\u0cc2\u0cb0\u0ccd\u0ca4\u0cbf\u0caf\u0cbe\u0c97\u0cbf, \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb8\u0cae\u0caf, \u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0cad\u0ccc\u0ca4\u0cbf\u0c95 \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf. \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0ca8\u0ccb\u0c9f\u0ccd\u0cb8\u0ccd\u200c\u0c97\u0cb3 \u0c8e\u0ca3\u0cbf\u0c95\u0cc6 \u0c92\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1.",cash_deposit_ac_list_desc:"\u0c88 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0cbe\u0c9a\u0cb0\u0ca3\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cbe\u0cb5\u0cc1 Radiant Cash Management Services Limited \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 QR \u0c95\u0ccb\u0ca1\u0ccd\u200c\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0cb5\u0cc6, \u0c85\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0c97\u0ca6\u0cc1 \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf, \u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0cb5\u0ca3\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 QR \u0c95\u0ccb\u0ca1\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",cash_online_deposit_desc:"\u0c88 \u0cb5\u0cb0\u0ca6\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf, RCE \u0cae\u0cc2\u0cb2\u0c95 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0ca8\u0c97\u0ca6\u0cc1 \u0c95\u0ccc\u0c82\u0c9f\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0ca6 \u0cb9\u0ca3, Cash Deposit Machine (CDM) \u0c97\u0cc6 \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0ca6 \u0cb9\u0ca3 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c87\u0ca4\u0cb0 \u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0ca6\u0cbf\u0c82\u0ca6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",cash_pickup_prepay_desc:"\u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 RCE \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cac\u0cbf\u0c82\u0ca6\u0cc1\u0cb5\u0cbf\u0ca8\u0cbf\u0c82\u0ca6 \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0ca8\u0cc0\u0ca1\u0cbf\u0ca6 \u0cae\u0cbe\u0ca7\u0ccd\u0caf\u0cae\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd-\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0cb5\u0cb0\u0ca6\u0cbf \u0c88 \u0cb2\u0cc6\u0ca1\u0ccd\u0c9c\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",cash_pickup_report_desc:"\u0c88 \u0cb5\u0cb0\u0ca6\u0cbf \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6\u0cbf\u0c82\u0ca6 RC \u0cae\u0cc2\u0cb2\u0c95 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0ca4 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3 \u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, RCE \u0ca1\u0cbf\u0c9c\u0cbf\u0c9f\u0cb2\u0ccd \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0ca8\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0cad\u0ccc\u0ca4\u0cbf\u0c95 \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0c8e\u0c82\u0cac\u0cc1\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","click on \"Resend Button\"":"\"Resend Button\" \u0cae\u0cc7\u0cb2\u0cc6 \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf",company_docs_deposit_desc:"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0c97\u0ca6\u0cc1 \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1, \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1, \u0c89\u0ca6\u0cbe: PAN \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd, \u0c87\u0ca6\u0cc1 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0c97\u0ca4\u0ccd\u0caf. \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc7\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cc1, \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",deposit_slip_cms_desc:"\u0cb9\u0ca3 \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0c95\u0cc6\u0cb2\u0cb5\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb5\u0cbf\u0cad\u0cbf\u0ca8\u0ccd\u0ca8 \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0cb0\u0cc1\u0cb5 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0cbf\u0c82\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",error_occurred_try_later:"\u0ca6\u0ccb\u0cb7 \u0cb8\u0c82\u0cad\u0cb5\u0cbf\u0cb8\u0cbf\u0ca6\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf",failed_title:"\u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",pay_picked_dues_desc:"\u0c88 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0cbe\u0c9a\u0cb0\u0ca3\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95, \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cb8\u0ccd\u0cb2\u0cbf\u0caa\u0ccd \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cbe\u0ca6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0ccb\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c88 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0ccd\u0caf\u0cc7\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c92\u0c9f\u0ccd\u0c9f\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",payout_note:"\u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0c97\u0ccd\u0caf\u0cbe\u0cb0\u0c82\u0c9f\u0cbf \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0c86\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cbe\u0c97 \u0c87\u0ca6\u0cc1 \u0c85\u0ca8\u0ccd\u0cb5\u0caf\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u2014 \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 \u0c97\u0ccd\u0caf\u0cbe\u0cb0\u0c82\u0c9f\u0cbf \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0cae\u0cbf\u0cb7\u0ca8\u0ccd.",pickup_deposit_ledger_desc:"\u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 RCE \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cac\u0cbf\u0c82\u0ca6\u0cc1\u0cb5\u0cbf\u0ca8\u0cbf\u0c82\u0ca6 \u0caa\u0cbf\u0c95\u0caa\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0ca8\u0cc0\u0ca1\u0cbf\u0ca6 \u0cae\u0cbe\u0ca7\u0ccd\u0caf\u0cae\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6, \u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd-\u0ca1\u0cc6\u0cac\u0cbf\u0c9f\u0ccd \u0cb5\u0cb0\u0ca6\u0cbf \u0c88 \u0cb2\u0cc6\u0ca1\u0ccd\u0c9c\u0cb0\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",req_civil:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb9\u0ca3\u0c95\u0cbe\u0cb8\u0cc1 \u0c95\u0ccd\u0cb0\u0cc6\u0ca1\u0cbf\u0c9f\u0ccd \u0c85\u0c82\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 (\u0cb8\u0cbf\u0cb5\u0cbf\u0cb2\u0ccd \u0c85\u0c82\u0c95\u0cc6) \u0cb8\u0cc1\u0cae\u0cbe\u0cb0\u0cc1 670 \u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cae\u0cc7\u0cb2\u0cc6\u0caf\u0cbe\u0c97\u0cbf \u0c87\u0c9f\u0ccd\u0c9f\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cc7\u0c95\u0cc1. \u0c87\u0ca6\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0c85\u0c82\u0c95\u0cc6 \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0cb0\u0ccd\u0cb9\u0cb0\u0cb2\u0ccd\u0cb2.",req_collection:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0ca4 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c85\u0c82\u0c97\u0ca1\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c95\u0c9a\u0cc7\u0cb0\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0ca8\u0c97\u0ca6\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca8\u0cbf\u0cb6\u0ccd\u0c9a\u0cbf\u0ca4 \u0cb8\u0cae\u0caf \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0c97\u0ccd\u0cb0\u0cb9\u0cbf\u0ca4 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb6\u0ccd\u0c9a\u0cbf\u0ca4 \u0cb8\u0cae\u0caf\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca0\u0cc7\u0cb5\u0ca3\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0c86\u0ca8\u0ccd\u0cb2\u0cc8\u0ca8\u0ccd \u0cae\u0cc2\u0cb2\u0c95 \u0c95\u0c82\u0caa\u0ca8\u0cbf\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb9\u0ccc\u0ca6\u0cc1 \u0c8e\u0c82\u0ca6\u0cb0\u0cc6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",req_criminal:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c95\u0cc1\u0c9f\u0cc1\u0c82\u0cac\u0ca6 \u0caf\u0cbe\u0cb0\u0cbe\u0ca6\u0cb0\u0cc2 \u0cb8\u0ca6\u0cb8\u0ccd\u0caf\u0cb0\u0cc1 \u0cad\u0cc2\u0ca4\u0c95\u0cbe\u0cb2\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c85\u0caa\u0cb0\u0cbe\u0ca7 \u0ca6\u0cbe\u0c96\u0cb2\u0cc6 \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca8\u0cc8\u0ca4\u0cbf\u0c95 \u0ca6\u0cc1\u0cb0\u0ccd\u0cac\u0cb2\u0ca4\u0cc6\u0caf\u0cc1\u0cb3\u0ccd\u0cb3 \u0c85\u0caa\u0cb0\u0cbe\u0ca7\u0c95\u0ccd\u0c95\u0cc7\u0cb0\u0cbf\u0ca6\u0cb0\u0cc6, \u0caa\u0cca\u0cb2\u0cc0\u0cb8\u0ccd \u0c87\u0ca4\u0cbf\u0cb9\u0cbe\u0cb8 \u0cb6\u0cc0\u0c9f\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca8\u0cc0\u0cb5\u0cc1 \u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cc6 \u0c85\u0cb0\u0ccd\u0cb9\u0cb0\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",req_indian:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0ccd\u0ca5\u0cb3\u0cc0\u0caf \u0cad\u0cbe\u0cb0\u0ca4\u0cc0\u0caf \u0ca8\u0cbe\u0c97\u0cb0\u0cbf\u0c95\u0cb0\u0cc1, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0cb3\u0cbf \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe KYC \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1, \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9a\u0cc6\u0c95\u0ccd \u0cac\u0cc1\u0c95\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb5\u0cc6.",req_population:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cbe\u0cb8\u0cbf\u0cb8\u0cc1\u0cb5 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf 10,000 \u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0c9c\u0ca8\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0cbf\u0ca6\u0cc6.",req_travel:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb6\u0cbe\u0cb0\u0cc0\u0cb0\u0cbf\u0c95\u0cb5\u0cbe\u0c97\u0cbf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cbe\u0cb9\u0ca8 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6\u0caf\u0cc7 \u0c8e\u0c82\u0ca6\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",search_by_amount:"\u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf",selfie_pending_msg:"\u0cb8\u0cc6\u0cb2\u0ccd\u0cab\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cac\u0cbe\u0c95\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca4\u0c82\u0ca1\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0c9f\u0ca8\u0ccd \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",set_additional_pin_desc:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0cae\u0cc7\u0cb2\u0cbf\u0ca8\u0c82\u0ca4\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cc0\u0cb5\u0cc1 \u0c87\u0ca4\u0cb0 \u0caa\u0cbf\u0ca8\u0ccd \u0c95\u0ccb\u0ca1\u0ccd \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6\u0cb0\u0cc6, 'ADD New' \u0c95