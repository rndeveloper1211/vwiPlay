0941\u0906 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u093e \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902\u0964","1matm":"1 \u091a\u0947\u0915 \u092c\u0948\u0932\u0947\u0902\u0938 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u091c\u0930\u0942\u0930\u0924 \u092a\u0921\u093c\u0928\u0947 \u092a\u0930 \u0939\u0940 \u0915\u0930\u0947\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u092c\u0948\u0902\u0915 \u0915\u0947 \u092e\u093e\u0938\u093f\u0915 \u091f\u094d\u0930\u093e\u0902\u091c\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u0941\u0921\u093c \u091c\u093e\u0924\u093e \u0939\u0948, \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u094b\u0908 \u091f\u094d\u0930\u093e\u0902\u091c\u0948\u0915\u094d\u0936\u0928 \u0915\u093f\u092f\u093e \u0939\u0948 \u0924\u094b \u0906\u092a \u0909\u0938\u0915\u0940 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0938\u0947 \u092d\u0940 \u092c\u0915\u093e\u092f\u093e \u0930\u0915\u092e \u091a\u0947\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","1mtm":"1 \u091a\u0947\u0915 \u092c\u0948\u0932\u0947\u0902\u0938 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u091c\u0930\u0942\u0930\u0924 \u092a\u0921\u093c\u0928\u0947 \u092a\u0930 \u0939\u0940 \u0915\u0930\u0947\u0902 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u092c\u0948\u0902\u0915 \u0915\u0947 \u092e\u093e\u0938\u093f\u0915 \u091f\u094d\u0930\u093e\u0902\u091c\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u0941\u0921\u093c \u091c\u093e\u0924\u093e \u0939\u0948, \u0905\u0917\u0930 \u0906\u092a\u0928\u0947 \u0907\u0938\u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u094b\u0908 \u091f\u094d\u0930\u093e\u0902\u091c\u0948\u0915\u094d\u0936\u0928 \u0915\u093f\u092f\u093e \u0939\u0948 \u0924\u094b \u0906\u092a \u0909\u0938\u0915\u0940 \u0939\u093f\u0938\u094d\u091f\u094d\u0930\u0940 \u0938\u0947 \u092d\u0940 \u092c\u0915\u093e\u092f\u093e \u0930\u0915\u092e \u091a\u0947\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964","1pan":"1  \u0906\u092a\u0915\u0940 \u092a\u0940\u090f\u0938\u090f \u0938\u0947\u0935\u093e \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964 \u092a\u0940\u090f\u0938\u090f \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0906\u0928\u0902\u0926 \u0932\u0947\u0902\u0964","1sec":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u094b \u090f\u0915 \u0938\u0902\u0926\u0947\u0936 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u090f\u0915 \u090f\u0902\u091f\u0940-\u0935\u093e\u092f\u0930\u0938 \u0915\u0941\u0902\u091c\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u0940 \u091c\u093f\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0938\u093e\u0925 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u0947 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964","2 CASH":"2 \u0915\u0943\u092a\u092f\u093e \u0932\u0947\u0928-\u0926\u0947\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0914\u0930 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0932\u093f\u0916\u093f\u0924 \u092e\u0947\u0902 \u0930\u0916\u0947\u0902, \u0935\u093f\u0935\u0930\u0923 \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964","2 Check":"2 \u0905\u092a\u0928\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 / \u092e\u094b\u092c\u093e\u0907\u0932 \u092c\u094d\u0932\u0942\u091f\u0942\u0925 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902 \u0964",key_clickth_188:"2. 2FA \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u0938\u094d\u0915\u0948\u0928' \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964",key_forcom_4:"2. \u0908-\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e Ok \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0906\u092a\u0915\u094b \u0906\u092a\u0915\u0947 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092a\u0930 OTP \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0917\u093e\u0964","2FA failed. Please try again.":"2FA \u0935\u093f\u092b\u0932 \u0930\u0939\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964","2FAREQUIRED":"\u0926\u094b-\u0938\u094d\u0924\u0930\u0940\u092f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0906\u0935\u0936\u094d\u092f\u0915","2matm":"2 \u0915\u0943\u092a\u092f\u093e \u0932\u0947\u0928-\u0926\u0947\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0914\u0930 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0932\u093f\u0916\u093f\u0924 \u092e\u0947\u0902 \u0930\u0916\u0947\u0902, \u0935\u093f\u0935\u0930\u0923 \u09