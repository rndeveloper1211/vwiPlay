09a7 \u0995\u09b0\u09c1\u09a8",location_note_title:"\u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u09a8\u09cb\u099f \u0995\u09b0\u09c1\u09a8",location_outside_message:"\u0986\u09aa\u09a8\u09bf \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u09b0 \u09b8\u09c7\u09a8\u09cd\u099f\u09be\u09b0\u09c7\u09b0 \u099c\u09bf\u0993\u09ab\u09c7\u09a8\u09cd\u09b8\u09bf\u0982 \u098f\u09b2\u09be\u0995\u09be\u09b0 \u09ac\u09be\u0987\u09b0\u09c7 \u0986\u099b\u09c7\u09a8, \u09a4\u09be\u0987 \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09b0\u0993 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u099b\u09bf \u09a8\u09be\u0964",location_solution_title:"\u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u0995\u09c0 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7?",location_solution_1:"1.\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u09b8\u09a0\u09bf\u0995 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8\u09c7 \u09a5\u09be\u0995\u09c7\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 Google \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8 \u09ac\u09be \u09b0\u09bf\u09b8\u09c7\u099f \u0995\u09b0\u09c1\u09a8\u0964",location_solution_2:"2. \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u09ac\u09be\u0987\u09b0\u09c7 \u09a5\u09be\u0995\u09c7\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u099c\u09bf\u0993\u09ab\u09c7\u09a8\u09cd\u09b8\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09c1\u09a8\u0964 \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u0996\u09c1\u09ac \u0995\u09be\u099b\u09c7 \u09a5\u09be\u0995\u09c7\u09a8 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09ad\u09bf\u09a4\u09b0\u09c7 \u09a8\u09be \u09a5\u09be\u0995\u09c7\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u09ad\u09bf\u09a4\u09b0\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964",location_solution_3:"3. \u0997\u09c1\u0997\u09b2 \u09b2\u09cb\u0995\u09c7\u09b6\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09c1\u09b0\u09c7\u09b8\u09bf \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09c1\u09a8: \u098f\u099f\u09bf \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09b8\u09a0\u09bf\u0995 \u09b2\u09cb\u0995\u09c7\u09b6\u09a8 \u09a6\u09c7\u09ac\u09c7\u0964",location_solution_4:"4. \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09a5\u09be\u0995\u09b2\u09c7, \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u09b0 \u09b8\u09be\u09b0\u09cd\u09ad\u09bf\u09b8\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964",understood_button:"\u09ac\u09c1\u099d\u09c7\u099b\u09bf","UTR must be at least 12 characters":"UTR \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 12 \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7","Verify UTR":"UTR \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8",key_youentere_113:"\u0986\u09aa\u09a8\u09bf \u09af\u09c7 UTR \u099f\u09bf \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u09a8 \u09a4\u09be \u09b9\u09b2:\n\n{{utr}}\n\n\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u098f\u099f\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4?",Sure:"\u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4",Payee:"\u09aa\u09cd\u09b0\u09be\u09aa\u0995",VPA:"VPA","UTR No":"UTR No","Enter UTR (min 12 chars)":"UTR \u09b2\u09bf\u0996\u09c1\u09a8 (\u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 12 \u0985\u0995\u09cd\u09b7\u09b0)","Upload Payment Proof":"\u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09cd\u09b0\u09c1\u09ab \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8","State Bank Of India \u20b9{{amount}}.00":"\u09b8\u09cd\u099f\u09c7\u099f \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0985\u09ab \u0987\u09a8\u09cd\u09a1\u09bf\u09af\u09bc\u