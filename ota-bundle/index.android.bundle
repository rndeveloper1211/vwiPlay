u0abf\u0ab6\u0ac7\u0ab7\u0aa4\u0abe*","The requirements must be met":"\u0a9c\u0ab0\u0ac2\u0ab0\u0ac0\u0aaf\u0abe\u0aa4\u0acb \u0aaa\u0ac2\u0ab0\u0ac0 \u0aa5\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f",key_throughth_103:"\u0a86 \u0aab\u0a82\u0a95\u0acd\u0ab6\u0aa8 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aae\u0ac7 Radiant Cash Management Services Limited \u0aa8\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0a85\u0aa8\u0ac7 QR \u0a95\u0acb\u0aa1\u0aa8\u0ac0 \u0aaf\u0abe\u0aa6\u0ac0 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe \u0a9b\u0ac0\u0a8f, \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0ac7 \u09a8\u0997\u0aa6 \u0a9c\u0aae\u0abe, \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a85\u0aa8\u0ac7 QR \u0ab8\u0acd\u0a95\u0ac7\u0aa8 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",key_throughth_104:"\u0a86 \u0aab\u0a82\u0a95\u0acd\u0ab6\u0aa8 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe, \u0aa4\u0aae\u0aa8\u0ac7 \u0aaa\u0ac0\u0a95\u0a85\u0aaa \u0ab8\u0aae\u0aaf, \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aa8\u0ac7 \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0ac0 \u0a9a\u0ab2\u0aa3\u0aa8\u0ac0 \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0a9b\u0ac7, \u0aa4\u0ac7\u0aae\u0a9c \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0abe \u0aa8\u0acb\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0a97\u0aa3\u0aa4\u0ab0\u0ac0 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a9c\u0ac7 \u0a9f\u0acb\u0a9f\u0ab2 \u0ab0\u0a95\u0aae \u0ab8\u0abe\u0aa5\u0ac7 \u0aae\u0ac7\u0ab2 \u0a96\u0abe\u0aaf.",key_throughth_105:"\u0a86 \u0aab\u0a82\u0a95\u0acd\u0ab6\u0aa8 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe, \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0aa5\u0aaf\u0ac7\u0ab2\u0abe \u0aaa\u0ac0\u0a95\u0a85\u0aaa \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aae\u0ac1\u0a9c\u0aac \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0aa8\u0ac7 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0aa8\u0ac0 \u0aaf\u0abe\u0aa6\u0ac0 \u0aa4\u0aae\u0ac7 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0ab6\u0acb. \u0a86 \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8 \u0a85\u0ab2\u0a97\u0aa5\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0ab8\u0abe\u0aa5\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.","To Date*":"\u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0ab8\u0ac1\u0aa7\u0ac0*","Transfer Report by Wallet":"\u0ab5\u0acb\u0ab2\u0ac7\u0a9f \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f","Upload Document":"\u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb","Verification Fees":"\u0ab5\u0ac7\u0ab0\u0abf\u0aab\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aab\u0ac0","View Back Aadhar Image":"\u0aaa\u0abe\u0a9b\u0ab3\u0aa8\u0ac0 \u0a86\u0aa7\u0abe\u0ab0 \u0a9b\u0aac\u0ac0 \u0a9c\u0ac1\u0a93","View Front Aadhar Image":"\u0aab\u0acd\u0ab0\u0aa8\u0acd\u0a9f \u0a86\u0aa7\u0abe\u0ab0 \u0a9b\u0aac\u0ac0 \u0a9c\u0ac1\u0a93",key_voterside_109:"\u0ab5\u0acb\u0a9f\u0ab0 \u0a86\u0a88\u0aa1\u0ac0/\u0aaa\u0abe\u0ab8\u0aaa\u0acb\u0ab0\u0acd\u0a9f/\u0ab0\u0ac7\u0ab6\u0aa8 \u0a95\u0abe\u0ab0\u0acd\u0aa1/\u0aa1\u0acd\u0ab0\u0abe\u0a88\u0ab5\u0abf\u0a82\u0a97 \u0ab2\u0abe\u0a88\u0ab8\u0aa8\u0acd\u0ab8/\u0ab5\u0abf\u0aa6\u0acd\u0aaf\u0ac1\u0aa4 \u0aac\u0abf\u0ab2/\u0a97\u0ac7\u0ab8 \u0aac\u0abf\u0ab2 (\u0a95\u0acb\u0a88\u0aaa\u0aa3)","Wallet Mode":"\u0ab5\u0acb\u0ab2\u0ac7\u0a9f \u0aae\u0acb\u0aa1","Yes, how can i work?":"\u0ab9\u0abe, \u0ab9\u0ac1\u0a82 \u0a95\u0ac7\u0ab5\u0ac0 \u0ab0\u0ac0\u0aa4\u0ac7 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac1\u0a82?","Your Image":"\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a9b\u0aac\u0ac0",key_yourscrat_118:"\u0aa4\u0aae\u0abe\u0ab0\u0acb \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac7\u0a9a \u0a95\u0acb\u0aa1 \u0aa8\u0ac0\u0a9a\u0ac7 \u0a9b\u0ac7, \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0ab8\u0acd\u0a95\u0acd\u0ab0\u0ac7\u0a9a \u0a95\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0aaa\u0acb\u0a88\u0aa8\u0acd\u0a9f\u0acd\u0ab8 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0acb","Yourself, bank security cheque":"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aaa\u0acb\u0aa4\u0abe\u0aa8\u0abe, \u0aac\u0ac7\u0a82\u0a95 \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a9a\u0ac7\u0a95",about_company_text_1:"Radiant Cash Management Services Limited \u0aad\u0abe\u0ab0\u0aa4\u0aa8\u0ac0 \u0aac\u0ac7\u0a82\u0a95\u0acb, \u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0ab8\u0a82\u0ab8\u0acd\u0aa5\u0abe\u0a93, \u0a93\u0ab0\u0acd\u0a97\u0ac7\u0aa8\u0abe\u0a87\u0a9d\u0acd\u0aa1 \u0ab0\u0abf\u0a9f\u0ac7\u0ab2 \u0a85\u0aa8\u0ac7 \u0a87-\u0a95\u0acb\u0aae\u0ab0\u0acd\u0ab8 \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0a93 \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0ac7\u0ab6 \u0aae\u0ac7\u0aa8\u0ac7\u0a9c\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0abe \u0ab5\u0abf\u0aa6\u0ac7\u0ab6\u0ac0 \u0a86\u0a89\u0a9f\u0ab8\u0acb\u0ab0\u0acd\u0ab8\u0abf\u0a82\u0a97 \u0a9c\u0ab0\u0ac2\u0ab0\u0abf\u0aaf\u0abe\u0aa4\u0acb\u0aa8\u0ac7 \u0aaa\u0ac2\u0ab0\u0ac0 \u0aaa\u0abe\u0aa1\u0ac7 \u0a9b\u0ac7. \u0a95\u0a82\u0aaa\u0aa8\u0ac0 \u0a85\u0aae\u0abe\u0ab0\u0abe \u0ab5\u0acd\u0aaf\u0ab5\u0ab8\u0abe\u0aaf\u0aa8\u0ac7 \u0aaa\u0abe\u0a82\u0a9a \u0ab5\u0ab0\u0acd\u0a9f\u0abf\u0a95\u0ab2\u0acd\u0ab8\u0aae\u0abe\u0a82 \u0a9a\u0ab2\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7.",about_company_text_2:"\u0a86\u0ab5\u0a95-\u0a9c\u0aa5\u0acd\u0aa5\u0abe \u0aaa\u0ab0 \u0a86\u0aa7\u0abe\u0ab0 \u0ab0\u0abe\u0a96\u0ac0\u0aa8\u0ac7, \u0a95\u0a82\u0aaa\u0aa8\u0ac0 \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a85\u0aa8\u0ac7 \u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0ab5\u0abe\u0aa8 \u0ab5\u0ab8\u0acd\u0aa4\u0ac1\u0a93\u0aa8\u0abe \u0aaa\u0ab0\u0abf\u0ab5\u0ab9\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0ab5\u0abe\u0ab9\u0aa8\u0acb\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0aac\u0ac7-\u0ab5\u0acd\u0ab9\u0ac0\u0ab2\u0ab0, \u0aad\u0abe\u0aa1\u0abe\u0aa8\u0abe \u0ab5\u0abe\u0ab9\u0aa8\u0acb \u0a85\u0aa8\u0ac7 \u0a96\u0abe\u0ab8 \u0aac\u0aa8\u0abe\u0ab5\u0ac7\u0ab2 \u0aac\u0a82\u0aa6\u0ac2\u0a95\u0ab5\u0abe\u0ab3\u0abe \u0ab5\u0abe\u0aa8\u0acd\u0ab8. \u0a95\u0a82\u0aaa\u0aa8\u0ac0 \u0aa6\u0ab0\u0ab0\u0acb\u0a9c \u0aa4\u0aae\u0abe\u0aae \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95\u0acb \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0ab2\u0a97\u0aad\u0a97 \u20b95000 - 6000 \u0aae\u0abf\u0ab2\u0abf\u0aaf\u0aa8\u0aa8\u0ac0 \u0a95\u0ac7\u0ab6 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0a9d\u0ac7\u0a95\u0acd\u0ab6\u0aa8 \u0ab8\u0a82\u0aad\u0abe\u0ab3\u0ac7 \u0a9b\u0ac7.",about_company_text_3:"\u0a86 \u0ab5\u0abf\u0aad\u0abe\u0a97\u0aa8\u0ac0 \u0a95\u0a82\u0aaa\u0aa8\u0ac0 \u0ab8\u0ac7\u0ab5\u0abe\u0a93\u0aae\u0abe\u0a82 \u0a8f\u0aa8\u0acd\u0aa1 \u0aaf\u0ac1\u0a9d\u0ab0 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0aa8\u0abe \u0a95\u0ab0\u0a82\u0a9f \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f\u0aae\u0abe\u0a82 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0ab5\u0ab5\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0aac\u0abe\u0aa6 \u0a95\u0acd\u0ab2\u0abe\u0aaf\u0a82\u0a9f\u0aa8\u0abe \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f\u0aae\u0abe\u0a82 \u0a8f \u0a9c \u0aa6\u0abf\u0ab5\u0ab8 \u0a85\u0aa5\u0ab5\u0abe \u0a86\u0a97\u0abe\u0aae\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0aa6\u0abf\u0ab5\u0ab8\u0ac7 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0ab5\u0ac1\u0a82 \u0634\u0627\u0645\u0644 \u0a9b\u0ac7. \u0a95\u0a82\u0aaa\u0aa8\u0ac0 \u0aae\u0abe\u0aa8\u0aa4\u0ac0 \u0a9b\u0ac7 \u0a95\u0ac7 60,000 \u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a9f\u0a9a \u0aaa\u0acb\u0a88\u0aa8\u0acd\u0a9f\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0ab8\u0aae\u0a97\u0acd\u0ab0 \u0aa6\u0ac7\u0ab6\u0aae\u0abe\u0a82 \u0ab5\u0abf\u0ab5\u0abf\u0aa7 \u0aac\u0ac7\u0a82\u0a95\u0acb \u0ab8\u0abe\u0aa5\u0ac7 \u0ab5\u0acd\u0aaf\u0abe\u0aaa\u0a95 \u0aa8\u0ac7\u0a9f\u0ab5\u0ab0\u0acd\u0a95 \u0a95\u0a82\u0aaa\u0aa8\u0ac0 \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95\u0acb, \u0a96\u0abe\u0ab8 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a96\u0abe\u0aa8\u0a97\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab5\u0abf\u0aa6\u0ac7\u0ab6\u0ac0 \u0aac\u0ac7\u0a82\u0a95\u0acb\u0aa8\u0ac7 \u0a85\u0aa8\u0aa8\u0acd\u0aaf \u0aae\u0ac2\u0ab2\u0acd\u0aaf \u0aaa\u0acd\u0ab0\u0ab8\u0acd\u0aa4\u0abe\u0ab5 (value proposition) \u0a93\u0aab\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aae\u0aa6\u0aa6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.",add_new_pickup_desc:"\u0aaa\u0ac0\u0a95\u0a85\u0aaa \u0ab8\u0aae\u0aaf, \u0a91\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0a85\u0aa5\u0ab5\u0abe \u0aab\u0abf\u0a9d\u0abf\u0a95\u0ab2 \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aa8\u0a82\u0aac\u0ab0 \u0a85\u0aa8\u0ac7 \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0ab2\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0abe \u0a9a\u0ab2\u0aa3\u0aa8\u0ac0 \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0acb, \u0aa4\u0ac7\u0aae\u0a9c \u0aa4\u0aae\u0abe\u0aae \u0aa8\u0acb\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0a97\u0aa3\u0aa4\u0ab0\u0ac0 \u0a9f\u0acb\u0a9f\u0ab2 \u0ab0\u0a95\u0aae \u0ab8\u0abe\u0aa5\u0ac7 \u0aaf\u0acb\u0a97\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0ac7\u0ab3 \u0a96\u0abe\u0aa4\u0ac0 \u0ab9\u0acb\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f.",cash_deposit_ac_list_desc:"\u0a86 \u0aab\u0a82\u0a95\u0acd\u0ab6\u0aa8 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aae\u0ac7 Radiant Cash Management Services Limited \u0aa8\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0a85\u0aa8\u0ac7 QR \u0a95\u0acb\u0aa1\u0aa8\u0ac0 \u0aaf\u0abe\u0aa6\u0ac0 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab0\u0ab9\u0acd\u0aaf\u0abe \u0a9b\u0ac0\u0a8f, \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0ac7 \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a9c\u0aae\u0abe, \u0a93\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a85\u0aa8\u0ac7 QR \u0ab8\u0acd\u0a95\u0ac7\u0aa8 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",cash_online_deposit_desc:"\u0a86 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f\u0aae\u0abe\u0a82, RCE \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aac\u0ac7\u0a82\u0a95 \u0a95\u0ac7\u0ab6 \u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f\u0ab0\u0aae\u0abe\u0a82 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2\u0abe \u0aa8\u0abe\u0aa3\u0abe\u0a82, Cash Deposit Machine (CDM) \u0aae\u0abe\u0a82 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2\u0abe \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0a95\u0acb\u0a88 \u0aaa\u0aa3 \u0a91\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aae\u0abe\u0aa7\u0acd\u0aaf\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0ac7\u0ab2\u0abe \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",cash_pickup_prepay_desc:"\u0aa8\u0abe\u0aa3\u0abe\u0a82 RCE \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0aaa\u0ac0\u0a95\u0a85\u0aaa \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95\u0ac7 \u0a86\u0aaa\u0ac7\u0ab2\u0abe \u0aae\u0abe\u0aa7\u0acd\u0aaf\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0aa8\u0ac7 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7, \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f-\u0aa1\u0ac7\u0aac\u0abf\u0a9f \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a86 \u0ab2\u0ac7\u0a9c\u0ab0\u0aae\u0abe\u0a82 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7.",cash_pickup_report_desc:"\u0a86 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0aa5\u0ac0 RC \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0ab5\u0abf\u0a97\u0aa4\u0acb \u0a86\u0aaa\u0ab6\u0ac7, RCE \u0aa1\u0abf\u0a9c\u0abf\u0a9f\u0ab2 \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a9a\u0ac1\u0a95\u0ab5\u0aa3\u0ac0 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0a95\u0ac7 \u0aab\u0abf\u0a9d\u0abf\u0a95\u0ab2 \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0aa4\u0ac7 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.","click on \"Resend Button\"":"\"Resend Button\" \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb",company_docs_deposit_desc:"\u0aac\u0ac7\u0a82\u0a95\u0acb\u0aae\u0abe\u0a82 \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7, \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0aa8\u0abe \u0a95\u0ac7\u0a9f\u0ab2\u0abe\u0a95 \u0aae\u0ab9\u0aa4\u0acd\u0ab5\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac0 \u0a9c\u0ab0\u0ac2\u0ab0 \u0aaa\u0aa1\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aae \u0a95\u0ac7 PAN \u0a95\u0abe\u0ab0\u0acd\u0aa1, \u0a9c\u0ac7 \u0aae\u0acb\u0a9f\u0abe\u0aad\u0abe\u0a97\u0aa8\u0ac0 \u0aac\u0ac7\u0a82\u0a95\u0acb\u0aae\u0abe\u0a82 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7. \u0a95\u0ac7\u0a9f\u0ab2\u0abe\u0a95 \u0aac\u0ac7\u0a82\u0a95\u0acb \u0ab5\u0aa7\u0abe\u0ab0\u0abe\u0aa8\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb\u0aa8\u0ac0 \u0aae\u0abe\u0a82\u0a97 \u0aaa\u0aa3 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7, \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c \u0a85\u0ab9\u0ac0\u0a82\u0aa5\u0ac0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0acb.",deposit_slip_cms_desc:"\u0a95\u0ac7\u0a9f\u0ab2\u0abe\u0a95 \u0aac\u0ac7\u0a82\u0a95\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0abe\u0aa3\u0abe \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0ab2\u0a97 \u0aa1\u0abf\u0aaa\u0acb\u0a9d\u0abf\u0a9f \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0ab9\u0acb\u0aaf \u0a9b\u0ac7. \u0a86 \u0aac\u0ac7\u0a82\u0a95\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0aa4\u0aae\u0abe\u0aae \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0a85\u0ab9\u0ac0\u0a82\u0aa5\u0ac0 \u0aa1\u0abe\u0a89\u0aa8\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0abf\u0aa8\u0acd\u0a9f (Print Slip) \u0ab2\u0a87 \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",error_occurred_try_later:"\u0a8f\u0a95 \u0aad\u0ac2\u0ab2 \u0a86\u0ab5\u0ac0 \u0a9b\u0ac7, \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0a9b\u0ac0 \u0aab\u0ab0\u0ac0 \u0aaa\u0acd\u0ab0\u0aaf\u0abe\u0ab8 \u0a95\u0ab0\u0acb",failed_title:"\u0ab5\u0abf\u0aab\u0ab3",pay_picked_dues_desc:"\u0a86 \u0aab\u0a82\u0a95\u0acd\u0ab6\u0aa8 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe, \u0a85\u0aaa\u0ab2\u0acb\u0aa1 \u0a95\u0ab0\u0ac7\u0ab2\u0abe \u0aaa\u0ac0\u0a95\u0a85\u0aaa \u0ab8\u0acd\u0ab2\u0abf\u0aaa \u0aae\u0ac1\u0a9c\u0aac \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0aa8\u0ac7 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7\u0aa8\u0ac0 \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0aa8\u0ac0 \u0aaf\u0abe\u0aa6\u0ac0 \u0a9c\u0acb\u0a88 \u0ab6\u0a95\u0ab6\u0acb. \u0a86 \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8 \u0a85\u0ab2\u0a97 \u0a85\u0aa5\u0ab5\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aaf \u0a9b\u0ac7.",payout_note:"\u0a86 \u0aa4\u0ac7 \u0ab8\u0aae\u0aaf\u0ac7 \u0ab2\u0abe\u0a97\u0ac1 \u0aaa\u0aa1\u0ac7 \u0a9b\u0ac7 \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a95\u0aae\u0abf\u0ab6\u0aa8 \u0aa8\u0acd\u0aaf\u0ac2\u0aa8\u0aa4\u0aae \u0a97\u0ac7\u0ab0\u0a82\u0a9f\u0ac0 \u0ab0\u0a95\u0aae \u0a95\u0ab0\u0aa4\u0abe\u0a82 \u0ab5\u0aa7\u0ac1 \u0ab9\u0acb\u0aaf. \u0aa4\u0aae\u0aa8\u0ac7 \u0a9c\u0ac7 \u0ab5\u0aa7\u0abe\u0ab0\u0ac7 \u0aae\u0ab3\u0ac7 \u0aa4\u0ac7 \u0aae\u0ab3\u0ab6\u0ac7 \u2014 \u0aa8\u0acd\u0aaf\u0ac2\u0aa8\u0aa4\u0aae \u0a97\u0ac7\u0ab0\u0a82\u0a9f\u0ac0 \u0ab0\u0a95\u0aae \u0a85\u0aa5\u0ab5\u0abe \u0a95\u0aae\u0abf\u0ab6\u0aa8.",personal_information:"\u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0a97\u0aa4 \u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0",pickup_deposit_ledger_desc:"\u0aa8\u0abe\u0aa3\u0abe\u0a82 RCE \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95 \u0aaa\u0abe\u0ab8\u0ac7\u0aa5\u0ac0 \u0aaa\u0ac0\u0a95\u0a85\u0aaa \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa5\u0ab5\u0abe \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95\u0ac7 \u0a86\u0aaa\u0ac7\u0ab2\u0abe \u0aae\u0abe\u0aa7\u0acd\u0aaf\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0aa8\u0ac7 \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7, \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f-\u0aa1\u0ac7\u0aac\u0abf\u0a9f \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a86 \u0ab2\u0ac7\u0a9c\u0ab0\u0aae\u0abe\u0a82 \u0ab0\u0ab9\u0ac7\u0ab6\u0ac7.",req_civil:"\u0aa4\u0aae\u0abe\u0ab0\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f \u0ab8\u0acd\u0a95\u0acb\u0ab0 (\u0ab8\u0abf\u0ab5\u0abf\u0ab2 \u0ab8\u0acd\u0a95\u0acb\u0ab0) 670 \u0aa5\u0ac0 \u0a89\u0aaa\u0ab0 \u0ab0\u0abe\u0a96\u0ab5\u0acb \u0a9c\u0ab0\u0ac2\u0ab0\u0ac0 \u0a9b\u0ac7. \u0a9c\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0abe\u0ab8\u0ac7 \u0a86 \u0a85\u0aa5\u0ab5\u0abe \u0ab5\u0aa7\u0ac1 \u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0a95\u0acd\u0ab0\u0ac7\u0aa1\u0abf\u0a9f \u0ab8\u0acd\u0a95\u0acb\u0ab0 \u0aa8\u0aa5\u0ac0, \u0aa4\u0acb \u0aa4\u0aae\u0ac7 \u0a85\u0ab0\u0acd\u0ab9 \u0aa8\u0aa5\u0ac0.",req_collection:"\u0a95\u0a82\u0aaa\u0aa8\u0ac0 \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a85\u0aa7\u0abf\u0a95\u0ac3\u0aa4 \u0ab8\u0acd\u0a9f\u0acb\u0ab0 \u0a85\u0aa5\u0ab5\u0abe \u0a93\u0aab\u0abf\u0ab8\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aa8\u0abe\u0aa3\u0abe\u0a82 \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0abf\u0ab0\u0acd\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab8\u0aae\u0aaf \u0ab2\u0a88 \u0ab6\u0a95\u0acb \u0a9b\u0acb \u0a85\u0aa8\u0ac7 \u0aa8\u0abf\u0ab0\u0acd\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0ab8\u0aae\u0aaf\u0aae\u0abe\u0a82 \u0a9c\u0aae\u0abe \u0a85\u0aa5\u0ab5\u0abe \u0a91\u0aa8\u0ab2\u0abe\u0a88\u0aa8 \u0aae\u0abe\u0aa7\u0acd\u0aaf\u0aae \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0a82\u0aaa\u0aa8\u0ac0\u0aa8\u0ac7 \u0a9f\u0acd\u0ab0\u0abe\u0aa8\u0acd\u0ab8\u0aab\u0ab0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0ab9\u0abe, \u0aa4\u0acb \u0aa4\u0aae\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb.",req_criminal:"\u0a9c\u0acb \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a85\u0aa5\u0ab5\u0abe \u0ab0\u0a95\u0acd\u0aa4 \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aa8\u0abe \u0a85\u0aa8\u0acd\u0aaf \u0ab8\u0aad\u0acd\u0aaf\u0aa8\u0ac0 \u0aad\u0ac2\u0aa4\u0a95\u0abe\u0ab3\u0aae\u0abe\u0a82 \u0a95\u0acb\u0a88 \u0aab\u0acb\u0a9c\u0aa6\u0abe\u0ab0\u0ac0 \u0aa8\u0acb\u0a82\u0aa7 \u0ab9\u0acb\u0aaf, \u0a95\u0acb\u0a88 \u0a95\u0abe\u0aaf\u0aa6\u0ac7\u0ab8\u0ab0 \u0a97\u0ac1\u0aa8\u0abe \u0a95\u0ab0\u0acd\u0aaf\u0abe \u0ab9\u0acb\u0aaf \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aae\u0acb\u0ab0\u0ab2 \u0a9f\u0ab0\u0acd\u0aaa\u0abf\u0a9a\u0ab0 \u0ab6\u0abe\u0aae\u0ac7\u0ab2 \u0ab9\u0acb\u0aaf \u0a85\u0aa5\u0ab5\u0abe \u0aaa\u0acb\u0ab2\u0ac0\u0ab8 \u0a87\u0aa4\u0abf\u0ab9\u0abe\u0ab8 \u0ab6\u0ac0\u0a9f \u0ab9\u0acb\u0aaf, \u0aa4\u0acb \u0a86 \u0ab8\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0ac7 \u0a85\u0ab0\u0acd\u0ab9 \u0aae\u0abe\u0aa8\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0aa8\u0ab9\u0abf \u0a86\u0ab5\u0acb.",req_indian:"\u0aa4\u0aae\u0ac7 \u0aad\u0abe\u0ab0\u0aa4\u0ac0\u0aaf \u0aa8\u0abe\u0a97\u0ab0\u0abf\u0a95 \u0a9b\u0acb \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aaa\u0abe\u0ab8\u0ac7 \u0aa4\u0aae\u0abe\u0aae KYC \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb, \u0aac\u0ac7\u0a82\u0a95 \u0a8f\u0a95\u0abe\u0a89\u0aa8\u0acd\u0a9f \u0a85\u0aa8\u0ac7 \u0a9a\u0ac7\u0a95\u0aac\u0ac1\u0a95 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7.",req_population:"\u0a9c\u0a97\u0acd\u0aaf\u0abe \u0a9c\u0acd\u0aaf\u0abe\u0a82 \u0aa4\u0aae\u0ac7 \u0ab0\u0ab9\u0ac7\u0aa4\u0abe \u0a9b\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0a82\u0aa8\u0ac0 \u0ab5\u0ab8\u0acd\u0aa4\u0ac0 10,000 \u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a9b\u0ac7.",req_travel:"\u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0ab6\u0abe\u0ab0\u0ac0\u0ab0\u0abf\u0a95 \u0ab0\u0ac0\u0aa4\u0ac7 \u0aae\u0ac1\u0ab8\u0abe\u0aab\u0ab0\u0ac0 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a85\u0aa8\u0ac7 \u0ab5\u0abe\u0ab9\u0aa8 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0ab9\u0acb\u0aaf.",search_by_amount:"\u0ab0\u0a95\u0aae \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0ac7 \u0ab6\u0acb\u0aa7\u0acb",selfie_pending_msg:"\u0ab8\u0ac7\u0ab2\u0acd\u0aab\u0ac0 \u0ab5\u0ac7\u0ab0\u0abf\u0aab\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aac\u0abe\u0a95\u0ac0 \u0a9b\u0ac7. \u0a9f\u0ac0\u0aae\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ab0\u0acd\u0a95 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aac\u0a9f\u0aa8 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0acb.",set_additional_pin_desc:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0aa6\u0ab8\u0acd\u0aa4\u0abe\u0ab5\u0ac7\u0a9c\u0acb \u0a85\u0aa8\u0ac1\u0ab8\u0abe\u0ab0 \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aaa\u0abf\u0aa8 \u0a95\u0acb\u0aa1 \u0a89\u0aaa\u0ab0 \u0a86\u0aaa\u0ac7\u0ab2 \u0a9b\u0ac7. \u0a9c\u0acb \u0aa4\u0aae\u0ac7 \u0a85\u0aa8\u0acd\u0aaf \u0aaa\u0abf\u0aa8 \u0a95\u0acb\u0aa1 \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0aaa\u0aa3 \u0a95\u0abe\u0aae \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb, \u0aa4\u0acb 'ADD New' \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0ab5\u0aa7\u0ac1 4 \u0aaa\u0abf\u0aa8 \u0a95\u0acb\u0aa1 \u0a89\u0aae\u0ac7\u0ab0\u0acb.",successfully_title:"\u0ab8\u0aab\u0ab3\u0aa4\u0abe\u0aaa\u0ac2\u0ab0\u0acd\u0ab5\u0a95",transfer_report_wallet_desc:"\u0aae\u0ac7\u0a88\u0aa8 \u0ab5\u0acb\u0ab2\u0ac7\u0a9f \u0a85\u0aa8\u0ac7 POS \u0ab5\u0acb\u0ab2\u0ac7\u0a9f \u0aae\u0abe\u0ab0\u0aab\u0aa4\u0ac7 \u0a9c\u0aae\u0abe \u0a95\u0ab0\u0abe\u0aaf\u0ac7\u0ab2\u0abe \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0a85\u0ab9\u0ac0\u0a82 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aae\u0a9c QR \u0a95\u0acb\u0aa1 \u0a85\u0aa8\u0ac7 Intent UPI \u0aae\u0acb\u0aa1 \u0aae\u0abe\u0ab0\u0aab\u0aa4\u0ac7 \u0a95\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7\u0ab2\u0abe \u0ab2\u0abe\u0a87\u0ab5 \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f\u0acd\u0ab8\u0aa8\u0ac0 \u0ab0\u0abf\u0aaa\u0acb\u0ab0\u0acd\u0a9f \u0aaa\u0aa3 \u0a85\u0ab9\u0ac0\u0a82 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7.",usb_connected_msg:"\u0aaa\u0acd\u0ab0\u0abf\u0aaf \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95, \u0a85\u0aae\u0ac7 \u0a93\u0ab3\u0a96\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7 \u0a95\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0acb \u0aae\u0acb\u0aac\u0abe\u0a88\u0ab2 \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 USB \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0a9f \u0a