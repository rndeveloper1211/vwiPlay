 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964",D4:"\u0918\u0930\u0947\u0932\u0942 \u092e\u0928\u0940 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 (\u0921\u0940\u090f\u092e\u091f\u0940) \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947, \u0917\u094d\u0930\u093e\u0939\u0915 \u090f\u0915 \u0932\u0947\u0928\u0926\u0947\u0928 \u092e\u0947\u0902 5000 \u0930\u0941\u092a\u092f\u0947 \u0924\u0915 \u0914\u0930 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u0940 \u0915\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0938\u0947 \u092a\u094d\u0930\u0924\u093f \u092e\u093e\u0939 \u0905\u0927\u093f\u0915\u0924\u092e 25000 \u0930\u0941\u092a\u092f\u0947 \u092d\u0947\u091c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",D5:"\u092f\u0926\u093f \u0915\u094b\u0908 \u0932\u0947\u0928\u0926\u0947\u0928 \u0932\u0902\u092c\u093f\u0924 \u0939\u0948, \u0924\u094b \u0907\u0938\u0947 \u0932\u0947\u0928\u0926\u0947\u0928 \u0915\u0940 \u0924\u093e\u0930\u0940\u0916 + \u0926\u094b \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u092e\u0902\u091c\u0942\u0930\u0940 \u0926\u0947 \u0926\u0940 \u091c\u093e\u090f\u0917\u0940\u0964",D6:"\u0928\u090f \u0926\u093f\u0936\u093e-\u0928\u093f\u0930\u094d\u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u0940 \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u093e\u0930 \u0938\u0902\u0916\u094d\u092f\u093e \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0939\u0948\u0964 \u0932\u093e\u092d\u093e\u0930\u094d\u0925\u0940 \u0915\u094b \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u091a\u0930\u0923\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f: - \u0938\u092c\u0938\u0947 \u092a\u0939\u0932\u0947 10 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u0947\u0937\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902> \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 (\u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u092c\u0948\u0902\u0915 \u0926\u094d\u0935\u093e\u0930\u093e \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e)> \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902> \u0909\u0902\u0917\u0932\u0940 \u0915\u094b \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902\u0964",D7:"\u090f\u0915 \u092c\u093e\u0930 \u0932\u0947\u0928-\u0926\u0947\u0928\u0947 \u0932\u0902\u092c\u093f\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u0932\u0947\u0928\u0926\u0947\u0928 \u0926\u093e\u0916\u093f\u0932 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 (\u0913\u091f\u0940\u092a\u0940 \u092a\u094d\u0930\u0947\u0937\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092d\u0947\u091c\u0947\u0917\u093e)\u0964",DATA:"\u0921\u0947\u091f\u093e",DAY_BOOK:"\u0926\u093f\u0928 \u092c\u0941\u0915",DAY_EARNING:"\u0926\u093f\u0928 \u0915\u0940 \u0915\u092e\u093e\u0908",DAY_LEDGER:"\u0926\u093f\u0928 \u0932\u0947\u091c\u0930",DAY_MONTH_BOOK:"\u0926\u093f\u0928 \u0914\u0930 \u092e\u093e\u0939 \u092c\u0941\u0915",DELETE:"\u0939\u091f\u093e\u090f\u0901","DELETE success":"\u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092e\u093f\u091f\u093e\u092f\u093e \u0917\u092f\u093e","DEVICE CONNECTED":"\u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 -",DISPUTE_REPORT:"\u0935\u093f\u0935\u093e\u0926 \u0930\u093f\u092a\u094b\u0930\u094d\u091f",DMT:"\u0921