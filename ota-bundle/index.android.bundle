ile_device_to_the_fingerprint_scanner":"\u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u099f\u09bf \u09ab\u09bf\u0999\u09cd\u0997\u09be\u09b0\u09aa\u09cd\u09b0\u09bf\u09a8\u09cd\u099f \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8\u09be\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8","1_Dear_Customer_Your_E_KYC_is_Not_Completed_So_Firstly_Complete_Your_E_KYC":"\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u0997\u09cd\u09b0\u09be\u09b9\u0995, \u0986\u09aa\u09a8\u09be\u09b0 \u0987-\u0995\u09c7\u0993\u09af\u09bc\u09be\u0987\u09b8\u09bf \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09b9\u09af\u09bc\u09a8\u09bf\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u0997\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0987-\u0995\u09c7\u0993\u09af\u09bc\u09be\u0987\u09b8\u09bf \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09b0\u09c1\u09a8","2_Click_the_Scan_button_to_complete_your_2FA_verification":"\u09e8\u098f\u09ab\u098f \u09af\u09be\u099a\u09be\u0987\u0995\u09b0\u09a3 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09b0\u09a4\u09c7 \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8 \u09ac\u09cb\u09a4\u09be\u09ae\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8","3_Please_firstly_Connect_Your_Mobile_with_Finger_Print_Scanner_Device_Morpho_Mantra_Startek":"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2\u0995\u09c7 \u09ab\u09bf\u0999\u09cd\u0997\u09be\u09b0\u09aa\u09cd\u09b0\u09bf\u09a8\u09cd\u099f \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 (Morpho / Mantra / Startek) \u098f\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8","A newer version of the app is available for a better experience.":"\u09ad\u09be\u09b2 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u09b0 \u09a8\u09a4\u09c1\u09a8 \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7","ADD VPA ID":"VPA \u0986\u0987\u09a1\u09bf \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8","Aadhar Card (Front Side)":"\u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 (\u09b8\u09be\u09ae\u09a8\u09c7\u09b0 \u09a6\u09bf\u0995)","Address Proof (Back Side)":"\u09a0\u09bf\u0995\u09be\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 (\u09aa\u09bf\u099b\u09a8\u09c7\u09b0 \u09a6\u09bf\u0995)","Already have an account ?":"\u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09bf \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u0995\u099f\u09bf \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u0986\u099b\u09c7?","Alternate Phone Number":"\u09ac\u09bf\u0995\u09b2\u09cd\u09aa \u09ab\u09cb\u09a8 \u09a8\u09ae\u09cd\u09ac\u09b0","An error occurred. Please try again.":"\u098f\u0995\u099f\u09bf \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u0998\u099f\u09c7\u099b\u09c7\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8","Are You Sure !":"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4?","Authentication Required":"\u09aa\u09cd\u09b0\u09ae\u09be\u09a3\u09c0\u0995\u09b0\u09a3 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8",But_this_is_optional_for_the_customer_you_can_continue_further:"\u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u099f\u09bf \u0997\u09cd\u09b0\u09be\u09b9\u0995\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0990\u099a\u09cd\u099b\u09bf\u0995, \u0986\u09aa\u09a8\u09bf \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8",Choose_a_front_image_from_Aadhar_or_back_image_from_Aadhar_photo:"\u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1\u09c7\u09b0 \u09b8\