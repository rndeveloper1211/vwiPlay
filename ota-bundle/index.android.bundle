e\u094d\u0939\u0940 \u092a\u094d\u0930\u0936\u093e\u0938\u0915\u093e\u091a\u094d\u092f\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0924\u092a\u0936\u0940\u0932 \u092c\u0926\u0932\u0942 \u0936\u0915\u0924\u093e. \u0938\u0924\u094d\u092f\u093e\u092a\u0928\u093e\u0928\u0902\u0924\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0924\u092a\u0936\u0940\u0932 \u092c\u0926\u0932\u0924\u093e \u092f\u0947\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924. \u092b\u0915\u094d\u0924 \u092a\u0930\u094d\u092f\u093e\u092f\u0940 \u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092c\u0926\u0932/\u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.","Manage Profile":"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e","Mobile number must be exactly 10 digits.":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0928\u0947\u092e\u0915\u0947 10 \u0905\u0902\u0915\u093e\u0902\u091a\u093e \u0905\u0938\u093e\u0935\u093e.","Update Profile":"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e","Select Image":"\u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e","Edit Profile":"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e",Edit:"\u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e","Please Enter Amount":"\u0915\u0943\u092a\u092f\u093e \u0930\u0915\u094d\u0915\u092e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e","Heavy Request":"\u091c\u0921 \u0935\u093f\u0928\u0902\u0924\u0940","select state":"\u0930\u093e\u091c\u094d\u092f \u0928\u093f\u0935\u0921\u093e","select District":"\u091c\u093f\u0932\u094d\u0939\u093e \u0928\u093f\u0935\u0921\u093e",SUCCESS:"\u092f\u0936\u0938\u094d\u0935\u0940",language_changed_success:"\u092d\u093e\u0937\u093e \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u0940\u0924\u094d\u092f\u093e \u092c\u0926\u0932\u0932\u0940.","Application {App} Language":"\u0972\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 {App} \u092d\u093e\u0937\u093e","Voice Notification":"\u0935\u094d\u0939\u0949\u0907\u0938 \u0938\u0942\u091a\u0928\u093e","Dark Mode":"\u0921\u093e\u0930\u094d\u0915 \u092e\u094b\u0921","Apk languages":"\u0939\u0947 \u0972\u092a \u0906\u0920 \u092d\u093e\u0937\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0947\u0932\u0947 \u0906\u0939\u0947 (\u0907\u0902\u0917\u094d\u0930\u091c\u0940, \u0939\u093f\u0902\u0926\u0940, \u092c\u0902\u0917\u093e\u0932\u0940, \u0917\u0941\u091c\u0930\u093e\u0924\u0940, \u092e\u0930\u093e\u0920\u0940, \u0924\u092e\u093f\u0933, \u0924\u0947\u0932\u0941\u0917\u0942 \u0906\u0923\u093f \u0915\u0928\u094d\u0928\u0921). \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u0940 \u092d\u093e\u0937\u093e \u0938\u0939\u091c \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u093e. \u092d\u093e\u0937\u093e \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u093e \u091f\u0945\u092c\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.","Apk notification":"\u0935\u0947\u0933\u094b\u0935\u0947\u0933\u0940 \u0938\u0942\u091a\u0928\u093e \u0924\u092a\u093e\u0938\u0924\u093e \u092f\u0947\u0924 \u0928\u0938\u0932\u094d\u092f\u093e\u0938, \u0938\u0942\u091a\u0928\u093e \u092c\u091f\u0923 \u0938\u0941\u0930\u0942 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u092c\u091f\u0923 \u0938\u0941\u0930\u0942 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0972\u092a \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0915\u094d\u0930\u093f\u092f\u093e\u0915\u0932\u093e\u092a\u093e\u0902\u092c\u0926\u094d\u0926\u0932 \u0906\u092a\u094b\u0906\u092a \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0932.","Apk theme":"\u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0928\u0940\u091f \u0926\u093f\u0938\u0924 \u0928\u0938\u0932\u094d\u092f\u093e\u0938, \u0921\u0940\u092b\u0949\u0932\u094d\u091f \u0972\u092a \u0925\u0940\u092e \u0935\u093e\u092a\u0930\u0942 \u0936\u0915\u0924\u093e. \u0921\u0940\u092b\u0949\u0932\u094d\u091f \u0925\u0940\u092e \u092c\u0939\u0941\u0924\u0947\u0915 \u0917\u0921\u0926 \u0930\u0902\u0917\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0905\u0938\u0924\u0947. \u092c\u0902\u0926 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092c\u091f\u0923 \u092c\u0902\u0926 \u0915\u0930\u093e.",mis:"\u092f\u093e \u0935\u093f\u092d\u093e\u0917\u093e\u0924 \u0938\u0930\u094d\u0935 \u092e\u0941\u0916\u094d\u092f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0924. \u092d\u093e\u0937\u093e, \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u092e\u094b\u0921, \u0938\u0942\u091a\u0928\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0906\u0923\u093f \u0907\u0924\u0930 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u094d\u092f\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.","Manage Important Setting":"\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u094d\u092f\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e","FAQ description":"\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0947 \u0935\u093e\u0930\u0902\u0935\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u0932\u0947 \u091c\u093e\u0923\u093e\u0930\u0947 \u092a\u094d\u0930\u0936\u094d\u0928 (FAQ) \u092a\u0943\u0937\u094d\u0920 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u092a\u094d\u0930\u0936\u094d\u0928\u093e\u0902\u091a\u0940 \u0909\u0924\u094d\u0924\u0930\u0947 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0906\u0939\u0947.",FAQs:"\u0935\u093e\u0930\u0902\u0935\u093e\u0930 \u0935\u093f\u091a\u093e\u0930\u0932\u0947 \u091c\u093e\u0923\u093e\u0930\u0947 \u092a\u094d\u0930\u0936\u094d\u0928","Bank Holiday":"\u092f\u093e \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0947\u0932\u094d\u092f\u093e\u0938 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0906\u0917\u093e\u092e\u0940 \u092c\u0901\u0915 \u0938\u0941\u091f\u094d\u091f\u094d\u092f\u093e\u0902\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u092e\u093f\u0933\u0947\u0932, \u091c\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0938\u0941\u091f\u094d\u091f\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0915\u093e\u0933\u093e\u0924 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u093e \u092c\u0945\u0932\u0928\u094d\u0938 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0920\u0947\u0935\u0942 \u0936\u0915\u0924\u093e.","Coming Bank Holidays":"\u0906\u0917\u093e\u092e\u0940 \u092c\u0901\u0915 \u0938\u0941\u091f\u094d\u091f\u094d\u092f\u093e",Complaint:"\u091f\u0940\u092a:- \u0906\u092e\u091a\u094d\u092f\u093e \u091a\u0945\u091f \u0938\u0947\u0935\u093e \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0938\u0902\u092d\u093e\u0937\u0923\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u094d\u092f\u093e \u091c\u093e\u0924 \u0928\u093e\u0939\u0940\u0924. \u0906\u092e\u094d\u0939\u0940 \u0915\u0947\u0935\u0933 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u092e\u0938\u094d\u092f\u093e\u0902\u0938\u093e\u0920\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u094b\u0924. \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0924 \u0938\u092e\u0938\u094d\u092f\u093e \u0906\u0932\u094d\u092f\u093e\u0938\u091a \u092f\u093e \u0938\u0947\u0935\u0947\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u093e.","Complaint Through Chat Service":"\u091a\u0945\u091f \u0938\u0947\u0935\u0947 \u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u0915\u094d\u0930\u093e\u0930","Support Email-ID":"\u0938\u092a\u094b\u0930\u094d\u091f \u0908\u092e\u0947\u0932-\u0906\u092f\u0921\u0940","Customer Care Number":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947\u0935\u093e \u0915\u094d\u0930\u092e\u093e\u0902\u0915","Every Sunday":"\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0930\u0935\u093f\u0935\u093e\u0930","Every Saturday":"\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0936\u0928\u093f\u0935\u093e\u0930","Monday to Friday":"\u0938\u094b\u092e\u0935\u093e\u0930 \u0924\u0947 \u0936\u0941\u0915\u094d\u0930\u0935\u093e\u0930","Cust Time":"\u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947\u0935\u093e \u0938\u0939\u093e\u092f\u094d\u092f\u093e\u091a\u0940 \u0935\u0947\u0933 \u0916\u093e\u0932\u0940 \u0926\u093f\u0932\u0940 \u0906\u0939\u0947. \u092f\u093e \u0935\u0947\u0933\u0947\u0924 \u0906\u092e\u094d\u0939\u0940 \u0926\u0942\u0930\u0927\u094d\u0935\u0928\u0940\u0926\u094d\u0935\u093e\u0930\u0947 \u0938\u0939\u093e\u092f\u094d\u092f \u0926\u0947\u090a.","Our Customer Care Timing":"\u0906\u092e\u091a\u0940 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947\u0935\u093e \u0935\u0947\u0933","Help & Support":"\u092e\u0926\u0924 \u0906\u0923\u093f \u0938\u0939\u093e\u092f\u094d\u092f",Back:"\u092e\u093e\u0917\u0947","November 01, 2024":"01 \u0928\u094b\u0935\u094d\u0939\u0947\u0902\u092c\u0930 2024","March 25, 2024":"25 \u092e\u093e\u0930\u094d\u091a 2024",Holi:"\u0939\u094b\u0933\u0940",Monday:"\u0938\u094b\u092e\u0935\u093e\u0930",Tuesday:"\u092e\u0902\u0917\u0933\u0935\u093e\u0930",Wednesday:"\u092c\u0941\u0927\u0935\u093e\u0930",Thursday:"\u0917\u0941\u0930\u0941\u0935\u093e\u0930",Friday:"\u0936\u0941\u0915\u094d\u0930\u0935\u093e\u0930",Saturday:"\u0936\u0928\u093f\u0935\u093e\u0930",Sunday:"\u0930\u0935\u093f\u0935\u093e\u0930",Deepawali:"\u0926\u093f\u0935\u093e\u0933\u0940","New Year":"\u0928\u0935\u0940\u0928 \u0935\u0930\u094d\u0937","FAQ Info":"\u091f\u0940\u092a:- \u092e\u093e\u0917\u0940\u0932 5 \u0926\u093f\u0935\u0938\u093e\u0902\u0924 \u0932\u0949\u0917\u093f\u0928 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u0930\u094d\u0935 \u092e\u094b\u092c\u093e\u0907\u0932 \u0909\u092a\u0915\u0930\u0923\u093e\u0902\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u092f\u0947\u0925\u0947 \u0926\u093f\u0932\u0940 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0928\u093e\u0935, \u092e\u0949\u0921\u0947\u0932, IP \u092a\u0924\u094d\u0924\u093e, \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0906\u092f\u0921\u0940, \u0905\u0915\u094d\u0937\u093e\u0902\u0936-\u0930\u0947\u0916\u093e\u0902\u0936 \u0906\u0923\u093f \u0936\u0947\u0935\u091f\u091a\u093e \u0935\u093e\u092a\u0930\u0932\u0947\u0932\u093e \u092a\u0924\u094d\u0924\u093e \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u093e. \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0909\u092a\u0915\u0930\u0923\u0947 \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0930\u093e. \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0928\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0909\u092a\u0915\u0930\u0923\u093e\u0902\u0935\u0930\u0942\u0928 \u0932\u0949\u0917\u093f\u0928 \u0915\u0930\u0924\u093e \u092f\u0947\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.","SAMSUNG Z 22":"\u0938\u0945\u092e\u0938\u0902\u0917 Z 22","sdf dfdssd":"\u090f\u0938\u0921\u0940\u090f\u092b \u0921\u0940\u090f\u092b\u0921\u0940\u090f\u0938\u090f\u0938\u0921\u0940","Manage Important Security":"\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e","MIS description2":"\u092a\u094d\u0930\u093f\u092f \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u092d\u093e\u0917\u0940\u0926\u093e\u0930, \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u0947\u0936\u0940 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u0930\u094d\u0935 \u0915\u094d\u0930\u093f\u092f\u093e\u0915\u0932\u093e\u092a \u092f\u093e \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947\u0924. \u0915\u0943\u092a\u092f\u093e \u0935\u0947\u0933\u094b\u0935\u0947\u0933\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0924\u092a\u093e\u0938\u093e. \u0924\u0941\u092e\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0906\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u0906\u0939\u0947.",Security:{"Set SIM":"\u090f\u0915\u0926\u093e \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930, \u0939\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u092b\u0915\u094d\u0924 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0938\u093f\u092e \u0924\u094d\u092f\u093e\u091a \u092e\u094b\u092c\u093e\u0907\u0932\u092e\u0927\u094d\u092f\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0915\u093e\u0930\u094d\u092f \u0915\u0930\u0947\u0932. \u092f\u093e\u092e\u0941\u0933\u0947 \u092b\u0938\u0935\u0923\u0942\u0915 \u091f\u093e\u0933\u0923\u094d\u092f\u093e\u0938 \u092e\u0926\u0924 \u0939\u094b\u0908\u0932. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u0930\u0935\u093e\u0928\u0917\u0940\u0936\u093f\u0935\u093e\u092f \u0932\u0949\u0917\u093f\u0928 \u0939\u094b\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.","Mandatory SIM Setting":"\u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0938\u093f\u092e \u0938\u0947\u091f\u093f\u0902\u0917","Screen Lock Setting":"\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0932\u0949\u0915 \u0938\u0947\u091f\u093f\u0902\u0917","Set One Time Password":"\u0935\u0928 \u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0947\u091f \u0915\u0930\u093e","Screen Lock":"\u0939\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0932\u0949\u0915\u0926\u094d\u0935\u093e\u0930\u0947 \u0972\u092a \u0932\u0949\u0917\u093f\u0928 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u0947\u0924\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u093f\u0928, \u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f \u0915\u093f\u0902\u0935\u093e \u092b\u0947\u0938 \u0932\u0949\u0915 \u0938\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.","OTP setting":"\u0935\u0928 \u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 (OTP) \u0939\u0940 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u094d\u0924\u0930 \u0906\u0939\u0947 \u091c\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0927\u094b\u0915\u0947 \u091f\u093e\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u094b\u092f\u0940\u0928\u0941\u0938\u093e\u0930 \u092a\u0930\u094d\u092f\u093e\u092f \u0928\u093f\u0935\u0921\u093e.","Change Login Password":"\u0932\u0949\u0917\u093f\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932\u093e","Change L & P":"\u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u093e \u0932\u0949\u0917\u093f\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932\u0942 \u0936\u0915\u0924\u093e. \u0938\u0941\u0930\u0915\u094d\u0937\u0947\u0938\u093e\u0920\u0940 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0935\u0947\u0933\u094b\u0935\u0947\u0933\u0940 \u092c\u0926\u0932\u0923\u0947 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0947 \u0906\u0939\u0947.","Change or Forget PIN":"\u092a\u093f\u0928 \u092c\u0926\u0932\u093e \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u0938\u0930\u0932\u093e\u0924","Forget PIN":"\u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u093f\u0928 \u0935\u093f\u0938\u0930\u0932\u093e\u0924 \u0915\u093f\u0902\u0935\u093e \u092c\u0926\u0932\u0942 \u0907\u091a\u094d\u091b\u093f\u0924 \u0905\u0938\u093e\u0932 \u0924\u0930 \u092f\u0947\u0925\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e. \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u093f\u0928\u0936\u093f\u0935\u093e\u092f \u0906\u0930\u094d\u0925\u093f\u0915 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0924\u093e \u092f\u0947\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.","Mob Registration Settings":"\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u094b\u0902\u0926\u0923\u0940 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938",Registration:"\u0924\u0941\u092e\u094d\u0939\u0940 \u090f\u0915 \u0915\u093f\u0902\u0935\u093e \u0905\u0927\u093f\u0915 \u092e\u094b\u092c\u093e\u0907\u0932 \u0909\u092a\u0915\u0930\u0923\u0947 \u0928\u094b\u0902\u0926\u0923\u0940 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0972\u092a \u092b\u0915\u094d\u0924 \u0928\u094b\u0902\u0926\u0923\u0940\u0915\u0943\u0924 \u0909\u092a\u0915\u0930\u0923\u093e\u0902\u0935\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0905\u0938\u0947\u0932.","Manage Login Platform":"\u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0932\u0945\u091f\u092b\u0949\u0930\u094d\u092e \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u093e","Manage Login":"\u092f\u093e \u0938\u0941\u0935\u093f\u0927\u0947\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0906\u0923\u093f \u092e\u094b\u092c\u093e\u0907\u0932 \u0972\u092a\u0935\u0930\u0940\u0932 \u0932\u0949\u0917\u093f\u0928 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0906\u0935\u0936\u094d\u092f\u0915 \u0928\u0938\u0932\u094d\u092f\u093e\u0938 \u092a\u094d\u0932\u0945\u091f\u092b\u0949\u0930\u094d\u092e \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e."},"Please Enter Old Password":"\u0915\u0943\u092a\u092f\u093e \u091c\u0941\u0928\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e!!!","Transaction PIN do not match":"\u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u093f\u0928 \u091c\u0941\u0933\u0924 \u0928\u093e\u0939\u0940",ERROR:"\u0924\u094d\u0930\u0941\u091f\u0940!!!",key_yourtrans_116:"\u0924\u0941\u092e\u091a\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u093f\u0928 \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u0940\u0924\u094d\u092f\u093e \u092c\u0926\u0932\u0932\u093e \u0917\u0947\u0932\u093e \u0905\u0938\u0942\u0928 \u0908\u092e\u0947\u0932\u0935\u0930 \u092a\u093e\u0920\u0935\u0932\u093e \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u093e \u0908\u092e\u0947\u0932 \u0924\u092a\u093e\u0938\u093e.","Pin changed successfully!":"\u092a\u093f\u0928 \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u0940\u0924\u094d\u092f\u093e \u092c\u0926\u0932\u0932\u093e!","An error occurred. Please try again.":"\u0924\u094d\u0930\u0941\u091f\u0940 \u0906\u0932\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.","Want To Delete This Device":"\u0939\u0947 \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0939\u091f\u0935\u093e\u092f\u091a\u0947 \u0906\u0939\u0947","Are You Sure":"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0916\u093e\u0924\u094d\u0930\u0940 \u0906\u0939\u0947 \u0915\u093e?","Want To block This Device":"\u0939\u0947 \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u093e\u092f\u091a\u0947 \u0906\u0939\u0947","Want To Unblock This Device":"\u0939\u0947 \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0905\u0928\u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u093e\u092f\u091a\u0947 \u0906\u0939\u0947","Your State Update Successfully.":"\u0924\u0941\u092e\u091a\u093e \u0938\u094d\u091f\u0947\u091f \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u0940\u0924\u094d\u092f\u093e \u0905\u092a\u0921\u0947\u091f \u091d\u093e\u0932\u093e.",ChangePassword:{"Change Login Password":"\u0932\u0949\u0917\u093f\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932\u093e","Password Security Tips":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091f\u093f\u092a\u094d\u0938","Current Password":"\u0938\u0927\u094d\u092f\u093e\u091a\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921","Enter New Password":"\u0928\u0935\u0940\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e","Confirm New Password":"\u0928\u0935\u0940\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e","Update Password":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e","Re-enter New Password":"\u0928\u0935\u0940\u0928 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e","Passwords should be at least 6 characters long":"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093f\u092e\u093e\u0928 6 \u0905\u0915\u094d\u0937\u0930\u093e\u0902\u091a\u093e \u0905\u0938\u093e\u0935\u093e","Don't use personal information":"\u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u0935\u093e\u092a\u0930\u0942 \u0928\u0915\u093e","Randomize patterns and sequences":"\u092a\u0945\u091f\u0930\u0