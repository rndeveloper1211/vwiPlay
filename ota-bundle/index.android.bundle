u0cb0 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0c9c\u0cae\u0cbe \u0cae\u0cbe\u0ca1\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0caf\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb6\u0cbe\u0c96\u0cc6\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf UTR \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ccb\u0cb0\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0c97\u0cc6 \u0cae\u0cc1\u0c82\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cbf.","Register New Remitter":"\u0cb9\u0cca\u0cb8 \u0cb0\u0cc6\u0cae\u0cbf\u0c9f\u0ccd\u0c9f\u0cb0\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf","Remitter Mobile Number":"\u0cb0\u0cc6\u0cae\u0cbf\u0c9f\u0ccd\u0c9f\u0cb0\u0ccd \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Remitter Name":"\u0cb0\u0cc6\u0cae\u0cbf\u0c9f\u0ccd\u0c9f\u0cb0\u0ccd \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1","Enter Remitter Name":"\u0cb0\u0cc6\u0cae\u0cbf\u0c9f\u0ccd\u0c9f\u0cb0\u0ccd \u0cb9\u0cc6\u0cb8\u0cb0\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","IFS Code":"IFS \u0c95\u0ccb\u0ca1\u0ccd",Ac:"\u0c96\u0cbe\u0ca4\u0cc6",ID:"\u0c90\u0ca1\u0cbf",Aadhaar:"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd",pancard:"\u0caa\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd",none:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc2 \u0c87\u0cb2\u0ccd\u0cb2","Enter Service Fee":"\u0cb8\u0cc7\u0cb5\u0cbe \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter Aadhaar Number":"\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter Pan Number":"\u0caa\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter Transaction PIN":"\u0c9f\u0ccd\u0cb0\u0cbe\u0ca8\u0ccd\u0cb8\u0cbe\u0c95\u0ccd\u0cb7\u0ca8\u0ccd PIN \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Please Enter Valid Aadhar Number":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Please Enter Valid Pan Card Number":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 \u0caa\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0c95\u0cbe\u0cb0\u0ccd\u0ca1\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Enter Same Amount":"\u0c85\u0ca6\u0cc7 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf !!!","Please Enter Valid Amount":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0ca6 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf !!!",aadhaarpanrequired:"\u20b9 24999 \u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0cca\u0ca4\u0ccd\u0ca4\u0c95\u0ccd\u0c95\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca5\u0cb5\u0cbe \u0caa\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c85\u0c97\u0ca4\u0ccd\u0caf",acHolder:"\u0c96\u0cbe\u0ca4\u0cc6\u0ca6\u0cbe\u0cb0","Pay Again":"\u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cbf",Hi:"\u0ca8\u0cae\u0cb8\u0ccd\u0c95\u0cbe\u0cb0","Monthly Limit":"\u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0cae\u0cbf\u0ca4\u0cbf","Remain Limit":"\u0c89\u0cb3\u0cbf\u0ca6 \u0cae\u0cbf\u0ca4\u0cbf","Enter Mobile No":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",Add:"\u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cbf",Verified:"\u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0ca4 \u0c96\u0cbe\u0ca4\u0cc6","Bank AC No":"\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6",SURE:"\u0c96\u0c9a\u0cbf\u0ca4",DELETE:"\u0c85\u0cb3\u0cbf\u0cb8\u0cbf","Add SuccessFully":"\u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Beneficiary Add Successfully":"\u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cb8\u0cc7\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Select Your Bank":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf","PayTm No":"PayTM \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Transaction Pin":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 PIN","Device Not Connected Please try Again":"\u0c89\u0caa\u0c95\u0cb0\u0ca3 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0cb2\u0ccd\u0cb2, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf","Device Number":"\u0c89\u0caa\u0c95\u0cb0\u0ca3 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Your M-ATM device is currently not found":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae M-ATM \u0c89\u0caa\u0c95\u0cb0\u0ca3 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0c82\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2","1 Check":"1 \u0c89\u0caa\u0c95\u0cb0\u0ca3\u0ca6 \u0caa\u0cb5\u0cb0\u0ccd \u0c86\u0ca8\u0ccd/\u0c86\u0cab\u0ccd \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","2 Check":"2 \u0c89\u0caa\u0c95\u0cb0\u0ca3 / \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cac\u0ccd\u0cb2\u0cc2\u0c9f\u0cc2\u0ca4\u0ccd \u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","3 Check":"3 M-ATM \u0caa\u0cb0\u0ca6\u0cc6\u0caf\u0cb2\u0ccd\u0cb2\u0cbf\u0ca8 \u0cac\u0ccd\u0cb2\u0cc2\u0c9f\u0cc2\u0ca4\u0ccd \u0c9a\u0cbf\u0cb9\u0ccd\u0ca8\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","4 Check":"* \u0c92\u0c82\u0ca6\u0cc7 \u0c89\u0caa\u0c95\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc6 \u0c8e\u0cb0\u0ca1\u0cc1 \u0cb5\u0cbf\u0cad\u0cbf\u0ca8\u0ccd\u0ca8 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cc1 \u0ca4\u0ccb\u0cb0\u0cbf\u0ca6\u0cb0\u0cc6, \u0c92\u0c82\u0ca6\u0cca\u0c82\u0ca6\u0cbe\u0c97\u0cbf \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cb2\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Error occured while bonding":"\u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0ca6\u0ccb\u0cb7 \u0cb8\u0c82\u0cad\u0cb5\u0cbf\u0cb8\u0cbf\u0ca6\u0cc6",Close:"\u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cbf","Amount Should":"\u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u20b9 201 \u0c85\u0ca5\u0cb5\u0cbe \u0c85\u0ca6\u0c95\u0ccd\u0c95\u0cbf\u0c82\u0ca4 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1!",cashposh:"\u0ca8\u0c97\u0ca6\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 POSH","1 CASH":"1 Cash & Posh \u20b9 200 \u0cb0\u0cbf\u0c82\u0ca6 \u20b9 2000 \u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0ca8\u0c97\u0ca6\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0caf\u0cb2\u0cc1 M-ATM \u0c97\u0cbf\u0c82\u0ca4 \u0c89\u0ca4\u0ccd\u0ca4\u0cae \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c87\u0ca6\u0cb0 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1\u0c97\u0cb3\u0cc1 ATM \u0cae\u0cbe\u0cb8\u0cbf\u0c95 \u0cae\u0cbf\u0ca4\u0cbf\u0caf\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cc6\u0c95\u0ccd\u0c95\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.","2 CASH":"2 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cb5\u0ccd\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0caf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cc1\u0c96\u0ccd\u0caf \u0cae\u0c