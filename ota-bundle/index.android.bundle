e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c35\u0c46\u0c30\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c24\u0c30\u0c41\u0c35\u0c3e\u0c24, \u0c2e\u0c40\u0c30\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c32\u0c47\u0c30\u0c41, \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c47\u0c35\u0c32\u0c02 \u0c10\u0c1a\u0c4d\u0c1b\u0c3f\u0c15 \u0c21\u0c3e\u0c15\u0c4d\u0c2f\u0c41\u0c2e\u0c46\u0c02\u0c1f\u0c4d\u0c32\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c21\u0c02/\u0c05\u0c2a\u0c4d\u200c\u0c32\u0c4b\u0c21\u0c4d \u0c1a\u0c47\u0c2f\u0c17\u0c32\u0c30\u0c41.","Manage Profile":"\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c23","Mobile number must be exactly 10 digits.":"\u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c02\u0c17\u0c3e 10 \u0c05\u0c02\u0c15\u0c46\u0c32\u0c41 \u0c09\u0c02\u0c21\u0c3e\u0c32\u0c3f.","Update Profile":"\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c28\u0c35\u0c40\u0c15\u0c30\u0c23","Select Image":"\u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f","Edit Profile":"\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",Edit:"\u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","Please Enter Amount":"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f","Heavy Request":"\u0c39\u0c46\u0c35\u0c3f \u0c30\u0c3f\u0c15\u0c4d\u0c35\u0c46\u0c38\u0c4d\u0c1f\u0c4d","select state":"\u0c30\u0c3e\u0c1c\u0c4d\u0c2f\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f","select District":"\u0c1c\u0c3f\u0c32\u0c4d\u0c32\u0c3e\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f",SUCCESS:"\u0c35\u0c3f\u0c1c\u0c2f\u0c02",language_changed_success:"\u0c2d\u0c3e\u0c37 \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.","Application {App} Language":"\u0c2f\u0c3e\u0c2a\u0c4d {App} \u0c2d\u0c3e\u0c37","Voice Notification":"\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d","Dark Mode":"\u0c21\u0c3e\u0c30\u0c4d\u0c15\u0c4d \u0c2e\u0c4b\u0c21\u0c4d","Apk languages":"\u0c2e\u0c47\u0c2e\u0c41 \u0c08 \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c28\u0c3f \u0c0e\u0c28\u0c3f\u0c2e\u0c3f\u0c26\u0c3f \u0c2d\u0c3e\u0c37\u0c32\u0c4d\u0c32\u0c4b (\u0c07\u0c02\u0c17\u0c4d\u0c32\u0c40\u0c37\u0c4d, \u0c39\u0c3f\u0c02\u0c26\u0c40, \u0c2c\u0c46\u0c02\u0c17\u0c3e\u0c32\u0c40, \u0c17\u0c41\u0c1c\u0c30\u0c3e\u0c24\u0c40, \u0c2e\u0c30\u0c3e\u0c20\u0c40, \u0c24\u0c2e\u0c3f\u0c33\u0c4d, \u0c24\u0c46\u0c32\u0c41\u0c17\u0c41, \u0c15\u0c28\u0c4d\u0c28\u0c21) \u0c05\u0c2d\u0c3f\u0c35\u0c43\u0c26\u0c4d\u0c27\u0c3f \u0c1a\u0c47\u0c38\u0c3e\u0c2e\u0c41, \u0c26\u0c40\u0c28\u0c3f \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2e\u0c40\u0c30\u0c41 \u0c2e\u0c40 \u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c38\u0c41\u0c32\u0c2d\u0c02\u0c17\u0c3e \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c2e\u0c3e\u0c24\u0c4b \u0c15\u0c32\u0c38\u0c3f \u0c38\u0c41\u0c32\u0c2d\u0c02\u0c17\u0c3e \u0c05\u0c2d\u0c3f\u0c35\u0c43\u0c26\u0c4d\u0c27\u0c3f \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f. \u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c08 \u0c1f\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.","Apk notification":"\u0c2e\u0c40\u0c30\u0c41 \u0c38\u0c2e\u0c2f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2a\u0c4d\u0c30\u0c24\u0c3f\u0c15\u0c4d\u0c30\u0c3f\u0c2f\u0c32\u0c28\u0c41 \u0c24\u0c28\u0c3f\u0c16\u0c40 \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c06\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c12\u0c15\u0c38\u0c3e\u0c30\u0c3f \u0c06\u0c28\u0c4d \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, \u0c2f\u0c3e\u0c2a\u0c4d \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c1a\u0c3e\u0c32\u0c15\u0c02\u0c17\u0c3e \u0c38\u0c02\u0c2c\u0c02\u0c27\u0c3f\u0c24 \u0c15\u0c3e\u0c30\u0c4d\u0c2f\u0c15\u0c32\u0c3e\u0c2a\u0c3e\u0c32 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c2e\u0c3f\u0c2e\u0c4d\u0c2e\u0c32\u0c4d\u0c28\u0c3f \u0c39\u0c46\u0c1a\u0c4d\u0c1a\u0c30\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c08 \u0c2b\u0c02\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2f\u0c3e\u0c2a\u0c4d \u0c36\u0c2c\u0c4d\u0c26 \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c42\u0c21\u0c3e \u0c05\u0c02\u0c26\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.","Apk theme":"\u0c21\u0c3f\u0c38\u0c4d\u0c2a\u0c4d\u0c32\u0c47\u0c28\u0c41 \u0c38\u0c30\u0c3f\u0c17\u0c3e \u0c1a\u0c42\u0c21\u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c2e\u0c40\u0c30\u0c41 \u0c26\u0c40\u0c28\u0c4d\u0c28\u0c3f \u0c21\u0c3f\u0c2b\u0c3e\u0c32\u0c4d\u0c1f\u0c4d \u0c2f\u0c3e\u0c2a\u0c4d \u0c25\u0c40\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c1a\u0c42\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c21\u0c3f\u0c2b\u0c3e\u0c32\u0c4d\u0c1f\u0c4d \u0c25\u0c40\u0c2e\u0c4d\u200c\u0c32\u0c4b \u0c38\u0c41\u0c32\u0c2d\u0c02\u0c17\u0c3e \u0c2a\u0c28\u0c3f \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c07\u0c26\u0c3f \u0c0e\u0c15\u0c4d\u0c15\u0c41\u0c35\u0c17\u0c3e \u0c21\u0c3e\u0c30\u0c4d\u0c15\u0c4d \u0c15\u0c32\u0c30\u0c4d\u0c32\u0c24\u0c4b \u0c2a\u0c28\u0c3f\u0c1a\u0c47\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. \u0c06\u0c28\u0c4d/\u0c06\u0c2b\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c28\u0c41 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",mis:"\u0c05\u0c28\u0c4d\u0c28\u0c3f \u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c2e\u0c48\u0c28 \u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c41\u0c32\u0c41 \u0c08 \u0c2b\u0c02\u0c15\u0c4d\u0c37\u0c28\u0c4d\u200c\u0c32\u0c4b \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c28\u0c4d\u0c28\u0c3e\u0c2f\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c2f\u0c3e\u0c2a\u0c4d \u0c2d\u0c3e\u0c37, \u0c38\u0c4d\u0c15\u0c4d\u0c30\u0c40\u0c28\u0c4d \u0c21\u0c3f\u0c38\u0c4d\u200c\u0c2a\u0c4d\u0c32\u0c47 \u0c2e\u0c4b\u0c21\u0c4d, \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c07\u0c24\u0c30 \u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c2e\u0c48\u0c28 \u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c41\u0c32\u0c28\u0c41 \u0c2e\u0c40\u0c15\u0c41 \u0c05\u0c28\u0c41\u0c17\u0c41\u0c23\u0c02\u0c17\u0c3e \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","Manage Important Setting":"\u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c2e\u0c48\u0c28 \u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c41\u0c32\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f","FAQ description":"\u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c4b\u0c24\u0c4d\u0c24\u0c30\u0c3e\u0c32 \u0c2a\u0c47\u0c1c\u0c40 \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2e\u0c41\u0c16\u0c4d\u0c2f\u0c2e\u0c48\u0c28 \u0c2d\u0c3e\u0c17\u0c02, \u0c0e\u0c02\u0c26\u0c41\u0c15\u0c02\u0c1f\u0c47 \u0c07\u0c26\u0c3f \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23\u0c02\u0c17\u0c3e \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c28\u0c41 \u0c38\u0c42\u0c1a\u0c3f\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f. FAQs \u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c24\u0c4b \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c2e\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c1a\u0c3f\u0c28\u0c4d\u0c28 \u0c38\u0c2e\u0c3e\u0c27\u0c3e\u0c28\u0c02 \u0c07\u0c38\u0c4d\u0c24\u0c41\u0c02\u0c26\u0c3f.",FAQs:"\u0c2a\u0c4d\u0c30\u0c36\u0c4d\u0c28\u0c32\u0c41","Bank Holiday":"\u0c08 \u0c2c\u0c1f\u0c28\u0c4d\u200c\u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c2f\u0c21\u0c02 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c30\u0c3e\u0c2c\u0c4b\u0c2f\u0c47 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c38\u0c46\u0c32\u0c35\u0c41\u0c32 \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02 \u0c2a\u0c4a\u0c02\u0c26\u0c35\u0c1a\u0c4d\u0c1a\u0c41, \u0c26\u0c40\u0c28\u0c3f \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c38\u0c46\u0c32\u0c35\u0c41\u0c32 \u0c38\u0c2e\u0c2f\u0c02\u0c32\u0c4b \u0c2c\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c28\u0c4d\u0c38\u0c4d \u0c28\u0c3f\u0c32\u0c4d\u0c35 \u0c1a\u0c47\u0c2f\u0c35\u0c1a\u0c4d\u0c1a\u0c41.","Coming Bank Holidays":"\u0c30\u0c3e\u0c2c\u0c4b\u0c2f\u0c47 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c38\u0c46\u0c32\u0c35\u0c41\u0c32\u0c41",Complaint:"\u0c17\u0c2e\u0c28\u0c3f\u0c15:- \u0c2e\u0c3e \u0c1a\u0c3e\u0c1f\u0c4d \u0c38\u0c47\u0c35\u0c32\u0c41 \u0c38\u0c3e\u0c27\u0c3e\u0c30\u0c23 \u0c38\u0c02\u0c2d\u0c3e\u0c37\u0c23 \u0c15\u0c4b\u0c38\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c35\u0c41. \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c38\u0c2e\u0c38\u0c4d\u0c2f\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c1f\u0c3e\u0c2f\u0c3f.","Complaint Through Chat Service":"\u0c1a\u0c3e\u0c1f\u0c4d \u0c38\u0c47\u0c35 \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2b\u0c3f\u0c30\u0c4d\u0c2f\u0c3e\u0c26\u0c41","Support Email-ID":"\u0c38\u0c39\u0c3e\u0c2f\u0c02 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d-ID","Customer Care Number":"\u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c15\u0c47\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d","Every Sunday"