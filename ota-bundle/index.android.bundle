47\u0928 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f:","Try a different search term":"\u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u0916\u094b\u091c \u0936\u092c\u094d\u0926 \u0906\u091c\u093c\u092e\u093e\u090f\u0902","Try adjusting the date range or filters.":"\u0924\u093e\u0930\u0940\u0916 \u0938\u0940\u092e\u093e \u092f\u093e \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u092c\u0926\u0932\u0915\u0930 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964","UTR No:":"UTR \u0928\u0902\u092c\u0930:","VPA:":"VPA:","Your Version: V":"\u0906\u092a\u0915\u093e \u0935\u0930\u094d\u091c\u0928: V","Your wallet balance is short by \u20b9":"\u0906\u092a\u0915\u0947 \u0935\u0949\u0932\u0947\u091f \u092c\u0948\u0932\u0947\u0902\u0938 \u092e\u0947\u0902 \u20b9 \u0915\u0940 \u0915\u092e\u0940 \u0939\u0948"}},1081,[]);
__d(function(e,a,t,o,i,n,r){i.exports={SP1:"Self Payout \u0cae\u0cc2\u0cb2\u0c95 IMPS (\u0ca4\u0c95\u0ccd\u0cb7\u0ca3\u0ca6 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb8\u0cc7\u0cb5\u0cc6) \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 NEFT (\u0cb0\u0cbe\u0cb7\u0ccd\u0c9f\u0ccd\u0cb0\u0cc0\u0caf \u0c8e\u0cb2\u0cc6\u0c95\u0ccd\u0c9f\u0ccd\u0cb0\u0cbe\u0ca8\u0cbf\u0c95\u0ccd \u0ca8\u0cbf\u0ca7\u0cbf \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0cb5\u0ca3\u0cc6) \u0cae\u0cc2\u0cb2\u0c95 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb9\u0ca3 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",SP2:"e-KYC \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u20b910.00 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",SP3:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c95\u0cbe\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc2 \u0ca4\u0caa\u0ccd\u0caa\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cc7\u0cb0\u0cc6 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0cb9\u0ca3 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",SP4:"Self-pay \u0cb8\u0cc7\u0cb5\u0cc6 \u0cb0\u0cbf\u0c9f\u0cc7\u0cb2\u0cb0\u0ccd \u0c85\u0cb5\u0cb0 \u0cb8\u0ccd\u0cb5\u0c82\u0ca4 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf, \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 DMT \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c95\u0cbe\u0cb0\u0ca3\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0caf\u0cbe\u0cb0\u0cbf\u0c97\u0cbe\u0ca6\u0cb0\u0cc2 \u0cb9\u0ca3 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0caf \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 KYC \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0c95\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",SP5:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cac\u0cbe\u0c95\u0cbf \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c85\u0ca6\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 + \u0c8e\u0cb0\u0ca1\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",SP6:"\u0c88 \u0cb8\u0cc7\u0cb5\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc8\u0caf\u0cbe\u0cb0\u0cc6 \u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cb2\u0cc1 30 \u0ca8\u0cbf\u0cae\u0cbf\u0cb7\u0c97\u0cb3\u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",D1:"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 IMPS (\u0ca4\u0c95\u0ccd\u0cb7\u0ca3\u0ca6 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb8\u0cc7\u0cb5\u0cc6) \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 NEFT \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0ca3 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",D2:"e-KYC \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u20b910.00 \u0cb6\u0cc1\u0cb2\u0ccd\u0c95 \u0cb5\u0cb8\u0cc2\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",D3:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c95\u0cbe\u0cb0\u0ca3\u0c95\u0ccd\u0c95\u0cc2 \u0ca4\u0caa\u0ccd\u0caa\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 DMT \u0cb9\u0ca3 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0cb5\u0ca3\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cc7\u0cb0\u0cc6 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0cb9\u0ca3 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",D4:"Domestic Money Transfer (DMT) \u0cae\u0cc2\u0cb2\u0c95, \u0c92\u0c82\u0ca6\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0c95\u0ccd\u0c95\u0cc6 \u20b95,000 \u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0ca4\u0cbf\u0c82\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c97\u0cb0\u0cbf\u0cb7\u0ccd\u0ca0 \u20b925,000 \u0cb5\u0cb0\u0cc6\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",D5:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cac\u0cbe\u0c95\u0cbf \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c85\u0ca6\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 + \u0c8e\u0cb0\u0ca1\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c85\u0ca8\u0cc1\u0cae\u0ccb\u0ca6\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",D6:"\u0cb9\u0cca\u0cb8 \u0cae\u0cbe\u0cb0\u0ccd\u0c97\u0cb8\u0cc2\u0c9a\u0cbf\u0c97\u0cb3 \u0caa\u0ccd\u0cb0\u0c95\u0cbe\u0cb0, \u0cb2\u0cbe\u0cad\u0cbe\u0cb0\u0ccd\u0ca5\u0cbf \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf\u0c97\u0cc6 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c95\u0ca1\u0ccd\u0ca1\u0cbe\u0caf. \u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0cc1: \u0cae\u0cca\u0ca6\u0cb2\u0cc1 10 \u0c85\u0c82\u0c95\u0cbf\u0caf \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf > OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf > \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf > \u0cac\u0cc6\u0cb0\u0cb3\u0c9a\u0ccd\u0c9a\u0cc1 \u0cb8\u0ccd\u0c95\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",D7:"\u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cac\u0cbe\u0c95\u0cbf \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0ca6\u0cc6 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 (OTP \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cc6 \u0cac\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6).",PPI1:"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 IMPS, NEFT \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 UPI \u0cae\u0cc2\u0cb2\u0c95 \u0cb9\u0ca3 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.",PPI2:"\u0ca4\u0caa\u0ccd\u0caa\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6 \u0cb9\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cae\u0cbe\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2 \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0cc7\u0cb0\u0cc6 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cc6 \u0cb5\u0cb0\u0ccd\u0c97\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.",PPI3:"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cac\u0cbe\u0c95\u0cbf \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c85\u0ca6\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 + \u0c8e\u0cb0\u0ca1\u0cc1 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0cbf\u0c82\u0c97\u0ccd \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0caf\u0cb0\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",PPI4:"\u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cb5\u0cb0 \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0c85\u0ca5\u0cb5\u0cbe PAN \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1. \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0c9a\u0cbe\u0cb2\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0c9c\u0ccb\u0ca1\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",login:"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd",signUp:"\u0ca8\u0ccb\u0c82\u0