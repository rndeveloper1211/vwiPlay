0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u09b0 \u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u09c1\u09a8","Yourself, bank security cheque":"\u0986\u09aa\u09a8\u09bf, \u09ac\u09cd\u09af\u09be\u0982\u0995 \u09b8\u09bf\u0995\u09bf\u0989\u09b0\u09bf\u099f\u09bf \u099a\u09c7\u0995",about_company_text_1:"Radiant Cash Management Services Limited \u09ad\u09be\u09b0\u09a4\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u0982\u0995, \u0986\u09b0\u09cd\u09a5\u09bf\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8, \u09b8\u0982\u0997\u09a0\u09bf\u09a4 \u09b0\u09bf\u099f\u09c7\u0987\u09b2 \u098f\u09ac\u0982 \u0987-\u0995\u09ae\u09be\u09b0\u09cd\u09b8 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u0997\u09a6 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u09ac\u09bf\u09b8\u09cd\u09a4\u09c3\u09a4 \u0986\u0989\u099f\u09b8\u09cb\u09b0\u09cd\u09b8\u09bf\u0982 \u099a\u09be\u09b9\u09bf\u09a6\u09be \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09c7\u0964 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf \u09aa\u09be\u0981\u099a\u099f\u09bf \u09ac\u09bf\u09ad\u09be\u0997\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ac\u09cd\u09af\u09ac\u09b8\u09be \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c7\u0964",about_company_text_2:"\u09aa\u09b0\u09bf\u09ae\u09be\u09a3\u09c7\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u0995\u09b0\u09c7, \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf \u09a8\u0997\u09a6 \u098f\u09ac\u0982 \u09ae\u09c2\u09b2\u09cd\u09af\u09ac\u09be\u09a8 \u099c\u09bf\u09a8\u09bf\u09b8\u09aa\u09a4\u09cd\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b9\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09aa\u09b0\u09bf\u09ac\u09b9\u09a8 \u09ae\u09be\u09a7\u09cd\u09af\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7, \u09af\u09c7\u09ae\u09a8 \u09a6\u09c1\u0987 \u099a\u09be\u0995\u09be\u09b0 \u09af\u09be\u09a8, \u09ad\u09be\u09a1\u09bc\u09be \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09af\u09be\u09a8 \u098f\u09ac\u0982 \u09ac\u09bf\u09b6\u09c7\u09b7\u09ad\u09be\u09ac\u09c7 \u09a4\u09c8\u09b0\u09bf \u0986\u09b0\u09cd\u09ae\u09be\u09b0\u09cd\u09a1 \u09ad\u09cd\u09af\u09be\u09a8\u0964 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf \u09a6\u09c8\u09a8\u09bf\u0995 \u09aa\u09cd\u09b0\u09be\u09af\u09bc \u09eb\u09e6\u09e6\u09e6\u2013\u09ec\u09e6\u09e6\u09e6 \u09ae\u09bf\u09b2\u09bf\u09af\u09bc\u09a8 \u099f\u09be\u0995\u09be \u0997\u09cd\u09b0\u09be\u09b9\u0995\u09a6\u09c7\u09b0 \u0995\u09be\u099b \u09a5\u09c7\u0995\u09c7 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7\u0964",about_company_text_3:"\u098f\u0987 \u09b8\u09c7\u0997\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u0985\u09a7\u09c0\u09a8\u09c7 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09b0 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b0\u09af\u09bc\u09c7\u099b\u09c7 \u09b6\u09c7\u09b7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u0995\u09be\u099b \u09a5\u09c7\u0995\u09c7 \u09a8\u0997\u09a6 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u098f\u09ac\u0982 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09b0 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be, \u098f\u09ac\u0982 \u09aa\u09b0\u09c7 \u0995\u09cd\u09b2\u09be\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u098f\u0995\u0987 \u09a6\u09bf\u09a8 \u09ac\u09be \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u0995\u09be\u09b0\u09cd\u09af\u09a6\u09bf\u09ac\u09b8\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be\u0964 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09c7 \u09af\u09c7 60,000-\u098f\u09b0 \u09ac\u09c7\u09b6\u09bf \u099f\u09be\u099a\u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f \u098f\u09ac\u0982 \u09a6\u09c7\u09b6\u09c7\u09b0 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09ac\u09cd\u09af\u09be\u0982\u0995\u09c7\u09b0 \u09ac\u09bf\u09b8\u09cd\u09a4\u09c3\u09a4 \u09a8\u09c7\u099f\u0993\u09af\u09bc\u09be\u09b0\u09cd\u0995 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09cd\u09b2\u09be\u09af\u09bc\u09c7\u09a8\u09cd\u099f\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09b6\u09c7\u09b7 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09be\u0987\u09ad\u09c7\u099f \u098f\u09ac\u0982 \u09ac\u09bf\u09a6\u09c7\u09b6\u09bf \u09ac\u09cd\u09af\u09be\u0982\u0995\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u0985\u09a8\u09a8\u09cd\u09af \u09ae\u09be\u09a8 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09be\u09ac \u0995\u09b0\u09a4\u09c7 \u09b8\u0995\u09cd\u09b7\u09ae \u0995\u09b0\u09c7\u0964",add_new_pickup_desc:"\u09aa\u09bf\u0995\u0986\u09aa \u09b8\u09ae\u09af\u09bc, \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09b8\u09cd\u09b2\u09bf\u09aa \u09ac\u09be \u09b6\u09be\u09b0\u09c0\u09b0\u09bf\u0995 \u09b8\u09cd\u09b2\u09bf\u09aa \u09a8\u09ae\u09cd\u09ac\u09b0 \u098f\u09ac\u0982 \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u09b0 \u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f \u09a5\u09c7\u0995\u09c7 \u09b8\u0982\u0997\u09c3\u09b9\u09c0\u09a4 \u0985\u09b0\u09cd\u09a5\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09b2\u09bf\u0996\u09c1\u09a8, \u098f\u099b\u09be\u09a1\u09bc\u09be\u0993 \u09b8\u09ac \u09a7\u09b0\u09a8\u09c7\u09b0 \u09a8\u09cb\u099f\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be \u09ae\u09cb\u099f \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09aa\u09c1\u09b0\u09cb\u09aa\u09c1\u09b0\u09bf \u09ae\u09bf\u09b2\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964",cash_deposit_ac_list_desc:"\u098f\u0987 \u09ab\u09be\u0982\u09b6\u09a8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 Radiant Cash Management Services Limited \u098f\u09b0 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u098f\u09ac\u0982 QR \u0995\u09cb\u09a1\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be \u09b6\u09c7\u09af\u09bc\u09be\u09b0 \u0995\u09b0\u099b\u09bf, \u09af\u09c7\u0996\u09be\u09a8\u09c7 \u0986\u09aa\u09a8\u09bf \u09a8\u0997\u09a6 \u099c\u09ae\u09be \u09a6\u09bf\u09a4\u09c7, \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09ab\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 QR \u0995\u09cb\u09a1 \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964",cash_online_deposit_desc:"\u098f\u0987 \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f\u09c7, RCE \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0995\u09cd\u09af\u09be\u09b6 \u0995\u09be\u0989\u09a8\u09cd\u099f\u09be\u09b0\u09c7 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u0985\u09b0\u09cd\u09a5, \u0995\u09cd\u09af\u09be\u09b6 \u09a1\u09bf\u09aa\u09cb\u099c\u09bf\u099f \u09ae\u09c7\u09b6\u09bf\u09a8\u09c7 (CDM) \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u0985\u09b0\u09cd\u09a5 \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u0985\u09a8\u09b2\u09be\u0987\u09a8 \u09ae\u09cb\u09a1\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09bf\u09a4 \u0985\u09b0\u09cd\u09a5 \u09a6\u09c7\u0996\u09be \u09af\u09be\u09ac\u09c7\u0964",cash_pickup_prepay_desc:"RCE \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f \u09a5\u09c7\u0995\u09c7 \u0985\u09b0\u09cd\u09a5 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09ac\u09be \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09be \u09b9\u09af\u09bc, \u09af\u09c7\u09ad\u09be\u09ac\u09c7\u0987 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09a4\u09c7 \u0985\u09b0\u09cd\u09a5 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09cb\u0995 \u09a8\u09be \u0995\u09c7\u09a8, \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f-\u09a1\u09c7\u09ac\u09bf\u099f \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f \u098f\u0987 \u0996\u09be\u09a4\u09be\u09af\u09bc \u09a5\u09be\u0995\u09ac\u09c7\u0964",cash_pickup_report_desc:"\u098f\u0987 \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f\u09c7 RC \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09b8\u0982\u0997\u09c3\u09b9\u09c0\u09a4 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09ac\u09bf\u09ac\u09b0\u09a3 \u09a5\u09be\u0995\u09ac\u09c7, RCE \u09a1\u09bf\u099c\u09bf\u099f\u09be\u09b2 \u09b8\u09cd\u09b2\u09bf\u09aa \u09ac\u09be \u09b6\u09be\u09b0\u09c0\u09b0\u09bf\u0995 \u09b8\u09cd\u09b2\u09bf\u09aa\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0995\u09b0\u09c7\u099b\u09c7 \u0995\u09bf\u09a8\u09be\u0964","click on \"Resend Button\"":"\"\u09aa\u09c1\u09a8\u0983\u09aa\u09cd\u09b0\u09c7\u09b0\u09a3 \u09ac\u09be\u099f\u09a8\u09c7\" \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8",company_docs_deposit_desc:"\u09ac\u09cd\u09af\u09be\u0982\u0995\u09c7 \u09a8\u0997\u09a6 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09b0 \u0995\u09bf\u099b\u09c1 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3 \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7, \u09af\u09c7\u09ae\u09a8 PAN \u0995\u09be\u09b0\u09cd\u09a1, \u09af\u09be \u09ac\u09c7\u09b6\u09bf\u09b0\u09ad\u09be\u0997 \u09ac\u09cd\u09af\u09be\u0982\u0995\u09c7 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u0995\u09bf\u099b\u09c1 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u099a\u09be\u0987\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7, \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u098f\u0996\u09be\u09a8\u09c7 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c1\u09a8\u0964",deposit_slip_cms_desc:"\u0995\u09bf\u099b\u09c1 \u09ac\u09cd\u09af\u09be\u0982\u0995\u09c7 \u0985\u09b0\u09cd\u09a5 \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09b2\u09be\u09a6\u09be \u09a1\u09bf\u09aa\u09cb\u099c\u09bf\u099f \u09b8\u09cd\u09b2\u09bf\u09aa \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u098f\u0987 \u09ac\u09cd\u09af\u09be\u0982\u0995\u0997\u09c1\u09b2\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09b8\u09ac \u09b8\u09cd\u09b2\u09bf\u09aa \u098f\u0996\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u09a1\u09be\u0989\u09a8\u09b2\u09cb\u09a1 \u0995\u09b0\u09c7 \u09aa\u09cd\u09b0\u09bf\u09a8\u09cd\u099f (Print Slip) \u0995\u09b0\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",error_occurred_try_later:"\u098f\u0995\u099f\u09bf \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u0998\u099f\u09c7\u099b\u09c7, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8",failed_title:"\u09ac\u09cd\u09af\u09b0\u09cd\u09a5","ifsc code..":"IFSC \u0995\u09cb\u09a1..",pay_picked_dues_desc:"\u098f\u0987 \u09ab\u09be\u0982\u09b6\u09a8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7, \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09be \u09aa\u09bf\u0995\u0986\u09aa \u09b8\u09cd\u09b2\u09bf\u09aa \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09a4\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09bf\u09a4 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u09a4\u09be\u09b2\u09bf\u0995\u09be \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964 \u098f\u0987 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0986\u09b2\u09be\u09a6\u09be\u09ad\u09be\u09ac\u09c7 \u09ac\u09be \u098f\u0995\u09b8\u09be\u09a5\u09c7 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",payout_note:"\u09af\u0996\u09a8 \u0995\u09ae\u09bf\u09b6\u09a8 \u09a8\u09cd\u09af\u09c2\u09a8\u09a4\u09ae \u0997\u09cd\u09af\u09be\u09b0\u09be\u09a8\u09cd\u099f\u09bf\u09af\u09c1\u0995\u09cd\u09a4 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3\u09c7\u09b0 \u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09c7\u09b6\u09bf \u09b9\u09af\u09bc \u09a4\u0996\u09a8 \u098f\u099f\u09bf \u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af\u0964 \u0986\u09aa\u09a8\u09bf \u09af\u09be \u09ac\u09c7\u09b6\u09bf \u09aa\u09be\u09ac\u09c7\u09a8 \u2014 \u09a8\u09cd\u09af\u09c2\u09a8\u09a4\u09ae \u0997\u09cd\u09af\u09be\u09b0\u09be\u09a8\u09cd\u099f\u09bf\u09af\u09c1\u0995\u09cd\u09a4 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09ac\u09be \u0995\u09ae\u09bf\u09b6\u09a8\u0964",pickup_deposit_ledger_desc:"RCE \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09af\u09bc\u09c7\u09a8\u09cd\u099f \u09a5\u09c7\u0995\u09c7 \u0985\u09b0\u09cd\u09a5 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09ac\u09be \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09be \u09b9\u09af\u09bc, \u09af\u09c7\u09ad\u09be\u09ac\u09c7\u0987 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09a4\u09c7 \u0985\u09b0\u09cd\u09a5 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09cb\u0995 \u09a8\u09be \u0995\u09c7\u09a8, \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f-\u09a1\u09c7\u09ac\u09bf\u099f \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f \u098f\u0987 \u0996\u09be\u09a4\u09be\u09af\u09bc \u09a5\u09be\u0995\u09ac\u09c7\u0964",please_check_your_internet_connection:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u09a8\u09cd\u099f\u09be\u09b0\u09a8\u09c7\u099f \u09b8\u0982\u09af\u09cb\u0997 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8",req_civil:"\u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09b0\u09cd\u09a5\u09bf\u0995 \u0995\u09cd\u09b0\u09c7\u09a1\u09bf\u099f \u09b8\u09cd\u0995\u09cb\u09b0 (\u09b8\u09bf\u09ad\u09bf\u09b2 \u09b8\u09cd\u0995\u09cb\u09b0) \u09aa\u09cd\u09b0\u09be\u09af\u09bc \u09ec\u09ed\u09e6-\u098f\u09b0 \u0989\u09aa\u09b0\u09c7 \u09b0\u09be\u0996\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u098f\u099f\u09bf \u09a8\u09be \u09a5\u09be\u0995\u09c7, \u0986\u09aa\u09a8\u09bf \u09af\u09cb\u0997\u09cd\u09af \u09a8\u09a8\u0964",req_collection:"\u0986\u09aa\u09a8\u09bf \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09b8\u09cd\u099f\u09cb\u09b0 \u09ac\u09be \u0985\u09ab\u09bf\u09b8 \u09a5\u09c7\u0995\u09c7 \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09b8\u09ae\u09af\u09bc\u09c7 \u0985\u09b0\u09cd\u09a5 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 \u098f\u09ac\u0982 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09be \u0985\u09b0\u09cd\u09a5 \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09b8\u09ae\u09af\u09bc\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09a1\u09bf\u09aa\u09cb\u099c\u09bf\u099f \u09ac\u09be \u0985\u09a8\u09b2\u09be\u0987\u09a8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0995\u09cb\u09ae\u09cd\u09aa\u09be\u09a8\u09bf\u09a4\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09af\u09a6\u09bf \u09b9\u09cd\u09af\u09be\u0981, \u09a4\u09ac\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u099f\u09bf \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",req_criminal:"\u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09b0\u0995\u09cd\u09a4 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7\u09b0 \u0985\u09a8\u09cd\u09af \u09b8\u09a6\u09b8\u09cd\u09af\u09c7\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u0995\u09cb\u09a8\u09cb \u0985\u09aa\u09b0\u09be\u09a7\u09ae\u09c2\u09b2\u0995 \u09b0\u09c7\u0995\u09b0\u09cd\u09a1 \u09a5\u09be\u0995\u09c7, \u0995\u09cb\u09a8 \u0985\u09aa\u09b0\u09be\u09a7\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a6\u09a3\u09cd\u09a1\u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4 \u09b9\u09a8, \u09aa\u09c1\u09b2\u09bf\u09b6 \u0987\u09a4\u09bf\u09b9\u09be\u09b8 \u09a5\u09be\u0995\u09c7, \u09a4\u09ac\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u0987 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09af\u09cb\u0997\u09cd\u09af \u09ac\u09bf\u09ac\u09c7\u099a\u09bf\u09a4 \u09b9\u09ac\u09c7\u09a8 \u09a8\u09be\u0964",req_indian:"\u0986\u09aa\u09a8\u09bf \u098f\u0995\u099c\u09a8 \u09ad\u09be\u09b0\u09a4\u09c0\u09af\u09bc \u09a8\u09be\u0997\u09b0\u09bf\u0995 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 KYC \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f, \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u098f\u09ac\u0982 \u099a\u09c7\u0995\u09ac\u09c1\u0995 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964",req_population:"\u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09b8\u09ac\u09be\u09b8\u09c7\u09b0 \u09b8\u09cd\u09a5\u09be\u09a8\u09c7 \u09e7\u09e6,\u09e6\u09e6\u09e6 \u098f\u09b0 \u09ac\u09c7\u09b6\u09bf \u099c\u09a8\u09b8\u0982\u0996\u09cd\u09af\u09be \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964",req_travel:"\u0986\u09aa\u09a8\u09bf \u09ad\u09cd\u09b0\u09ae\u09a3 \u0995\u09b0\u09a4\u09c7 \u09b6\u09be\u09b0\u09c0\u09b0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09b8\u0995\u09cd\u09b7\u09ae \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09af\u09be\u09a8\u09ac\u09be\u09b9\u09a8 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964",search_by_amount:"\u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8",selfie_pending_msg:"\u09b8\u09c7\u09b2\u09ab\u09bf \u09af\u09be\u099a\u09be\u0987 \u09ae\u09c1\u09b2\u09a4\u09c1\u09ac\u09bf \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u099f\u09bf\u09ae\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09ac\u09be\u099f\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964",set_additional_pin_desc:"\u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u099c\u09b8\u09cd\u09ac \u09aa\u09bf\u09a8 \u0995\u09cb\u09a1 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u0995\u09c1\u09ae\u09c7\u09a8\u09cd\u099f \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u0989\u09aa\u09b0\u09c7 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u0985\u09a8\u09cd\u09af \u09aa\u09bf\u09a8 \u0995\u09cb\u09a1 \u098f\u09b2\u09be\u0995\u09be\u09af\u09bc \u0995\u09be\u099c \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, 'ADD New' \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c7 \u09b8\u09b0\u09cd\u09ac\u09be\u09a7\u09bf\u0995 \u09ea\u099f\u09bf \u09aa\u09bf\u09a8 \u0995\u09cb\u09a1 \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964",successfully_title:"\u09b8\u09ab\u09b2\u09ad\