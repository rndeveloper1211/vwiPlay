\u092f\u094b \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0947\u0902",key_pleaseall_63:"\u0915\u0943\u092a\u092f\u093e '\u0905\u091c\u094d\u091e\u093e\u0924 \u0910\u092a\u094d\u0938 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902' \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902\u0964","Please check if the device is connected":"\u0915\u0943\u092a\u092f\u093e \u091c\u093e\u0902\u091a\u0947\u0902 \u0915\u093f \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902","Please check if the device is connected.":"\u0915\u0943\u092a\u092f\u093e \u091c\u093e\u0902\u091a\u0947\u0902 \u0915\u093f \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0928\u0947\u0915\u094d\u091f \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902",key_pleaseche_64:"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u092e\u0942\u0932\u094d\u092f\u0935\u0930\u094d\u0917 \u0915\u0947 \u0915\u0941\u0932 \u092f\u094b\u0917 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928: \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0947\u0902","Please click on the":"\u0915\u0943\u092a\u092f\u093e","Please complete all fields":"\u0915\u0943\u092a\u092f\u093e \u0938\u092d\u0940 \u092b\u093c\u0940\u0932\u094d\u0921 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0947\u0902",key_pleasecom_65:"\u0915\u0943\u092a\u092f\u093e \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u093f\u0924 \u0932\u094b\u0915\u0947\u0936\u0928 \u0915\u0947 100 \u092e\u0940\u091f\u0930 \u0915\u0947 \u092d\u0940\u0924\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u0940 \u0915\u0930\u0947\u0902\u0964","Please confirm details":"\u0915\u0943\u092a\u092f\u093e \u092c\u0949\u0915\u094d\u0938 \u0915\u094b \u091a\u0947\u0915 \u0915\u0930\u0915\u0947 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \u0915\u093f \u0935\u093f\u0935\u0930\u0923 \u0938\u0939\u0940 \u0939\u0948\u0902\u0964",key_pleaseena_66:"\u0915\u0943\u092a\u092f\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947 \u0938\u094d\u0925\u093e\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902",key_pleaseens_67:"\u0915\u0943\u092a\u092f\u093e \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0915\u093f \u0938\u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u092b\u093c\u0940\u0932\u094d\u0921 \u092d\u0930\u0947 \u0917\u090f \u0939\u0948\u0902\u0964","Please enter OTP":"\u0915\u0943\u092a\u092f\u093e \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please enter UTR number":"\u0915\u0943\u092a\u092f\u093e \u092f\u0942\u091f\u0940\u0906\u0930 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please enter a valid Aadhar Card number.":"\u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u0935\u0948\u0927 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter a valid PAN Card number.":"\u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u0935\u0948\u0927 \u092a\u0948\u0928 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",key_pleaseent_68:"\u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u0935\u0948\u0927 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092f\u093e \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter a valid pin code":"\u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u092e\u093e\u0928\u094d\u092f \u092a\u093f\u0928 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please enter amount and transaction pin.":"\u0915\u0943\u092a\u092f\u093e \u0930\u093e\u0936\u093f \u0914\u0930 \u0932\u0947\u0928-\u0926\u0947\u0928 \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964","Please enter an amount":"\u0915\u0943\u092a\u092f\u093e \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",key_pleaseent_69:"\u0915\u0943\u092a\u092f\u093e \u20b9 1 \u0938\u0947 \u20b9 100000 \u0915\u0947 \u092c\u0940\u091a \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",key_pleaseent_70:"\u0915\u0943\u092a\u092f\u093e \u20b9 200 \u0938\u0947 \u20b9 5000 \u0915\u0947 \u092c\u0940\u091a \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",key_pleaseent_71:"\u0915\u0943\u092a\u092f\u093e \u20b9 5000 \u0938\u0947 \u20b9 50000 \u0915\u0947 \u092c\u0940\u091a \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please enter mobile number":"\u0915\u0943\u092a\u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please enter valid OTP":"\u0915\u0943\u092a\u092f\u093e \u092e\u093e\u0928\u094d\u092f \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please enter valid mobile number":"\u0915\u0943\u092a\u092f\u093e \u092e\u093e\u0928\u094d\u092f \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",key_pleasefil_72:"\u0915\u0943\u092a\u092f\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u092d\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092d\u0930\u0947\u0902\u0964",key_pleasefil_73:"\u0915\u0943\u092a\u092f\u093e \u0938\u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u092b\u093c\u0940\u0932\u094d\u0921 \u092d\u0930\u0947\u0902","Please fill all the wallet details.":"\u0915\u0943\u092a\u092f\u093e \u0935\u0949\u0932\u0947\u091f \u0915\u0940 \u0938\u092d\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092d\u0930\u0947\u0902\u0964","Please fill in all required fields.":"\u0915\u0943\u092a\u092f\u093e \u0938\u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u092b\u093c\u0940\u0932\u094d\u0921 \u092d\u0930\u0947\u0902\u0964",key_pleasefin_74:"\u0915\u0943\u092a\u092f\u093e \u0938\u0902\u0932\u0917\u094d\u0928 \u0932\u0947\u0928-\u0926\u0947\u0928 \u0935\u093f\u0935\u0930\u0923 \u0926\u0947\u0916\u0947\u0902\u0964",key_pleasefir_75:"\u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u0905\u092a\u0928\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u092b\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f \u0938\u094d\u0915\u0948\u0928\u0930 \u0921\u093f\u0935\u093e\u0907\u0938 (Morpho, Mantra, Startek) \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u0947\u0902\u0964",key_pleasegra_85:"\u0915\u0943\u092a\u092f\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947 \u0915\u0948\u092e\u0930\u093e \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902\u0964","Please match the number of":"\u0915\u0943\u092a\u092f\u093e","Please provide a valid amount":"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u0930\u093e\u0936\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902","Please select Received.":"\u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u091a\u0941\u0928\u0947\u0902\u0964","Please select Remark.":"\u0915\u0943\u092a\u092f\u093e \u091f\u093f\u092a\u094d\u092a\u0923\u0940 \u091a\u0941\u0928\u0947\u0902\u0964",key_pleasesel_77:"\u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u0935\u0948\u0927 \u092c\u0948\u0915 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u091b\u0935\u093f \u091a\u0941\u0928\u0947\u0902\u0964",key_pleasesel_78:"\u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u0935\u0948\u0927 \u0930\u0926\u094d\u0926 \u091a\u0947\u0915 \u091b\u0935\u093f \u091a\u0941\u0928\u0947\u0902\u0964",key_pleasesel_79:"\u0915\u0943\u092a\u092f\u093e \u090f\u0915 \u0935\u0948\u0927 \u092b\u094d\u0930\u0902\u091f \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u091b\u0935\u093f \u091a\u0941\u0928\u0947\u0902\u0964","Please select a valid PAN Card Image.":"