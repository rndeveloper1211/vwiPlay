e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092f\u093e \u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",Mobile_Email:"\u092e\u094b\u092c\u093e\u0907\u0932/\u0908\u092e\u0947\u0932",Home_Screen:"\u0939\u094b\u092e \u0938\u094d\u0915\u094d\u0930\u0940\u0928",Close_View:"\u0935\u094d\u092f\u0942 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902",key_youarecu_128:"\u0906\u092a \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0915\u0938\u094d\u091f\u092e\u0930 \u0938\u0947\u0902\u091f\u0930 \u0915\u0947 \u091c\u093f\u092f\u094b\u092b\u0947\u0902\u0938\u093f\u0902\u0917 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u0939\u092e \u0906\u092a\u0915\u094b \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0947 \u0938\u0915\u0924\u0947",What_can_be_the_solution:"\u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u094d\u092f\u093e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948?",key_ifyoua_129:"1. \u092f\u0926\u093f \u0906\u092a \u0938\u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0939\u0948\u0902, \u0924\u094b \u0905\u092a\u0928\u093e \u0917\u0942\u0917\u0932 \u0932\u094b\u0915\u0947\u0936\u0928 \u091a\u093e\u0932\u0942 \u092f\u093e \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0947\u0902",key_ifyoua_130:"2. \u092f\u0926\u093f \u0906\u092a \u092c\u093e\u0939\u0930 \u0939\u0948\u0902, \u0924\u094b \u091c\u093f\u092f\u094b\u092b\u0947\u0902\u0938 \u0915\u0947 \u0905\u0902\u0926\u0930 \u091c\u093e\u090f\u0902\u0964 \u092f\u0926\u093f \u0906\u092a \u092c\u0939\u0941\u0924 \u0915\u0930\u0940\u092c \u0939\u0948\u0902 \u0932\u0947\u0915\u093f\u0928 \u0905\u0902\u0926\u0930 \u0928\u0939\u0940\u0902, \u0924\u094b \u0905\u0902\u0926\u0930 \u091c\u093e\u0915\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902",key_turnon_131:"3. \u0917\u0942\u0917\u0932 \u0932\u094b\u0915\u0947\u0936\u0928 \u090f\u0915\u094d\u092f\u0942\u0930\u0947\u0938\u0940 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964 \u0907\u0938\u0938\u0947 \u092f\u0939 \u0938\u0941\u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u094b\u0917\u093e \u0915\u093f \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0915\u094b \u0938\u092c\u0938\u0947 \u0938\u091f\u0940\u0915 \u0938\u094d\u0925\u093e\u0928 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092e\u093f\u0932 \u0930\u0939\u0940 \u0939\u0948",key_ifthere_132:"4. \u092f\u0926\u093f \u0915\u094b\u0908 \u0905\u0928\u094d\u092f \u0938\u092e\u0938\u094d\u092f\u093e \u0939\u0948, \u0924\u094b \u0915\u0938\u094d\u091f\u092e\u0930 \u0938\u0930\u094d\u0935\u093f\u0938 \u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0947\u0902",I_Understood:"\u092e\u0948\u0902 \u0938\u092e\u091d \u0917\u092f\u093e",Extremely_Important:"\u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923",Sorry_you_cannot_accept_new_payment_from_Customer_Point_without_police_verification_PVC:"\u0915\u094d\u0937\u092e\u093e \u0915\u0930\u0947\u0902, \u0906\u092a \u092a\u0941\u0932\u093f\u0938 \u0935\u0947\u0930\u093f\u092b\u093f\u0915\u0947\u0936\u0928 (PVC) \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u0938\u094d\u091f\u092e\u0930 \u092a\u0949\u0907\u0902\u091f \u0938\u0947 \u0928\u092f\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0947",But_this_is_optional_for_the_customer_you_can_continue_further:"\u0932\u0947\u0915\u093f\u0928 \u0917\u094d\u0930\u093e\u0939\u0915 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0939\u0948, \u0906\u092a \u0906\u0917\u0947 \u091c\u093e\u0930\u0940 \u0930\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902",Police_verification_is_mandatory_Please_do_the_verific