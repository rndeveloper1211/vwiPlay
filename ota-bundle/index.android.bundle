:"\u0c2a\u0c02\u0c2a\u0c3f\u0c28\u0c35\u0c3e\u0c30\u0c41","Sender Name:":"\u0c2a\u0c02\u0c2a\u0c3f\u0c28\u0c35\u0c3e\u0c30\u0c3f \u0c2a\u0c47\u0c30\u0c41:","Spent: \u20b9":"\u0c16\u0c30\u0c4d\u0c1a\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02: \u20b9","State Bank Of India":"\u0c38\u0c4d\u0c1f\u0c47\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c06\u0c2b\u0c4d \u0c07\u0c02\u0c21\u0c3f\u0c2f\u0c3e","Status:":"\u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f (Status):","To Date:":"\u0c2e\u0c41\u0c17\u0c3f\u0c02\u0c2a\u0c41 \u0c24\u0c47\u0c26\u0c40:","Tokens No:":"\u0c1f\u0c4b\u0c15\u0c46\u0c28\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d:","Total Receipt":"\u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c30\u0c38\u0c40\u0c26\u0c41","Transaction Date:":"\u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c24\u0c47\u0c26\u0c40:","Transaction Status:":"\u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f:","Try a different search term":"\u0c2e\u0c30\u0c4b \u0c2a\u0c26\u0c02\u0c24\u0c4b \u0c35\u0c46\u0c24\u0c15\u0c02\u0c21\u0c3f","Try adjusting the date range or filters.":"\u0c24\u0c47\u0c26\u0c40 \u0c2a\u0c30\u0c3f\u0c27\u0c3f \u0c32\u0c47\u0c26\u0c3e \u0c2b\u0c3f\u0c32\u0c4d\u0c1f\u0c30\u0c4d\u0c32\u0c28\u0c41 \u0c2e\u0c3e\u0c30\u0c4d\u0c1a\u0c3f \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.","UTR No:":"UTR \u0c28\u0c02\u0c2c\u0c30\u0c4d:","VPA:":"VPA:","Your Version: V":"\u0c2e\u0c40 \u0c35\u0c46\u0c30\u0c4d\u0c37\u0c28\u0c4d: V","Your wallet balance is short by \u20b9":"\u0c2e\u0c40 \u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c32\u0c46\u0c28\u0c4d\u0c38\u0c4d\u200c\u0c32\u0c4b \u20b9 \u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35\u0c17\u0c3e \u0c09\u0c02\u0c26\u0c3f"}},1085,[]);
__d(function(e,a,t,o,n,i,r){n.exports={SP1:"IMPS (\u0987\u09ae\u09bf\u09a1\u09bf\u09af\u09bc\u09c7\u099f \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09b8\u09be\u09b0\u09cd\u09ad\u09bf\u09b8) \u098f\u09ac\u0982 NEFT (\u09a8\u09cd\u09af\u09be\u09b6\u09a8\u09be\u09b2 \u0987\u09b2\u09c7\u0995\u099f\u09cd\u09b0\u09a8\u09bf\u0995 \u09ab\u09be\u09a8\u09cd\u09a1 \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09ab\u09be\u09b0) \u098f\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09b8\u09c7\u09b2\u09cd\u09ab \u09aa\u09c7\u0986\u0989\u099f\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u099f\u09be\u0995\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",SP2:"\u0987-\u0995\u09c7\u0993\u09af\u09bc\u09be\u0987\u09b8\u09bf (e-KYC) \u09b0\u09c7\u099c\u09bf\u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09b6\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09ad\u09cb\u0997\u09c0\u09b0 \u0995\u09be\u099b \u09a5\u09c7\u0995\u09c7 \u20b910.00 \u099a\u09be\u09b0\u09cd\u099c \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7\u0964",SP3:"\u0995\u09cb\u09a8\u09cb \u0995\u09be\u09b0\u09a3\u09c7 \u09ad\u09c1\u09b2 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09bf\u09a4 \u0985\u09b0\u09cd\u09a5 \u09ab\u09c7\u09b0\u09a4 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7 \u09a8\u09be \u09ac\u09be \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u09a8\u09be\u0964 \u099f\u09be\u0995\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09c7\u09b0 \u0986\u0997\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a8\u09ae\u09cd\u09ac\u09b0 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8\u0964",SP4:"\u09b8\u09c7\u09b2\u09cd\u09ab-\u09aa\u09c7 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u0996\u09c1\u099a\u09b0\u09be \u09ac\u09bf\u0995\u09cd\u09b0\u09c7\u09a4\u09be\u09b0 \u09a8\u09bf\u099c\u09b8\u09cd\u09ac \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09af\u09bc\u09bf\u0995 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09ae\u09a8\u09c7 \u09b0\u09be\u0996\u09ac\u09c7\u09a8 \u09af\u09c7 \u098f\u099f\u09bf \u09a1\u09bf\u098f\u09ae\u099f\u09bf (DMT) \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09af\u09be\u09ac\u09c7 \u09a8\u09be\u0964 \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u0995\u09cb\u09a8\u09cb \u09aa\u0995\u09cd\u09b7\u0995\u09c7 \u099f\u09be\u0995\u09be \u09aa\u09be\u09a0\u09be\u09a8, \u09a4\u09ac\u09c7 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be\u09b0 \u0995\u09be\u09b0\u09a3\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09ad\u09cb\u0997\u09c0\u09b0 \u09b8\u09a0\u09bf\u0995 \u0995\u09c7\u0993\u09af\u09bc\u09be\u0987\u09b8\u09bf (KYC) \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964",SP5:"\u09af\u09a6\u09bf \u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09ae\u09c1\u09b2\u09a4\u09c1\u09ac\u09bf \u09a5\u09be\u0995\u09c7, \u09a4\u09ac\u09c7 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09a6\u09c1\u0987 \u0995\u09be\u09b0\u09cd\u09af\u09a6\u09bf\u09ac\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u099f\u09bf \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964",SP6:"\u098f\u0987 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u099f\u09bf \u098f\u0995\u099f\u09bf \u09ae\u09cd\u09af\u09be\u09a8\u09c1\u09af\u09bc\u09be\u09b2 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u098f\u09ac\u0982 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09b8\u09ab\u09b2 \u09b9\u09a4\u09c7 \u09e9\u09e6 \u09ae\u09bf\u09a8\u09bf\u099f \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09ae\u09af\u09bc \u09b2\u09be\u0997\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",D1:"IMPS (\u0987\u09ae\u09bf\u09a1\u09bf\u09af\u09bc\u09c7\u099f \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09b8\u09be\u09b0\u09cd\u09ad\u09bf\u09b8) \u098f\u09ac\u0982 NEFT (\u09a8\u09cd\u09af\u09be\u09b6\u09a8\u09be\u09b2 \u0987\u09b2\u09c7\u0995\u099f\u09cd\u09b0\u09a8\u09bf\u0995 \u09ab\u09be\u09a8\u09cd\u09a1 \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09ab\u09be\u09b0) \u098f\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0997\u09cd\u09b0\u09be\u09b9\u0995\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u099f\u09be\u0995\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",D2:"\u0987-\u0995\u09c7\u0993\u09af\u09bc\u09be\u0987\u09b8\u09bf (e-KYC) \u09b0\u09c7\u099c\u09bf\u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09b6\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09ad\u09cb\u0997\u09c0\u09b0 \u0995\u09be\u099b \u09a5\u09c7\u0995\u09c7 \u20b910.00 \u099a\u09be\u09b0\u09cd\u099c \u09a8\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7\u0964",D3:"\u0995\u09cb\u09a8\u09cb \u0995\u09be\u09b0\u09a3\u09c7 \u09ad\u09c1\u09b2 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09bf\u09a4 \u0985\u09b0\u09cd\u09a5 \u09ab\u09c7\u09b0\u09a4 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7 \u09a8\u09be \u09ac\u09be \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u09a8\u09be\u0964 \u099f\u09be\u0995\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09c7\u09b0 \u0986\u0997\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a8\u09ae\u09cd\u09ac\u09b0 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8\u0964",D4:"\u09a1\u09ae\u09c7\u09b8\u09cd\u099f\u09bf\u0995 \u09ae\u09be\u09a8\u09bf \u099f\u09cd\u09b0\u09be\u09a8\u09cd\u09b8\u09ab\u09be\u09b0 (DMT) \u098f\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u098f\u0995\u099c\u09a8 \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7 \u20b95,000 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09ad\u09cb\u0997\u09c0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf \u09ae\u09be\u09b8\u09c7 \u09b8\u09b0\u09cd\u09ac\u09cb\u099a\u09cd\u099a \u20b925,000 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09aa\u09be\u09a0\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",D5:"\u09af\u09a6\u09bf \u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09ae\u09c1\u09b2\u09a4\u09c1\u09ac\u09bf \u09a5\u09be\u0995\u09c7, \u09a4\u09ac\u09c7 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09a6\u09c1\u0987 \u0995\u09be\u09b0\u09cd\u09af\u09a6\u09bf\u09ac\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u099f\u09bf \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964",D6:"\u09a8\u09a4\u09c1\u09a8 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be \u0985\u09a8\u09c1\u09b8\u09be\u09b0\u09c7, \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09ad\u09cb\u0997\u09c0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be\u09ae\u09c2\u09b2\u0995\u0964 \u09b8\u09c1\u09ac\u09bf\u09a7\u09be\u09ad\u09cb\u0997\u09c0\u0995\u09c7 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u098f\u0987 \u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa\u0997\u09c1\u09b2\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7: \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u09e7\u09e6-\u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09aa\u09cd\u09b0\u09c7\u09b0\u0995\u09c7\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09b2\u09bf\u0996\u09c1\u09a8 > \u0993\u099f\u09bf\u09aa\u09bf (\u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u0995\u09be\u09b0\u09c0 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09c7\u09b0\u09bf\u09a4) \u09b2\u09bf\u0996\u09c1\u09a8 > \u0986\u09a7\u09be\u09b0 \u0995\u09be\u09b0\u09cd\u09a1 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09b2\u09bf\u0996\u09c1\u09a8 > \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u0986\u0999\u09c1\u09b2\u09c7\u09b0 \u099b\u09be\u09aa \u09b8\u09cd\u0995\u09cd\u09af\u09be\u09a8 \u0995\u09b0\u09c1\u09a8\u0964",D7:"\u098f\u0995\u09ac\u09be\u09b0 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09ae\u09c1\u09b2\u09a4\u09c1\u09ac\u09bf \u09a5\u09be\u0995\u09b2\u09c7, OTP \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u09a8\u09be \u0995\u09b0\u09c7 \u09a4\u09be \u099c\u09ae\u09be \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09af\u09be\u09ac\u09c7 \u09a8\u09be (OTP \u09aa\u09cd\u09b0\u09c7\u09b0\u0995\u09c7\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09ae\u09cd\u09ac\u09b0\u09c7 \u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u09ac\u09c7)\u0964",PPI1:"IMPS, NEFT \u098f\u09ac\u0982 UPI \u098f\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0997\u09cd\u09b0\u09be\u09b9\u0995\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u099f\u09be\u0995\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964",PPI2:"\u09af\u09c7\u0995\u09cb\u09a8\u09cb \u0995\u09be\u09b0\u09a3\u09c7, \u09ad\u09c1\u09b2 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09be \u099f\u09be\u0995\u09be \u09ab\u09c7\u09b0\u09a4 \u09a6\u09c7\u0993\u09df\u09be \u09b9\u09ac\u09c7 \u09a8\u09be \u09ac\u09be \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u0993 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u09a8\u09be\u0964 \u099f\u09be\u0995\u09be \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0 \u0995\u09b0\u09be\u09b0 \u0986\u0997\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09a8\u09ae\u09cd\u09ac\u09b0\u099f\u09bf \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8\u0964",PPI3:"\u09af\u09a6\u09bf \u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09ae\u09c1\u09b2\u09a4\u09c1\u09ac\u09bf \u09a5\u09be\u0995\u09c7, \u09a4\u09ac\u09c7 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09a6\u09c1\u0987 \u0995\u09be\u09b0\u09cd\u09af\u09a6\u09bf\u09ac\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u099f\u09bf \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964",PPI4:"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u09aa\u09cd\u09b0\u09c7\u09b0\u0995\u09c7\u09b0 \u0986\u09a7\u09be\u09b0 \u09ac\u09be \u09aa\u09cd\u09af\u09be\u09a8 \u0995\u09be\u09b0\u09cd\u09a1 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09be\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u0985\u09a8\u09cd\u09af\u09a5\u09be\u09af\u09bc, \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09a7\u09be\u09b0 \u09a8\u09ae\u09cd\u09ac\u09b0 \u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u0982\u09af\u09c1\u0995\u09cd\u09a4 \u09b9\u09ac\u09c7\u0964",login:"\u09b2\u0997\u0987\u09a8",signUp:"\u09b8\u09be\u0987\u09a8 \u0986\u09aa",forgotPassword:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09ad\u09c1\u09b2\u09c7 \u0997\u09c7\u099b\u09c7\u09a8?",loginInfo:"\u09b2\u0997\u0987\u09a8 \u09a4\u09a5\u09cd\u09af",login_credentials_blank:"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u09a0\u09bf\u0995 \u0987\u0989\u099c\u09be\u09b0 \u0986\u0987\u09a1\u09bf \u098f\u09ac\u0982 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b2\u09bf\u0996\u09c1\u09a8, \u0986\u09aa\u09a8\u09bf \u098f\u099f\u09bf \u0996\u09be\u09b2\u09bf \u09b0\u09be\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\u0964",all_fields_required:"\u09b8\u09ae\u09b8\u09cd\u09a4 \u0998\u09b0 \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964",password_length_error:"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u0985\u09ac\u09b6\u09cd\u09af\u0987 \u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 \u09eb \u09b8\u0982\u0996\u09cd\u09af\u09be\u09b0 \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964",password_match_error:"\u09aa\u09be\u09b8\u09