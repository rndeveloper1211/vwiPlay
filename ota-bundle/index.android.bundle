4b\u0930\u094d\u091f \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u094d\u0925\u093e\u0928 \u0938\u0947 \u0906\u0930\u0938\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u093f\u090f \u0917\u090f \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0902\u0917\u094d\u0930\u0939 \u0915\u093e \u092a\u0942\u0930\u093e \u0935\u093f\u0935\u0930\u0923 \u0926\u0947\u0917\u0940, \u091a\u093e\u0939\u0947 \u0906\u0930\u0938\u0940\u0908 \u0928\u0947 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u0932\u093f\u092a \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u093e \u092d\u094c\u0924\u093f\u0915 \u0938\u094d\u0932\u093f\u092a \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093f\u092f\u093e \u0939\u094b\u0964",cashposh:"\u0928\u0915\u0926 \u0914\u0930 \u092a\u0949\u0936",change_language:"\u092d\u093e\u0937\u093e \u092c\u0926\u0932\u094b",change_voice_notification:"\u0935\u0949\u0907\u0938 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u092c\u0926\u0932\u0947\u0902",charges:"Charges",checklist_confirmation:"\u0939\u093e\u0901, \u092e\u0948\u0902\u0928\u0947 \u0938\u092d\u0940 \u0935\u093f\u0935\u0930\u0923\u094b\u0902 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930 \u0932\u0940 \u0939\u0948 \u0914\u0930 \u0938\u094d\u091f\u094b\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0938\u0947 \u092d\u0940 \u0907\u0938\u0947 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0935\u093e \u0932\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u0939\u0940 \u0939\u0948 \u0914\u0930 \u092e\u0948\u0902 \u0906\u0917\u0947 \u0915\u0940 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0942\u0901\u0917\u093e\u0964",choose_image_source:"\u0917\u0948\u0932\u0930\u0940 \u0938\u0947 \u091b\u0935\u093f \u091a\u0941\u0928\u0947\u0902 \u092f\u093e \u0928\u0908 \u092b\u094b\u091f\u094b \u0932\u0947\u0902",city:"\u0936\u0939\u0930","click Again Please":"\u0915\u0943\u092a\u092f\u093e \u092b\u093f\u0930 \u0938\u0947 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902","click on \"Resend Button\"":"\"\u092a\u0941\u0928\u0903 \u092d\u0947\u091c\u0947\u0902 \u092c\u091f\u0928\" \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902","click upon Resend Button":"\u092a\u0941\u0928\u0903 \u092d\u0947\u091c\u0947\u0902 \u092c\u091f\u0928 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902",close:"\u092c\u0902\u0926 \u0915\u0930\u0947\u0902",cms_ac_list_desc:"\u0928\u0940\u091a\u0947 \u0930\u0947\u0921\u093f\u092f\u0902\u091f \u0915\u0948\u0936 \u092e\u0948\u0928\u0947\u091c\u092e\u0947\u0902\u091f \u0938\u0930\u094d\u0935\u093f\u0938\u0947\u091c \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092e\u0947\u0902 \u0928\u0915\u0926 \u091c\u092e\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0916\u093e\u0924\u094b\u0902 \u0915\u0940 \u0938\u0942\u091a\u0940 \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0909\u091a\u093f\u0924 \u0916\u093e\u0924\u093e \u091a\u0941\u0928\u0947\u0902\u0964 \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0936\u093e\u0916\u093e \u0915\u093e \u091a\u092f\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u091c\u0939\u093e\u0901 \u0906\u092a\u0915\u094b \u092d\u0940\u0921\u093c \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0928 \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0947 \u0914\u0930 \u0906\u092a\u0915\u093e \u0938\u092e\u092f \u092d\u0940 \u092c\u0930\u094d\u092c\u093e\u0926 \u0928 \u0939\u094b\u0964",cms_ac_list_note:"\u0928\u0940\u091a\u0947 \u0930\u0947\u0921\u093f\u092f\u0902\u091f \u0915\u0948\u0936 \u092e\u0948\u0928\u0947\u091c\u092e\u0947\u0902\u091f \u0938\u0930\u094d\u0935\u093f\u0938\u0947\u091c \u0932\u093f\u092e\u093f\u091f\u0947\u0921 \u092e\u0947\u0902 \u0928\u0915\u0926 \u091c\u092e\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0916\u093e\u0924\u094b\u0902 \u0915\u0940 \u0938\u0942\u091a\u0940 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0940 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0909\u091a\u093f\u0924 \u0916\u093e\u0924\u0947 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964 \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0936\u093e\u0916\u093e \u0915\u093e \u091a\u092f\u0928 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u091c\u0939\u093e\u0901 \u0906\u092a\u0915\u094b \u092d\u0940\u0921\u093c \u0915\u093e \u0938\u093e\u092e\u0928\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0947\u0917\u093e \u0914\u0930 \u0906\u092a\u0915\u093e \u0938\u092e\u092f \u092d\u0940 \u092c\u0930\u094d\u092c\u093e\u0926 \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u093e\u0964",cms_checkbox_msg:"\u0939\u093e\u0901, \u092e\u0948\u0902\u0928\u0947 \u0938\u092d\u0940 \u0935\u093f\u0935\u0930\u0923\u094b\u0902 \u0915\u0940 \u091c\u093e\u0901\u091a \u0915\u0930 \u0932\u0940 \u0939\u0948 \u0914\u0930 \u0938\u094d\u091f\u094b\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0938\u0947 \u092d\u0940 \u0907\u0938\u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930 \u0932\u0940 \u0939\u0948 \u0915\u093f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u0939\u0940 \u0939\u0948 \u0914\u0930 \u092e\u0948\u0902 \u0906\u0917\u0947 \u0915\u0940 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0930\u0942\u0901\u0917\u093e\u0964",cms_status_sorry_msg:"\u0905\u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947 \u0932\u093f\u090f, \u0932\u0947\u0915\u093f\u0928 \u0917\u094d\u0930\u093e\u0939\u0915 \u092c\u093f\u0902\u0926\u0941 \u0938\u0947 \u0938\u094d\u0915\u094d\u0930\u0948\u091a \u0915\u094b\u0921 \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0905\u092d\u0940 \u0924\u0915 \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u093e\u0930\u0923\u094b\u0902 \u0938\u0947, \u091c\u092c \u0924\u0915 \u0938\u094d\u0915\u094d\u0930\u0948\u091a \u0915\u094b\u0921 \u0915\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092a\u0942\u0930\u093e \u0928\u0939\u0940\u0902 \u0939\u094b \u091c\u093e\u0924\u093e, \u0939\u092e \u0906\u092a\u0915\u094b \u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0947 \u0938\u0915\u0924\u0947\u0964 \u0915\u0943\u092a\u092f\u093e \u0917\u094d\u0930\u093e\u0939\u0915 \u092c\u093f\u0902\u0926\u0941 \u0915\u094b \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u091c\u0932\u094d\u0926 \u0938\u0947 \u091c\u0932\u094d\u0926 \u092a\u0942\u0930\u093e \u0939\u094b \u0938\u0915\u0947\u0964",cms_verify_otp_msg:"\u0915\u093e \u092e\u093f\u0932\u093e\u0928 \u0915\u0930\u0947\u0902\u0964 \u092f\u0926\u093f \u0938\u092c \u0915\u0941\u091b \u0920\u0940\u0915 \u0939\u0948, \u0924\u094b \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0915\u0947 \u0932\u0947\u0928\u0926\u0947\u0928 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902\u0964 \u0915\u0941\u0932 \u0930\u093e\u0936\u093f \u0915\u0947 \u0935\u093f\u0935\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0938\u094d\u091f\u094b\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u0913\u091f\u0940\u092a\u0940 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964",collection_agent:"\u0915\u0932\u0947\u0915\u094d\u0936\u0928 \u090f\u091c\u0947\u0902\u091f",company_docs_deposit_desc:"\u092c\u0948\u0902\u0915\u094b\u0902 \u092e\u0947\u0902 \u0928\u0915\u0926 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0902\u092a\u0928\u0940 \u0915\u0947 \u0915\u0941\u091b \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948, \u091c\u0948\u0938\u0947 \u092a\u0948\u0928 \u0915\u093e\u0930\u094d\u0921, \u091c\u094b \u0905\u0927\u093f\u0915\u093e\u0902\u0936 \u092c\u0948\u0902\u0915\u094b\u0902 \u092e\u0947\u0902 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964 \u0915\u0941\u091b \u092c\u0948\u0902\u0915 \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092d\u0940 \u092e\u093e\u0902\u0917 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092f\u0939\u093e\u0901 \u0938\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964",confirm:"\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902",confirm_password:"\u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902",consume_limit:"\u0909\u092a\u092d\u094b\u0917 \u0938\u0940\u092e\u093e",contact_info_updated_till:"\u0938\u0902\u092a\u0930\u094d\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0940 \u0917\u0908",contact_no_colon:"\u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0902\u092c\u0930:",contact_person_number_given_below:"\u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u093e \u0928\u0902\u092c\u0930 \u0928\u0940\u091a\u0947 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964",continue:"\u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",customerName:"\u0917\u094d\u0930