d":"\u0c2e\u0c40 \u0c2a\u0c3e\u0c38\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c21\u0c4d",WARNING:"\u0c39\u0c46\u0c1a\u0c4d\u0c1a\u0c30\u0c3f\u0c15","Forget Transaction":"\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c38\u0c3e\u0c15\u0c4d\u0c37\u0c28\u0c4d \u0c2a\u0c3f\u0c28\u0c4d \u0c30\u0c40\u0c38\u0c46\u0c1f\u0c4d: ",key_incorrect_51:"\u0c24\u0c2a\u0c4d\u0c2a\u0c41 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",voice_notification_title:"\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d",voice_notification_enable:"\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",voice_notification_disable:"\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c28\u0c3f\u0c32\u0c3f\u0c2a\u0c3f\u0c35\u0c47\u0c2f\u0c02\u0c21\u0c3f",ringtone_on:"\u0c30\u0c3f\u0c02\u0c17\u0c4d\u0c1f\u0c4b\u0c28\u0c4d \u0c06\u0c28\u0c4d",ringtone_off:"\u0c30\u0c3f\u0c02\u0c17\u0c4d\u0c1f\u0c4b\u0c28\u0c4d \u0c06\u0c2b\u0c4d",save_settings:"\u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u0c38\u0c4d \u0c38\u0c47\u0c35\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",test_voice:"\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c1f\u0c46\u0c38\u0c4d\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f",permission_required:"\u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c05\u0c35\u0c38\u0c30\u0c02",permission_message:"\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c15\u0c4b\u0c38\u0c02 \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c02\u0c21\u0c3f",change_voice_notification:"\u0c35\u0c3e\u0c2f\u0c3f\u0c38\u0c4d \