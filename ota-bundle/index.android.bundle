\u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a1\u09c7\u099f \u09b9\u09af\u09bc\u09c7\u099b\u09c7","Invalid response from server.":"\u09b8\u09be\u09b0\u09cd\u09ad\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \u0985\u09ac\u09c8\u09a7 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09aa\u09be\u0993\u09af\u09bc\u09be \u0997\u09c7\u099b\u09c7",Latest:"\u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7","Loading...":"\u09b2\u09cb\u09a1 \u09b9\u099a\u09cd\u099b\u09c7...","Location Required":"\u09b2\u09cb\u0995\u09c7\u09b6\u09a8 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8","Please allow location to continue.":"\u099a\u09be\u09b2\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b2\u09cb\u0995\u09c7\u09b6\u09a8 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09bf\u09a8","Mobile...":"\u09ae\u09cb\u09ac\u09be\u0987\u09b2","Net Amt":"\u09ae\u09cb\u099f \u09aa\u09b0\u09bf\u09ae\u09be\u09a3","New Update Available":"\u09a8\u09a4\u09c1\u09a8 \u0986\u09aa\u09a1\u09c7\u099f \u0989\u09aa\u09b2\u09ac\u09cd\u09a7",Note_Currently_the_beneficiary_banks_server_is_down_or_busy_please_try_after_sometime:"\u09a6\u09cd\u09b0\u09b7\u09cd\u099f\u09ac\u09cd\u09af: \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u0989\u09aa\u0995\u09be\u09b0\u09ad\u09cb\u0997\u09c0 \u09ac\u09cd\u09af\u09be\u0982\u0995\u09c7\u09b0 \u09b8\u09be\u09b0\u09cd\u09ad\u09be\u09b0 \u09a1\u09be\u0989\u09a8 \u09ac\u09be \u09ac\u09cd\u09af\u09b8\u09cd\u09a4\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0995\u09bf\u099b\u09c1 \u09b8\u09ae\u09af\u09bc \u09aa\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8","PIN should be at least 4 characters long":"PIN \u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 \u09ea \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7","PIN should be at least 6 characters long!":"PIN \u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 \u09ec \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7","Passwords should be at least 6 characters long":"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 \u09ec \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7","Payment Options":"\u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0985\u09aa\u09b6\u09a8","Please Enter Old Password !!!":"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b2\u09bf\u0996\u09c1\u09a8","Please enter the complete OTP.":"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 OTP \u09b2\u09bf\u0996\u09c1\u09a8","Please fill in all required fields.":"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u09ac \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09ab\u09bf\u09b2\u09cd\u09a1 \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8",Police_verification_is_mandatory_Please_do_the_verification_and_then_try_again:"\u09aa\u09c1\u09b2\u09bf\u09b6 \u09af\u09be\u099a\u09be\u0987 \u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be\u09ae\u09c2\u09b2\u0995\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09af\u09be\u099a\u09be\u0987 \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8","QR UPI status failed with no message.":"QR UPI \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09be\u09b8 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5 (\u0995\u09cb\u09a8 \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09a8\u09c7\u0987)","QR code has expired.":"QR \u0995\u09cb\u09a1\u09c7\u09b0 \u09ae\u09c7\u09af\u09bc\u09be\u09a6 \u09b6\u09c7\u09b7 \u09b9\u09af\u09bc\u09c7\u099b\u09c7","QR status is not OK, try again.":"QR \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09be\u09b8 \u09a0\u09bf\u0995 \u09a8\u09af\u09bc, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8",Received:"\u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4",Retailer:"\u09b0\u09bf\u099f\u09c7\u0987\u09b2\u09be\u09b0","Save Details":"\u09a4\u09a5\u09cd\u09af \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c1\u09a8","Search Name or Number":"\u09a8\u09be\u09ae \u09ac\u09be \u09a8\u09ae\u09cd\u09ac\u09b0 \u0996\u09c1\u0981\u099c\u09c1\u09a8","Security improvements":"\u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u0989\u09a8\u09cd\u09a8\u09a4\u09bf","Self UPI status failed with no message.":"Self UPI \u09b8\u09cd\u099f\u09cd\u09af\u09be\u099f\u09be\u09b8 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5 (\u0995\u09cb\u09a8 \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09a8\u09c7\u0987)",Sorry_you_cannot_accept_new_payment_from_Customer_Point_without_police_verification_PVC:"\u09a6\u09c1\u0983\u0996\u09bf\u09a4, \u09aa\u09c1\u09b2\u09bf\u09b6 \u09af\u09be\u099a\u09be\u0987 (PVC) \u099b\u09be\u09a1\u09bc\u09be \u0986\u09aa\u09a8\u09bf \u0997\u09cd\u09b0\u09be\u09b9\u0995\u09c7\u09b0 \u0995\u09be\u099b \u09a5\u09c7\u0995\u09c7 \u09a8\u09a4\u09c1\u09a8 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be",The_OTP_has_been_sent_to_the_store_contact_person:"OTP \u09b8\u09cd\u099f\u09cb\u09b0\u09c7\u09b0 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u09b0 \u0995\u09be\u099b\u09c7 \u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7","Type your reason here...":"\u098f\u0996\u09be\u09a8\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09be\u09b0\u09a3 \u09b2\u09bf\u0996\u09c1\u09a8...","UPI Failed":"UPI \u09ac\u09cd\u09af\u09b0\u09cd\u09a5","Unable to download the QR code.":"QR \u0995\u09cb\u09a1 \u09a1\u09be\u0989\u09a8\u0