ame:":"\u0916\u093e\u0924\u0947 \u0928\u093e\u0935:","A/C Number:":"\u0916\u093e\u0924\u0947 \u0915\u094d\u0930\u092e\u093e\u0902\u0915:","Bank Name:":"\u092c\u0901\u0915\u0947\u091a\u0947 \u0928\u093e\u0935:","IFSC:":"IFSC:","Branch:":"\u0936\u093e\u0916\u093e:",key_hiiams_49:"\u0939\u093e\u092f, \u092e\u0940 {appName} \u0905\u200d\u0945\u092a \u0935\u093e\u092a\u0930\u0942\u0928 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u091a\u0947 \u0924\u092a\u0936\u0940\u0932 \u0936\u0947\u0905\u0930 \u0915\u0930\u0924 \u0906\u0939\u0947.","A/C Name":"\u0916\u093e\u0924\u0947 \u0928\u093e\u0935","Branch Info":"\u0936\u093e\u0916\u093e \u092e\u093e\u0939\u093f\u0924\u0940",Merchant:"\u0935\u094d\u092f\u093e\u092a\u093e\u0930\u0940","VPA ID":"VPA ID",cms_ac_list_desc:"\u0928\u0940\u091a\u0947 Radiant Cash Management Services Limited \u092e\u0927\u0940\u0932 \u0930\u094b\u0916 \u091c\u092e\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u092a\u0932\u092c\u094d\u0927 \u0916\u093e\u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u092f\u093e\u0926\u0940 \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0906\u092a\u0932\u094d\u092f\u093e \u0938\u094b\u092f\u0940\u0938\u093e\u0920\u0940 \u092f\u094b\u0917\u094d\u092f \u0916\u093e\u0924\u0947 \u0928\u093f\u0935\u0921\u093e. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0936\u093e\u0916\u093e \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u093e \u091c\u093f\u0925\u0947 \u0917\u0930\u094d\u0926\u0940\u091a\u093e \u0938\u093e\u092e\u0928\u093e \u0915\u0930\u093e\u0935\u093e \u0932\u093e\u0917\u0923\u093e\u0930 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u093e \u0935\u0947\u0933 \u0935\u093e\u092f\u093e \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.",verification_inst_1:"\u0915\u0943\u092a\u092f\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u091c\u0941\u0933\u0935\u093e",verification_inst_2:"\u0906\u0923\u093f",verification_inst_3:". \u0938\u0930\u094d\u0935 \u0915\u093e\u0939\u0940 \u092f\u094b\u0917\u094d\u092f \u0905\u0938\u0932\u094d\u092f\u093e\u0938, OTP \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0942\u0928 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u093e.",checklist_confirmation:"\u0939\u094b\u092f, \u092e\u0940 \u0938\u0930\u094d\u0935 \u0924\u092a\u0936\u0940\u0932 \u0924\u092a\u093e\u0938\u0932\u0947 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0938\u094d\u091f\u094b\u0905\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0915\u0921\u0942\u0928 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0915\u0930\u0942\u0928 \u0918\u0947\u0924\u0932\u0940 \u0906\u0939\u0947 \u0915\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u092f\u094b\u0917\u094d\u092f \u0906\u0939\u0947 \u0906\u0923\u093f \u092e\u0940 \u092a\u0941\u0922\u0940\u0932 \u0915\u093e\u0930\u0935\u093e\u0908 \u0915\u0930\u0940\u0928.","Radiant CMS Slip Count":"Radiant CMS \u0938\u094d\u0932\u093f\u092a \u092e\u094b\u091c\u0923\u0940","Housing Tex":"\u0939\u093e\u090a\u0938\u093f\u0902\u0917 \u0915\u0930","Aadhaar Images":"\u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u0924\u093f\u092e\u093e","Cash Management Services":"\u0930\u094b\u0916 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928 \u0938\u0947\u0935\u093e","Cash Pickup":"\u0930\u094b\u0916 \u092a\u093f\u0915\u0905\u092a","From Date*":"\u0924\u093e\u0930\u0940\u0916 \u092a\u093e\u0938\u0942\u0928*","Other Qualification details":"\u0907\u0924\u0930 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0924\u092a\u0936\u0940\u0932",about_company_text_1:"Radiant Cash Management Services Limited \u092d\u093e\u0930\u0924\u093e\u0924\u0940\u0932 \u092c\u0901\u0915\u093e, \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u0902\u0938\u094d\u0925\u093e, \u0906\u092f\u094b\u091c\u093f\u0924 \u0930\u093f\u091f\u0947\u0932 \u0906\u0923\u093f \u0908-\u0915\u0949\u092e\u0930\u094d\u0938 \u0915\u0902\u092a\u0928\u094d\u092f\u093e\u0902\u0938\u093e\u0920\u0940 \u0930\u094b\u0916 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928 \u0938\u0947\u0935\u093e \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0906\u0909\u091f\u0938\u094b\u0930\u094d\u0938\u093f\u0902\u0917 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0924\u093e\u0924. \u0915\u0902\u092a\u0928\u0940 \u0906\u092a\u0932\u093e \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u092a\u093e\u091a \u0935\u093f\u092d\u093e\u0917\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u091a\u093e\u0932\u0935\u0924\u0947.",about_company_text_2:"\u0935\u0949\u0932\u094d\u092f\u0942\u092e\u0935\u0930 \u0905\u0935\u0932\u0902\u092c\u0942\u0928, \u0915\u0902\u092a\u0928\u0940 \u0930\u094b\u0916 \u0906\u0923\u093f \u092e\u094c\u0932\u094d\u092f\u0935\u093e\u0928 \u0935\u0938\u094d\u0924\u0942\u0902\u091a\u094d\u092f\u093e \u0935\u093e\u0939\u0924\u0941\u0915\u0940\u0938\u093e\u0920\u0940 \u0905\u0928\u0947\u0915 \u092a\u094d\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e \u0935\u093e\u0939\u0924\u0942\u0915 \u0938\u093e\u0927\u0928\u093e\u0902\u091a\u093e \u0935\u093e\u092a\u0930 \u0915\u0930\u0924\u0947, \u0926\u094b\u0928 \u091a\u093e\u0915\u0940 \u0935\u093e\u0939\u0928\u0902, \u092d\u093e\u0921\u094d\u092f\u093e\u0928\u0947 \u0918\u0947\u0924\u0932\u0947\u0932\u0940 \u0935\u093e\u0939\u0928\u0902 \u0906\u0923\u093f \u0935\u093f\u0936\u0947\u0937 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0947\u0932\u0940 \u0938\u0902\u0930\u0915\u094d\u0937\u0923\u093e\u0924\u094d\u092e\u0915 \u0935\u094d\u0939\u0945\u0928\u094d\u0938. \u0915\u0902\u092a\u0928\u0940 \u0930\u094b\u091c \u0938\u0941\u092e\u093e\u0930\u0947 \u20b95000 - 6000 \u0926\u0936\u0932\u0915\u094d\u0937 \u0930\u094b\u0916 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0938\u0930\u094d\u0935 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0902\u0915\u0921\u0942\u0928 \u0939\u093e\u0924\u093e\u0933\u0924\u0947.",about_company_text_3:"\u092f\u093e \u0935\u093f\u092d\u093e\u0917\u093e\u0924 \u0915\u0902\u092a\u0928\u0940 \u0938\u0947\u0935\u093e \u092e\u094d\u0939\u0923\u091c\u0947 \u090f\u0902\u0921 \u092f\u0942\u091c\u0930\u0915\u0921\u0942\u0928 \u0930\u094b\u0916 \u0917\u094b\u0933\u093e \u0915\u0930\u0942\u0928 \u0915\u0902\u092a\u0928\u0940\u091a\u094d\u092f\u093e \u091a\u093e\u0932\u0942 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091c\u092e\u093e \u0915\u0930\u0923\u0947 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u0938\u092e\u093e\u0928 \u0926\u093f\u0935\u0936\u0940 \u0915\u093f\u0902\u0935\u093e \u092a\u0941\u0922\u0940\u0932 \u0915\u093e\u0930\u094d\u092f\u0926\u093f\u0935\u0936\u0940 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930\u0923\u0947. \u0915\u0902\u092a\u0928\u0940 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0920\u0947\u0935\u0924\u0947 \u0915\u0940 60,000 \u0939\u0942\u0928 \u0905\u0927\u093f\u0915 \u091f\u091a \u092a\u0949\u0907\u0902\u091f\u094d\u0938\u091a\u0947 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0906\u0923\u093f \u0926\u0947\u0936\u092d\u0930\u093e\u0924\u0940\u0932 \u0935\u093f\u0935\u093f\u0927 \u092c\u0901\u0915\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0916\u093e\u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0906\u092e\u094d\u0939\u093e\u0932\u093e \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0902\u0928\u093e, \u0935\u093f\u0936\u0947\u0937\u0924: \u0916\u093e\u091c\u0917\u0940 \u0906\u0923\u093f \u0935\u093f\u0926\u0947\u0936\u0940 \u092c\u0901\u0915\u093e\u0902\u0928\u093e, \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0936\u093e\u0916\u093e \u0928\u0947\u091f\u0935\u0930\u094d\u0915\u0938\u0939 \u0905\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u092e\u0942\u0932\u094d\u092f \u092a\u094d\u0930\u0938\u094d\u0924\u093e\u0935 \u0926\u0947\u0923\u094d\u092f\u093e\u0938 \u092e\u0926\u0924 \u0915\u0930\u0924\u0947.",add_new_pickup_desc:"\u092a\u093f\u0915\u0905\u092a \u0935\u0947\u0933, \u0911\u0928\u0932\u093e\u0907\u0928 \u0938\u094d\u0932\u093f\u092a \u0915\u093f\u0902\u0935\u093e \u092b\u093f\u091c\u093f\u0915\u0932 \u0938\u094d\u0932\u093f\u092a \u0928\u0902\u092c\u0930 \u0906\u0923\u093f \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0915\u0921\u0942\u0928 \u0918\u0947\u0924\u0932\u0947\u0932\u094d\u092f\u093e \u091a\u0932\u0928\u093e\u091a\u0940 \u092a\u0942\u0930\u094d\u0923 \u092e\u093e\u0939\u093f\u0924\u0940 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e, \u0924\u0938\u0947\u091a \u0938\u0930\u094d\u0935 \u0928\u094b\u091f\u094d\u0938\u091a\u0940 \u0917\u0923\u0928\u093e \u090f\u0915\u0942\u0923 \u0930\u0915\u092e\u0947\u0936\u0940 \u0905\u091a\u0942\u0915 \u091c\u0941\u0933\u0932\u0940 \u092a\u093e\u0939\u093f\u091c\u0947.",cash_deposit_ac_list_desc:"\u092f\u093e \u092b\u0902\u0915\u094d\u0936\u0928\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u092e\u094d\u0939\u0940 Radiant Cash Management Services Limited \u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u0906\u0923\u093f QR \u0915\u094b\u0921\u091a\u0940 \u092f\u093e\u0926\u0940 \u0936\u0947\u0905\u0930 \u0915\u0930\u0924 \u0906\u0939\u094b\u0924, \u091c\u094d\u092f\u093e\u0924 \u0924\u0941\u092e\u094d\u0939\u0940 \u0930\u094b\u0916 \u091c\u092e\u093e, \u0911\u0928\u0932\u093e\u0907\u0928 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u0906\u0923\u093f QR \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",cash_online_deposit_desc:"\u092f\u093e \u0905\u0939\u0935\u093e\u0932\u093e\u0924, RCE \u0926\u094d\u0935\u093e\u0930\u0947 \u092c\u0901\u0915 \u0915\u0945\u0936 \u0915\u093e\u0909\u0902\u091f\u0930\u092e\u0927\u094d\u092f\u0947 \u091c\u092e\u093e \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u0948\u0938\u0947, Cash Deposit Machine (CDM) \u092e\u0927\u094d\u092f\u0947 \u091c\u092e\u093e \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u0948\u0938\u0947 \u0906\u0923\u093f \u0907\u0924\u0930 \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0911\u0928\u0932\u093e\u0907\u0928 \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u0915\u0947\u0932\u0947\u0932\u0947 \u092a\u0948\u0938\u0947 \u092a\u093e\u0939\u0924\u093e \u092f\u0947\u0924\u0940\u0932.",cash_pickup_prepay_desc:"\u0930\u0915\u094d\u0915\u092e RCE \u0926\u094d\u0935\u093e\u0930\u0947 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0915\u0921\u0942\u0928 \u092a\u093f\u0915\u0905\u092a \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947 \u0915\u093f\u0902\u0935\u093e \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0926\u093f\u0932\u094d\u092f\u093e \u091c\u093e\u0923\u093e\u0931\u094d\u092f\u093e \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u0915\u0902\u092a\u0928\u0940\u0915\u0921\u0947 \u092a\u093e\u0920\u0935\u0932\u0940 \u091c\u093e\u0924\u0947, \u092a\u0942\u0930\u094d\u0923 \u0915\u094d\u0930\u0947\u0921\u093f\u091f-\u0921\u0947\u092c\u093f\u091f \u0905\u0939\u0935\u093e\u0932 \u092f\u093e \u0932\u0947\u091c\u0930\u092e\u0927\u094d\u092f\u0947 \u0930\u093e\u0939\u0940\u0932.",cash_pickup_report_desc:"\u0939\u093e \u0905\u0939\u0935\u093e\u0932 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u091a\u094d\u092f\u093e \u0920\u093f\u0915\u093e\u0923\u093e\u0939\u0942\u0928 RC \u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u0947\u092e\u0947\u0902\u091f \u0938\u0902\u0915\u0932\u0928\u093e\u091a\u0940 \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092e\u093e\u0939\u093f\u0924\u0940 \u0926\u0947\u0908\u0932, RCE \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u094d\u0932\u093f\u092a \u0915\u093f\u0902\u0935\u093e \u092b\u093f\u091c\u093f\u0915\u0932 \u0938\u094d\u0932\u093f\u092a\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0947\u0932\u0947 \u0906\u0939\u0947 \u0915\u093e \u0924\u0947 \u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0926\u093f\u0938\u0947\u0932.","click on \"Resend Button\"":"\"Resend Button\" \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e",company_docs_deposit_desc:"\u092c\u0901\u0915\u0947\u0924 \u0930\u094b\u0916 \u091c\u092e\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0915\u0902\u092a\u0928\u0940\u091a\u094d\u092f\u093e \u0915\u093e\u0939\u0940 \u092e\u0939\u0924\u094d\u0935\u093e\u091a\u094d\u092f\u093e \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u0902\u091a\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0905\u0938\u0942 \u0936\u0915\u0924\u0947, \u091c\u0938\u0947 \u0915\u0940 PAN \u0915\u093e\u0930\u094d\u0921, \u091c\u0947 \u092c\u0939\u0941\u0924\u093e\u0902\u0936 \u092c\u0901\u0915\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u0915\u093e\u0939\u0940 \u092c\u0901\u0915\u093e \u0905\u0924\u093f\u0930\u093f\u0915\u094d\u0924 \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u0926\u0947\u0916\u0940\u0932 \u092e\u093e\u0917\u0942 \u0936\u0915\u0924\u093e\u0924, \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u0947 \u092f\u0947\u0925\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u093e.",deposit_slip_cms_desc:"\u0915\u093e\u0939\u0940 \u092c\u0901\u0915\u093e\u0902\u0938\u093e\u0920\u0940 \u092a\u0948\u0938\u0947 \u091c\u092e\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u0947\u0917\u0933\u0940 \u0921\u093f\u092a\u0949\u091d\u093f\u091f \u0938\u094d\u0932\u093f\u092a \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0924\u0947. \u092f\u093e \u092c\u0901\u0915\u093e\u0902\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u0930\u094d\u0935 \u0938\u094d\u0932\u093f\u092a\u094d\u0938 \u092f\u0947\u0925\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0924\u093e \u092f\u0947\u0924\u093e\u0924 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0902\u0928\u093e \u092a\u094d\u0930\u093f\u0902\u091f \u0906\u0909\u091f \u0918\u0947\u090a\u0928 (Print Slip) \u0935\u093e\u092a\u0930\u0924\u093e \u092f\u0947\u0908\u0932.",error_occurred_try_later:"\u0924\u094d\u0930\u0941\u091f\u0940 \u0906\u0932\u0940 \u0906\u0939\u0947, \u0915\u0943\u092a\u092f\u093e \u0928\u0902\u0924\u0930 \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e",failed_title:"\u0905\u092f\u0936\u0938\u094d\u0935\u0940",pay_picked_dues_desc:"\u092f\u093e \u092b\u0902\u0915\u094d\u0936\u0928\u0926\u094d\u0935\u093e\u0930\u0947, \u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u093f\u0915\u0905\u092a \u0938\u094d\u0932\u093f\u092a\u0928\u0941\u0938\u093e\u0930 \u0915\u0902\u092a\u0928\u0940\u0915\u0921\u0947 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0930\u094d\u0935 \u092a\u0947\u092e\u0947\u0902\u091f\u094d\u0938\u091a\u0940 \u092f\u093e\u0926\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u093e\u0939\u0942 \u0936\u0915\u093e\u0932. \u0939\u0940 \u0938\u0930\u094d\u0935 \u092a\u0947\u092e\u0947\u0902\u091f\u094d\u0938 \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930\u092a\u0923\u0947 \u0915\u093f\u0902\u0935\u093e \u090f\u0915\u0924\u094d\u0930 \u0915\u0947\u0932\u0940 \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924.",payout_note:"\u0939\u093e \u0924\u0947\u0935\u094d\u0939\u093e\u091a \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u094b \u091c\u0947\u0935\u094d\u0939\u093e \u0915\u092e\u093f\u0936\u0928 \u0915\u093f\u092e\u093e\u0928 \u0939\u092e\u0940 \u0930\u0915\u092e\u0947\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u093e\u0938\u094d\u0924 \u0905\u0938\u0947\u0932. \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u091c\u093e\u0938\u094d\u0924 \u0930\u0915\u094d\u0915\u092e \u092e\u093f\u0933\u0947\u0932 \u2014 \u0915\u093f\u092e\u093e\u0928 \u0939\u092e\u0940 \u0930\u0915\u094d\u0915\u092e \u0915\u093f\u0902\u0935\u093e \u0915\u092e\u093f\u0936\u0928.",pickup_deposit_ledger_desc:"\u0930\u0915\u094d\u0915\u092e RCE \u0926\u094d\u0935\u093e\u0930\u0947 \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0915\u0921\u0942\u0928 \u092a\u093f\u0915\u0905\u092a \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947 \u0915\u093f\u0902\u0935\u093e \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0926\u094d\u0935\u093e\u0930\u0947 \u0926\u093f\u0932\u094d\u092f\u093e \u091c\u093e\u0923\u093e\u0931\u094d\u092f\u093e \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u0915\u0902\u092a\u0928\u0940\u0915\u0921\u0947 \u092a\u093e\u0920\u0935\u0932\u0940 \u091c\u093e\u0924\u0947, \u092a\u0942\u0930\u094d\u0923 \u0915\u094d\u0930\u0947\u0921\u093f\u091f-\u0921\u0947\u092c\u093f\u091f \u0905\u0939\u0935\u093e\u0932 \u092f\u093e \u0932\u0947\u091c\u0930\u092e\u0927\u094d\u092f\u0947 \u0930\u093e\u0939\u0940\u0932.",req_civil:"\u0924\u0941\u092e\u091a\u093e \u0906\u0930\u094d\u0925\u093f\u0915 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0938\u094d\u0915\u094b\u0930 (\u0938\u093f\u0935\u094d\u0939\u093f\u0932 \u0938\u094d\u0915\u094b\u0930) \u0938\u0941\u092e\u093e\u0930\u0947 670 \u092a\u0947\u0915\u094d\u0937\u093e \u091c\u093e\u0938\u094d\u0924 \u0920\u0947\u0935\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947. \u091c\u0930 \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u0939\u093e \u0915\u093f\u0902\u0935\u093e \u0905\u0927\u093f\u0915 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0938\u094d\u0915\u094b\u0930 \u0928\u0938\u0947\u0932 \u0924\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u093e\u0924\u094d\u0930 \u0928\u093e\u0939\u0940.",req_collection:"\u0915\u0902\u092a\u0928\u0940\u0928\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0938\u094d\u091f\u094b\u0905\u0930 \u0915\u093f\u0902\u0935\u093e \u0911\u092b\u093f\u0938\u092e\u0927\u0942\u0928 5 \u0915\u093f\u092e\u0940\u091a\u094d\u092f\u093e radius \u092e\u0927\u094d\u092f\u0947 \u092a\u0948\u0938\u0947 \u0917\u094b\u0933\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0935\u0947\u0933 \u0918\u0947\u090a \u0936\u0915\u0924\u093e \u0906\u0923\u093f \u0917\u094b\u0933\u093e \u0915\u0947\u0932\u0947\u0932\u0940 \u0930\u0915\u094d\u0915\u092e \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0935\u0947\u0933\u0947\u0924 \u091c\u092e\u093e \u0915\u093f\u0902\u0935\u093e \u0911\u0928\u0932\u093e\u0907\u0928 \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u0915\u0902\u092a\u0928\u0940\u0915\u0921\u0947 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. \u0939\u094b\u092f \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0938\u0947 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",req_criminal:"\u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0930\u0915\u094d\u0924\u0938\u0902\u092c\u0902\u0927\u0940\u0924 \u0907\u0924\u0930 \u0938\u0926\u0938\u094d\u092f\u093e\u0902\u0935\u0930 \u092a\u0942\u0930\u094d\u0935\u0940 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0917\u0941\u0928\u094d\u0939\u0947\u0917\u093e\u0930\u0940 \u0928\u094b\u0902\u0926 \u0905\u0938\u0947\u0932, \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0917\u0941\u0928\u094d\u0939\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0936\u093f\u0915\u094d\u0937\u093e \u091d\u093e\u0932\u0940 \u0905\u0938\u0947\u0932 \u091c\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0928\u0948\u0924\u093f\u0915 \u0926\u0941\u0930\u094d\u092c\u0932\u0924\u093e (moral turpitude) \u0906\u0939\u0947, \u092a\u094b\u0932\u0940\u0938 \u0907\u0924\u093f\u0939\u093e\u0938 \u092a\u093e\u0928 \u0905\u0938\u0947\u0932, \u0924\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u092f\u093e \u0938\u0947\u0935\u0947\u091a\u0940 \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u0926\u093f\u0932\u0940 \u091c\u093e\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.",req_indian:"\u0924\u0941\u092e\u094d\u0939\u0940 \u092d\u093e\u0930\u0924\u093e\u091a\u0947 \u0928\u093e\u0917\u0930\u0940\u0915 \u0906\u0939\u093e\u0924 \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u0938\u0930\u094d\u0935 KYC \u0926\u0938\u094d\u0924\u0910\u0935\u091c, \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0906\u0923\u093f \u091a\u0947\u0915\u092c\u0941\u0915 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947.",req_population:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0930\u0939\u093f\u0935\u093e\u0938\u0940 \u091c\u093e\u0917\u0947\u091a\u0940 \u0932\u094b\u0915\u0938\u0902\u0916\u094d\u092f\u093e 10,000 \u092a\u0947\u0915\u094d\u0937\u093e \u091c\u093e\u0938\u094d\u0924 \u0906\u0939\u0947.",req_travel:"\u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u0936\u093e\u0930\u0940\u0930\u093f\u0915\u0930\u093f\u0924\u094d\u092f\u093e \u092a\u094d\u0930\u0935\u093e\u0938 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e \u0906\u0923\u093f \u0935\u093e\u0939\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0905\u0938\u0947\u0932.",search_by_amount:"\u0930\u0915\u094d\u0915\u092e\u0947\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u0936\u094b\u0927\u093e",selfie_pending_msg:"\u0938\u0947\u0932\u094d\u092b\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0906\u0939\u0947. \u091f\u0940\u092e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092c\u091f\u0923\u093e\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.",set_additional_pin_desc:"\u0924\u0941\u092e\u091a\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u093e \u092a\u093f\u0928 \u0915\u094b\u0921 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0926\u0938\u094d\u0924\u0910\u0935\u091c\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0935\u0930 \u0926\u093f\u0932\u093e \u0906\u0939\u0947. \u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u0907\u0924\u0930 \u092a\u093f\u0928 \u0915\u094b\u0921 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0924\u0939\u0940 \u0915\u093e\u092e \u0915\u0930\u0942 \u0936\u0915\u0924\u093e, \u0924\u0930 'ADD New' \u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942\u0928 4 \u092a\u093f\u0928 \u0915\u094b\u0921\u092a\u0930\u094d\u092f\u0902\u0924 \u091c\u094b\u0921\u093e.",successfully_title:"\u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e",transfer_report_wallet_desc:"\u092e\u0941\u0916\u094d\u092f \u0935\u0949\u0932\u0947\u091f \u0906\u0923\u093f POS \u0935\u0949\u0932\u0947\u091f\u0926\u094d\u0935\u093e\u0930\u0947 \u091c\u092e\u093e \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u0930\u094d\u0935 \u092a\u0947\u092e\u0947\u0902\u091f\u094d\u0938\u091a\u093e \u0905\u0939\u0935\u093e\u0932 \u092f\u0947\u0925\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947. \u0924\u0938\u0947\u091a QR \u0915\u094b\u0921, Intent UPI \u092e\u094b\u0921\u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0925\u0947\u091f \u092a\u0947\u092e\u0947\u0902\u091f\u094d\u0938\u091a\u093e \u0905\u0939\u0935\u093e\u0932 \u0926\u0947\u0916\u0940\u0932 \u092f\u0947\u0925\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947.",usb_connected_msg:"\u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u0906\u092e\u094d\u0939\u0940 \u0913\u0933\u0916\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 \u0924\u0941\u092e\u091a\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u0915\u094d\u0930\u093f\u092f\u092a\u0923\u0947 USB \u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u0928\u0947\u0915\u094d\u091f \u0906\u0939\u0947. \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u093e\u0930\u0923\u093e\u0938\u094d\u0924\u0935, Open \u0905\u200d\u0945\u092a \u0935\u093e\u092a\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0943\u092a\u092f\u093e USB \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0921\u093f\u0938\u094d\u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u093e.",usb_connected_note:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0924\u094d\u0930\u0941\u091f\u0940 \u091f\u093e\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0915\u094d\u0930\u093f\u092f USB \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0935\u093e\u092a\u0930\u0923\u0947 \u091f\u093e\u0933\u093e","Voter ID":"\u092e\u0924\u0926\u093e\u0930 \u0913\u0933\u0916\u092a\u0924\u094d\u0930","Driving License":"\u0921\u094d\u0930\u093e\u092f\u0935\u094d\u0939\u093f\u0902\u0917 \u0932\u093e\u092f\u0938\u0928\u094d\u0938",Passport:"\u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f","Ration Card":"\u0930\u093e\u0936\u0928 \u0915\u093e\u0930\u094d\u0921","User ID is required.":"User ID \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.","Please enter a valid PAN Card number.":"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 PAN \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e.","Please select a valid PAN Card Image.":"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 PAN \u0915\u093e\u0930\u094d\u0921 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e.","Please enter a valid Aadhar Card number.":"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e.",key_pleasesel_79:"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u0938\u092e\u094b\u0930\u091a\u0940 \u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e.",key_pleasesel_77:"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u092e\u093e\u0917\u0940\u0932 \u0906\u0927\u093e\u0930 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e.","Voter ID or Driving License is required.":"\u092e\u0924\u0926\u093e\u0930 \u0913\u0933\u0916\u092a\u0924\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u0921\u094d\u0930\u093e\u092f\u0935\u094d\u0939\u093f\u0902\u0917 \u0932\u093e\u092f\u0938\u0928\u094d\u0938 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.",key_pleasesel_81:"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u092e\u0924\u0926\u093e\u0930 \u0913\u0933\u0916\u092a\u0924\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u0921\u094d\u0930\u093e\u092f\u0935\u094d\u0939\u093f\u0902\u0917 \u0932\u093e\u092f\u0938\u0928\u094d\u0938 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e.",key_pleasesel_80:"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u092a\u094b\u0932\u0940\u0938 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e.",key_pleasesel_78:"\u0915\u0943\u092a\u092f\u093e \u0935\u0948\u0927 \u0930\u0926\u094d\u0926 \u0915\u0947\u0932\u0947\u0932\u0940 \u091a\u0947\u0915 \u092a\u094d\u0930\u0924\u093f\u092e\u093e \u0928\u093f\u0935\u0921\u093e.","Document uploaded successfully.":"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0905\u092a\u0932\u094b\u0921 \u091d\u093e\u0932\u093e.",key_documentu_32:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940, \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e.",key_anerroro_11:"\u0926\u0938\u094d\u0924\u0910\u0935\u091c \u0905\u092a\u0932\u094b\u0921 \u0