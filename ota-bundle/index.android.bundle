0915\u0947 \u092c\u093e\u0926, \u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0917\u0908 \u0938\u092d\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u092a\u0942\u0930\u093e \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u092d\u0940 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u091c\u093f\u0938\u0947 \u092c\u093e\u0926 \u092e\u0947\u0902 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0915\u0947\u0935\u0932 \u0924\u092d\u0940 \u0939\u091f\u093e\u090f\u0902 \u091c\u092c \u0906\u092a \u0938\u0939\u092e\u0924 \u0939\u094b\u0902\u0964",Delete:"\u0939\u091f\u093e\u090f\u0902",Cancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u0947\u0902","Press me if you agree to the deletion":"\u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092e\u0941\u091d\u0947 \u0926\u092c\u093e\u090f\u0902","Are you sure you want to delete your account?":"\u0915\u094d\u092f\u093e \u0906\u092a \u0935\u093e\u0915\u0908 \u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?","":""},dob_format:"\u091c\u0928\u094d\u092e \u0924\u093f\u0925\u093f (dd/mm/yyyy)",done_button:"\u092a\u0942\u0930\u094d\u0923",email:"\u0908\u092e\u0947\u0932",emailOrMobile:"\u0908\u092e\u0947\u0932 \u092f\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930",email_already_exists:"\u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0964",email_exists_error:"\u0906\u092a\u0915\u0940 \u0908\u092e\u0947\u0932 \u0906\u0908\u0921\u0940 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0939\u0940 \u0939\u092e\u093e\u0930\u0947 \u092a\u093e\u0938 \u092e\u094c\u091c\u0942\u0926 \u