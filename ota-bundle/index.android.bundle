ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf","Privacy Policy Page":"\u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0ca8\u09c0\u09a4\u09bf \u0caa\u0cc1\u0c9f","Personal Information":"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf","KYC Info & Docs":"KYC \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf & \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1","Your Password":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd",WARNING:"\u0c8e\u0c9a\u0ccd\u0c9a\u0cb0\u0cbf\u0c95\u0cc6","Forget Transaction":"\u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0cb0\u0cbf",key_incorrect_51:"\u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0ca6 \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf",voice_notification_title:"\u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cb6\u0cc0\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0cc6",voice_notification_enable:"\u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf",voice_notification_disable:"\u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf",ringtone_on:"\u0cb0\u0cbf\u0c82\u0c97\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",ringtone_off:"\u0cb0\u0cbf\u0c82\u0c97\u0ccd\u0c9f\u0ccb\u0ca8\u0ccd \u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6",save_settings:"\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cbf",test_voice:"\u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0caa\u0cb0\u0cc0\u0c95\u0ccd\u0cb7\u0cc6",permission_required:"\u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0cc6",permission_message:"\u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0cb8\u0c82\u0ca6\u0cc7\u0cb6",change_voice_notification:"\u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cbf",voice_notification_content:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cae\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0ca4\u0c95\u0ccd\u0c95 \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0cb8\u0cae\u0cb0\u0ccd\u0ca5\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cac\u0c9f\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6, \u0c86\u0ccd\u0caf\u0caa\u0ccd \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0c9a\u0cbe\u0cb2\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0cc2\u0c9a\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0cc1 \u0c86\u0ccd\u0caf\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3(Alert) \u0ca8\u0cc0\u0ca1\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",active_mode_is:"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0cae\u0ccb\u0ca1\u0ccd \u0c87\u0cb0\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6",cancel:"\u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0cae\u0cbe\u0ca1\u0cbf","Device is ON":"\u0cb8\u0cbe\u0ca7\u0ca8 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Device is OFF":"\u0cb8\u0cbe\u0ca7\u0ca8 \u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Save Change":"\u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c89\u0cb3\u0cbf\u0cb8\u0cbf",dark_mode_setting:"\u0ca1\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0cae\u0ccb\u0ca1\u0ccd \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd",dark_mode_content:"\u0ca1\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0cae\u0ccb\u0ca1\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cac\u0ca3\u0ccd\u0ca3\u0c97\u0cb3\u0cc1 \u0ca8\u0cbf\u0cb6\u0ccd\u0c9a\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca1\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0cae\u0ccb\u0ca1\u0ccd \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0cae\u0cc2\u0cb2 \u0cac\u0ca3\u0ccd\u0ca3\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6 \u0ca1\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0cae\u0ccb\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca1\u0cbe\u0cb0\u0ccd\u0c95\u0ccd \u0cae\u0ccb\u0ca1\u0ccd \u0ca4\u0cc6\u0c97\u0cc6\u0ca6\u0cc1\u0cb9\u0cbe\u0c95\u0cb2\u0cc1, \u0ca8\u0cc0\u0cb5\u0cc1 \u0cac\u0c9f\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc8\u0caf\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cb7\u0ccd\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cac\u0cc7\u0c95\u0cc1.","Current Password":"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd","Enter New Password":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Re-enter New Password":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0caa\u0cc1\u0ca8\u0c83 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Manage Login Devices":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cbf","Mobile Application (APP)":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0c86\u0ccd\u0caf\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd (APP)","Mobile description":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb5\u0cb3\u0cbf\u0c95\u0cc6\u0caf\u0c82\u0ca4\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0c86\u0ccd\u0caf\u0caa\u0ccd\u0cb2\u0cbf\u0c95\u0cc7\u0cb6\u0ca8\u0ccd \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cb2\u0cc8\u0cb5\u0ccd \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0cc6\u0cb3\u0c97\u0cc6 \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0cac\u0ca6\u0cb2\u0cbe\u0cb5\u0ca3\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0cca\u0ca6\u0cb2\u0cc1 \u0caa\u0cb0\u0cbf\u0ca3\u0cbe\u0cae\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.","Website Login (Web)":"\u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd (Web)","Website description":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0c97\u0ca4\u0ccd\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb5\u0cb3\u0cbf\u0c95\u0cc6\u0caf\u0c82\u0ca4\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cbe\u0ca6 \u0cb5\u0cc6\u0cac\u0ccd \u0cac\u0cb3\u0c95\u0cc6\u0ca6\u0cbe\u0cb0 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cb2\u0cc8\u0cb5\u0ccd \u0cae\u0cbe\