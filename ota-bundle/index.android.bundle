9\u09cd\u0995 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf","No transactions found":"\u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf","Note:":"\u09a6\u09cd\u09b0\u09b7\u09cd\u099f\u09ac\u09cd\u09af:","Operator:":"\u0985\u09aa\u09be\u09b0\u09c7\u099f\u09b0:","PAY NOW \u20b9":"\u098f\u0996\u09a8\u0987 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u0995\u09b0\u09c1\u09a8 \u20b9",PROCEED:"\u098f\u0997\u09bf\u09df\u09c7 \u09af\u09be\u09a8","PROTECTED BY SECURITY SYSTEM":"\u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4","Payee:":"\u09aa\u09cd\u09b0\u09be\u09aa\u0995:",Paying:"\u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09be \u09b9\u099a\u09cd\u099b\u09c7","Please complete your verification to enable all AEPS features.":"\u09b8\u09ae\u09b8\u09cd\u09a4 AEPS \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u0995\u09b0\u09a4\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09af\u09be\u099a\u09be\u0987\u0995\u09b0\u09a3 \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u0995\u09b0\u09c1\u09a8\u0964","Please match the number of Notes":"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09a8\u09cb\u099f\u09c7\u09b0 \u09b8\u0982\u0996\u09cd\u09af\u09be \u09ae\u09bf\u09b2\u09bf\u09af\u09bc\u09c7 \u09a8\u09bf\u09a8","Please wait...":"\u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c1\u09a8...","Post Balance: \u20b9":"\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8: \u20b9","Pre Balance: \u20b9":"\u09aa\u09c2\u09b0\u09cd\u09ac\u09ac\u09b0\u09cd\u09a4\u09c0 \u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8: \u20b9","Profile Picture Not Found - click for upload new":"\u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u099b\u09ac\u09bf \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf - \u09a8\u09a4\u09c1\u09a8 \u0986\u09aa\u09b2\u09cb\u09a1 \u0995\u09b0\u09a4\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8","Receipt of":"\u09b0\u09b8\u09bf\u09a6","Recharge Amount:":"\u09b0\u09bf\u099a\u09be\u09b0\u09cd\u099c\u09c7\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3:","Ref No:":"\u09b0\u09c7\u09ab\u09be\u09b0\u09c7\u09a8\u09cd\u09b8 \u09a8\u0982:","Remain Amount: \u20b9":"\u0985\u09ac\u09b6\u09bf\u09b7\u09cd\u099f \u09aa\u09b0\u09bf\u09ae\u09be\u09a3: \u20b9","Remaining Receipts:":"\u0985\u09ac\u09b6\u09bf\u09b7\u09cd\u099f \u09b0\u09b8\u09bf\u09a6:","Remaining: \u20b9":"\u0985\u09ac\u09b6\u09bf\u09b7\u09cd\u099f: \u20b9","Retailer Info:":"\u09b0\u09bf\u099f\u09c7\u09b2\u09be\u09b0 \u09a4\u09a5\u09cd\u09af:","SECURITY ALERT":"\u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09b8\u09a4\u09b0\u09cd\u0995\u09a4\u09be","Select your device model from the dropdown below.":"\u09a8\u09bf\u099a\u09c7\u09b0 \u09a1\u09cd\u09b0\u09aa\u09a1\u09be\u0989\u09a8 \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u09ae\u09a1\u09c7\u09b2\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8\u0964",Sender:"\u09aa\u09cd\u09b0\u09c7\u09b0\u0995","Sender Name:":"\u09aa\u09cd\u09b0\u09c7\u09b0\u0995\u09c7\u09b0 \u09a8\u09be\u09ae:","Spent: \u20b9":"\u09ac\u09cd\u09af\u09af\u09bc \u09b9\u09af\u09bc\u09c7\u099b\u09c7: \u20b9","State Bank Of India":"\u09b8\u09cd\u099f\u09c7\u099f \u09ac\u09cd\u09af\u09be\u0999\u09cd\u0995 \u0985\u09ab \u0987\u09a8\u09cd\u09a1\u09bf\u09af\u09bc\u09be","Status:":"\u0985\u09ac\u09b8\u09cd\u09a5\u09be (Status):","To Date:":"\u09b6\u09c7\u09b7 \u09a4\u09be\u09b0\u09bf\u0996 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4:","Tokens No:":"\u099f\u09cb\u0995\u09c7\u09a8 \u09a8\u0982:","Total Receipt":"\u09ae\u09cb\u099f \u09b0\u09b8\u09bf\u09a6","Transaction Date:":"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09a4\u09be\u09b0\u09bf\u0996:","Transaction Status:":"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u0985\u09ac\u09b8\u09cd\u09a5\u09be:","Try a different search term":"\u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u09b6\u09ac\u09cd\u09a6 \u09a6\u09bf\u09df\u09c7 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c1\u09a8","Try adjusting the date range or filters.":"\u09a4\u09be\u09b0\u09bf\u0996\u09c7\u09b0 \u09b8\u09c0\u09ae\u09be \u09ac\u09be \u09ab\u09bf\u09b2\u09cd\u099f\u09be\u09b0 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09c7 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964","UTR No:":"UTR \u09a8\u0982:","VPA:":"VPA:","Your Version: V":"\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3: V","Your wallet balance is short by \u20b9":"\u0986\u09aa\u09a8\u09be\u09b0 \u0993\u09af\u09bc\u09be\u09b2\u09c7\u099f \u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8 \u20b9 \u0995\u09ae \u0986\u099b\u09c7"}},1086,[]);
