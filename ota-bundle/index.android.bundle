u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf",SUCCESS:"\u0caf\u0cb6\u0cb8\u0ccd\u0cb8\u0cc1",language_changed_success:"\u0cad\u0cbe\u0cb7\u0cc6 \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Voice Notification":"\u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6","Apk languages":"\u0c88 \u0c86\u0caa\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbe\u0cb5\u0cc1 \u0c8e\u0c82\u0c9f\u0cc1 \u0cad\u0cbe\u0cb7\u0cc6\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf (\u0c87\u0c82\u0c97\u0ccd\u0cb2\u0cbf\u0cb7\u0ccd, \u0cb9\u0cbf\u0c82\u0ca6\u0cbf, \u0cac\u0cc6\u0c82\u0c97\u0cbe\u0cb3\u0cbf, \u0c97\u0cc1\u0c9c\u0cb0\u0cbe\u0ca4\u0cbf, \u0cae\u0cb0\u0cbe\u0ca0\u0cbf, \u0ca4\u0cae\u0cbf\u0cb3\u0cc1, \u0ca4\u0cc6\u0cb2\u0cc1\u0c97\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0ca8\u0ccd\u0ca8\u0ca1) \u0c85\u0cad\u0cbf\u0cb5\u0cc3\u0ca6\u0ccd\u0ca7\u0cbf\u0caa\u0ca1\u0cbf\u0cb8\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0cb5\u0cc6, \u0c87\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad\u0cb5\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0cae\u0ccd\u0cae\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb8\u0cc7\u0cb0\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad\u0cb5\u0cbe\u0c97\u0cbf \u0cac\u0cc6\u0cb3\u0cc6\u0caf\u0cbf\u0cb0\u0cbf. \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c88 \u0c9f\u0ccd\u0caf\u0cbe\u0cac\u0ccd \u0c92\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cbf.","Apk notification":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cbf\u0caf\u0cae\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0caa\u0ccd\u0cb0\u0ca4\u0cbf\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0cc6 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6 \u0cac\u0c9f\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cac\u0c9f\u0ca8\u0ccd \u0c86\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0c86\u0caa\u0ccd \u0cb8\u0ccd\u0cb5\u0caf\u0c82\u0c9a\u0cbe\u0cb2\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3 \u0cac\u0c97\u0ccd\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0c97\u0cc6 \u0ca4\u0cbf\u0cb3\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c88 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0cc1 \u0ca7\u0ccd\u0cb5\u0ca8\u0cbf \u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0ca6\u0c97\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Apk theme":"\u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0c95\u0cbe\u0cb0\u0ca3\u0ca6\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0ca6\u0cb0\u0ccd\u0cb6\u0ca8 \u0cb8\u0ccd\u0caa\u0cb7\u0ccd\u0c9f\u0cb5\u0cbe\u0c97\u0cbf \u0c95\u0cbe\u0ca3\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca1\u0cc0\u0cab\u0cbe\u0cb2\u0ccd\u0c9f\u0ccd \u0c86\u0caa\u0ccd \u0ca5\u0cc0\u0cae\u0ccd \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca1\u0cc0\u0cab\u0cbe\u0cb2\u0ccd\u0c9f\u0ccd \u0ca5\u0cc0\u0cae\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0cc6\u0cb2\u0cb8 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad. \u0c87\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0cab\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 Close \u0cac\u0c9f\u0ca8\u0ccd \u0c92\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0\u0cbf.","FAQ description":"FAQ \u0caa\u0cc1\u0c9f\u0cb5\u0cc1 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf \u0cb5\u0cbf\u0cad\u0cbe\u0c97\u0ca6 \u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0cad\u0cbe\u0c97\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6, \u0c8f\u0c95\u0cc6\u0c82\u0ca6\u0cb0\u0cc6 \u0c87\u0ca6\u0cc1 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cbf \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0cb0 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. FAQ \u0c97\u0cb3\u0cc1 \u0caa\u0ccd\u0cb0\u0cb6\u0ccd\u0ca8\u0cc6\u0caf\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cb5\u0cbe\u0c97\u0cbf \u0cb8\u0ca3\u0ccd\u0ca3 \u0c89\u0ca4\u0ccd\u0ca4\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.",FAQs:"FAQ \u0c97\u0cb3\u0cc1","Bank Holiday":"\u0c88 \u0cac\u0c9f\u0ca8\u0ccd \u0c92\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cb0\u0cc6, \u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb0\u0c9c\u0cbe\u0ca6\u0cbf\u0ca8\u0c97\u0cb3 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Coming Bank Holidays":"\u0cae\u0cc1\u0c82\u0cac\u0cb0\u0cc1\u0cb5 \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb0\u0c9c\u0cbe\u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cc1",Complaint:"\u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf:- \u0ca8\u0cae\u0ccd\u0cae \u0c9a\u0cbe\u0c9f\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0cc1 \u0cb8\u0cbe\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cb8\u0c82\u0cad\u0cbe\u0cb7\u0ca3\u0cc6\u0c97\u0cc6 \u0cac\u0cb3\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca8\u0cbe\u0cb5\u0cc1 \u0c95\u0cc7\u0cb5\u0cb2 \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0ccd\u0ca6\u0cc7\u0cb5\u0cc6.","Complaint Through Chat Service":"\u0c9a\u0cbe\u0c9f\u0ccd \u0cb8\u0cc7\u0cb5\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0ca6\u0cc2\u0cb0\u0cc1","Support Email-ID":"\u0cb8\u0cb9\u0cbe\u0caf \u0c87\u0cae\u0cc7\u0cb2\u0ccd-ID","Customer Care Number":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cb8\u0cc7\u0cb5\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Every Sunday":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cad\u0cbe\u0ca8\u0cc1\u0cb5\u0cbe\u0cb0","Every Saturday":"\u0caa\u0ccd\u0cb0\u0ca4\u0cbf \u0cb6\u0ca8\u0cbf\u0cb5\u0cbe\u0cb0","Monday to Friday":"\u0cb8\u0ccb\u0cae\u0cb5\u0cbe\u0cb0\u0ca6\u0cbf\u0c82\u0ca6 \u0cb6\u0cc1\u0c95\u0ccd\u0cb0\u0cb5\u0cbe\u0cb0","Cust Time":"\u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cb8\u0cc7\u0cb5\u0cc6 \u0cb8\u0cae\u0caf","Our Customer Care Timing":"\u0ca8\u0cae\u0ccd\u0cae \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cb8\u0cc7\u0cb5\u0cc6 \u0cb8\u0cae\u0caf","Help & Support":"\u0cb8\u0cb9\u0cbe\u0caf & \u0cac\u0cc6\u0c82\u0cac\u0cb2",Back:"\u0cb9\u0cbf\u0c82\u0ca6\u0cc6","November 01, 2024":"\u0ca8\u0cb5\u0cc6\u0c82\u0cac\u0cb0\u0ccd 01, 2024","March 25, 2024":"\u0cae\u0cbe\u0cb0\u0ccd\u0c9a\u0ccd 25, 2024",Holi:"\u0cb9\u0ccb\u0cb3\u0cbf",Monday:"\u0cb8\u0ccb\u0cae\u0cb5\u0cbe\u0cb0",Tuesday:"\u0cae\u0c82\u0c97\u0cb3\u0cb5\u0cbe\u0cb0",Wednesday:"\u0cac\u0cc1\u0ca7\u0cb5\u0cbe\u0cb0",Thursday:"\u0c97\u0cc1\u0cb0\u0cc1\u0cb5\u0cbe\u0cb0",Friday:"\u0cb6\u0cc1\u0c95\u0ccd\u0cb0\u0cb5\u0cbe\u0cb0",Saturday:"\u0cb6\u0ca8\u0cbf\u0cb5\u0cbe\u0cb0",Sunday:"\u0cad\u0cbe\u0ca8\u0cc1\u0cb5\u0cbe\u0cb0",Deepawali:"\u0ca6\u0cc0\u0caa\u0cbe\u0cb5\u0cb3\u0cbf","New Year":"\u0cb9\u0cca\u0cb8 \u0cb5\u0cb0\u0ccd\u0cb7","FAQ Info":"\u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf:- \u0c95\u0cb3\u0cc6\u0ca6 5 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0ccb\u0ca1\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cb8\u0cbe\u0ca7\u0ca8\u0ca6 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0cae\u0cbe\u0ca6\u0cb0\u0cbf, IP \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8, \u0cb8\u0cbe\u0ca7\u0ca8 ID \u0cae\u0cc1\u0c82\u0ca4\u0cbe\u0ca6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb5\u0cc6.","Manage Important Security":"\u0caa\u0ccd\u0cb0\u0cae\u0cc1\u0c96 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cc6","MIS description2":"\u0caa\u0ccd\u0cb0\u0cbf\u0caf \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0caa\u0cbe\u0cb2\u0cc1\u0ca6\u0cbe\u0cb0, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0ca4 \u0c8e\u0cb2\u0ccd\u0cb2\u0cbe \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0cc1 \u0c88 \u0caa\u0cc1\u0c9f\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c85\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0c85\u0ca8\u0cc1\u0cb8\u0cb0\u0cbf\u0cb8\u0cbf.","Please Enter Old Password":"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb9\u0cb3\u0cc6\u0caf \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Transaction PIN do not match":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 PIN \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0c95\u0cc6\u0caf\u0cbe\u0c97\u0cbf\u0cb2\u0ccd\u0cb2",ERROR:"\u0ca6\u0ccb\u0cb7",key_yourtrans_116:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 PIN \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cbf \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf.","Pin changed successfully!":"PIN \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6!","An error occurred. Please try again.":"\u0ca6\u0ccb\u0cb7 \u0cb8\u0c82\u0cad\u0cb5\u0cbf\u0cb8\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Want To Delete This Device":"\u0c88 \u0cb8\u0cbe\u0ca7\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe?","Are You Sure":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb5\u0cc7?","Want To block This Device":"\u0c88 \u0cb8\u0cbe\u0ca7\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe?","Want To Unblock This Device":"\u0c88 \u0cb8\u0cbe\u0ca7\u0ca8\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0ca8\u0ccd\u0cac\u0ccd\u0cb2\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cc1\u0cb5\u0cbf\u0cb0\u0cbe?","SAMSUNG Z 22":"SAMSUNG Z 22","sdf dfdssd":"sdf dfdssd",Security:{"Set SIM":"\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf\u0ca6 \u0ca8\u0c82\u0ca4\u0cb0, \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 SIM \u0c85\u0ca6\u0cc7 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0ca6\u0ccd\u0ca6\u0cbe\u0c97 \u0cae\u0cbe\u0ca4\u0ccd\u0cb0 \u0c87\u0ca6\u0cc1 \u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0c87\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cb0\u0cc0\u0ca4\u0cbf\u0caf \u0cb5\u0c82\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cc1\u0cb2\u0cad\u0cb5\u0cbe\u0c97\u0cbf \u0ca4\u0ca1\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0caf\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0caf\u0cbe\u0cb0\u0cbf\u0c97\u0cc2 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.","Mandatory SIM Setting":"\u0c95\u0ca1\u0ccd\u0ca1\u0cbe\u0caf SIM \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd","Screen Lock Setting":"\u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd \u0cb2\u0cbe\u0c95\u0ccd","Set One Time Password":"\u0c92\u0cae\u0ccd\u0cae\u0cc6 \u0cac\u0cb3\u0c95\u0cc6\u0caf \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf","Screen Lock":"\u0c88 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0cb5\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd\u200c\u0ca8 \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd \u0cb2\u0cbe\u0c95\u0ccd \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0c86\u0caa\u0ccd \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6. \u0ca8\u0cc0\u0cb5\u0cc1 PIN, \u0cac\u0cc6\u0cb0\u0cb3\u0c9a\u0ccd\u0c9a\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cc1\u0c96 \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0cb8\u0cc1\u0cb5\u0cbf\u0c95\u0cc6\u0caf \u0cae\u0cc2\u0cb2\u0c95 \u0cb2\u0cbe\u0c95\u0ccd \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","OTP setting":"\u0c92\u0cae\u0ccd\u0cae\u0cc6 \u0cac\u0cb3\u0c95\u0cc6\u0caf \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd {OTP} \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c85\u0caa\u0cbe\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cb2\u0cc1 \u0c95\u0ca1\u0ccd\u0ca1\u0cbe\u0caf\u0cb5\u0cbe\u0ca6 \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1\u0cb5\u0cb0\u0cbf \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0caa\u0ca6\u0cb0\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c85\u0ca8\u0cc1\u0c95\u0cc2\u0cb2\u0c95\u0ccd\u0c95\u0cc6 \u0c85\u0ca8\u0cc1\u0c97\u0cc1\u0ca3\u0cb5\u0cbe\u0c97\u0cbf \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cb2\u0cc1 \u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 OTP \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0c97\u0cb3\u0cc1 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb5\u0cc6.","Change Login Password":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Change L & P":"\u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0c95\u0cbe\u0cb0\u0ca3\u0c97\u0cb3\u0cbf\u0c82\u0ca6\u0cbe\u0c97\u0cbf \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0cae\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cb8\u0cae\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0cac\u0cb9\u0cb3 \u0cae\u0cc1\u0c96\u0ccd\u0caf. \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6\u0c97\u0cc6 \u0cb8\u0c82\u0cac\u0c82\u0ca7\u0cbf\u0cb8\u0cbf\u0ca6 \u0cae\u0cc1\u0c96\u0ccd\u0caf \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0cae\u0cc1\u0c82\u0ca6\u0cbf\u0ca8 \u0caa\u0cc1\u0c9f\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.","Change or Forget PIN":"PIN \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbe","Forget PIN":"\u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 PIN \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0cac\u0ca6\u0cb2\u0cbe\u0caf\u0cbf\u0cb8\u0cb2\u0cc1 \u0cac\u0caf\u0cb8\u0cbf\u0ca6\u0cb0\u0cc6, \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf. \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 PIN \u0cb9\u0ca3\u0c95\u0cbe\u0cb8\u0cc1 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0ccd\u0ca6\u0cc1, PIN \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2.","Mob Registration Settings":"\u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0ca8\u0ccb\u0c82\u0ca6\u0ca3\u0cbf \u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1",Registration:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c92\u0c82\u0ca6\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0cb8\u0ca6 \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0caa\u0ccd\u200c\u0c97\u0cc6 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2. \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cb2\u0cc1 \u0c95\u0cc7\u0cb5\u0cb2 \u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc7 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1.","Manage Login Platform":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0caa\u0ccd\u0cb2\u0cbe\u0c9f\u0ccd\u200c\u0cab\u0cbe\u0cb0\u0ccd\u0cae\u0ccd \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0ca3\u0cc6","Manage Login":"\u0c88 \u0cb5\u0cc8\u0cb6\u0cbf\u0cb7\u0ccd\u0c9f\u0ccd\u0caf\u0ca6 \u0cae\u0cc2\u0cb2\u0c95 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb5\u0cc6\u0cac\u0ccd\u200c\u0cb8\u0cc8\u0c9f\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0c86\u0caa\u0ccd \u0c8e\u0cb0\u0ca1\u0cb0\u0cb2\u0ccd\u0cb2\u0cbf\u0caf\u0cc2 \u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0c85\u0c97\u0ca4\u0ccd\u0caf\u0cb5\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6 \u0c8e\u0cb0\u0ca1\u0ca8\u0ccd\u0ca8\u0cc2 \u0cac\u0cb3\u0cb8\u0cac\u0cb9\u0cc1\u0ca6\u0cc1 \u0c85\u0ca5\u0cb5\u0cbe \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0caf\u0c82\u0ca4\u0cc6 \u0ca4\u0ca1\u0cc6\u0cb9\u0cbf\u0ca1\u0cbf\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1. \u0ca8\u0cbf\u0cb0\u0ccd\u0cb5\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0c87\u0cb2\u0ccd\u0cb2\u0cbf \u0c95\u0ccd\u0cb2\u0cbf\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cbf."},"Your State Update Successfully.":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cb0\u0cbe\u0c9c\u0ccd\u0caf\u0ca6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf \u0caf\u0cb6\u0cb8\u0ccd\u0cb5\u0cbf\u0caf\u0cbe\u0c97\u0cbf \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6.",ChangePassword:{"Change Login Password":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Password Security Tips":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cb3\u0cc1","Current Password":"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd","Enter New Password":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Confirm New Password":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf","Update Password":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca8\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf","Re-enter New Password":"\u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Passwords should be at least 6 characters long":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Don't use personal information":"\u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cac\u0cc7\u0ca1\u0cbf","Randomize patterns and sequences":"\u0caf\u0cbe\u0ca6\u0cc3\u0c9a\u0ccd\u0c9b\u0cbf\u0c95 \u0cae\u0cbe\u0ca6\u0cb0\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb3\u0cb8\u0cbf","Never reuse passwords":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0cac\u0cb3\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cac\u0cc7\u0ca1\u0cbf","Prioritize password length":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c89\u0ca6\u0ccd\u0ca6\u0c95\u0ccd\u0c95\u0cc6 \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6 \u0ca8\u0cc0\u0ca1\u0cbf","Never share your passwords":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0caf\u0cbe\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cac\u0cc7\u0ca1\u0cbf","Avoid public Wi-Fi":"\u0cb8\u0cbe\u0cb0\u0ccd\u0cb5\u0c9c\u0ca8\u0cbf\u0c95 Wi-Fi \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0caa\u0ccd\u0caa\u0cbf\u0cb8\u0cbf","Use a variety of numbers, letters, and characters":"\u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cc1, \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9a\u0cbf\u0cb9\u0ccd\u0ca8\u0cc6\u0c97\u0cb3 \u0cae\u0cbf\u0cb6\u0ccd\u0cb0\u0ca3 \u0cac\u0cb3\u0cb8\u0cbf","Download a reliable password manager":"\u0cb5\u0cbf\u0cb6\u0ccd\u0cb5\u0cbe\u0cb8\u0cbe\u0cb0\u0ccd\u0cb9 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0ccd\u0caf\u0cbe\u0ca8\u0cc7\u0c9c\u0cb0\u0ccd \u0ca1\u0ccc\u0ca8\u0ccd\u200c\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","Enable two-factor authentication":"\u0c8e\u0cb0\u0ca1\u0cc1 \u0cb9\u0c82\u0ca4\u0ca6 \u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf","Check the strength of your passwords":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0cb2\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf","Change passwords periodically":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb5\u0ca7\u0cbf \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cc6 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Close Tips":"\u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cbf","Periodically Change":"\u0cb5\u0cbf\u0cb5\u0cbf\u0ca7 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cbe\u0c97\u0cbf \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cc1\u0cb5 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb5\u0ca7\u0cbf \u0c85\u0cb5\u0ca7\u0cbf\u0c97\u0cc6 \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cc7\u0c9f\u0cbe \u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf\u0cb0\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Password Strength":"LastPass \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0cb2 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0c95\u0c97\u0cb3\u0cc1 \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb0\u0c9a\u0cbf\u0cb8\u0cc1\u0cb5 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3 \u0caa\u0cb0\u0cbf\u0ca3\u0cbe\u0cae\u0c95\u0cbe\u0cb0\u0cbf\u0ca4\u0ccd\u0cb5\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.",Reliability:"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cae\u0ccd\u0caf\u0cbe\u0ca8\u0cc7\u0c9c\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c85\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cb2\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0c82\u0c98\u0c9f\u0cbf\u0cb8\u0cb2\u0cc1 \u0c95\u0cb7\u0ccd\u0c9f\u0caa\u0ca1\u0cc1\u0cb5\u0cb5\u0cb0\u0cbf\u0c97\u0cc6 \u0c89\u0caa\u0caf\u0cc1\u0c95\u0ccd\u0ca4 \u0cb8\u0cbe\u0ca7\u0ca8\u0c97\u0cb3\u0cbe\u0c97\u0cbf\u0cb5\u0cc6.",Variety:"\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cc1 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cc1, \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9a\u0cbf\u0cb9\u0ccd\u0ca8\u0cc6\u0c97\u0cb3\u0cbf\u0cb0\u0cc1\u0cb5 \u0cb8\u0c82\u0c95\u0cc0\u0cb0\u0ccd\u0ca3 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0cb9\u0ccd\u0caf\u0cbe\u0c95\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6\u0cbf\u0cb8\u0cc1\u0cb5 \u0cb8\u0cbe\u0ca7\u0ccd\u0caf\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0cb5\u0cc6.","Avoid Wi-Fi":"VPN \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0cb8\u0cbe\u0cb0\u0ccd\u0cb5\u0c9c\u0ca8\u0cbf\u0c95 Wi-Fi \u0cac\u0cb3\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6\u0cb0\u0cc6, \u0cb9\u0ccd\u0caf\u0cbe\u0c95\u0cb0\u0ccd\u200c\u0c97\u0cb3\u0cc1 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca8\u0ccd\u200c\u0cb2\u0cc8\u0ca8\u0ccd \u0c9a\u0c9f\u0cc1\u0cb5\u0c9f\u0cbf\u0c95\u0cc6\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c9f\u0ccd\u0cb0\u0ccd\u0caf\u0cbe\u0c95\u0ccd \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca1\u0cc7\u0c9f\u0cbe\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cac\u0cb9\u0cbf\u0cb0\u0c82\u0c97 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5 \u0c85\u0caa\u0cbe\u0caf\u0cb5\u0cbf\u0ca6\u0cc6.","Never share password ":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c85\u0ca8\u0ccd\u0ca8\u0cc1 \u0c87\u0ca4\u0cb0\u0cb0\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cc1\u0cb5\u0cc1\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cb3 \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cc6 \u0c85\u0caa\u0cbe\u0caf\u0c95\u0ccd\u0c95\u0cc6 \u0c92\u0cb3\u0c97\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",priority:"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0c89\u0ca6\u0ccd\u0ca6\u0cb5\u0cbe\u0ca6\u0cb7\u0ccd\u0c9f\u0cc2 \u0c85\u0ca6\u0ca8\u0ccd\u0ca8\u0cc1 \u0c8a\u0cb9\u0cbf\u0cb8\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c95\u0cb7\u0ccd\u0c9f\u0cb5\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Don't use personal Info":"\u0cb9\u0cc6\u0cb8\u0cb0\u0cc1, \u0c9c\u0ca8\u0ccd\u0cae \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95, \u0cb5\u0cbf\u0cb3\u0cbe\u0cb8 \u0c85\u0ca5\u0cb5\u0cbe \u0cab\u0ccb\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0baa\u0bcb\u0ba9\u0bcd\u0bb1 \u0cb5\u0cc8\u0caf\u0c95\u0ccd\u0ca4\u0cbf\u0c95 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0ca8\u0cb2\u0ccd\u0cb2\u0cbf \u0cac\u0cb3\u0cb8\u0cac\u0cc7\u0ca1\u0cbf.",Randomize:"\u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cc1, \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0c9a\u0cbf\u0cb9\u0ccd\u0ca8\u0cc6\u0c97\u0cb3 \u0caf\u0cbe\u0ca6\u0cc3\u0c9a\u0ccd\u0c9b\u0cbf\u0c95 \u0cb8\u0c82\u0caf\u0ccb\u0c9c\u0ca8\u0cc6 \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0ca6\u0cbe\u0cb3\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0ca1\u0cc6\u0caf\u0cb2\u0cc1 \u0cb8\u0cb9\u0cbe\u0caf \u0cae\u0cbe\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.","Never reuse pass":"\u0cb9\u0cb3\u0cc6\u0caf \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd\u200c\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0cae\u0cb0\u0cc1\u0cac\u0cb3\u0c95\u0cc6 \u0cae\u0cbe\u0ca1\u0cc1\u0cb5\u0cc1\u0ca6\u0cc1 \u0c96\u0cbe\u0ca4\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0c85\u0caa\u0cbe\u0caf\u0c95\u0cbe\u0cb0\u0cbf\u0caf\u0cbe\u0c97\u0cbf\u0ca6\u0cc6."},"Password Security Tips":"\u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cad\u0ca6\u0ccd\u0cb0\u0ca4\u0cbe \u0cb8\u0cb2\u0cb9\u0cc6\u0c97\u0cb3\u0cc1","Change Login Password":"\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0caa\u0cbe\u0cb8\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Set Transaction PIN":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 PIN \u0cb9\u0cca\u0c82\u0ca6\u0cbf\u0cb8\u0cbf","Change PIN":"PIN \u0cac\u0ca6\u0cb2\u0cbf\u0cb8\u0cbf","Current PIN":"\u0caa\u0ccd\u0cb0\u0cb8\u0ccd\u0ca4\u0cc1\u0ca4 PIN","Enter New PIN":"\u0cb9\u0cca\u0cb8 PIN \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Re-enter New PIN":"\u0cb9\u0cca\u0cb8 PIN \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","PIN should be at least 6 characters long":"PIN \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 6 \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Forgot PIN ?":"PIN \u0cae\u0cb0\u0cc6\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbe?","Forget Transaction PIN":"\u0cb5\u0cb9\u0cbf\u0cb5\u0cbe\u0c9f\u0cc1 PIN \u0cae\u0c