aa8\u0ac7 \u0a95\u0acb\u0ab2 \u0a95\u0ab0\u0acb",key_sorryfor_137:"\u0a85\u0ab8\u0ac1\u0ab5\u0abf\u0aa7\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0acd\u0ab7\u0aae\u0abe \u0a95\u0ab0\u0ab6\u0acb, \u0a95\u0ac7\u0a9f\u0ab2\u0abe\u0a95 \u0ab8\u0ac1\u0aa7\u0abe\u0ab0\u0abe\u0a93 \u0ab8\u0abe\u0aa5\u0ac7 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8\u0aa8\u0ac1\u0a82 \u0aa8\u0ab5\u0ac1\u0a82 \u0ab5\u0ab0\u0acd\u0a9d\u0aa8 \u0a89\u0aaa\u0ab2\u0aac\u0acd\u0aa7 \u0a9b\u0ac7. \u0aa4\u0aae\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0aac\u0a9f\u0aa8 \u0aaa\u0ab0 \u0a95\u0acd\u0ab2\u0abf\u0a95 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0ac7\u0aa8\u0ac7 \u0a85\u0aaa\u0aa1\u0ac7\u0a9f \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0acb \u0a9b\u0acb. \u0a9c\u0acb \u0a95\u0acb\u0a88 \u0ab8\u0aae\u0ab8\u0acd\u0aaf\u0abe \u0a9c\u0aa3\u0abe\u0aaf, \u0aa4\u0acb \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0a85\u0aa8\u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a87\u0aa8\u0acd\u0ab8\u0acd\u0a9f\u0acb\u0ab2 \u0a95\u0ab0\u0acb",key_aadhaarpa_141:"\u0a86\u0aa7\u0abe\u0ab0 \u0aaa\u0ac7 \u0ab8\u0ac7\u0ab5\u0abe\u0aa8\u0acb \u0a89\u0aaa\u0aaf\u0acb\u0a97 \u0ab5\u0acb\u0ab2\u0ac7\u0a9f \u0ab8\u0ac7\u0ab5\u0abe \u0ab8\u0abe\u0aa5\u0ac7 \u0a95\u0ab0\u0ac0 \u0ab6\u0a95\u0abe\u0aa4\u0acb \u0aa8\u0aa5\u0ac0","1_Dear_Customer_Your_E_KYC_is_Not_Completed_So_Firstly_Complete_Your_E_KYC":"1. \u0ab5\u0ab9\u0abe\u0ab2\u0abe \u0a97\u0acd\u0ab0\u0abe\u0ab9\u0a95, \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 E-KYC \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa5\u0aaf\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0, \u0aa4\u0ac7\u0aa5\u0ac0 \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aaa\u0ab9\u0ac7\u0ab2\u0abe \u0aa4\u0aae\u0abe\u0ab0\u0ac1\u0a82 E-KYC \u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a95\u0ab0\u0acb",No_Camera_Found:"\u0a95\u0ac7\u0aae\u0ac7\u0ab0\u0abe \u0aae\u0ab3\u0acd\u0aaf\u0acb \u0aa8\u0aa5\u0ac0