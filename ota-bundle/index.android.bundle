u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",key_failedto_40:"\u0caa\u0cbe\u0cb8\u0ccd\u0cb5\u0cb0\u0ccd\u0ca1\u0ccd \u0cb0\u0cbf\u0cb8\u0cc6\u0c9f\u0ccd \u0cb2\u0cbf\u0c82\u0c95\u0ccd \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca8\u0c82\u0ca4\u0cb0 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",select_state_title:"\u0cb0\u0cbe\u0c9c\u0ccd\u0caf \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cb6\u0cc0\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0cc6",select_operator_title:"\u0c86\u0caa\u0cb0\u0cc7\u0c9f\u0cb0\u0ccd \u0c86\u0caf\u0ccd\u0c95\u0cc6 \u0cb6\u0cc0\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0cc6",wallet_screen_title:"\u0cb5\u0cbe\u0cb2\u0cc6\u0c9f\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd \u0cb6\u0cc0\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0cc6",profile_screen_title:"\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd \u0cb6\u0cc0\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0cc6",home_screen_title:"\u0cae\u0cc1\u0c96\u0caa\u0cc1\u0c9f \u0cb8\u0ccd\u0c95\u0ccd\u0cb0\u0cc0\u0ca8\u0ccd \u0cb6\u0cc0\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0cc6",done_button:"\u0cae\u0cc1\u0c97\u0cbf\u0ca4 \u0cac\u0c9f\u0ca8\u0ccd",view_image_title:"\u0c9a\u0cbf\u0ca4\u0ccd\u0cb0 \u0cb5\u0cc0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6 \u0cb6\u0cc0\u0cb0\u0ccd\u0cb7\u0cbf\u0c95\u0cc6",Close_button:"\u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cbf \u0cac\u0c9f\u0ca8\u0ccd",location_note_title:"\u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c97\u0cae\u0ca8\u0cbf\u0cb8\u0cbf",location_outside_message:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0c88\u0c97 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0c95\u0cc7\u0c82\u0ca6\u0ccd\u0cb0\u0ca6 \u0c9c\u0cbf\u0caf\u0ccb\u0cab\u0cc6\u0ca8\u0ccd\u0cb8\u0cbf\u0c82\u0c97\u0ccd \u0caa\u0ccd\u0cb0\u0ca6\u0cc7\u0cb6\u0ca6 \u0cb9\u0cca\u0cb0\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbf, \u0c86\u0ca6\u0ccd\u0ca6\u0cb0\u0cbf\u0c82\u0ca6 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cb2\u0cc1 \u0c85\u0ca8\u0cc1\u0cae\u0ca4\u0cbf \u0ca8\u0cc0\u0ca1\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",location_solution_title:"\u0caa\u0cb0\u0cbf\u0cb9\u0cbe\u0cb0 \u0c8f\u0ca8\u0cc1 \u0c87\u0cb0\u0cac\u0cb9\u0cc1\u0ca6\u0cc1?",location_solution_1:"1. \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cb0\u0cbf\u0caf\u0cbe\u0ca6 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0ca8\u0cbf\u0cae\u0ccd\u0cae Google \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf \u0c85\u0ca5\u0cb5\u0cbe \u0cae\u0cb0\u0cc1\u0cb8\u0cc6\u0c9f\u0ccd \u0cae\u0cbe\u0ca1\u0cbf.",location_solution_2:"2. \u0ca8\u0cc0\u0cb5\u0cc1 \u0cb9\u0cca\u0cb0\u0c97\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c9c\u0cbf\u0caf\u0ccb\u0cab\u0cc6\u0ca8\u0ccd\u0cb8\u0ccd \u0c92\u0cb3\u0c97\u0cc6 \u0cac\u0ca8\u0ccd\u0ca8\u0cbf. \u0ca8\u0cc0\u0cb5\u0cc1 \u0c85\u0ca4\u0cc0 \u0cb9\u0ca4\u0ccd\u0ca4\u0cbf\u0cb0 \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc2 \u0c92\u0cb3\u0c97\u0cc6 \u0c87\u0cb0\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cbf\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c92\u0cb3\u0c97\u0cc6 \u0cb9\u0ccb\u0c97\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.",location_solution_3:"3. Google \u0cb8\u0ccd\u0ca5\u0cb3 \u0c96\u0c9a\u0cbf\u0ca4\u0ca4\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf: \u0c87\u0ca6\u0cc1 \u0c85\u0ca4\u0ccd\u0caf\u0c82\u0ca4 \u0ca8\u0cbf\u0c96\u0cb0\u0cb5\u0cbe\u0ca6 \u0cb8\u0ccd\u0ca5\u0cb3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca8\u0cc0\u0ca1\u0cc1\u0ca4\u0ccd\u0ca4\u0ca6\u0cc6.",location_solution_4:"4. \u0caf\u0cbe\u0cb5\u0cc1\u0ca6\u0cc7 \u0cae\u0ca4\u0ccd\u0ca4\u0cca\u0c82\u0ca6\u0cc1 \u0cb8\u0cae\u0cb8\u0ccd\u0caf\u0cc6 \u0c87\u0ca6\u0ccd\u0ca6\u0cb0\u0cc6, \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95 \u0cb8\u0cc7\u0cb5\u0cc6\u0c97\u0cc6 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf.",understood_button:"\u0c86\u0cb0\u0ccd\u0ca5\u0cae\u0cbe\u0ca1\u0cbf\u0c95\u0cca\u0c82\u0ca1\u0cc1 \u0cac\u0c9f\u0ca8\u0ccd","UTR must be at least 12 characters":"UTR \u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 12 \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1","Verify UTR":"UTR \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf",key_youentere_113:"\u0ca8\u0cc0\u0cb5\u0cc1 \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf\u0ca6 UTR:\n\n{{utr}}\n\n\u0ca8\u0cc0\u0cb5\u0cc1 \u0cb8\u0cb2\u0ccd\u0cb2\u0cbf\u0cb8\u0cb2\u0cc1 \u0c96\u0c9a\u0cbf\u0ca4\u0cb0\u0cbf\u0ca6\u0ccd\u0ca6\u0cc0\u0cb0\u0cbe?",Sure:"\u0c96\u0c9a\u0cbf\u0ca4",Payee:"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0c97\u0cbe\u0cb0",VPA:"VPA","UTR No":"UTR \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6","Enter UTR (min 12 chars)":"UTR \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf (\u0c95\u0ca8\u0cbf\u0cb7\u0ccd\u0ca0 12 \u0c85\u0c95\u0ccd\u0cb7\u0cb0\u0c97\u0cb3\u0cc1)","Upload Payment Proof":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb8\u0cbe\u0cac\u0cc0\u0ca4\u0cc1 \u0c85\u0caa\u0ccd\u0cb2\u0ccb\u0ca1\u0ccd \u0cae\u0cbe\u0ca1\u0cbf","State Bank Of India \u20b9{{amount}}.00":"\u0cb8\u0ccd\u0c9f\u0cc7\u0c9f\u0ccd \u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c86\u0cab\u0ccd \u0c87\u0c82\u0ca1\u0cbf\u0caf\u0cbe \u20b9{{amount}}.00","OTP Sent to Mobile Number or Email":"OTP \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6 \u0c85\u0ca5\u0cb5\u0cbe \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Enter the OTP sent to your email":"\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c87\u0cae\u0cc7\u0cb2\u0ccd\u200c\u0c97\u0cc6 \u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 OTP \u0ca8\u0cae\u0cc2\u0ca6\u0cbf\u0cb8\u0cbf","Resend Otp":"OTP \u0cae\u0cb0\u0cc1\u0c95\u0cb3\u0cc1\u0cb9\u0cbf\u0cb8\u0cbf",Transaction:"\u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0",Circle:"\u0cb5\u0cc3\u0ca4\u0ccd\u0ca4","Date - Time":"\u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95 - \u0cb8\u0cae\u0caf","Share PDF":"PDF \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf","Failed to open PDF: ":"PDF \u0ca4\u0cc6\u0cb0\u0cc6\u0cb8\u0cb2\u0cc1 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6: ","Failed to share PDF: ":"PDF \u0cb9\u0c82\u0c9a\u0cb2\u0cc1 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6: ",transaction_receipt:"\u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cb0\u0cb8\u0cc0\u0ca6\u0cbf","PIN must be 4 or 6 digits":"PIN 4 \u0c85\u0ca5\u0cb5\u0cbe 6 \u0c85\u0c82\u0c95\u0cc6\u0c97\u0cb3\u0cbf\u0cb0\u0cac\u0cc7\u0c95\u0cc1",visibility:"\u0c95\u0cbe\u0ca3\u0cc1\u0cb5\u0cbf\u0c95\u0cc6","visibility-off":"\u0c95\u0cbe\u0ca3\u0ca6\u0c82\u0ca4\u0cc6","Extremely Important":"\u0c85\u0ca4\u0ccd\u0caf\u0c82\u0ca4 \u0cae\u0cc1\u0c96\u0ccd\u0caf",key_sorryyou_133:"\u0c95\u0ccd\u0cb7\u0cae\u0cbf\u0cb8\u0cbf, \u0caa\u0cca\u0cb2\u0cc0\u0cb8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 (PVC) \u0c87\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 Customer Point \u0ca8\u0cbf\u0c82\u0ca6 \u0cb9\u0cca\u0cb8 \u0caa\u0cbe\u0cb5\u0ca4\u0cbf\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0cb5\u0cc1\u0ca6\u0cbf\u0cb2\u0ccd\u0cb2.",key_butthisi_134:"\u0c86\u0ca6\u0cb0\u0cc6 \u0c97\u0ccd\u0cb0\u0cbe\u0cb9\u0c95\u0ca8\u0cbf\u0c97\u0cc6 \u0c87\u0ca6\u0cc1 \u0c90\u0c9a\u0ccd\u0c9b\u0cbf\u0c95, \u0ca8\u0cc0\u0cb5\u0cc1 \u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cc6\u0caf\u0cac\u0cb9\u0cc1\u0ca6\u0cc1",key_policever_135:"\u0caa\u0ccb\u0cb2\u0cc0\u0cb8\u0ccd \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0c95\u0ca1\u0ccd\u0ca1\u0cbe\u0caf. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 \u0cae\u0cbe\u0ca1\u0cbf \u0ca8\u0c82\u0ca4\u0cb0 \u0cae\u0cb0\u0cc1\u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf","Contact to admin for more details.":"\u0cae\u0ca4\u0ccd\u0ca4\u0cb7\u0ccd\u0c9f\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97