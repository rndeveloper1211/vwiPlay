a8\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u09b2\u09c7\u09a8\u09cd\u09b8 \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09ac\u09c7\u0964","Coming Bank Holidays":"\u0986\u09b8\u09a8\u09cd\u09a8 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u099b\u09c1\u099f\u09bf",Complaint:"\u09a6\u09cd\u09b0\u09b7\u09cd\u099f\u09ac\u09cd\u09af:- \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u099a\u09cd\u09af\u09be\u099f \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u0995\u09a5\u09cb\u09aa\u0995\u09a5\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b9\u09af\u09bc \u09a8\u09be\u0964 \u0986\u09ae\u09b0\u09be \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8-\u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u0997\u09c1\u09b2\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u0989\u09aa\u09b2\u09ac\u09cd\u09a7 \u098f\u09ac\u0982 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b8\u09ae\u09be\u09a7\u09be\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964","Complaint Through Chat Service":"\u099a\u09cd\u09af\u09be\u099f \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0985\u09ad\u09bf\u09af\u09cb\u0997","Support Email-ID":"\u09b8\u09be\u09aa\u09cb\u09b0\u09cd\u099f \u0987\u09ae\u09c7\u09b2-\u0986\u0987\u09a1\u09bf","Customer Care Number":"\u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09a8\u09ae\u09cd\u09ac\u09b0","Every Sunday":"\u09aa\u09cd\u09b0\u09a4\u09bf \u09b0\u09ac\u09bf\u09ac\u09be\u09b0","Every Saturday":"\u09aa\u09cd\u09b0\u09a4\u09bf \u09b6\u09a8\u09bf\u09ac\u09be\u09b0","Monday to Friday":"\u09b8\u09cb\u09ae\u09ac\u09be\u09b0 \u09a5\u09c7\u0995\u09c7 \u09b6\u09c1\u0995\u09cd\u09b0\u09ac\u09be\u09b0","Cust Time":"\u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b8\u09ae\u09af\u09bc","Our Customer Care Timing":"\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0997\u09cd\u09b0\u09be\u09b9\u0995 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b8\u09ae\u09af\u09bc","Help & Support":"\u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u098f\u09ac\u0982 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8",Back:"\u09aa\u09bf\u099b\u09a8\u09c7","November 01, 2024":"\u09a8\u09ad\u09c7\u09ae\u09cd\u09ac\u09b0 \u09e6\u09e7, \u09e8\u09e6\u09e8\u09ea","March 25, 2024":"\u09ae\u09be\u09b0\u09cd\u099a \u09e8\u09eb, \u09e8\u09e6\u09e8\u09ea",Holi:"\u09b9\u09cb\u09b2\u09bf",Monday:"\u09b8\u09cb\u09ae\u09ac\u09be\u09b0",Tuesday:"\u09ae\u0999\u09cd\u0997\u09b2\u09ac\u09be\u09b0",Wednesday:"\u09ac\u09c1\u09a7\u09ac\u09be\u09b0",Thursday:"\u09ac\u09c3\u09b9\u09b8\u09cd\u09aa\u09a4\u09bf\u09ac\u09be\u09b0",Friday:"\u09b6\u09c1\u0995\u09cd\u09b0\u09ac\u09be\u09b0",Saturday:"\u09b6\u09a8\u09bf\u09ac\u09be\u09b0",Sunday:"\u09b0\u09ac\u09bf\u09ac\u09be\u09b0",Deepawali:"\u09a6\u09c0\u09aa\u09be\u09ac\u09b2\u09bf","New Year":"\u09a8\u09a4\u09c1\u09a8 \u09ac\u099b\u09b0","FAQ Info":"\u09a6\u09cd\u09b0\u09b7\u09cd\u099f\u09ac\u09cd\u09af:- \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0997\u09a4 5 \u09a6\u09bf\u09a8\u09c7 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09be \u09b8\u09ae\u09b8\u09cd\u09a4 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u09a4\u09a5\u09cd\u09af \u09a6\u09bf\u099a\u09cd\u099b\u09bf\u0964 \u0986\u09aa\u09a8\u09bf \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u09a8\u09be\u09ae, \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u09ae\u09a1\u09c7\u09b2, \u0986\u0987\u09aa\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be, \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u0986\u0987\u09a1\u09bf, \u0985\u0995\u09cd\u09b7\u09be\u0982\u09b6 \u098f\u09ac\u0982 \u09a6\u09cd\u09b0\u09be\u0998\u09bf\u09ae\u09be\u0982\u09b6 \u098f\u09ac\u0982 \u09b6\u09c7\u09b7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09a6\u09b0\u0995\u09be\u09b0\u09c0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u0997\u09c1\u09b2\u09bf \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09a8 \u0995\u09b0\u09c1\u09a8\u0964 \u098f\u099f\u09bf \u0995\u09b0\u09be\u09b0 \u09aa\u09b0\u09c7, \u0986\u09aa\u09a8\u09bf \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09a8\u09af\u09bc \u098f\u09ae\u09a8 \u0995\u09cb\u09a8\u0993 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09a5\u09c7\u0995\u09c7 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\u0964","SAMSUNG Z 22":"\u09b8\u09cd\u09af\u09be\u09ae\u09b8\u09be\u0982 \u099c\u09c7\u09a1 \u09e8\u09e8","sdf dfdssd":"\u098f\u09b8\u09a1\u09bf\u098f\u09ab \u09a1\u09bf\u098f\u09ab\u09a1\u09bf\u098f\u09b8\u098f\u09b8\u09a1\u09bf","Manage Important Security":"\u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c1\u09a8","MIS description2":"\u09aa\u09cd\u09b0\u09bf\u09af\u09bc \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09af\u09bc\u09bf\u0995 \u0985\u0982\u09b6\u09c0\u09a6\u09be\u09b0, \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09b8\u09ae\u09b8\u09cd\u09a4 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b2\u09be\u09aa \u098f\u0987 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09af\u09bc \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09af\u09be \u0986\u09aa\u09a8\u09bf \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09a0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u0985\u09a4\u09cd\u09af\u09a8\u09cd\u09a4 \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3, \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u09b8\u09ae\u09af\u09bc \u09b8\u09ae\u09af\u09bc \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09ac\u09be\u09a1\u09bc\u09be\u09a4\u09c7 \u09a5\u09be\u0995\u09c1\u09a8\u0964",Security:{"Set SIM":"\u098f\u0995\u09ac\u09be\u09b0 \u09b8\u0995\u09cd\u09b0\u09bf\u09af\u09bc \u09b9\u09af\u09bc\u09c7 \u0997\u09c7\u09b2\u09c7, \u098f\u099f\u09bf \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09a4\u0996\u09a8\u0987 \u0995\u09be\u099c \u0995\u09b0\u09ac\u09c7 \u09af\u0996\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09b8\u09bf\u09ae \u098f\u0995\u0987 \u09ae\u09cb\u09ac\u09be\u0987\u09b2\u09c7 \u09a5\u09be\u0995\u09ac\u09c7, \u09af\u09be \u09b8\u09b9\u099c\u09c7\u0987 \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09a7\u09b0\u09a8\u09c7\u09b0 \u099c\u09be\u09b2\u09bf\u09af\u09bc\u09be\u09a4\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u09b0\u09cb\u09a7 \u0995\u09b0\u09ac\u09c7\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf \u099b\u09be\u09a1\u09bc\u09be \u0995\u09c7\u0989 \u09b2\u0997\u0987\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7 \u09a8\u09be\u0964","Mandatory SIM Setting":"\u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be\u09ae\u09c2\u09b2\u0995 \u09b8\u09bf\u09ae \u09b8\u09c7\u099f\u09bf\u0982","Screen Lock Setting":"\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8 \u09b2\u0995","Set One Time Password":"\u098f\u0995\u0995\u09be\u09b2\u09c0\u09a8 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b8\u09c7\u099f \u0995\u09b0\u09c1\u09a8","Screen Lock":"\u098f\u0987 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u099f\u09bf \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8 \u09b2\u0995 \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09be\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u09b6\u09a8 \u09b2\u0997\u0987\u09a8 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09a6\u09c7\u09af\u09bc\u0964 \u0986\u09aa\u09a8\u09bf \u09aa\u09bf\u09a8, \u09ab\u09bf\u0999\u09cd\u0997\u09be\u09b0\u09aa\u09cd\u09b0\u09bf\u09a8\u09cd\u099f \u098f\u09ac\u0982 \u09ae\u09c1\u0996\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09b2\u0995 \u0996\u09c1\u09b2\u09a4\u09c7 \u09b8\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964","OTP setting":"\u0993\u09af\u09bc\u09be\u09a8 \u099f\u09be\u0987\u09ae \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 {OTP} \u09b9\u09b2 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u099d\u09c1\u0981\u0995\u09bf \u098f\u09a1\u09bc\u09be\u09a4\u09c7 \u098f\u0995\u099f\u09bf \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u09b8\u09cd\u09a4\u09b0 \u09af\u09be \u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be\u09ae\u09c2\u09b2\u0995\u0964 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u0995\u09bf\u099b\u09c1 \u09a7\u09b0\u09a3\u09c7\u09b0 OTP \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09be \u09b8\u09cd\u09a4\u09b0 \u09b0\u09af\u09bc\u09c7\u099b\u09c7 \u09af\u09be \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09c1\u09ac\u09bf\u09a7\u09be \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09ac\u09c7\u099b\u09c7 \u09a8\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964","Change Login Password":"\u09b2\u0997\u0987\u09a8 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09c1\u09a8","Change L & P":"\u098f\u0996\u09be\u09a8\u09c7 \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09b2\u0997\u0987\u09a8 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, \u09af\u09be \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u0995\u09be\u09b0\u09a3\u09c7 \u09b8\u09ae\u09af\u09bc \u09b8\u09ae\u09af\u09bc \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09be \u0996\u09c1\u09ac \u0997\u09c1\u09b0\u09c1\u09a4\u09cd\u09ac\u09aa\u09c2\u09b0\u09cd\u09a3\u0964 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09a4\u09a5\u09cd\u09af \u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09af\u09bc \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964","Change or Forget PIN":"\u09aa\u09bf\u09a8 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09c1\u09a8 \u09ac\u09be \u09ad\u09c1\u09b2\u09c7 \u09af\u09be\u09a8","Forget PIN":"\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09bf\u09a8 \u09ad\u09c1\u09b2\u09c7 \u09af\u09be\u09a8 \u09ac\u09be \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8, \u09a4\u09be\u09b9\u09b2\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09bf\u09a8 \u0986\u09b0\u09cd\u09a5\u09bf\u0995 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09be\u099c \u0995\u09b0\u09c7, \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09bf\u09a8 \u099b\u09be\u09a1\u09bc\u09be \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0986\u09b0\u09cd\u09a5\u09bf\u0995 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8 \u09a8\u09be\u0964","Mob Registration Settings":"\u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09b0\u09c7\u099c\u09bf\u09b8\u09cd\u099f\u09cd\u09b0\u09c7\u09b6\u09a8 \u09b8\u09c7\u099f\u09bf\u0982\u09b8",Registration:"\u0986\u09aa\u09a8\u09bf \u098f\u0995 \u09ac\u09be \u098f\u0995\u09be\u09a7\u09bf\u0995 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u09b6\u09a8\u099f\u09bf \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u0993 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09a5\u09c7\u0995\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8\u09af\u09cb\u0997\u09cd\u09af \u09b9\u09ac\u09c7 \u09a8\u09be\u0964 \u0986\u09aa\u09a8\u09bf \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09bf\u09a4 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u0997\u09c1\u09b2\u09bf \u09a5\u09c7\u0995\u09c7 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u098f\u09ac\u0982 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09b8\u0995\u09cd\u09b7\u09ae \u09b9\u09ac\u09c7\u09a8\u0964","Manage Login Platform":"\u09b2\u0997\u0987\u09a8 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09c1\u09a8","Manage Login":"\u098f\u0987 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u099f\u09bf\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09aa\u09a8\u09bf \u0989\u09ad\u09af\u09bc \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae\u09c7 (\u0993\u09af\u09bc\u09c7\u09ac\u09b8\u09be\u0987\u099f \u098f\u09ac\u0982 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u0985\u09cd\u09af\u09be\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u09b6\u09a8) \u0986\u09aa\u09a8\u09be\u09b0 \u09b2\u0997\u0987\u09a8 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8, \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c7 \u0989\u09ad\u09af\u09bc \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c1\u09a8 \u0985\u09a8\u09cd\u09af\u09a5\u09be\u09af\u09bc \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6 \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09ac\u09cd\u09b2\u0995 \u0995\u09b0\u09c1\u09a8\u0964 \u098f\u099f\u09bf \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8\u0964"},"Please Enter Old Password":"\u09aa\u09c1\u09b0\u09be\u09a8\u09cb \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09b2\u09bf\u0996\u09c1\u09a8","Transaction PIN do not match":"\u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09bf\u09a8 \u09ae\u09c7\u09b2\u09c7 \u09a8\u09be",ERROR:"\u09a4\u09cd\u09b0\u09c1\u099f\u09bf",key_yourtrans_116:"\u0986\u09aa\u09a8\u09be\u09b0 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 \u09aa\u09bf\u09a8 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u09ae\u09c7\u09b2 \u0986\u0987\u09a1\u09bf\u09a4\u09c7 \u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0987\u09ae\u09c7\u09b2 \u0986\u0987\u09a1\u09bf \u099a\u09c7\u0995 \u0995\u09b0\u09c1\u09a8\u0964","Pin changed successfully!":"\u09aa\u09bf\u09a8 \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7!","An error occurred. Please try again.":"\u098f\u0995\u099f\u09bf \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u0998\u099f\u09c7\u099b\u09c7\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964","Want To Delete This Device":"\u098f\u0987 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u099f\u09bf \u09ae\u09c1\u099b\u09a4\u09c7 \u099a\u09be\u09a8","Are You Sure":"\u0986\u09aa\u09a8\u09bf \u0995\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4","Want To block This Device":"\u098f\u0987 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u099f\u09bf \u09ac\u09cd\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8","Want To Unblock This Device":"\u098f\u0987 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u099f\u09bf \u0986\u09a8\u09ac\u09cd\u09b2\u0995 \u0995\u09b0\u09a4\u09c7 \u099a\u09be\u09a8","Your State Update Successfully.":"\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u099f\u09c7\u099f \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964",ChangePassword:{"Change Login Password":"\u09b2\u0997\u0987\u09a8 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8 \u0995\u09b0\u09c1\u09a8","Password Security Tips":"\u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09b0\u09cd\u09a1 \u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u099f\u09bf\u09aa\u09b8","Current Password":"\u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8 \u09aa\u09be\u09b8\u0993\u09af\u09bc\u09be\u09