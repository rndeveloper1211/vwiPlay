\u09aa\u09a8\u09bf \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09ac\u09cb\u09a4\u09be\u09ae\u099f\u09bf \u099a\u09be\u09b2\u09c1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09ac\u09cb\u09a4\u09be\u09ae\u099f\u09bf \u099a\u09be\u09b2\u09c1 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09be\u09a5\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09a6\u09bf\u09a4\u09c7 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7, \u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u0995\u09be\u09b0\u09cd\u09af\u0995\u09b2\u09be\u09aa \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09b8\u09a4\u09b0\u09cd\u0995 \u0995\u09b0\u09c7\u0964 \u098f\u0987 \u09ab\u09be\u0982\u09b6\u09a8\u099f\u09bf\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7, \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09b6\u09ac\u09cd\u09a6 \u09a8\u09cb\u099f\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8 \u09b8\u09a4\u09b0\u09cd\u0995\u09a4\u09be \u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0995\u09b0\u09c7\u0964","Apk theme":"\u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u0995\u09cb\u09a8\u09cb \u0995\u09be\u09b0\u09a3\u09c7 \u09a1\u09bf\u09b8\u09aa\u09cd\u09b2\u09c7 \u09aa\u09b0\u09bf\u09b7\u09cd\u0995\u09be\u09b0\u09ad\u09be\u09ac\u09c7 \u09a6\u09c7\u0996\u09a4\u09c7 \u09a8\u09be \u09aa\u09be\u09a8, \u09a4\u09ac\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u099f\u09bf \u09a1\u09bf\u09ab\u09b2\u09cd\u099f \u0985\u09cd\u09af\u09be\u09aa \u09a5\u09bf\u09ae\u09c7 \u09a6\u09c7\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0986\u09aa\u09a8\u09bf \u09b8\u09b9\u099c\u09c7\u0987 \u09a1\u09bf\u09ab\u09b2\u09cd\u099f \u09a5\u09bf\u09ae \u09a8\u09bf\u09af\u09bc\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8