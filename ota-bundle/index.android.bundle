f \u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0c82\u0ca4\u0cb0","Re Amount":"\u0cb0\u0cc0 \u0cae\u0cca\u0ca4\u0ccd\u0ca4",key_anerroro_7:"\u0ca8\u0cbf\u0ca7\u0cbf \u0cb9\u0cb8\u0ccd\u0ca4\u0cbe\u0c82\u0ca4\u0cb0\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cc1\u0cb5\u0cbe\u0c97 \u0ca6\u0ccb\u0cb7 \u0cb8\u0c82\u0cad\u0cb5\u0cbf\u0cb8\u0cbf\u0ca6\u0cc6.",key_retailern_89:"\u0cae\u0cbe\u0cb0\u0cbe\u0c9f\u0c97\u0cbe\u0cb0 \u0cb2\u0cad\u0ccd\u0caf\u0cb5\u0cbf\u0cb2\u0ccd\u0cb2. \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0cbf\u0cb8\u0cbf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf.","Invalid Amount":"\u0c85\u0cae\u0cbe\u0ca8\u0ccd\u0caf \u0cae\u0cca\u0ca4\u0ccd\u0ca4",key_forupiam_43:"UPI \u0cae\u0cca\u0ca4\u0ccd\u0ca4 \u20b9${min} \u0cb0\u0cbf\u0c82\u0ca6 \u20b9${max} \u0ca8\u0ca1\u0cc1\u0cb5\u0cc6 \u0c87\u0cb0\u0cac\u0cc7\u0c95\u0cc1",key_dealercap_26:"\u0ca1\u0cc0\u0cb2\u0cb0\u0ccd \u0c95\u0cbe\u0caa\u0cbf\u0c82\u0c97\u0ccd \u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0c87\u0ca6\u0cc6, \u0ca6\u0caf\u0cb5\u0cbf\u0c9f\u0ccd\u0c9f\u0cc1 \u0c86\u0ca1\u0ccd\u0cae\u0cbf\u0ca8\u0ccd \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0cb8\u0cbf","Payment Failed":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6","Transaction failed. Reason: ${errorMsg}":"\u0cb5\u0ccd\u0caf\u0cb5\u0cb9\u0cbe\u0cb0 \u0cb5\u0cbf\u0cab\u0cb2\u0cb5\u0cbe\u0c97\u0cbf\u0ca6\u0cc6. \u0c95\u0cbe\u0cb0\u0ca3: ${errorMsg}","Something went wrong: ${error.message}":"\u0c8f\u0ca8\u0ccb \u0ca4\u0caa\u0ccd\u0caa\u0cbe\u0c97\u0cbf\u0ca6\u0cc6: ${error.message}","Payment method not found!":"\u0caa\u0cbe\u0cb5\u0ca4\u0cbf \u0cb5\u0cbf\u0ca7\u0cbe\u0ca8 \u0c95\u0c82\u0ca1\u0cc1\u0cac\u0cb0\u0cb2\u0cbf\u0cb2\u0ccd\u0cb2!","UPI URL missing":"UPI URL \u0c95\u0cbe\u0ca3\u0cb2\u0cbe\u0c97\u