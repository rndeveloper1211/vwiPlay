ndatory)":"\u0a86\u0aa7\u0abe\u0ab0 \u0a95\u0abe\u0ab0\u0acd\u0aa1 (\u0a85\u0aa8\u0abf\u0ab5\u0abe\u0ab0\u0acd\u0aaf)","Active USB Connection Detected":"\u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf USB \u0a95\u0aa8\u0ac7\u0a95\u0acd\u0ab6\u0aa8 \u0ab6\u0acb\u0aa7\u0abe\u0aaf\u0ac1\u0a82","Add New Pickup Request":"\u0aa8\u0ab5\u0ac1\u0a82 \u0aaa\u0ac0\u0a95\u0a85\u0aaa \u0ab0\u0abf\u0a95\u0acd\u0ab5\u0ac7\u0ab8\u0acd\u0a9f \u0a89\u0aae\u0ac7\u0ab0\u0acb","Add Other Qualification":"\u0a85\u0aa8\u0acd\u0aaf \u0ab2\u0abe\u0aaf\u0a95\u0abe\u0aa4 \u0a89\u0aae\u0ac7\u0ab0\u0acb",key_asproofo_17:"\u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0abe\u0aa8\u0ac1\u0a82 \u0aaa\u0ac1\u0ab0\u0abe\u0ab5\u0acb, \u0a9c\u0acb \u0aa4\u0ac7\u0a93\u0aa8\u0acb \u0a95\u0abe\u0aaf\u0aae\u0ac0 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0aa8\u0ac7 \u0ab5\u0ab0\u0acd\u0aa4\u0aae\u0abe\u0aa8 \u0ab8\u0ab0\u0aa8\u0abe\u0aae\u0ac1\u0a82 \u0a85\u0ab2\u0a97 \u0ab9\u0acb\u0aaf","Back Image":"\u0aaa\u0abe\u0a9b\u0ab3\u0aa8\u0ac0 \u0a9b\u0aac\u0ac0","Background Verification Form":"\u0aac\u0ac7\u0a95\u0a97\u0acd\u0ab0\u0abe\u0a89\u0aa8\u0acd\u0aa1 \u0ab5\u0ac7\u0ab0\u0abf\u0aab\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aab\u0acb\u0ab0\u0acd\u0aae","Bank Charges":"\u0aac\u0ac7\u0a82\u0a95 \u0a9a\u0abe\u0ab0\u0acd\u0a9c\u0abf\u0ab8",key_beloware_18:"\u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab5\u0acb\u0ab2\u0ac7\u0a9f\u0aae\u0abe\u0a82 UPI \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a89\u0aae\u0ac7\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0ac0\u0a9a\u0ac7 \u0aac\u0ac7 \u0ab5\u0abf\u0a95\u0ab2\u0acd\u0aaa \u0a9b\u0ac7. \u0a95\u0ac3\u0aaa\u0abe \u0a95\u0ab0\u0ac0\u0aa8\u0ac7 \u0aa4\u0ac7 \u0aaa\u0aa6\u0acd\u0aa7\u0aa4\u0abf \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb \u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0ac7 \u0aaa\u0ac7\u0aae\u0ac7\u0aa8\u0acd\u0a9f \u0a89\u0aae\u0ac7\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a82\u0a97\u0acb \u0a9b\u0acb. QR \u0aae\u0acb\u0aa1\u0aae\u0abe\u0a82, \u0a8f\u0a95 QR \u0a95\u0acb\u0aa1 \u0a96\u0ac2\