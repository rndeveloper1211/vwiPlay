02\u091a\u093e\u0932\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964",about_company_text_2:"\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930, \u0915\u0902\u092a\u0928\u0940 \u0928\u0915\u0926\u0940 \u0914\u0930 \u0915\u0940\u092e\u0924\u0940 \u0938\u093e\u092e\u093e\u0928\u094b\u0902 \u0915\u0940 \u0906\u0935\u093e\u091c\u093e\u0939\u0940 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u093f\u0935\u0939\u0928 \u0915\u0947 \u0915\u0908 \u0924\u0930\u0940\u0915\u094b\u0902, \u0926\u094b\u092a\u0939\u093f\u092f\u093e \u0935\u093e\u0939\u0928\u094b\u0902, \u0915\u093f\u0930\u093e\u090f \u0915\u0947 \u0935\u093e\u0939\u0928\u094b\u0902 \u0914\u0930 \u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u092c\u0916\u094d\u0924\u0930\u092c\u0902\u0926 \u0935\u0948\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u0915\u0902\u092a\u0928\u0940 \u0938\u092d\u0940 \u0917\u094d\u0930\u093e\u0939\u0915\u094b\u0902 \u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u0926\u093f\u0928 \u0932\u0917\u092d\u0917 5000 - 6000 \u092e\u093f\u0932\u093f\u092f\u0928 \u0930\u0941\u092a\u092f\u0947 \u0915\u0947 \u0928\u0915\u0926 \u0932\u0947\u0928\u0926\u0947\u0928 \u0915\u094b \u0938\u0902\u092d\u093e\u0932\u0924\u0940 \u0939\u0948\u0964",about_company_text_3:"\u0907\u0938 \u0916\u0902\u0921 \u0915\u0947 \u0924\u0939\u0924 \u0915\u0902\u092a\u0928\u0940 \u0915\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u092e\u0947\u0902 \u0905\u0902\u0924\u093f\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u0947 \u0928\u0915\u0926\u0940 \u0938\u0902\u0917\u094d\u0930\u0939 \u0914\u0930 \u0915\u0902\u092a\u0928\u0940 \u0915\u0947 \u091a\u093e\u0932\u0942 \u0916\u093e\u0924\u094b\u0902 \u092e\u0947\u0902 \u091c\u092e\u093e \u0915\u0930\u0928\u093e \u0914\u0930 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0909\u0938\u0940 \u0926\u093f\u0928 \u092f\