__d(function(e,a,t,o,i,n,r){i.exports={SP1:"\u0c38\u0c46\u0c32\u0c4d\u0c2b\u0c4d \u0c2a\u0c47\u0c2f\u0c4c\u0c1f\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c21\u0c2c\u0c4d\u0c2c\u0c41 IMPS (\u0c24\u0c15\u0c4d\u0c37\u0c23 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c47\u0c35) \u0c2e\u0c30\u0c3f\u0c2f\u0c41 NEFT (\u0c28\u0c47\u0c37\u0c28\u0c32\u0c4d \u0c0e\u0c32\u0c15\u0c4d\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c4d \u0c2b\u0c02\u0c21\u0c4d \u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c38\u0c4d\u200c\u0c2b\u0c30\u0c4d) \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c2a\u0c02\u0c2a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",SP2:"\u0c08-\u0c15\u0c47\u0c35\u0c48\u0c38\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c32\u0c3e\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u20b910.00 \u0c2b\u0c40\u0c1c\u0c41 \u0c35\u0c3f\u0c27\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f",SP3:"\u0c0f \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c35\u0c32\u0c4d\u0c32 \u0c05\u0c2f\u0c3f\u0c28\u0c3e, \u0c24\u0c2a\u0c4d\u0c2a\u0c41 \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c24\u0c47 \u0c05\u0c26\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c30\u0c4a\u0c15 \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c26\u0c41. \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c16\u0c3e\u0c24\u0c3e \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",SP4:"\u0c38\u0c46\u0c32\u0c4d\u0c2b\u0c4d-\u0c2a\u0c47 \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c15\u0c47\u0c35\u0c32\u0c02 \u0c30\u0c3f\u0c1f\u0c48\u0c32\u0c30\u0c4d \u0c38\u0c4d\u0c35\u0c02\u0c24 \u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c3e\u0c24\u0c4d\u0c30\u0c2e\u0c47, \u0c26\u0c40\u0c28\u0c4d\u0c28\u0c3f DMT \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c09\u0c2a\u0c2f\u0c4b\u0c17\u0c3f\u0c02\u0c1a\u0c30\u0c3e\u0c26\u0c41. \u0c2e\u0c40\u0c30\u0c41 \u0c0f\u0c35\u0c48\u0c28\u0c3e \u0c2a\u0c3e\u0c30\u0c4d\u0c1f\u0c40\u0c15\u0c3f \u0c2e\u0c4a\u0c24\u0c4d\u0c24\u0c02 \u0c2a\u0c02\u0c2a\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c15\u0c3e\u0c30\u0c23\u0c3e\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c32\u0c3e\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c38\u0c30\u0c48\u0c28 KYC \u0c1a\u0c47\u0c2f\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f.",SP5:"\u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c4b \u0c09\u0c02\u0c1f\u0c47, \u0c05\u0c26\u0c3f \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c24\u0c47\u0c26\u0c40 + \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c4d\u0c32\u0c4b \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",SP6:"\u0c08 \u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c2e\u0c3e\u0c28\u0c4d\u0c2f\u0c41\u0c35\u0c32\u0c4d \u0c38\u0c3f\u0c38\u0c4d\u0c1f\u0c2e\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c05\u0c35\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f 30 \u0c28\u0c3f\u0c2e\u0c3f\u0c37\u0c3e\u0c32\u0c41 \u0c2a\u0c21\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",D1:"IMPS (\u0c24\u0c15\u0c4d\u0c37\u0c23 \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41 \u0c38\u0c47\u0c35) \u0c2e\u0c30\u0c3f\u0c2f\u0c41 NEFT (\u0c28\u0c47\u0c37\u0c28\u0c32\u0c4d \u0c0e\u0c32\u0c15\u0c4d\u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c3f\u0c15\u0c4d \u0c2b\u0c02\u0c21\u0c4d \u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c38\u0c4d\u200c\u0c2b\u0c30\u0c4d) \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c2a\u0c02\u0c2a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",D2:"\u0c08-\u0c15\u0c47\u0c35\u0c48\u0c38\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c32\u0c3e\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u20b910.00 \u0c2b\u0c40\u0c1c\u0c41 \u0c35\u0c3f\u0c27\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f",D3:"\u0c0f \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c35\u0c32\u0c4d\u0c32 \u0c05\u0c2f\u0c3f\u0c28\u0c3e, \u0c24\u0c2a\u0c4d\u0c2a\u0c41 \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c21\u0c4b\u0c2e\u0c46\u0c38\u0c4d\u0c1f\u0c3f\u0c15\u0c4d \u0c2e\u0c28\u0c40 \u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c38\u0c4d\u200c\u0c2b\u0c30\u0c4d (DMT) \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c24\u0c47 \u0c05\u0c26\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c30\u0c4a\u0c15 \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c26\u0c41. \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c16\u0c3e\u0c24\u0c3e \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",D4:"\u0c21\u0c4b\u0c2e\u0c46\u0c38\u0c4d\u0c1f\u0c3f\u0c15\u0c4d \u0c2e\u0c28\u0c40 \u0c1f\u0c4d\u0c30\u0c3e\u0c28\u0c4d\u0c38\u0c4d\u200c\u0c2b\u0c30\u0c4d (DMT) \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e, \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c12\u0c15 \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c32\u0c4b \u20b95000 \u0c35\u0c30\u0c15\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c3e\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c3f \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c28\u0c46\u0c32\u0c15\u0c41 \u0c17\u0c30\u0c3f\u0c37\u0c4d\u0c1f\u0c02\u0c17\u0c3e \u20b925000 \u0c2a\u0c02\u0c2a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",D5:"\u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c4b \u0c09\u0c02\u0c1f\u0c47, \u0c05\u0c26\u0c3f \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c24\u0c47\u0c26\u0c40 + \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c4d\u0c32\u0c4b \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",D6:"\u0c15\u0c4a\u0c24\u0c4d\u0c24 \u0c2e\u0c3e\u0c30\u0c4d\u0c17\u0c26\u0c30\u0c4d\u0c36\u0c15\u0c3e\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c02\u0c1a\u0c3f, \u0c32\u0c3e\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c3f \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c15\u0c4b\u0c38\u0c02 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c24\u0c2a\u0c4d\u0c2a\u0c28\u0c3f\u0c38\u0c30\u0c3f. \u0c32\u0c3e\u0c2d\u0c2a\u0c4d\u0c30\u0c26\u0c3f \u0c08 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26\u0c3f \u0c26\u0c36\u0c32\u0c28\u0c41 \u0c05\u0c28\u0c41\u0c38\u0c30\u0c3f\u0c02\u0c1a\u0c3e\u0c32\u0c3f: \u0c2e\u0c4a\u0c26\u0c1f 10-\u0c05\u0c02\u0c15\u0c46\u0c32 \u0c2a\u0c4d\u0c30\u0c47\u0c30\u0c15 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f > OTP \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f (\u0c38\u0c30\u0c4d\u0c35\u0c40\u0c38\u0c4d \u0c2a\u0c4d\u0c30\u0c4a\u0c35\u0c48\u0c21\u0c30\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f) > \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41 \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f > \u0c35\u0c47\u0c33\u0c4d\u0c32\u0c4b\u0c1a\u0c3f\u0c2a\u0c4d\u0c2a\u0c41\u0c28\u0c41 \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c38\u0c4d\u0c15\u0c3e\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",D7:"\u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c05\u0c2f\u0c3f\u0c28 \u0c24\u0c30\u0c4d\u0c35\u0c3e\u0c24, OTP \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c32\u0c47\u0c30\u0c41 (OTP \u0c2a\u0c4d\u0c30\u0c47\u0c30\u0c15 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c2a\u0c02\u0c2a\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f).",PPI1:"IMPS, NEFT \u0c2e\u0c30\u0c3f\u0c2f\u0c41 UPI \u0c26\u0c4d\u0c35\u0c3e\u0c30\u0c3e \u0c15\u0c38\u0c4d\u0c1f\u0c2e\u0c30\u0c4d \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c2a\u0c02\u0c2a\u0c35\u0c1a\u0c4d\u0c1a\u0c41.",PPI2:"\u0c0f \u0c15\u0c3e\u0c30\u0c23\u0c02 \u0c35\u0c32\u0c4d\u0c32 \u0c05\u0c2f\u0c3f\u0c28\u0c3e, \u0c24\u0c2a\u0c4d\u0c2a\u0c41 \u0c16\u0c3e\u0c24\u0c3e\u0c32\u0c4b \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c35\u0c4d\u0c30\u0c3e\u0c38\u0c3f\u0c28\u0c26\u0c3f \u0c24\u0c3f\u0c30\u0c3f\u0c17\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c26\u0c41 \u0c32\u0c47\u0c26\u0c3e \u0c2e\u0c30\u0c4a\u0c15 \u0c16\u0c3e\u0c24\u0c3e\u0c15\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c26\u0c41. \u0c21\u0c2c\u0c4d\u0c2c\u0c41 \u0c2c\u0c26\u0c3f\u0c32\u0c40 \u0c1a\u0c47\u0c2f\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c2e\u0c41\u0c02\u0c26\u0c41 \u0c16\u0c3e\u0c24\u0c3e \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c28\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.",PPI3:"\u0c0f\u0c26\u0c48\u0c28\u0c3e \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d \u0c32\u0c4b \u0c09\u0c02\u0c1f\u0c47, \u0c05\u0c26\u0c3f \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40 \u0c24\u0c47\u0c26\u0c40 + \u0c30\u0c46\u0c02\u0c21\u0c41 \u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c3f\u0c02\u0c17\u0c4d \u0c30\u0c4b\u0c1c\u0c41\u0c32\u0c4d\u0c32\u0c4b \u0c15\u0c4d\u0c32\u0c3f\u0c2f\u0c30\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",PPI4:"\u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c28\u0c3f \u0c38\u0c30\u0c3f\u0c17\u0c4d\u0c17\u0c3e \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c3e\u0c28\u0c3f\u0c15\u0c3f, \u0c2e\u0c40\u0c30\u0c41 \u0c2a\u0c4d\u0c30\u0c47\u0c30\u0c15 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c32\u0c47\u0c26\u0c3e \u0c2a\u0c3e\u0c28\u0c4d \u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c15\u0c42\u0c21\u0c3e \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c3f. \u0c32\u0c47\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c2e\u0c40 \u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c28\u0c02\u0c2c\u0c30\u0c4d \u0c38\u0c4d\u0c35\u0c2f\u0c02\u0c1a\u0c3e\u0c32\u0c15\u0c02\u0c17\u0c3e \u0c32\u0c3e\u0c35\u0c3e\u0c26\u0c47\u0c35\u0c40\u0c24\u0c4b \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c41\u0c24\u0c41\u0c02\u0c26\u0c3f.",login:"\u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d",signUp:"\u0c38\u0c48\u0c28\u0c4d \u0c05\u0c2a\u0c4d",forgotPassword:"\u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c2e\u0c30\u0c4d\u0c1a\u0c3f\u0c2a\u0c4b\u0c2f\u0c3e\u0c30\u0c3e?",loginInfo:"\u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02",update_available:"\u0c28\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f",update_description:"\u0c05\u0c38\u0c4c\u0c15\u0c30\u0c4d\u0c2f\u0c3e\u0c28\u0c3f\u0c15\u0c3f \u0c15\u0c4d\u0c37\u0c2e\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f, \u0c15\u0c4a\u0c28\u0c4d\u0c28\u0c3f \u0c2b\u0c3f\u0c15\u0c4d\u0c38\u0c4d\u200c\u0c32\u0c24\u0c4b \u0c12\u0c15 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c28 \u0c2f\u0c3e\u0c2a\u0c4d \u0c05\u0c02\u0c26\u0c41\u0c2c\u0c3e\u0c1f\u0c41\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f. \u0c2e\u0c40\u0c30\u0c41 \u0c15\u0c4d\u0c30\u0c3f\u0c02\u0c26 \u0c2c\u0c1f\u0c28\u0c4d \u0c2a\u0c48 \u0c15\u0c4d\u0c32\u0c3f\u0c15\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c35\u0c1a\u0c4d\u0c1a\u0c41. \u0c38\u0c2e\u0c38\u0c4d\u0c2f \u0c09\u0c02\u0c1f\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c28\u0c4d\u200c\u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c33\u0c4d\u0c33\u0c40 \u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",update_now:"\u0c07\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",update_troubleshoot:"\u0c2f\u0c3e\u0c2a\u0c4d \u0c05\u0c2a\u0c4d\u0c21\u0c47\u0c1f\u0c4d \u0c05\u0c35\u0c15\u0c2a\u0c4b\u0c24\u0c47, \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c2f\u0c3e\u0c2a\u0c4d\u200c\u0c28\u0c41 \u0c05\u0c28\u0c4d\u200c\u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c38\u0c3f \u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c07\u0c28\u0c4d\u200c\u0c38\u0c4d\u0c1f\u0c3e\u0c32\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.",login_credentials_blank:"\u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c38\u0c30\u0c48\u0c28 \u0c2f\u0c42\u0c1c\u0c30\u0c4d ID \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c3e\u0c38\u0c4d\u0c35\u0c30\u0c4d\u0c21\u0c4d \u0c28\u0c2e\u0c4b\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f, \u0c07\u0c35\u0c3f \u0c16\u0c3e\u0c33\u0c40\u0c17\u0c3e \u0c35\u0c26\u0c32\u0c35\u0c26\u0c4d\u0c26\u0c41",notification_permission_granted:"\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c05\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f",notification_permission_not_granted:"\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c05\u0c28\u0c41\u0c2e\u0c24\u0c3f \u0c07\u0c35\u0c4d\u0c35\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41",video_kyc_pending:"\u0c35\u0c40\u0c21\u0c3f\u0c2f\u0c4b KYC \u0c05\u0c2a\u0c4d\u0c32\u0c4b\u0c21\u0c4d \u0c05\u0c2f\u0c4d\u0c2f\u0c3f\u0c02\u0c26\u0c3f. \u0c05\u0c21\u0c4d\u0c2e\u0c3f\u0c28\u0c4d \u0c06\u0c2e\u0c4b\u0c26\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c35\u0c47\u0c1a\u0c3f \u0c09\u0c02\u0c21\u0c02\u0c21\u0c3f.",remember:"\u0c2e\u0c30\u0c1a\u0c3f\u0c2a\u0c4b\u0c15\u0c41",session_expired:"\u0c38\u0c46\u0c37\u0c28\u0c4d \u0c2e\u0c41\u0c17\u0c3f\u0c38\u0c3f\u0c02\u0c26\u0c3f",hi:"\u0c39\u0c32\u0c4b",your_quick_access:"\u0c2e\u0c40 \u0c24\u0c4d\u0c35\u0c30\u0c3f\u0c24 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c24\u0c3f",recharge_pay_bill:"\u0c30\u0c3f\u0c1a\u0c3e\u0c30\u0c4d\u0c1c\u0c4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2c\u0c3f\u0c32\u0c4d \u0c1a\u0c46\u0c32\u0c4d\u0c32\u0c3f\u0c02\u0c2a\u0c41",is_already_exists:"\u0c07\u0c2a\u0c4d\u0c2a\u0c1f\u0c3f\u0c15\u0c47 \u0c09\u0c02\u0c26\u0c3f","Move Wallet":"\u0c35\u0c3e\u0c32\u0c46\u0c1f\u0c4d \u0c2c\u0c26\u0c3f\u0c32\u0c40","Hold & Credit":"\u0c39\u0c4b\u0c32\u0c4d\u200d\u0d21\u0d4d \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c15\u0c4d\u0c30\u0c46\u0c21\u0c3f\u0c1f\u0c4d","Recent Tr":"\u0c24\u0c3e\u0c1c\u0c3e \u0c1a\u0c30\u0c3f\u0c24\u0c4d\u0c30","View More":"\u0c2e\u0c30\u0c3f\u0c02\u0c24 \u0c1a\u0c42\u0c21\u0c02\u0c21\u0c3f","Hide More":"\u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c1a\u0c42\u0c2a\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f",New:"\u0c15\u0c4a\u0c24\u0c4d\u0c24\u0c26\u0c3f",signupText:"\u0c16\u0c3e\u0c24\u0c3e \u0c32\u0c47\u0c26\u0c41?",home_page:"\u0