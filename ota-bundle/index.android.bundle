092e\u091d\u0947\u0902\u0964","Go to Unblock":"\u0905\u0928\u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u093e\u090f\u0902",ON:"\u091a\u093e\u0932\u0942",OFF:"\u092c\u0902\u0926","":""},MobileDeviceReg:{MobileDeviceReg:"\u092e\u094b\u092c\u093e\u0907\u0932 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0902\u091c\u0940\u0915\u0930\u0923",Note:"\u0928\u094b\u091f:- \u0939\u092e \u0906\u092a\u0915\u094b \u0928\u0935\u0940\u0928\u0924\u092e 5 \u0926\u093f\u0928\u094b\u0902 \u092e\u0947\u0902 \u0932\u0949\u0917 \u0907\u0928 \u0915\u093f\u090f \u0917\u090f \u0938\u092d\u0940 \u092e\u094b\u092c\u093e\u0907\u0932 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u093e \u092a\u0942\u0930\u093e \u0935\u093f\u0935\u0930\u0923 \u0926\u0947 \u0930\u0939\u0947 \u0939\u0948\u0902, \u0906\u092a \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u093e \u0928\u093e\u092e, \u0921\u093f\u0935\u093e\u0907\u0938 \u092e\u0949\u0921\u0932, \u0906\u0908\u092a\u0940 \u090f\u0921\u094d\u0930\u0947\u0938, \u0921\u093f\u0935\u093e\u0907\u0938 \u0906\u0908\u0921\u0940, \u0905\u0915\u094d\u0937\u093e\u0902\u0936 \u0914\u0930 \u0926\u0947\u0936\u093e\u0902\u0924\u0930, \u0905\u0902\u0924\u093f\u092e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092a\u0924\u093e \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0909\u092a\u092f\u094b\u0917\u0940 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u094b \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0915\u0930\u0947\u0902\u0964 \u0910\u0938\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u0906\u092a \u0909\u0928 \u0905\u0928\u094d\u092f \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0938\u0947 \u0932\u0949\u0917 \u0907\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930 \u092a\u093e\u090f\u0902\u0917\u0947 \u091c\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0947 \u0938\u093e\u0925 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \